<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- 1. 强制覆盖所有子项目中的多语言资源设定，防止各个 csproj 里乱配 -->
  <PropertyGroup>
    <SatelliteResourceLanguages>en;zh-CN;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 2. 最强硬的清理手段：在解析完引用后，即将复制之前，强行剔除所有的 .xml 甚至 .pdb 文件 -->
  <Target Name="RemoveXmlAndPdbFilesFromCopyLocal" AfterTargets="ResolveReferences">
    <ItemGroup>
      <!-- 把所有扩展名为 .xml 的拷贝项剔除 -->
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.xml'" />
      
      <!-- 如果你在 Release 模式下连 PDB 文件都不想要，可以取消下面这两行的注释 -->
      <!--
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.pdb' And '$(Configuration)' == 'Release'" />
      -->
    </ItemGroup>
  </Target>

  <Target Name="CopyProjectAssets" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(OutputPath)Devices"
          SkipUnchangedFiles="true"
          Condition="'$(CopyToDevicesFolder)' == 'true'" />

    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(OutputPath)Motions"
          SkipUnchangedFiles="true"
          Condition="'$(CopyToMotionsFolder)' == 'true'" />
</Target>

<Target Name="CopyErrorCodeFolder" 
        AfterTargets="Build" 
        Condition="'$(CopyErrorCodeFolder)' == 'true' AND Exists('$(MSBuildProjectDirectory)\CardErrorCode')">
    <ItemGroup>
        <ErrorCodeFiles Include="$(MSBuildProjectDirectory)\CardErrorCode\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ErrorCodeFiles)" 
          DestinationFolder="$(OutputPath)CardErrorCode\%(RecursiveDir)" 
          SkipUnchangedFiles="true" />
</Target>

<Target Name="CopyCustomFolders" 
        AfterTargets="Build" 
        Condition="'$(CustomContentFolders)' != ''">
    <ItemGroup>
        <CustomFoldersToCopy Include="$(CustomContentFolders)" />
    </ItemGroup>
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="CopyOneFolderInternal"
             Properties="FolderToCopy=%(CustomFoldersToCopy.Identity)" />
</Target>

<Target Name="CopyOneFolderInternal" Condition="Exists('$(MSBuildProjectDirectory)\$(FolderToCopy)')">
    <ItemGroup>
        <FolderFiles Include="$(MSBuildProjectDirectory)\$(FolderToCopy)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FolderFiles)" 
          DestinationFolder="$(OutputPath)$(FolderToCopy)\%(RecursiveDir)" 
          SkipUnchangedFiles="true" />
</Target>

<Target Name="CollectPluginAssets"
        AfterTargets="Build"
        Condition="'$(IsShellProject)' == 'true'">
    <ItemGroup>
        <DeviceDlls Include="$(OutputPath)Devices\*.dll" />
        <MotionDlls Include="$(OutputPath)Motions\*.dll" />
    </ItemGroup>
    <Delete Files="@(DeviceDlls->'$(OutputPath)%(Filename)%(Extension)')"
            Condition="Exists('$(OutputPath)%(Filename)%(Extension)')" />
    <Delete Files="@(MotionDlls->'$(OutputPath)%(Filename)%(Extension)')"
            Condition="Exists('$(OutputPath)%(Filename)%(Extension)')" />
    <Message Text="[Shell] 自动汇总完成，所有组件已在 $(OutputPath) 中就绪。" Importance="high" />
</Target>

</Project>