<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>True</ManagePackageVersionsCentrally>
        <TargetFramework>net472</TargetFramework>
        <LangVersion>9.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        
        <ArtifactsDir>$(MSBuildThisFileDirectory)artifacts\</ArtifactsDir>
        
        <OutputPath>$(ArtifactsDir)bin\net472\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

        <BaseIntermediateOutputPath>$(ArtifactsDir)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
        
        <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    </PropertyGroup>

    <PropertyGroup>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DebugType>portable</DebugType>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
        <MinVerSkip>true</MinVerSkip>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
        <DebugType>embedded</DebugType>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <Target Name="DeepClean">
        <Message Text="Deep cleaning artifacts..." Importance="high" />
        <RemoveDir Directories="$(ArtifactsDir)" />
    </Target>

    <PropertyGroup>
        <MinVerTagPrefix>$(MSBuildProjectName)-v</MinVerTagPrefix>
    </PropertyGroup>

    <PropertyGroup>
        <IsShellProject Condition="'$(IsShellProject)' == ''">false</IsShellProject>
    </PropertyGroup>

    <PropertyGroup>
        <!-- 1. 清除引用库生成的多余文件 -->
        <!-- 默认是 .pdb;.xml，修改为只包含 .pdb，这将阻止复制数百个冗余的 .xml 注释文件 -->
        <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
        
        <!-- 如果在 Release 模式下连第三方包的 PDB 都不想要，可以设置为空: -->
        <!-- <AllowedReferenceRelatedFileExtensions Condition="'$(Configuration)' == 'Release'"></AllowedReferenceRelatedFileExtensions> -->

        <!-- 2. 过滤掉无用的多语言资源文件夹 (例如 fr, es, ru 等子文件夹) -->
        <!-- 只保留英语和简体中文 -->
        <SatelliteResourceLanguages>en;zh-CN;zh-Hans</SatelliteResourceLanguages>

        <!-- 3. 如果你自己项目也不需要生成 XML 文档说明 -->
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- 4. 可选：禁止 NuGet 包本身将不想关的内容（如 content files）复制到输出目录 -->
    <ItemDefinitionGroup>
      <PackageReference>
        <ExcludeAssets>contentFiles</ExcludeAssets>
      </PackageReference>
    </ItemDefinitionGroup>
</Project>