<?xml version="1.0" encoding="utf-8"?>
<!--
  测试宿主配置 (TES-133 net472 测试基建修复)
  - probing privatePath="Motions": Handover 等插件 dll 由 CopyToMotionsFolder 拷到
    Motions\ 子目录,主程序 Shell 的 CollectPluginAssets 会删除 bin 根的同名副本。
    测试 exe 在 bin 根运行,靠 probing 在 Motions\ 子目录定位插件 dll,
    无需手动复制 dll,且不受全量 sln 构建顺序影响。
  - binding redirect 由 AutoGenerateBindingRedirects 自动生成并与本文件合并。
-->
<configuration>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <probing privatePath="Motions" />
    </assemblyBinding>
  </runtime>
</configuration>
