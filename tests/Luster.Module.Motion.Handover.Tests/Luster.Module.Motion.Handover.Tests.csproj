<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<!-- 测试工程不拷贝到 Motions 目录 -->
		<CopyToMotionsFolder>false</CopyToMotionsFolder>
