<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<IsPackable>false</IsPackable>
		<Nullable>disable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="NUnit" />
		<PackageReference Include="NUnit3TestAdapter" />
		<PackageReference Include="FluentAssertions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Modules\Luster.Module.Motion.FiveAxis\Luster.Module.Motion.FiveAxis.csproj" />
		<!-- P5-7(TES-116):虚拟端到端跑通用 ZMotionMotionCard(SimulationMode)做卡端旁路虚拟后端 -->
		<ProjectReference Include="..\..\src\Modules\Luster.SimDevice.MotionCard\Luster.SimDevice.MotionCard.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- 可运行 recipe 拷贝到测试输出目录,供 LoadRecipe 加载校验 -->
		<Content Include="..\..\src\Modules\Luster.Module.Motion.FiveAxis\Recipes\AOI1_ThreeSegment.runtime.recipe.xml">
			<Link>Recipes\AOI1_ThreeSegment.runtime.recipe.xml</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<!-- TES-118:标定 diff 回归基线 CSV(源端算法语义独立手算,见 Diff/BASELINE-Provenance.md),拷贝到输出目录供 diff 工具比对 -->
		<Content Include="Diff\Baseline\*.csv">
			<Link>Diff\Baseline\%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
