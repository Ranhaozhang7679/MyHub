<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" allowInsecureConnections="True" />
        <add key="offline" value=".\packages" allowInsecureConnections="True" />

    </packageSources>

    <packageSourceMapping>                       
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <packageSource key="offline">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
    
</configuration>