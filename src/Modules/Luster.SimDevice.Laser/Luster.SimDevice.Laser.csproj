<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <Version>0.0.0.1</Version>
        <PlatformTarget>x64</PlatformTarget>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>

        <!-- 启用统一拷贝功能 -->
        <CopyToDevicesFolder>true</CopyToDevicesFolder>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="Costura64\GoApi.dll" />
        <None Remove="Costura64\GoPxLSdk.dll" />
        <None Remove="Costura64\GoPxLSdkExtern.dll" />
        <None Remove="Costura64\GoSdk.dll" />
        <None Remove="Costura64\kApi.dll" />
        <None Remove="Costura64\kApiNet.dll" />
        <None Remove="Costura64\kFireSync.dll" />
        <None Remove="Costura64\SR7Link.dll" />
        <None Remove="Costura64\SRAPI_CSharp-x64.dll" />
        <None Remove="Costura64\Vevo-x64.dll" />
        <None Remove="Costura64\Vevo.dll" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Costura64\GoApi.dll" />
        <EmbeddedResource Include="Costura64\GoPxLSdk.dll" />
        <EmbeddedResource Include="Costura64\GoPxLSdkExtern.dll" />
        <EmbeddedResource Include="Costura64\GoSdk.dll" />
        <EmbeddedResource Include="Costura64\kApi.dll" />
        <EmbeddedResource Include="Costura64\kApiNet.dll" />
        <EmbeddedResource Include="Costura64\kFireSync.dll" />
        <EmbeddedResource Include="Costura64\SR7Link.dll" />
        <EmbeddedResource Include="Costura64\SRAPI_CSharp-x64.dll" />
        <EmbeddedResource Include="Costura64\Vevo-x64.dll">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </EmbeddedResource>
        <EmbeddedResource Include="Costura64\Vevo.dll">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Costura.Fody">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="MinVer" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Luster.Common.DataAccess\Luster.Common.DataAccess.csproj" />
        <!--<ProjectReference Include="..\Luster.Motion.DataStruct\Luster.Motion.DataStruct.csproj" />-->
        <ProjectReference Include="..\Luster.SimDevice\Luster.SimDevice.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="FsApiNet">
            <HintPath>..\..\..\bin\net472\Devices\FsApiNet.dll</HintPath>
        </Reference>
        <Reference Include="GoPxlSDKNet">
            <HintPath>FocalSpce5000\GoPxLSdkNet.dll</HintPath>
        </Reference>
        <Reference Include="GoSdkNet">
            <HintPath>Costura64\GoSdkNet.dll</HintPath>
            <CopyLocal>True</CopyLocal>
        </Reference>
        <Reference Include="kApiNet">
            <HintPath>Costura64\kApiNet.dll</HintPath>
        </Reference>
        <Reference Include="SRAPI_CSharp-x64">
            <HintPath>Costura64\SRAPI_CSharp-x64.dll</HintPath>
        </Reference>
    </ItemGroup>

</Project>