<UserControl
    x:Class="Luster.Motion.FiveAxis.UI.Views.FiveAxisContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:param="clr-namespace:Luster.Control.Wpf.Motion;assembly=Luster.Control.Wpf.Motion"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">

    <Border Margin="10" Background="{DynamicResource BackgroundBrush}" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏：标定参数面板 + 权限提示 -->
            <Grid Grid.Row="0" Margin="10,10,10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="五轴 AOI 标定参数" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    Text="Administrator 字段按权限门控 / 面板对工程师+可见" />
            </Grid>

            <!-- ParamGrid：按 [Parameter] 特性自动生成编辑面板。
                 HasPermission 绑定 SysRole，ConverterParameter=Admin 对齐源端 [Permission(Administrator)]。
                 SelectedObject 当前为 stand-in（既有标定算子），待全栈交付真实五轴 [Parameter] 数据模型后替换。
                 特性对齐：[DisplayName]→CN / [Category]→Group / [Description]→Tips /
                           [Editor(UITypeEditor)]→EditorType / [Browsable(false)]→Visible=false /
                           [TypeConverter(ExpandableObjectConverter)]→CanExpand -->
            <ScrollViewer Grid.Row="1" Margin="10,0,10,10">
                <Grid>
                    <param:ParamGrid
                        MinHeight="120"
                        Margin="0"
                        HasPermission="{Binding SysRole, Converter={StaticResource RoleEnabledCoverter}, ConverterParameter=Admin}"
                        SelectedObject="{Binding CaliParamModule}" />

                    <!-- 占位提示：真实五轴标定 [Parameter] 数据模型（IModule）待全栈交付。
                         交付后给 CaliParamModule 赋值，本提示自动隐藏，ParamGrid 自动生成面板。 -->
                    <TextBlock
                        Margin="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="P6-A 基建就绪：ParamGrid 已装配 + 权限门控已接入。&#x0A;五轴标定 [Parameter] 数据模型待全栈工程师交付后自动生成参数面板。">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCaliParamModule}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
