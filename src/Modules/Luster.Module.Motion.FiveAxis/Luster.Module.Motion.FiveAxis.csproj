<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 启用统一拷贝功能:编译产物自动进 Motions\,被 ModuleFactory 反射自动加载(Shell 零改动) -->
		<CopyToMotionsFolder>true</CopyToMotionsFolder>
	</PropertyGroup>

	<ItemGroup>
		<!-- 五轴运动学模块依赖运控功能节点基类 MotionModule / MotionModuleCreator -->
		<ProjectReference Include="..\Luster.TaskFlow.Motion\Luster.TaskFlow.Motion.csproj" />
		<!-- P5-5:标定/配置数据模型实现 IXMLParser(平台 XElement round-trip 约定),需平台数据结构接口 -->
		<ProjectReference Include="..\Luster.Common.DataStruct\Luster.Common.DataStruct.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- 路 X 决策:原样迁 MathNet.Numerics 5.0.0(Coord5Axis 用 Matrix<double>/Vector<double>),不重写自研矩阵 -->
		<PackageReference Include="MathNet.Numerics" />
		<PackageReference Include="MinVer" />
	</ItemGroup>

	<!-- ADR 修正版(风险解除):不引入 RpcLibrary.Components dll。
	     UI 耦合基类 FieldToPropertyTypeDescriptor 已从 PositionBase/Coord5Axis 剥离(改普通类),
	     WinForm PropertyGrid 特性([TypeConverter]/[Category]/[DisplayName])已去,节点层改挂 lmv [Parameter]。
	     故无需 RpcLibrary.dll / System.Windows.Forms / System.Drawing / System.ComponentModel.DataAnnotations 引用。 -->

</Project>
