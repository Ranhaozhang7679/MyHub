<UserControl
    x:Class="Luster.Motion.CommonUI.Views.Dialogs.HiveStartDialog2Part1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:Luster.Motion.CommonUI.ViewModel.Dialogs"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Luster.Motion.CommonUI.Views.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=dialogs:HiveStartDialog2Part1VM}"
    d:DesignHeight="450"
    d:DesignWidth="700"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid" Focusable="True" MouseDown="RootGrid_MouseDown">
        <hc:Interaction.Triggers>
            <hc:EventTrigger EventName="KeyDown">
                <hc:EventToCommand Command="{Binding ScanCommand}" PassEventArgsToCommand="True" />
            </hc:EventTrigger>
            <hc:EventTrigger EventName="Loaded">
                <hc:EventToCommand Command="{Binding LoadCommand}" PassEventArgsToCommand="True" />
            </hc:EventTrigger>
        </hc:Interaction.Triggers>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Background="#518FFF">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label
                Width="100"
                HorizontalAlignment="Left"
                Background="Transparent"
                BorderBrush="Transparent"
                Content="观察&#x0a;Observe" />
            <Button
                Grid.Row="1"
                Width="300"
                Height="57"
                HorizontalContentAlignment="Left"
                Background="#D6D6D6"
                Command="{Binding Path=DataContext.ObserveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" SharedSizeGroup="IconColumn"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0"  Width="30" Height="30" Source="/Luster.Motion.CommonUI;component/Views/Dialogs/run.PNG" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" TextBlock.HorizontalAlignment="Left" TextAlignment="Left" Text="观察生产5个机台&#x0a;Observe production of 5 units"/>
                </Grid>
            </Button>
            <Label
                Grid.Row="2"
                Width="350"
                Margin="0,10,0,0"
                HorizontalContentAlignment="Center"
                Background="Transparent"
                BorderBrush="Transparent"
                Content="&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;设备能生产，HIVE保持在宕机状态&#x0a;Set machine in production mode while keeping Hive in Down State" 
                 />
            <Button
                Visibility="{Binding MaintenanceVisibility}"
                Grid.Row="3"
                Width="300"
                Height="57"
                HorizontalContentAlignment="left"
                Background="#D6D6D6"
                Command="{Binding Path=DataContext.Click1Command, RelativeSource={RelativeSource AncestorType=UserControl}}" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="IconColumn"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0"  Width="30" Height="30" Source="/Luster.Motion.CommonUI;component/Views/Dialogs/stop.PNG" Stretch="Uniform" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" TextBlock.HorizontalAlignment="Left" TextAlignment="Left" Text="停止设备，继续维修&#x0a;Stop machine, continue to repair"/>
                </Grid>
            </Button>
            <Label
                Grid.Row="4"
                Width="350"
                Margin="0,10,0,0"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderBrush="Transparent"
                Content="&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;停止设备，HIVE保持在宕机状态&#x0a;Fully stops machine while keeping Hive in Down State"
                Visibility="{Binding MaintenanceVisibility}" />
            <Button
                Visibility="{Binding MaintenanceVisibility}"
                Grid.Row="5"
                Width="300"
                Height="57"
                Margin="0,3,0,0"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Left"
                Background="#D6D6D6"
                Command="{Binding DataContext.Click2Command, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="IconColumn"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0"  Width="30" Height="30" Source="/Luster.Motion.CommonUI;component/Views/Dialogs/pause.PNG" Stretch="Uniform" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" TextBlock.HorizontalAlignment="Left" TextAlignment="Left" Text="暂停设备，继续维修&#xA;Pause machine,Continue to repair"/>
                </Grid>
            </Button>
            <Label
                Grid.Row="6"
                Width="350"
                Margin="0,10,0,0"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderBrush="Transparent"
                Content="              暂停设备，HIVE保持在宕机状态&#xA;Pause machine while keeping Hive in Down State"
                Visibility="{Binding MaintenanceVisibility}"/>
        </Grid>
        <Grid Grid.Column="1" Background="#8DD471">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />

            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Label
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="生产"
                    FontSize="30" />
                <Label
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="Resume production" />
                <Label
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="设备能生产，Hive切换到生产/待机状态&#x0a;Sets machine in production mode and&#x0a;changes Hive to Running/idle State"
                    FontSize="8" />
            </Grid>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Label
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="请求帮助 Help request:" />
                <Label
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="维护开始 Help request:" />
                <Label
                    Grid.Row="2"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="维护结束 Help request:" />
                <Label
                    Grid.Row="3"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="宕机时间 Help request:" />
                <TextBox
                    Grid.Column="1"
                    Background="#D6D6D6"
                    IsReadOnly="True"
                    Text="{Binding ErrorStartTime}" />
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Background="#D6D6D6"
                    IsReadOnly="True"
                    Text="{Binding RepairStartTime}" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Background="#D6D6D6"
                    IsReadOnly="True"
                    Text="{Binding RepairEndTime}" />
                <TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Background="#D6D6D6"
                    Text="{Binding DownTime, StringFormat={}{0} minutes}" />
            </Grid>
            <Line X1="0" Y1="0" X2="340" Y2="0"
                    Stroke="Gray"
                    StrokeThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,151,0,0" Grid.Row="1"/>
            <Grid Grid.Row="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Image
                    Grid.RowSpan="2"
                    Height="50"
                    Opacity="1"
                    Source="/Luster.Motion.CommonUI;component/Views/Dialogs/card.png" />
                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="线长: 请刷卡结束维修且恢复生产"
                    FontSize="6" />
                <Label
                    Grid.Row="1"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="Scan badge to end repair and resume production"
                    FontSize="6" />
            </Grid>
            <!-- 合并占同一行也行，或保持 7、8 两行，只要把内容换成这个 -->
            <StackPanel Grid.Row="7" Grid.RowSpan="2" Margin="2">
                <!-- 文本区 -->
                <Border BorderBrush="Gray" BorderThickness="1" Padding="6">
                    <TextBlock Text="{Binding CardLog}" TextWrapping="Wrap"/>
                </Border>
                <!-- 状态条：负上边距让上下边界重合 -->
                <Border BorderBrush="Gray" BorderThickness="1" Margin="0,-1,0,0">
                    <Grid Background="{Binding CardBkColor}" Height="20"/>
                </Border>
            </StackPanel>
            <!--<TextBlock Grid.Row="7" Text="{Binding CardLog}" />
            <Grid Grid.Row="8" Background="{Binding CardBkColor}" />-->
            <TextBlock
                x:Name="tbCardId"
                Grid.Row="9"
                Width="200"
                HorizontalAlignment="Left"
                Focusable="True"
                Text="        " />
        </Grid>
    </Grid>
</UserControl>
