<UserControl
    x:Class="Luster.Motion.CommonUI.Views.Dialogs.ShowOperationTipDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.CommonUI.Views.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Width="500"
    MinHeight="300"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="150" />
                <ColumnDefinition MinWidth="150" />
            </Grid.ColumnDefinitions>
            <GroupBox
                Margin="0,0,5,0"
                hc:TitleElement.Background="{DynamicResource RegionBrush}"
                Header="宕机原因"
                Style="{StaticResource GroupBoxTab}">
                <ItemsControl ItemsSource="{Binding StopReasons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton
                                Margin="5"
                                HorizontalAlignment="Left"
                                Content="{Binding Text}"
                                GroupName="Down"
                                IsChecked="{Binding IsSelected}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>
            <GroupBox
                Grid.Column="1"
                Margin="5,0,0,0"
                hc:TitleElement.Background="{DynamicResource RegionBrush}"
                Header="维护操作"
                Style="{StaticResource GroupBoxTab}">
                <ItemsControl ItemsSource="{Binding RepairReasons}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton
                                Content="{Binding Text}"
                                GroupName="Down"
                                IsChecked="{Binding IsSelected}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>
        </Grid>
        <Grid Grid.Row="1" Margin="0,10">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <CheckBox
                Name="ckOther"
                Margin="0,0,0,5"
                Content="其他原因"
                FontSize="16"
                FontWeight="Bold"
                IsChecked="{Binding IsOther}" />
            <TextBox
                Grid.Row="1"
                hc:InfoElement.Placeholder="请输入额外信息"
                IsEnabled="{Binding ElementName=ckOther, Path=IsChecked}"
                Text="{Binding Memo}" />
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,0,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="80"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="cancel"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
                <Button
                    Width="80"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="ok"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Confirm}}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
