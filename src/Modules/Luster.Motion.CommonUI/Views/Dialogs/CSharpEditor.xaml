<UserControl x:Class="Luster.Motion.CommonUI.Views.Dialogs.CSharpEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Luster.Motion.CommonUI.Views.Dialogs"
             xmlns:Models="clr-namespace:Luster.Motion.CommonUI.Models"
             mc:Ignorable="d" 
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
             d:DesignHeight="600" d:Width="800"
             Background="{DynamicResource RegionBrush}" MaxWidth="1000" MaxHeight="750"
             >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <ToolBar Grid.Row="0" Background="#FFEEE8E8">
            <Button Content="编译" Command="{Binding GenerateDll_Click}" Width="80" ToolTip="生成物理DLL文件" Background="#FF2196F3" Foreground="White"/>
            <Button Content="运行代码(内存)" Command="{Binding RunInMemory_Click}" ToolTip="在内存中编译并运行"/>
            <Button Content="运行DLL文件" Command="{Binding RunDll_Click}" ToolTip="运行已生成的DLL文件"/>
            <Separator/>
            <Button Content="清除输出" Command="{Binding ClearOutput_Click}"/>
            <Separator/>
            <Button Content="打开输出目录" Command="{Binding OpenOutputDir_Click}"/>
            <Button Content="清理输出文件" Command="{Binding CleanOutput_Click}"/>
            <Button
                 HorizontalAlignment="Right"
                 Command="{Binding CloseCommand}"
                 CommandParameter="cancel"
                 Content="关闭窗口" Width="80" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" />
        </ToolBar>

        <!-- 代码编辑器 -->
        <avalonEdit:TextEditor             
            Grid.Row="1"
            x:Name="CodeEditor"
            Models:TextEditorHelper.BindableText="{Binding CodeEditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            FontFamily="Consolas"
            FontSize="14"
            SyntaxHighlighting="C#"
            ShowLineNumbers="True"
            WordWrap="False"
            HorizontalScrollBarVisibility="Visible"
            VerticalScrollBarVisibility="Visible" MinHeight="300"
        />
        <GridSplitter Grid.Row="2"
              Height="3"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Background="#FFBDBDBD"
              ShowsPreview="True"
              ResizeDirection="Rows"
              />
        <Grid Grid.RowSpan="2" Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#FFF5F5F5" Height="20">
                <TextBlock x:Name="StatusText" Text="{Binding StatusText}" Margin="5,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="输出目录:" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="OutputDirText" Text="{Binding OutputDirText}" Margin="5,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="最新文件:" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="LatestFileText" Text="{Binding LatestFileText}" Margin="5,0,10,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TabControl Grid.Row="1" >
                <TabItem Header="输出">
                    <TextBox 
                        MinHeight="50"
                        x:Name="OutputTextBox"
                        Text="{Binding OutputText}"    
                        IsReadOnly="True"
                        VerticalScrollBarVisibility="Auto"
                        TextWrapping="Wrap"
                        FontFamily="Consolas"
                        Background="#FFF0F0F0"
                        BorderThickness="0"/>
                </TabItem>
                <TabItem Header="错误">
                    <TextBox 
                        x:Name="ErrorTextBox"
                        Text="{Binding ErrorText}"
                        IsReadOnly="True"
                        VerticalScrollBarVisibility="Auto"
                        TextWrapping="Wrap"
                        FontFamily="Consolas"
                        Foreground="Red"
                        Background="#FFF0F0F0"
                        BorderThickness="0"/>
                </TabItem>
                <TabItem Header="文件信息">
                    <ListBox 
                        x:Name="FileListBox"
                        ItemsSource="{Binding FileList}"                    
                        FontFamily="Consolas"
                        Background="#FFF0F0F0"/>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 状态和信息栏 -->
        <!-- 分割线 -->
        <!-- 输出窗口 -->
    </Grid>
</UserControl>
