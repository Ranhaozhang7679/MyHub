<UserControl x:Class="Luster.Motion.CommonUI.Views.Dialogs.HiveOnboardAlarmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Luster.Motion.CommonUI.Views.Dialogs"
             Loaded="OnLoadedAsync"
             mc:Ignorable="d"  Width="800" Height="400"
             d:DesignHeight="400" d:DesignWidth="800">
    <StackPanel Background="#FF4233A6">
        <!--<Rectangle Width="800" Height="20"  Stroke="Black" StrokeThickness="0" Fill="LightGray" />-->
        <Grid Height="400">
            <TextBlock Width="612" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="20" Foreground="White" Text="请检查Hive网络连接或者重新注册&#x0a;Pls check the Hive network connection or re-onboard" Margin="0,106,0,0"/>
            <Button   
                Command="{Binding DataContext.ClickCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                Height="62" Width="516" Content="发送最新消息/Send most recent message" FontSize="20" HorizontalContentAlignment="Center"  Background="LightGray" Margin="0,235,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" />
        </Grid>
    </StackPanel>
</UserControl>
