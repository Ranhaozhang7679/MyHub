<UserControl
    x:Class="Luster.Motion.CommonUI.Views.Dialogs.RecipeVersionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Width="480"
    d:DesignHeight="400"
    d:DesignWidth="480"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 版本类型 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5">
            <Label Content="版本类型：" VerticalAlignment="Center" />
            <ComboBox Width="200"
                      ItemsSource="{Binding VersionTypes}"
                      SelectedItem="{Binding SelectedVersionType}" />
        </StackPanel>

        <!-- 版本编号 -->
        <StackPanel Grid.Row="1" Margin="0,5">
            <StackPanel Orientation="Horizontal">
                <Label Content="版本编号：" VerticalAlignment="Center" />
                <TextBox Width="150" Text="{Binding VersionNoPrefix, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" />
                <TextBlock Text="." VerticalAlignment="Center" Margin="2,0" FontWeight="Bold" />
                <TextBox Width="45" Text="{Binding VersionNoDaySuffix, Mode=OneWay}"
                         VerticalAlignment="Center" IsReadOnly="True" Background="#EEEEEE" />
            </StackPanel>
            <TextBlock Margin="10,2,0,0" FontSize="12" Foreground="Red"
                       Text="{Binding VersionWarning}" TextWrapping="Wrap"
                       Visibility="{Binding HasVersionWarning, Converter={StaticResource Boolean2VisibilityConverter}}" />
        </StackPanel>

        <!-- 修改人和修改时间 -->
        <StackPanel Grid.Row="2" Margin="0,5">
            <StackPanel Orientation="Horizontal">
                <Label Content="修 改 人：" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ModifiedBy}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <Label Content="修改时间：" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ModifiedTime}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- 变更说明标题 + 添加按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5">
            <Label Content="变更说明：" VerticalAlignment="Center" />
            <Button Content="+" Width="30" Command="{Binding AddLineCommand}" />
        </StackPanel>

        <!-- 变更说明列表 -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,5">
            <ItemsControl ItemsSource="{Binding ChangeLines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBox Margin="0,2" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Width="80" Content="保存" Command="{Binding SaveVersionCommand}" Margin="0,0,10,0" />
            <Button Width="80" Content="取消" Command="{Binding CancelVersionCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
