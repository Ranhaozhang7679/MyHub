<UserControl
    x:Class="Luster.Motion.CommonUI.Views.Dialogs.HiveStartDialog2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:Luster.Motion.CommonUI.ViewModel.Dialogs"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Luster.Motion.CommonUI.Views.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=dialogs:HiveStartDialog2VM}"
    d:DesignHeight="450"
    d:DesignWidth="700"
    mc:Ignorable="d">
    <Grid>
        <hc:Interaction.Triggers>
            <hc:EventTrigger EventName="KeyDown">
                <hc:EventToCommand Command="{Binding ScanCommand}" PassEventArgsToCommand="True" />
            </hc:EventTrigger>
            <hc:EventTrigger EventName="Loaded">
                <hc:EventToCommand Command="{Binding LoadCommand}" PassEventArgsToCommand="True" />
            </hc:EventTrigger>
        </hc:Interaction.Triggers>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Background="#518FFF">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Label
                Width="100"
                HorizontalAlignment="Left"
                Background="Transparent"
                BorderBrush="Transparent"
                Content="观察&#x0a;Observe" />
            <Button
                Grid.Row="1"
                Width="300"
                Height="57"
                HorizontalContentAlignment="Center"
                Background="#D6D6D6"
                Command="{Binding Path=DataContext.ObserveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Content="&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;观察生产5个机台&#x0a;Observe production of 5 units" />
            <Label
                Grid.Row="2"
                Width="400"
                Margin="0,2,0,0"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderBrush="Transparent"
                Content="&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;设备能生产，HIVE保持在宕机状态&#x0a;Set machine in production mode with keeping Hive in Down State" />
            <Button
                Grid.Row="3"
                Width="300"
                Height="56"
                HorizontalContentAlignment="Center"
                Background="#D6D6D6"
                Command="{Binding Path=DataContext.Click1Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Content="&#x00a0;&#x00a0;        停止设备，继续维修&#x0a;Stop machine, continue to repair"
                Visibility="{Binding MaintenanceVisibility}" />
            <Label
                Grid.Row="4"
                Width="400"
                Margin="0,10,0,0"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderBrush="Transparent"
                Content="&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;&#x00a0;停止设备，HIVE保持在宕机状态&#x0a;Fully stops machine while keeping Hive in Down State"
                Visibility="{Binding MaintenanceVisibility}" />
            <Button
                Grid.Row="5"
                Grid.RowSpan="2"
                Width="300"
                Height="56"
                Margin="0,3,0,0"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                Background="#D6D6D6"
                Command="{Binding DataContext.Click2Command, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                Content="          暂停设备，继续维修&#xA;Pause machine,Continue to repair"
                Visibility="{Binding MaintenanceVisibility}" />
            <Label
                Grid.Row="6"
                Grid.RowSpan="2"
                Width="400"
                Margin="0,12,0,0"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderBrush="Transparent"
                Content="                 暂停设备，HIVE保持在宕机状态&#xA;Pause machine while keeping Hive in Down State"
                Visibility="{Binding MaintenanceVisibility}" />
        </Grid>
        <Grid Grid.Column="1" Background="#8DD471">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />

            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Label
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="生产"
                    FontSize="30" />
                <Label
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="Resume production" />
                <Label
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="设备能生产，Hive切换到生产/待机状态&#x0a;Sets machine in production mode and&#x0a;changes Hive to Running/idle State"
                    FontSize="8" />
            </Grid>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Label
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="请求帮助 Help request:" />
                <Label
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="维护开始 Help request:" />
                <Label
                    Grid.Row="2"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="维护结束 Help request:" />
                <Label
                    Grid.Row="3"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="宕机时间 Help request:" />
                <TextBox
                    Grid.Column="1"
                    Background="#D6D6D6"
                    IsReadOnly="True"
                    Text="{Binding ErrorStartTime}" />
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Background="#D6D6D6"
                    IsReadOnly="True"
                    Text="{Binding RepairStartTime}" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Background="#D6D6D6"
                    IsReadOnly="True"
                    Text="{Binding RepairEndTime}" />
                <TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Background="#D6D6D6"
                    Text="{Binding DownTime, StringFormat={}{0} minutes}" />
            </Grid>
            <hc:ComboBox
                Grid.Row="2"
                Width="350"
                hc:InfoElement.Placeholder="宕机原因 Downtime cause"
                DisplayMemberPath="Desc"
                ItemsSource="{Binding DownTimeLists}"
                SelectedValue="{Binding DownTimeCause}"
                SelectedValuePath="Desc"
                BorderBrush="Red"/>
            <hc:TextBox
                Grid.Row="3"
                Width="350"
                hc:InfoElement.Placeholder="宕机描述/维修动作（可填）&#x0a;Downtime description/ action taken(optional)"
                MouseLeave="tb_MouseLeave"
                Text="{Binding ActionTaken}" />
            <hc:ComboBox
                Grid.Row="4"
                Width="350"
                hc:InfoElement.Placeholder="消耗物品 Spare parts used "
                DisplayMemberPath="Desc"
                ItemsSource="{Binding SparePartLists}"
                MouseLeave="tb_MouseLeave"
                SelectedValue="{Binding SparePart}"
                SelectedValuePath="Desc"
                SelectionChanged="tb_MouseLeave"
                Visibility="{Binding MaintenanceVisibility}"
                BorderBrush="Red"/>
            <hc:ComboBox
                Grid.Row="5"
                Width="350"
                hc:InfoElement.Placeholder="评价（可选）Rating(optional)"
                DisplayMemberPath="Desc"
                ItemsSource="{Binding RateLists}"
                MouseLeave="tb_MouseLeave"
                SelectedValue="{Binding Rate}"
                SelectedValuePath="Desc"
                SelectionChanged="tb_MouseLeave"
                Visibility="{Binding MaintenanceVisibility}" />
            <Grid Grid.Row="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Image
                    Grid.RowSpan="2"
                    Height="50"
                    Opacity="1"
                    Source="/Luster.Motion.CommonUI;component/Views/Dialogs/card.png" />
                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="线长: 请刷卡结束维修且恢复生产"
                    FontSize="6" />
                <Label
                    Grid.Row="1"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="Scan badge to end repair and resume production"
                    FontSize="6" />
            </Grid>
            <TextBlock Grid.Row="7" Text="{Binding CardLog}" />
            <Grid Grid.Row="8" Background="{Binding CardBkColor}" />
            <TextBlock
                x:Name="tbCardId"
                Grid.Row="9"
                Width="200"
                HorizontalAlignment="Left"
                Focusable="True"
                Text="        " />
        </Grid>
    </Grid>
</UserControl>
