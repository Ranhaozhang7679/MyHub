<UserControl
    x:Class="Luster.Motion.CommonUI.Views.Dialogs.InteractiveDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.CommonUI.Views.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Width="500"
    Height="Auto"
    d:DesignWidth="500"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="MyRadioButton"
            BasedOn="{StaticResource RadioButtonIcon}"
            TargetType="RadioButton">
            <Setter Property="Height" Value="80" />
            <Setter Property="Margin" Value="0,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="32" />
        </Style>

        <Style x:Key="MyButtonBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="100" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="120" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel
            Margin="0,5"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <TextBlock
                FontSize="32"
                Foreground="{Binding FontBrush}"
                Text="交互对话框" />
        </StackPanel>
        <StackPanel
           Grid.Row="1"
             >
            <TextBlock
                FontSize="32"
                Foreground="{Binding FontBrush}" 
                Text="{Binding InteractiveTip }" />

        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource WarningBrush}" >
                <RadioButton
                    Background="{DynamicResource WarningBrush}"
                    Command="{Binding CloseCommand}"
                    CommandParameter="no"
                    Content="继续"
                    Foreground="White"
                    Style="{StaticResource MyRadioButton}" />
            </Border>
            <Border
                Grid.Column="1"
                Background="{DynamicResource SuccessBrush}"
                >
                <RadioButton
                    Background="{DynamicResource SuccessBrush}"
                    Command="{Binding CloseCommand}"
                    CommandParameter="ok"
                    Content="重试"
                    Foreground="White"
                    Style="{StaticResource MyRadioButton}" />
            </Border>

            <Border
                Grid.Column="2"
                Background="{DynamicResource DangerBrush}"
                >
                <RadioButton
                    Background="{DynamicResource DangerBrush}"
                    Command="{Binding CloseCommand}"
                    CommandParameter="cancel"
                    Content="停止"
                    Foreground="White"
                    Style="{StaticResource MyRadioButton}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
