<UserControl
    x:Class="Luster.Motion.CommonUI.Views.Dialogs.AlarmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.CommonUI.Views.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Width="800"
    d:DesignHeight="Auto"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
            <Setter Property="Width" Value="80" />
            <Setter Property="Margin" Value="5,0" />
        </Style>

        <Style TargetType="prism:DialogWindow">
            <!--<Setter Property="Topmost" Value="True" />-->
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Image Source="/Luster.Motion.Assests;component/Images/警告.png" Stretch="None" />
            <hc:Divider
                Grid.Column="1"
                Margin="2,10"
                LineStrokeDashArray="4,4"
                LineStrokeThickness="2"
                Orientation="Vertical" />
            <StackPanel Grid.Column="2">
                <Grid>
                    <Grid.RowDefinitions >
                        <RowDefinition Height="140" />
                        <RowDefinition Height="50" />
                        <RowDefinition Height="50" />
                        <RowDefinition Height="50" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                  
                <TextBlock Grid.Row="0"
                    Margin="10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="32"
                    FontWeight="Bold"
                    Text="{Binding AlarmTitle}" />
                    
                <TextBlock Grid.Row="1"
                    Margin="10"
                    FontSize="16"
                    Text="{Binding AlarmMsg}"
                    TextWrapping="WrapWithOverflow" />

                   



                    <TextBlock Grid.Row="2"
                    Margin="10"
                    FontSize="16"
                    Text="穴位号："
                    Visibility="{Binding CurveEnable, Converter={StaticResource Boolean2VisibilityConverter}}"          
                    TextWrapping="WrapWithOverflow" />

                    <TextBox Grid.Row="3"
                    Margin="10"
                    FontSize="16"
                     Background="LightGray"
                     Text="{Binding Curve, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding CurveEnable, Converter={StaticResource Boolean2VisibilityConverter}}"   
                     IsEnabled="True"
                     hc:Poptip.Content="{Binding WarningContent}"
                     />

                    <!-- 二维网格选择器 -->
                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="300" Margin="10,5,10,20" Visibility="{Binding GridEnable, Converter={StaticResource
                    Boolean2VisibilityConverter}}">
                    <ItemsControl Margin="10,5"
                    ItemsSource="{Binding GridItems}"
                    Visibility="{Binding GridEnable, Converter={StaticResource
                    Boolean2VisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding DataContext.TrayCols, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Gray" BorderThickness="1" Margin="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="White"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#4CAF50"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Content="{Binding DisplayText}"
                      FontSize="12"
                      Background="Transparent"
                      BorderThickness="0"
                      Command="{Binding DataContext.SelectGridItemCommand,
                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding}"
                      Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Foreground" Value="Black"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>

                </Grid>
            </StackPanel>
        </Grid>
        <hc:Divider
            Grid.Row="1"
            Height="2"
            Margin="0"
            LineStrokeThickness="2"
            Orientation="Horizontal" />
        <StackPanel
            Grid.Row="2"
            Margin="10,5"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="100"
                Command="{Binding CloseCommand}"
                CommandParameter="Stop"
                Content="{lang:Lang Key={x:Static lang:LangKeys.ProgramStop}}"
                Visibility="{Binding IsHigh, Converter={StaticResource Boolean2VisibilityConverter}}" />
            <Button
                Command="{Binding CloseCommand}"
                CommandParameter="Ng"
                Content="{lang:Lang Key={x:Static lang:LangKeys.ProductNG}}"
                Visibility="{Binding IsNG, Converter={StaticResource Boolean2VisibilityConverter}}" />
            <Button
                Command="{Binding CloseCommand}"
                CommandParameter="Continue"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Continue}}"
                Visibility="{Binding IsLow, Converter={StaticResource Boolean2VisibilityConverter}}" />
            <Button
                Command="{Binding CloseCommand}"
                CommandParameter="PlcClearError"
                Content="{lang:Lang Key={x:Static lang:LangKeys.PLCClearMistake}}"
                Visibility="{Binding IsPLC, Converter={StaticResource Boolean2VisibilityConverter}}" />
            <Button
                Command="{Binding CloseCommand}"
                CommandParameter="Retry"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Retry}}"
                Visibility="{Binding IsMiddle, Converter={StaticResource Boolean2VisibilityConverter}}" />
            <!--<Button
                Command="{Binding CloseCommand}"
                CommandParameter="Retry"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Retry}}"
                Visibility="{Binding IsMiddle, Converter={StaticResource Boolean2VisibilityConverter}}" />-->
        </StackPanel>
    </Grid>
</UserControl>
