<UserControl
    x:Class="Luster.Motion.CommonUI.Views.Dialogs.SetOpenCloseDoorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extension="clr-namespace:Luster.Motion.Assests.Extention;assembly=Luster.Motion.Assests"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.CommonUI.Views.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Width="800"
    Height="450"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Border
                Margin="2"
                Background="{DynamicResource BackgroundBrush}"
                CornerRadius="5">
                <StackPanel Orientation="Horizontal">
                    <hc:ComboBox
                        Width="200"
                        Margin="10,6"
                        HorizontalAlignment="Left"
                        hc:InfoElement.Placeholder="请选择"
                        hc:TitleElement.Title="类型"
                        hc:TitleElement.TitlePlacement="Left"
                        Background="{DynamicResource RegionBrush}"
                        DisplayMemberPath="{Binding Desc}"
                        IsEditable="False"
                        ItemsSource="{Binding DoorTypeList}"
                        SelectedValue="{Binding DoorType}"
                        SelectedValuePath="Key" />
                    <hc:SearchBar
                        Width="200"
                        Margin="5,6,0,6"
                        HorizontalAlignment="Left"
                        hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Module_Name}}"
                        hc:TitleElement.TitlePlacement="Left"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource SearchBarExtend}"
                        Text="{Binding SearchKey, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="55" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <ListView
                Name="ListOrign"
                Margin="2"
                AllowDrop="True"
                ItemContainerStyle="{StaticResource ListViewItemBaseStyle}"
                ItemsSource="{Binding OrignVarDatas}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding Name}" Header="{lang:Lang Key={x:Static lang:LangKeys.OutIO}}" />
                    </GridView>
                </ListView.View>
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="Drop">
                        <hc:EventToCommand Command="{Binding ReCallDropCommand}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </ListView>
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    hc:IconElement.Geometry="{StaticResource Transfer}"
                    Foreground="Gray"
                    Style="{StaticResource ButtonIcon}" />

            </StackPanel>
            <ListView
                Name="ListTo"
                Grid.Column="2"
                Margin="2"
                AllowDrop="True"
                ItemContainerStyle="{StaticResource ListViewItemBaseStyle}"
                ItemsSource="{Binding SelectVarDatas}">
                <ListView.View>
                    <GridView>
                        <GridView.Columns>
                            <GridViewColumn
                                Width="300"
                                DisplayMemberBinding="{Binding Name}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.GlobalVar}}" />
                            <!--<GridViewColumn Width="60" Header="{lang:Lang Key={x:Static lang:LangKeys.Apply}}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsHitTestVisible="True"
                                            Style="{StaticResource CheckBoxBaseStyle}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>-->
                            <GridViewColumn Width="Auto">
                                <GridViewColumnHeader HorizontalAlignment="Right" Content="{lang:Lang Key={x:Static lang:LangKeys.Delete}}" />
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Width="60"
                                            HorizontalAlignment="Right"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=ListView}, Path=DataContext.DeleteCommand}"
                                            CommandParameter="{Binding .}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.Delete}}"
                                            IsHitTestVisible="True"
                                            Style="{StaticResource ButtonDanger.Small}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView.Columns>
                    </GridView>
                </ListView.View>
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="Drop">
                        <hc:EventToCommand Command="{Binding ReciveDropCommand}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </ListView>
        </Grid>


        <DockPanel Grid.Row="2">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="80"
                    Margin="10,8,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="cancel"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
                <Button
                    Width="80"
                    Margin="10,8,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="ok"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Confirm}}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
