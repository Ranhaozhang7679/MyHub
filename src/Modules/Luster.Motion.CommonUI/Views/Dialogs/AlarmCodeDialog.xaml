<UserControl x:Class="Luster.Motion.CommonUI.Views.Dialogs.AlarmCodeDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:hc="https://handyorg.github.io/handycontrol"
 xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 Width="550"
 MinHeight="350"
 MaxHeight="400"
 d:DesignHeight="350"
 d:DesignWidth="550"
 Background="{DynamicResource RegionBrush}"
 mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Margin="10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <hc:SearchBar
             Width="200"
             Margin="5,0,0,0"
             HorizontalAlignment="Left"
                hc:InfoElement.Placeholder="关键字搜索"                
             hc:TitleElement.TitlePlacement="Left"
             Command="{Binding SearchCommand}"
             Style="{StaticResource SearchBarExtend}"
             Text="{Binding SearchKey, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
            <!--<hc:ButtonGroup
             Grid.Column="1"
             Margin="0,0,10,0"
             Visibility="{Binding IsIO, Converter={StaticResource Boolean2VisibilityConverter}}">
                <RadioButton Content="{lang:Lang Key={x:Static lang:LangKeys.Input}}" IsChecked="{Binding IsIn}" />
                <RadioButton Content="{lang:Lang Key={x:Static lang:LangKeys.Output}}" IsChecked="{Binding IsIn, Converter={StaticResource Boolean2BooleanReConverter}}" />
            </hc:ButtonGroup>-->
            <hc:ButtonGroup Grid.Column="2">
                <hc:ButtonGroup.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </hc:ButtonGroup.ItemsPanel>
                <Button
                 hc:IconElement.Geometry="{StaticResource SubGeometry}"
                 hc:IconElement.Width="12"
                 Command="{Binding CloseCommand}"
                 CommandParameter="cancel"
                 Content="{lang:Lang Key={x:Static lang:LangKeys.Clear}}"
                 Foreground="{StaticResource DangerBrush}"
                 Style="{StaticResource ButtonDanger}" />
                <Button
                 Grid.Column="1"
                 hc:IconElement.Geometry="{StaticResource RemoveGeometry}"
                 Command="{Binding CloseCommand}"
                 CommandParameter="close"
                 Content="{lang:Lang Key={x:Static lang:LangKeys.Exit}}"
                 Style="{StaticResource ButtonDanger}" />
            </hc:ButtonGroup>
        </Grid>
        <DataGrid
         Grid.Row="1"
         AutoGenerateColumns="False"
         CanUserSortColumns="False"
         HeadersVisibility="All"
         IsReadOnly="False"
         ItemsSource="{Binding AlarmCodeList}"
         SelectionMode="Single"
         Style="{StaticResource DataGrid.Small}">
            <DataGrid.Columns>
                <DataGridTextColumn
                 Width="100"
                 MinWidth="100"
                 Binding="{Binding AlarmKey}"
                 Header="报警代码"
                 IsReadOnly="True" />
                <DataGridTextColumn
                 Width="*"
                 MinWidth="150"
                 Binding="{Binding AlarmCN}"
                 Header="中文描述"
                 IsReadOnly="True" />
                <DataGridTextColumn
                Width="*"
                MinWidth="150"
                Binding="{Binding AlarmEn}"
                Header="英文描述"
                IsReadOnly="True" />
                <DataGridTemplateColumn
                 Width="80"
                 MinWidth="80"
                 Header="{lang:Lang Key={x:Static lang:LangKeys.Operate}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                             HorizontalAlignment="Center"
                             hc:IconElement.Geometry="{StaticResource SuccessGeometry}"
                             hc:IconElement.Width="12"
                             Command="{Binding Path=DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                             CommandParameter="{Binding .}"
                             Content="{lang:Lang Key={x:Static lang:LangKeys.Choose}}"
                             Style="{StaticResource ButtonDashed.Small}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
