<UserControl
    x:Class="Luster.Motion.CommonUI.Views.Dialogs.HiveOperationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Luster.Motion.CommonUI.Views.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Width="580"
    Height="650"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="White"
    mc:Ignorable="d">
    <Grid>
        <hc:Interaction.Triggers>
            <hc:EventTrigger EventName="KeyDown">
                <hc:EventToCommand Command="{Binding ScanCommand}" PassEventArgsToCommand="True" />
            </hc:EventTrigger>
            <hc:EventTrigger EventName="Loaded">
                <hc:EventToCommand Command="{Binding LoadCommand}" PassEventArgsToCommand="True" />
            </hc:EventTrigger>
        </hc:Interaction.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />

        </Grid.RowDefinitions>
        <Label Width="580" Background="Gray" />
        <Label
            Grid.Row="1"
            HorizontalAlignment="Center"
            Background="White"
            BorderThickness="0"
            FontWeight="Bold">
            设备已暂停 Machine paused
        </Label>
        <Grid Grid.Row="2" HorizontalAlignment="Center">
            <Separator
                Width="560"
                Height="5"
                Background="Black" />
        </Grid>

        <Label
            Grid.Row="3"
            HorizontalAlignment="Left"
            BorderThickness="0"
            Foreground="#FFE16E6D">
            维修/Repair
        </Label>
        <RadioButton
            Grid.Row="4"
            Margin="0,5,0,0"
            HorizontalAlignment="Left"
            Command="{Binding Path=DataContext.SetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="一级供应商"
            Content="一级供应商 Repaired by 1st tier vendor"
            GroupName="1" />
        <RadioButton
            Grid.Row="5"
            Margin="0,5,0,0"
            HorizontalAlignment="Left"
            Command="{Binding Path=DataContext.SetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="一+二级供应商"
            Content="一级和二级供应商维修 Repaired by 1st &amp; 2nd tier vendor"
            GroupName="1" />
        <RadioButton
            Grid.Row="6"
            Margin="0,5,0,0"
            HorizontalAlignment="Left"
            Command="{Binding Path=DataContext.SetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="凌云光"
            Content="康耐视 Repaired by Cognex"
            GroupName="1" />
        <RadioButton
            Grid.Row="7"
            Margin="0,5,0,0"
            HorizontalAlignment="Left"
            Command="{Binding Path=DataContext.SetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="汇川"
            Content="基恩士 Repaired by Keyence"
            GroupName="1" />
        <RadioButton
            Grid.Row="8"
            Margin="0,5,0,0"
            HorizontalAlignment="Left"
            Command="{Binding Path=DataContext.SetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="工厂人员"
            Content="工厂人员维修 Repaired by comtract manufacturer"
            GroupName="1" />
        <Grid Grid.Row="9" HorizontalAlignment="Center">
            <Separator
                Width="560"
                Height="5"
                Background="Black" />
        </Grid>
        <Label
            Grid.Row="10"
            HorizontalAlignment="Left"
            BorderThickness="0"
            Foreground="#FF0050C8">
            保养和其他/Maintenance and others
        </Label>
        <Grid Grid.Row="11">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <RadioButton
                Margin="0,5,0,0"
                HorizontalAlignment="Left"
                Command="{Binding Path=DataContext.SetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="耗材/物料补充"
                Content="耗材/物料补充 Consumable/material replenishment"
                GroupName="1" />
            <RadioButton
                Grid.Row="1"
                Margin="0,5,0,0"
                HorizontalAlignment="Left"
                Command="{Binding Path=DataContext.SetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="非生产时间调试"
                Content="非生产时间调试 Fine-tuning during non-production time"
                GroupName="1" />
            <Grid Grid.Row="2" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <RadioButton
                    Grid.Row="2"
                    HorizontalAlignment="Left"
                    Command="{Binding Path=DataContext.SetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="周保养"
                    Content="周保养 Weekly Maintenance"
                    GroupName="1" />
                <Label
                    Grid.Column="1"
                    BorderBrush="Transparent"
                    Content="到期Due in" />
                <Label
                    Grid.Column="2"
                    BorderBrush="Transparent"
                    Content="{Binding RemainWeekMaintenanceDays}"
                    Foreground="{Binding WeekMaintenanceColor}" />
                <Label
                    Grid.Column="3"
                    BorderBrush="Transparent"
                    Content="Days" />
            </Grid>
            <Grid Grid.Row="3" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <RadioButton
                    HorizontalAlignment="Left"
                    Command="{Binding Path=DataContext.SetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="月保养"
                    Content="月保养 Monthly Maintenance"
                    GroupName="1" />
                <Label
                    Grid.Column="1"
                    BorderBrush="Transparent"
                    Content="到期Due in" />
                <Label
                    Grid.Column="2"
                    BorderBrush="Transparent"
                    Content="{Binding RemainMonthMaintenanceDays}"
                    Foreground="{Binding MonthMaintenanceColor}" />
                <Label
                    Grid.Column="3"
                    BorderBrush="Transparent"
                    Content="Days" />
            </Grid>

            <RadioButton
                Grid.Row="4"
                Margin="0,5,0,0"
                HorizontalAlignment="Left"
                IsChecked="True"
                Command="{Binding Path=DataContext.SetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="计划关机"
                Content="计划关机/交接班 Planned shutdown / shift break"
                GroupName="1" />
        </Grid>

        <Grid Grid.Row="12" HorizontalAlignment="Center">
            <Separator
                Width="560"
                Height="5"
                Background="Black" />
        </Grid>
        <Label
            Grid.Row="13"
            HorizontalAlignment="Left"
            BorderThickness="0"
            Foreground="#FF3DB92B">
            非停机异常 / Degraded mode
        </Label>
        <RadioButton
            Grid.Row="14"
            Margin="0,5,0,0"
            HorizontalAlignment="Left"
            Command="{Binding Path=DataContext.SetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="记录非停机异常"
            Content="记录非停机异常/Logs DT while machine is running"
            GroupName="1" />
        <Grid Grid.Row="15" HorizontalAlignment="Center">
            <Separator
                Width="560"
                Height="5"
                Background="Black" />
        </Grid>
        <Grid
            Grid.Row="15"
            Grid.RowSpan="2"
            Margin="0,9,0,106">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Image
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Source="/Luster.Motion.CommonUI;component/Views/Dialogs/card.png" />
            <Label
                Grid.Row="0"
                Grid.Column="1"
                HorizontalAlignment="Left"
                BorderThickness="0">
                OSS/OP/线长: 请刷卡提交选项
            </Label>
            <Label
                Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                BorderThickness="0">
                Scan badge to submit the selected option
            </Label>
        </Grid>
        <Grid
            Grid.Row="15"
            Grid.RowSpan="2"
            Margin="0,9,0,-26"
            ShowGridLines="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="180" />
            </Grid.RowDefinitions>
            <!-- 新增：左侧状态区（按钮、倒计时继续保留原位置） -->
            <StackPanel Grid.Row="1"
                Margin="10,73,290,0"  
                Orientation="Vertical">
                <!-- CardLog 文字 -->
                <Border BorderBrush="Gray" BorderThickness="1" Padding="6">
                    <TextBlock Text="{Binding CardLog}"
                       TextWrapping="Wrap"/>
                </Border>

                <!-- CardBkColor 状态条：负上边距重合边框 -->
                <Border BorderBrush="Gray" BorderThickness="1"
                Margin="0,-1,0,0">
                    <Grid Background="{Binding CardBkColor}" Height="20"/>
                </Border>
            </StackPanel>
            <!--<TextBlock
                Grid.Row="1"
                Margin="0,73,290,0"
                Text="{Binding CardLog}" />
            <Grid
                Grid.Row="1"
                Margin="0,180,260,-18"
                Background="{Binding CardBkColor}" />-->
            <Button
                x:Name="ButtonResume"
                Grid.Row="1"
                Width="249"
                Height="83"
                Margin="320,79,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                Background="#518FFF"
                Command="{Binding Path=DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="Clear"
                Content="        恢复生产&#xA;Resume production"
                Foreground="White"
                Focusable="False"
                IsEnabled="{Binding IsButtonEnable}" />
            <Grid HorizontalAlignment="Left" Margin="325,162,0,0" Grid.Row="1" Width="300">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Width="200" HorizontalAlignment="Left" Text="剩余时间 Remaining time:" Grid.ColumnSpan="2"/>
                <TextBlock HorizontalAlignment="Left" Text="{Binding CountDown}" Grid.Column="2" />
            </Grid>
        </Grid>
    </Grid>
