<UserControl x:Class="Luster.Motion.CommonUI.Views.Dialogs.PythonEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Luster.Motion.CommonUI.Views.Dialogs"
             xmlns:Models="clr-namespace:Luster.Motion.CommonUI.Models"
             mc:Ignorable="d" 
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:prism="http://prismlibrary.com/"
             d:DesignHeight="600" d:Width="800"
             Background="{DynamicResource RegionBrush}" MaxWidth="1000" MaxHeight="750">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <ToolBar Grid.Row="0" Background="#FFEEE8E8">
            <Button Content="保存脚本" Command="{Binding SaveCommand}" Width="80" ToolTip="保存当前脚本" Background="#FF4CAF50" Foreground="White"/>
            <Separator/>
            <Button Content="导入离线依赖包(.whl/.tar.gz)" Command="{Binding ImportPackageCommand}" ToolTip="导入离线Python库"/>
            <Separator/>
            <Button
                 HorizontalAlignment="Right"
                 Command="{Binding CloseCommand}"
                 CommandParameter="cancel"
                 Content="关闭窗口" Width="80" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" />
        </ToolBar>

        <!-- 代码编辑器 -->
        <avalonEdit:TextEditor             
            Grid.Row="1"
            x:Name="CodeEditor"
            Models:TextEditorHelper.BindableText="{Binding CodeEditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            FontFamily="Consolas"
            FontSize="14"
            SyntaxHighlighting="Python"
            ShowLineNumbers="True"
            WordWrap="False"
            HorizontalScrollBarVisibility="Visible"
            VerticalScrollBarVisibility="Visible" MinHeight="300"
        />

        <GridSplitter Grid.Row="2"
              Height="3"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Background="#FFBDBDBD"
              ShowsPreview="True"
              ResizeDirection="Rows"
              />

        <Grid Grid.RowSpan="2" Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#FFF5F5F5" Height="20">
                <TextBlock Text="{Binding StatusText}" Margin="5,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="输出目录:" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding OutputDirectory}" Margin="5,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="当前文件:" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding LatestGeneratedFile}" Margin="5,0,10,0" VerticalAlignment="Center"/>
            </StackPanel>

            <TabControl Grid.Row="1" >
                <TabItem Header="Pip包管理日志">
                    <TextBox 
                        Text="{Binding PipLogOutput}"    
                        IsReadOnly="True"
                        VerticalScrollBarVisibility="Auto"
                        TextWrapping="Wrap"
                        FontFamily="Consolas"
                        Background="#FFF0F0F0"
                        BorderThickness="0"/>
                </TabItem>
                <TabItem Header="错误">
                    <TextBox 
                        Text="{Binding ErrorText}"
                        IsReadOnly="True"
                        VerticalScrollBarVisibility="Auto"
                        TextWrapping="Wrap"
                        FontFamily="Consolas"
                        Foreground="Red"
                        Background="#FFF0F0F0"
                        BorderThickness="0"/>
                </TabItem>
                <TabItem Header="输出">
                    <TextBox 
                        Text="{Binding OutputText}"
                        IsReadOnly="True"
                        VerticalScrollBarVisibility="Auto"
                        TextWrapping="Wrap"
                        FontFamily="Consolas"
                        Foreground="Black"
                        Background="#FFF0F0F0"
                        BorderThickness="0"/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>