<UserControl
    x:Class="Luster.Motion.CommonUI.Views.Dialogs.EditBarcodeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.CommonUI.Views.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="350"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="ScanTextStyle"
            BasedOn="{StaticResource TextBoxExtend}"
            TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="OrderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <hc:TextBox
                Width="250"
                hc:InfoElement.Placeholder="条码长度"
                hc:InfoElement.Title="检查条码长度:"
                hc:InfoElement.TitlePlacement="Left"
                hc:TitleElement.TitleWidth="85"
                Foreground="Black"
                Text="{Binding Length, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="PreviewKeyDown">
                        <hc:EventToCommand Command="{Binding LengthChangeCommand}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </hc:TextBox>
            <ToggleButton
                Grid.Column="1"
                HorizontalAlignment="Center"
                IsChecked="{Binding CheckLength}"
                Style="{StaticResource ToggleButtonSwitch}" />
        </Grid>
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <hc:TextBox
                Width="250"
                hc:InfoElement.Placeholder="条码规则"
                hc:InfoElement.Title="检查条码规则:"
                hc:InfoElement.TitlePlacement="Left"
                hc:TitleElement.TitleWidth="85"
                Foreground="Black"
                Text="{Binding Expression, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="PreviewKeyDown">
                        <hc:EventToCommand Command="{Binding RuleChangeCommand}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </hc:TextBox>
            <ToggleButton
                Grid.Column="1"
                HorizontalAlignment="Center"
                IsChecked="{Binding CheckExpression}"
                Style="{StaticResource ToggleButtonSwitch}" />
        </Grid>
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <TextBlock Width="250" Text="是否自动删除" />
            <ToggleButton
                Grid.Column="1"
                HorizontalAlignment="Center"
                IsChecked="{Binding AutoDelete}"
                Style="{StaticResource ToggleButtonSwitch}" />
        </Grid>
        <StackPanel
            Grid.Row="3"
            Margin="0,10,10,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Width="50"
                Command="{Binding CloseCommand}"
                CommandParameter="cancel"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
            <Button
                Width="50"
                Margin="15,0,0,0"
                Command="{Binding CloseCommand}"
                CommandParameter="ok"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Confirm}}" />
        </StackPanel>
    </Grid>
</UserControl>
