<UserControl x:Class="Luster.Motion.CommonUI.Views.Dialogs.HiveStartDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Luster.Motion.CommonUI.Views.Dialogs"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="9*"/>

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="LightGray"/>
        <Button Grid.Row="1" Background="Red"  Height="180" Width="150" 
                Command="{Binding Path=DataContext.ClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="调试" 
                >

            <TextBlock TextAlignment="Center" FontSize="9" Height="86" Width="145">
                调试
                <LineBreak/>
                Fine-tuning
                <LineBreak/>               
                关闭PDCA
                <LineBreak/>
                PDCA disabled
                <LineBreak/>
                Hive状态保持宕机
                <LineBreak/>              
                Hive state remains Down
            </TextBlock>
        </Button>

        <Button Grid.Row="1" Grid.Column="1"  Background="LightGreen"  Height="180" Width="150" 
                Command="{Binding Path=DataContext.ClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="生产"    
                >
            <TextBlock TextAlignment="Center" FontSize="9" Height="86" Width="145">
                生产
                <LineBreak/>
                Production
                <LineBreak/>               
                启用PDCA
                <LineBreak/>
                PDCA ensabled
                <LineBreak/>
                Hive状态切成待机/生产
                <LineBreak/>              
                Hive changed to Idle/Running
            </TextBlock>
        </Button>

    </Grid>
</UserControl>
