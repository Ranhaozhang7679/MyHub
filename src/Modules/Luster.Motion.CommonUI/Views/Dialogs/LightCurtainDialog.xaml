<UserControl
    x:Class="Luster.Motion.CommonUI.Views.Dialogs.LightCurtainDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.CommonUI.Views.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignWidth="300"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
            <ComboBox
                Height="30"
                MinWidth="300"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Device}}"
                hc:InfoElement.TitlePlacement="Left"
                hc:TitleElement.TitleWidth="70"
                DisplayMemberPath="Name"
                Foreground="Black"
                ItemsSource="{Binding DataContext.DeviceList, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{StaticResource ComboBoxExtend.Small}">
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="SelectionChanged">
                        <hc:EventToCommand Command="{Binding DeviceChangeCommand}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </ComboBox>

            <ComboBox
                Height="30"
                MinWidth="300"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.GlobalVar}}"
                hc:InfoElement.TitlePlacement="Left"
                hc:TitleElement.TitleWidth="70"
                DisplayMemberPath="GlobalName"
                Foreground="Black"
                ItemsSource="{Binding DataContext.VarDatas, RelativeSource={RelativeSource AncestorType=UserControl}}"
                SelectedItem="{Binding SelectGlobal}"
                Style="{StaticResource ComboBoxExtend.Small}">
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="SelectionChanged">
                        <hc:EventToCommand Command="{Binding GlobalChangeCommand}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </ComboBox>
        </hc:UniformSpacingPanel>
        <DockPanel Grid.Row="1" Margin="0,20,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="80"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="cancel"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
                <Button
                    Width="80"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="ok"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Confirm}}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
