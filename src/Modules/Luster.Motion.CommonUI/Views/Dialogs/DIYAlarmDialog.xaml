<UserControl x:Class="Luster.Motion.CommonUI.Views.Dialogs.DIYAlarmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Luster.Motion.CommonUI.Views.Dialogs"
             xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
             mc:Ignorable="d" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource RegionBrush}"
             d:Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <hc:UniformSpacingPanel Grid.Row="0" Orientation="Vertical" Spacing="10">
            <hc:NumericUpDown 
                hc:InfoElement.Necessary="True"
                hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.AlarmID}}"
                hc:TitleElement.TitlePlacement="Left"
                hc:TitleElement.TitleWidth="70"
                Style="{StaticResource NumericUpDownExtendBaseStyle }"
                Value="{Binding AlarmID}"
             />
            
            <TextBox
                hc:InfoElement.Necessary="True"
                hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.AlarmContent}}"
                hc:TitleElement.TitlePlacement="Left"
                hc:TitleElement.TitleWidth="70"
                Style="{StaticResource TextBoxValidationStyle}"
                Text="{Binding AlarmContent}" />
            
            <TextBox
                hc:InfoElement.Necessary="True"
                hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.AlarmSolution}}"
                hc:TitleElement.TitlePlacement="Left"
                hc:TitleElement.TitleWidth="70"
                Style="{StaticResource TextBoxValidationStyle}"
                Text="{Binding AlarmSolution}" />
            
        </hc:UniformSpacingPanel>

        <DockPanel Grid.Row="1" Margin="0,20,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                Width="80"
                HorizontalAlignment="Right"
                Command="{Binding CloseCommand}"
                CommandParameter="cancel"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
                <Button
                Width="80"
                Margin="10,0,0,0"
                HorizontalAlignment="Right"
                Command="{Binding CloseCommand}"
                CommandParameter="ok"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Confirm}}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
