<UserControl
    x:Class="Luster.Motion.CommonUI.Views.Dialogs.HiveStartDialog2Part2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:Luster.Motion.CommonUI.ViewModel.Dialogs"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Luster.Motion.CommonUI.Views.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=dialogs:HiveStartDialog2Part2VM}"
    Width="700" Height="350"
    d:DesignHeight="350"
    d:DesignWidth="700"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Background="#8DD471" RenderTransformOrigin="0.523,0.432">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Rectangle Grid.Row="0" Width="700" Height="20"  Stroke="Black" StrokeThickness="0" Fill="LightGray" Margin="0,0,0,10" />
            <hc:ComboBox
                Grid.Row="1"
                Width="680"
                IsEditable="False"
                hc:InfoElement.Placeholder="宕机原因 Downtime cause"
                DisplayMemberPath="Desc"
                ItemsSource="{Binding DownTimeLists}"
                Text="{Binding DownTimeCause, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                SelectedValuePath="Desc"
                BorderBrush="Red" Margin="0,0,0,0" Grid.RowSpan="3"/>
            <!-- 表格容器：外框 + 与上方间距 10 -->
            <Border Grid.Row="2" Width="680" BorderBrush="Red" BorderThickness="1" Margin="0,40,0,10">
                <!-- 内部 Grid：画行列线 -->
                <Grid Width="660" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 行列线：用 Border 画线，比 ShowGridLines 更细更可控 -->
                    <!-- 横线 1（表头底边） -->
                    <Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="Black" BorderThickness="0,0,0,1" Margin="-10,0,-10,89" Grid.RowSpan="2"/>
                    <!-- 竖线 1（列间） -->
                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,0"/>
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,0"/>
                    <!-- 竖线 2 -->
                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,0"/>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,0"/>

                    <!-- 表头文字 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="检查步骤&#x0a;Action taken"
                   HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="用到工具&#x0a;Tools used"
                   HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="调整参数&#x0a;Settings changed"
                   HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold"/>

                    <!-- 第 2 行：每个 ComboBox 外包 Border，Padding=10 保证到框线≥10 -->
                    <Border Grid.Row="1" Grid.Column="0" Padding="5">
                        <!--<hc:ComboBox hc:InfoElement.Placeholder="" Height="80" IsEditable="True" DisplayMemberPath="Desc" ItemsSource="{Binding ActionLists}" SelectedValuePath="Desc" SelectedValue="{Binding ActionTaken}"  HorizontalAlignment="Stretch" VerticalAlignment="Center"/>-->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 多行输入框 -->
                            <TextBox x:Name="TbAction" Grid.Column="0" Text="{Binding ActionTaken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="80" FontSize="16" Grid.ColumnSpan="2" Margin="0,0,19,0"/>

                            <!-- 下拉箭头 -->
                            <Button Grid.Column="1" Width="20" Height="80" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Click="Arrow_Click">
                                <Path Data="M0,0 L4,4 L8,0 Z" Fill="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- 弹出列表（同之前） -->
                            <Popup x:Name="PopAction" Grid.Column="0" Grid.ColumnSpan="2"
                                    PlacementTarget="{Binding ElementName=TbAction}"
                                    Placement="Bottom" Width="{Binding ActualWidth, ElementName=TbAction}"
                                    MaxHeight="120" IsOpen="False">
                                <ListBox x:Name="LbAction" ItemsSource="{Binding ActionLists}"
                                         DisplayMemberPath="Desc" SelectedValuePath="Desc"
                                         SelectionChanged="LbAction_SelectionChanged"/>
                            </Popup>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Padding="5">
                        <!--<hc:ComboBox IsEditable="True" Height="80"  DisplayMemberPath="Desc" ItemsSource="{Binding ToolLists}" SelectedValue="{Binding Tool}"  HorizontalAlignment="Stretch" VerticalAlignment="Center"/>-->
                        <ComboBox IsEditable="True"
                                  DisplayMemberPath="Desc"
                                  ItemsSource="{Binding ToolLists}"
                                  Text="{Binding Tool, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Height="80"
                                  FontSize="16"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Padding="5">
                        <!--<hc:ComboBox IsEditable="True" Height="80"  DisplayMemberPath="Desc" ItemsSource="{Binding SettingLists}" SelectedValue="{Binding Setting}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>-->
                        <ComboBox IsEditable="True"
                                  DisplayMemberPath="Desc"
                                  ItemsSource="{Binding SettingLists}"
                                  Text="{Binding Setting, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Height="80"
                                  FontSize="16"/>
                    </Border>
                </Grid>
            </Border>
            <hc:ComboBox
                Grid.Row="3"
                Width="680"
                IsEditable="True"
                hc:InfoElement.Placeholder="消耗物品 Spare parts used "
                DisplayMemberPath="Desc"
                ItemsSource="{Binding SparePartLists}"
                MouseLeave="tb_MouseLeave"
                Text="{Binding SparePart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                SelectedValuePath="Desc"
                SelectionChanged="tb_MouseLeave"
                Visibility="{Binding MaintenanceVisibility}"
                BorderBrush="Red" Margin="0,0,0,10"/>
            <hc:ComboBox x:Name="rateComboBox"
                Grid.Row="4"
                Width="680"
                IsEditable="True"
                hc:InfoElement.Placeholder="评价（可选）Rating(optional)"
                DisplayMemberPath="Desc"
                ItemsSource="{Binding RateLists}"
                MouseLeave="tb_MouseLeave"
                Text="{Binding Rate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                SelectedValuePath="Desc"
                SelectionChanged="tb_MouseLeave"
                Visibility="{Binding MaintenanceVisibility}" Margin="0,0,0,0" />
            <TextBlock Grid.Row="5" Text="{Binding CardLog}" />
            <Button
                Grid.Row="6"
                Width="144"
                Height="28"
                HorizontalContentAlignment="Center"
                Background="#D6D6D6"
                Command="{Binding Path=DataContext.ClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Content="   提交/Submit" />
        </Grid>
    </Grid>
</UserControl>
