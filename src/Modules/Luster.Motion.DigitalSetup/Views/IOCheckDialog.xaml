<Window x:Class="Luster.Motion.DigitalSetup.Views.IOCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IO检查" Height="150" Width="400"
        Loaded="Window_Loaded" Closing="Window_Closing"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <!-- 上部：消息内容，占据剩余空间 -->
            <RowDefinition Height="Auto"/>
            <!-- 下部：按钮 -->
        </Grid.RowDefinitions>

        <!-- 提示消息（垂直居中） -->
        <TextBlock x:Name="txtMessage" 
                   Width="400"
                   Height="80"
                   Grid.Row="0"
                   FontSize="18" 
                   LineHeight="40"
                   TextAlignment="Center"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,20"/>
        <!-- 第二行：提示 达到输出IO最大设置次数 -->
        <TextBlock x:Name="txtMessage2" 
                   Width="400"
                   Grid.Row="1"
                   FontSize="14" 
                   Foreground="Gray"
                   TextAlignment="Right"
                   Margin="0,10"/>

        <!-- 三个按钮（水平居中，靠下，底部留白 40） -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
            <Button Content="OK" 
                    Width="80" 
                    Height="35" 
                    Margin="15,0" 
                    FontSize="14"
                    Click="BtnOK_Click"/>
            <Button Content="NG" 
                    Width="80" 
                    Height="35" 
                    Margin="15,0" 
                    FontSize="14"
                    Click="BtnNG_Click"/>
            <Button Content="跳过" 
                    Width="80" 
                    Height="35" 
                    Margin="15,0" 
                    FontSize="14"
                    Click="BtnSkip_Click"/>
        </StackPanel>
    </Grid>
</Window>