<UserControl
    x:Class="Luster.Motion.DigitalSetup.Views.BusopContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewModel="clr-namespace:Luster.Motion.DigitalSetup.ViewModel"
    xmlns:views="clr-namespace:Luster.Motion.DigitalSetup.Views"
    prism:ViewModelLocator.AutoWireViewModel="True"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
        <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <hc:Interaction.Triggers>
            <hc:EventTrigger EventName="Loaded">
                <hc:EventToCommand Command="{Binding LoadedCommand}" PassEventArgsToCommand="True" />
            </hc:EventTrigger>
        </hc:Interaction.Triggers>

        <!-- 左侧子页面列表 -->
        <Grid Background="{DynamicResource BackgroundBrush}" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Margin="20,10"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontSize="10"
                       Text="BUSOP" />
            <!-- 增删改按钮 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,5" HorizontalAlignment="Center">
                <Button Content="+" Width="28" Height="22" FontSize="12" Padding="0"
                        Command="{Binding AddSubItemCommand}" ToolTip="添加" Margin="2,0" />
                <Button Content="-" Width="28" Height="22" FontSize="12" Padding="0"
                        Command="{Binding DeleteSubItemCommand}" ToolTip="删除" Margin="2,0" />
                <Button Content="✎" Width="28" Height="22" FontSize="12" Padding="0"
                        Command="{Binding RenameSubItemCommand}" ToolTip="重命名" Margin="2,0" />
            </StackPanel>
            <ListBox
                Name="lstDevice"
                Grid.Row="2"
                Margin="10,5,10,5"
                Padding="5"
                Background="#F4F6FA"
                BorderThickness="0"
                ItemsSource="{Binding Pages}"
                SelectedItem="{Binding SelectedReportPage}"
                SelectionMode="Single"
                VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Margin="5,0,5,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="LightGray"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CheckStatus}" Value="0">
                                                <Setter Property="Fill" Value="LightGray"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CheckStatus}" Value="1">
                                                <Setter Property="Fill" Value="LightGreen"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CheckStatus}" Value="2">
                                                <Setter Property="Fill" Value="LightCoral"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListBoxItemBaseStyle}" TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Height" Value="35" />
                        <Setter Property="Background" Value="#DEE0E7" />
                        <Setter Property="hc:BorderElement.CornerRadius" Value="0,5,5,0" />
                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextIconBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="SelectionChanged">
                        <hc:EventToCommand Command="{Binding SelectedCommand}"
                                           CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}, Path=SelectedItem}" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </ListBox>
        </Grid>

        <GridSplitter
            Grid.Column="1"
            Width="2"
            Margin="0,10"
            HorizontalAlignment="Stretch"
            Foreground="{DynamicResource RegionBrush}" />

        <!-- 右侧内容区域 -->
        <Grid Grid.Column="2" Background="{DynamicResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 按钮区域 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
                <!-- 缩放控制 -->
                <Border
                    Background="{DynamicResource RegionBrush}"
                    CornerRadius="4"
                    Padding="5,2"
                    Margin="5,0"
                    Visibility="{Binding HasSheetImage, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="-" Width="24" Height="24" Padding="0" FontSize="14"
                                Command="{Binding ZoomOutCommand}" />
                        <TextBlock Text="{Binding ZoomPercent, StringFormat={}{0}%}"
                                   Width="45" TextAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                        <Button Content="+" Width="24" Height="24" Padding="0" FontSize="14"
                                Command="{Binding ZoomInCommand}" />
                        <Button Content="适应" Width="36" Height="24" Padding="0" FontSize="10" Margin="5,0,0,0"
                                Command="{Binding ZoomFitCommand}" />
                    </StackPanel>
                </Border>

                <Button
                    Command="{Binding OpenBusopCommand}"
                    Content="打开 BUSOP"
                    Style="{StaticResource ButtonPrimary}"
                    Width="100"
                    Height="30"
                    Margin="5" />

                <Button
                    Command="{Binding OpenSettingsCommand}"
                    Content="设置"
                    Style="{StaticResource ButtonDefault}"
                    Width="80"
                    Height="30"
                    Margin="5" />
            </StackPanel>

            <!-- Sheet 图片显示区域 -->
            <Grid Grid.Row="1" Margin="10">
                <!-- 状态提示（无图片时显示） -->
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    Text="{Binding StatusMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSheetImage}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Sheet 渲染图片（支持滚轮缩放 + 鼠标拖拽） -->
                <Grid
                    x:Name="ImageContainer"
                    Visibility="{Binding HasSheetImage, Converter={StaticResource Boolean2VisibilityConverter}}"
                    ClipToBounds="True"
                    PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel"
                    PreviewMouseLeftButtonDown="ImageContainer_MouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="ImageContainer_MouseLeftButtonUp"
                    PreviewMouseMove="ImageContainer_MouseMove"
                    Background="Transparent">
                    <Image
                        Source="{Binding SheetImage}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}" />
                                <TranslateTransform X="{Binding OffsetX}" Y="{Binding OffsetY}" />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>