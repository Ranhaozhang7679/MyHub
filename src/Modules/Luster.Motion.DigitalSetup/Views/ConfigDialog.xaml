<Window x:Class="Luster.Motion.DigitalSetup.Views.ConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Luster.Motion.DigitalSetup.Views"
        Title="配置 - CPK测试设置"
        Height="700"
        Width="750"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 目标模板 (Busop文件) -->
            <GroupBox Grid.Row="0" Header="目标模板 (Busop文件)" Margin="0,0,0,10">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding TempConfigFile2}" IsReadOnly="True" 
                             Height="30" Padding="5" Background="White" Margin="0,0,5,0"/>
                    <Button Grid.Column="1" Content="浏览" Command="{Binding BrowseTempFile2Command}" 
                            Width="70" Height="30" Background="#2196F3" Foreground="White"/>
                </Grid>
            </GroupBox>

            <!-- 原始数据 (CPK文件) -->
            <GroupBox Grid.Row="1" Header="原始数据 (CPK文件)" Margin="0,0,0,10">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding TempConfigFile1}" IsReadOnly="True" 
                             Height="30" Padding="5" Background="White" Margin="0,0,5,0"/>
                    <Button Grid.Column="1" Content="浏览" Command="{Binding BrowseTempFile1Command}" 
                            Width="70" Height="30" Background="#2196F3" Foreground="White"/>
                </Grid>
            </GroupBox>

            <!-- Python脚本路径配置 -->
            <GroupBox Grid.Row="2" Header="Python脚本路径" Margin="0,0,0,10">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding TempPythonScriptPath}" IsReadOnly="True" 
                             Height="30" Padding="5" Background="White" Margin="0,0,5,0"
                             ToolTip="Python脚本路径，用于执行CPK数据处理"/>
                    <Button Grid.Column="1" Content="浏览" Command="{Binding BrowseTempPythonScriptCommand}" 
                            Width="70" Height="30" Background="#2196F3" Foreground="White"/>
                </Grid>
            </GroupBox>

            <!-- 检测位置多选列表 -->
            <GroupBox Grid.Row="3" Header="检测位置选择" Margin="0,0,0,10">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="请选择需要处理的检测位置 (可多选):" Margin="0,0,0,5"/>
                    <ListBox x:Name="ParameterListBox"
                             Grid.Row="1" 
                             ItemsSource="{Binding TempParameterList}"
                             SelectionMode="Multiple"
                             Height="120"
                             Margin="0"
                             BorderThickness="1"
                             BorderBrush="LightGray"
                             Background="White"
                             SelectionChanged="ListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="LightGray"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </GroupBox>

            <!-- 精确阵列配置 -->
            <GroupBox Grid.Row="4" Header="精确阵列配置 (字段映射)" Margin="0,0,0,10">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="配置文本键与Excel列的映射关系:" Margin="0,0,0,5"/>
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding MappingItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="True"
                              CanUserDeleteRows="True"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              RowHeight="35"
                              Margin="0,0,0,5"
                              MinHeight="150">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="文本键" Binding="{Binding TxtKey, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Excel列名" Binding="{Binding ExcelKey, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="起始行" Binding="{Binding StartRow, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            <DataGridTextColumn Header="最大行" Binding="{Binding MaxRow, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            <DataGridTextColumn Header="最小行" Binding="{Binding MinRow, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <!-- 按钮区域 -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,10">
                <Button Content="确定" Command="{Binding ConfirmCommand}" 
                        Width="80" Height="32" Margin="0,0,10,0" 
                        Background="#4CAF50" Foreground="White" BorderThickness="0"/>
                <Button Content="取消" Command="{Binding CancelCommand}" 
                        Width="80" Height="32" 
                        Background="#F44336" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>