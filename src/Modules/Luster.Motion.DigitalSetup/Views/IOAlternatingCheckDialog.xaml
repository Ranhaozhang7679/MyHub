<Window x:Class="Luster.Motion.DigitalSetup.Views.IOAlternatingCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Luster.Motion.DigitalSetup.Views"
        xmlns:selectors="clr-namespace:Luster.Common.Assets.FloatingInfo.Selectors;assembly=Luster.Common.Assets"
        xmlns:models="clr-namespace:Luster.Common.Assets.FloatingInfo.Models;assembly=Luster.Common.Assets"
        mc:Ignorable="d"
        Title="IO交替检测" Height="Auto" MinHeight="250" Width="800" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Topmost="True">
    <Window.Resources>
        <selectors:ContentTemplateSelector x:Key="ContentTemplateSelector">
            <selectors:ContentTemplateSelector.TextTemplate>
                <DataTemplate DataType="{x:Type models:TextContentItem}">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="{Binding Margin}" FontSize="12"/>
                </DataTemplate>
            </selectors:ContentTemplateSelector.TextTemplate>
            <selectors:ContentTemplateSelector.ImageTemplate>
                <DataTemplate DataType="{x:Type models:ImageContentItem}">
                    <Image Source="{Binding ImagePath}" MaxWidth="{Binding MaxWidth}" MaxHeight="{Binding MaxHeight}" Margin="{Binding Margin}" Stretch="Uniform"/>
                </DataTemplate>
            </selectors:ContentTemplateSelector.ImageTemplate>
        </selectors:ContentTemplateSelector>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" x:Name="txtMessage" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,15"/>
            
            <TextBlock Grid.Row="1" x:Name="txtStatus" TextWrapping="Wrap" FontSize="12" Foreground="Gray" Margin="0,0,0,10"/>
            
            <TextBlock Grid.Row="2" x:Name="txtCurrentState" TextWrapping="Wrap" FontSize="16" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,15"/>
            
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="配置说明" Width="80" Height="30" Margin="10,0" Click="BtnSettings_Click"/>
                <Button Content="跳过" Width="80" Height="30" Margin="10,0" Click="BtnSkip_Click"/>
                <Button Content="取消检测" Width="80" Height="30" Margin="10,0" Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>

        <!-- 右侧图文说明区域 -->
        <Border Grid.Column="1" Background="#F9F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ContentItems, RelativeSource={RelativeSource AncestorType=Window}}"
                              ItemTemplateSelector="{StaticResource ContentTemplateSelector}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
