<UserControl
    x:Class="Luster.Motion.DigitalSetup.Views.DigitalAssContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalon="https://github.com/Dirkster99/AvalonDock"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:g="clr-namespace:Luster.Motion.CommonUI;assembly=Luster.Motion.CommonUI"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.DigitalSetup.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="800"
    d:DesignWidth="1024"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    FocusManager.IsFocusScope="True"
    mc:Ignorable="d">
    <!-- Root container -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220*" x:Name="LeftPanelColumn" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="500*" x:Name="MiddlePanelColumn" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="200*" x:Name="RightPanelColumn" />
        </Grid.ColumnDefinitions>

        <!-- Main content layer - affected by GlobalProperty.IsEnabled -->
        <Grid Grid.ColumnSpan="5" Background="#F4F6FA" IsEnabled="{Binding Path=(g:GlobalProperty.IsEnabeld), UpdateSourceTrigger=PropertyChanged}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="500*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200*" />
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0"
                Visibility="{Binding ReportSelectVisible, Converter={StaticResource Boolean2VisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                        Margin="20,10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Text="{lang:Lang Key={x:Static lang:LangKeys.Configure}}" />
                <ListBox
                  Name="lstDevice"
                  Grid.Row="1"
                  Margin="0,5,10,5"
                  Padding="0"
                  Background="#F4F6FA"
                  BorderThickness="0"
                  ItemsSource="{Binding Pages}"
                  SelectedItem="{Binding SelectedReportPage}"
                  SelectionMode="Single"
                  VirtualizingStackPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5,0">
                                <!-- 点检状态指示器 -->
                                <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="LightGray"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CheckStatus}" Value="0">
                                                    <Setter Property="Fill" Value="LightGray"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CheckStatus}" Value="1">
                                                    <Setter Property="Fill" Value="LightGreen"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CheckStatus}" Value="2">
                                                    <Setter Property="Fill" Value="LightCoral"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <!-- 页面名称 - 移除固定宽度，自适应容器 -->
                                <hc:HighlightTextBlock
                                      Padding="0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      SourceText="{lang:Lang Key={Binding Name}}"
                                      TextAlignment="Left"
                                      TextTrimming="CharacterEllipsis"
                                      MaxWidth="180" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListBoxItemBaseStyle}" TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Height" Value="35" />
                            <Setter Property="Background" Value="#DEE0E7" />
                            <Setter Property="hc:BorderElement.CornerRadius" Value="0,5,5,0" />
                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="true">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextIconBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="SelectionChanged">
                            <hc:EventToCommand Command="{Binding SelectedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}, Path=SelectedItem}" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </ListBox>
                <TextBlock Text="{Binding LogMsg}"/>
            </Grid>
            <GridSplitter
                  Grid.Column="1"
                  Width="5"
                  HorizontalAlignment="Stretch"
                  Background="Transparent"
                  ResizeBehavior="PreviousAndNext">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>
            <Grid  Grid.Column="2" Margin="1" Background="{DynamicResource RegionBrush}">
                <ContentControl Grid.Row="0" Margin="2" prism:RegionManager.RegionName="DigitalAssEditorRegion" />
            </Grid>
            <GridSplitter
                  Grid.Column="3"
                  Width="5"
                  HorizontalAlignment="Stretch"
                  Background="Transparent"
                  ResizeBehavior="PreviousAndNext">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>
            <ContentControl
                  Grid.Column="4"
                  Margin="1"
                  prism:RegionManager.RegionName="LogContentRegon_Ass" />


            <hc:Interaction.Triggers>
                <hc:EventTrigger EventName="Loaded">
                    <hc:EventToCommand Command="{Binding LoadedCommand}" PassEventArgsToCommand="True" />
                </hc:EventTrigger>
            </hc:Interaction.Triggers>
        </Grid>

        <!-- Settings Button - 放在最后确保在最上层，跟随 GridSplitter 移动 -->
        <Grid Grid.Column="0" Height="50" VerticalAlignment="Top">
            <Button
                    Width="40"
                    Height="35"
                    Margin="0,10,50,0"
                    VerticalAlignment="Top"
                    Command="{Binding OpenSettingsCommand}"
                    Content="⚙"
                    FontSize="16" />
        </Grid>
    </Grid>
</UserControl>
