<UserControl x:Class="Luster.Motion.DigitalSetup.Views.PointTeachingContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"  
             xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
             xmlns:local="clr-namespace:Luster.Motion.DigitalSetup.Views"
             xmlns:chart="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:lang1="clr-namespace:Luster.SimDevice.SubSystem.Langs;assembly=Luster.SimDevice.SubSystem"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Background="{DynamicResource BackgroundBrush}" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock  
                 Margin="20,10"  
                 HorizontalAlignment="Left"  
                 VerticalAlignment="Center"  
                 FontSize="10" 
                 Text="{lang:Lang Key={x:Static lang:LangKeys.PointTeaching}}"/>
            <ListBox  
                 Name="lstDevice"  
                 Grid.Row="1"  
                 Margin="10,5,10,5"  
                 Padding="5"  
                 Background="#F4F6FA"  
                 BorderThickness="0"  
                 ItemsSource="{Binding Pages}"  
                 SelectedItem="{Binding SelectedReportPage}"  
                 SelectionMode="Single"  
                 VirtualizingStackPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <!-- 点检状态指示器 -->
                            <Ellipse Width="12" Height="12" Margin="5,0,5,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="LightGray"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CheckStatus}" Value="0">
                                                <Setter Property="Fill" Value="LightGray"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CheckStatus}" Value="1">
                                                <Setter Property="Fill" Value="LightGreen"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CheckStatus}" Value="2">
                                                <Setter Property="Fill" Value="LightCoral"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!-- 页面名称 -->
                            <hc:HighlightTextBlock
                                 Width="160"
                                 Padding="0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 SourceText="{Binding Name}"
                                 TextAlignment="Left" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListBoxItemBaseStyle}" TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Height" Value="35" />
                        <Setter Property="Background" Value="#DEE0E7" />
                        <Setter Property="hc:BorderElement.CornerRadius" Value="0,5,5,0" />
                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextIconBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="SelectionChanged">
                        <hc:EventToCommand Command="{Binding SelectedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}, Path=SelectedItem}" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </ListBox>
        </Grid>
        <GridSplitter  
             Grid.Column="1"  
             Width="2"  
             Margin="0,10"  
             HorizontalAlignment="Stretch"  
             Foreground="{DynamicResource RegionBrush}" />
        <Grid Grid.Column="2" Background="{DynamicResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <hc:Card Header="基准位置"  Grid.Row="0" Grid.Column="0">
                <DataGrid
                Grid.Row="0"
                Grid.Column="0"
                x:Name="dgPosition"
                Padding="-5"                
                hc:DataGridAttach.ShowRowNumber="False"
                hc:DataGridAttach.ShowSelectAllButton="False"
                AlternationCount="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CanUserSortColumns="False"
                ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                HeadersVisibility="Column"
                IsReadOnly="False"
                ItemsSource="{Binding AxisPositions_GodLine}"
                RowStyle="{StaticResource CustomDataGridRowStyle}"
                SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                        Width="*"
                        MinWidth="80"
                        Binding="{Binding Name}"                         
                        Header="{lang1:Lang Key={x:Static lang1:LangKeys.Name}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="False" />
                        <DataGridTextColumn
                        Width="*"
                        MinWidth="85"
                        Binding="{Binding Position, Mode=TwoWay }"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang1:Lang Key={x:Static lang1:LangKeys.Position}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="False">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn
                        Visibility="Collapsed"
                        Width="200"
                        hc:TitleElement.HorizontalAlignment="Center"
                        CanUserResize="False"
                        Header="{lang1:Lang Key={x:Static lang1:LangKeys.Operation}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <hc:ElementGroup HorizontalContentAlignment="Right" Orientation="Horizontal">
                                        <Button
                                    Margin="0"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.MoveTeachCommand}"
                                    CommandParameter="{Binding}"
                                    Content="{lang1:Lang Key={x:Static lang1:LangKeys.Move}}"
                                    IsEnabled="{Binding SysRole, Converter={StaticResource RoleEnabledCoverter}, ConverterParameter=Integrator}"
                                    Style="{StaticResource ButtonSuccess.Small}" />
                                    </hc:ElementGroup>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="SelectionChanged">
                            <hc:EventToCommand Command="{Binding SelectedPosionCommand}" PassEventArgsToCommand="True" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </DataGrid>
            </hc:Card>
            <hc:Card Header="实际位置" Grid.Row="0" Grid.Column="1">
                <DataGrid
                Grid.Row="0"
                Grid.Column="1"
                x:Name="dgPosition1"
                Padding="-5"                
                hc:DataGridAttach.ShowRowNumber="False"
                hc:DataGridAttach.ShowSelectAllButton="False"
                AlternationCount="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CanUserSortColumns="False"
                ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                HeadersVisibility="Column"
                IsReadOnly="False"
                ItemsSource="{Binding AxisPositions}"
                RowStyle="{StaticResource CustomDataGridRowStyle}"
                SelectedItem="{Binding AxisPositionsSelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                        Width="*"
                        MinWidth="80"
                        Binding="{Binding Name}"
                        Header="{lang1:Lang Key={x:Static lang1:LangKeys.Name}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="False" />
                        <DataGridTextColumn
                        Width="*"
                        MinWidth="85"
                        Binding="{Binding Position, Mode=TwoWay}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang1:Lang Key={x:Static lang1:LangKeys.Position}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="False">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <!--<DataGridTemplateColumn
                        Width="200"
                        hc:TitleElement.HorizontalAlignment="Center"
                        CanUserResize="False"
                        Header="{lang1:Lang Key={x:Static lang1:LangKeys.Operation}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <hc:ElementGroup HorizontalContentAlignment="Right" Orientation="Horizontal">
                                    <Button
                                        Margin="0"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.MoveTeachCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{lang1:Lang Key={x:Static lang1:LangKeys.Move}}"
                                        IsEnabled="{Binding SysRole, Converter={StaticResource RoleEnabledCoverter}, ConverterParameter=Integrator}"
                                        Style="{StaticResource ButtonSuccess.Small}" />
                                </hc:ElementGroup>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>-->
                    </DataGrid.Columns>
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="SelectionChanged">
                            <hc:EventToCommand Command="{Binding SelectedPosionCommand}" PassEventArgsToCommand="True" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </DataGrid>
            </hc:Card>
            <Border Grid.Row="1" Grid.Column="0" Padding="3" Margin="0,5,1,0" Visibility="Hidden"
                 Background="#F4F6FA" CornerRadius="3">
                <StackPanel>
                    <TextBlock Text="工站配置" FontWeight="Bold" FontSize="12" Margin="0,0,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <TextBlock Text="工站数量：" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <hc:NumericUpDown
                             Width="80"
                             Minimum="1"
                             Maximum="20"
                             Value="{Binding StationCount, Mode=TwoWay}"
                             Style="{StaticResource NumericUpDownExtend}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding StationConfigs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- 工站点检状态指示器 -->
                                    <Ellipse Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="LightGray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CheckStatus}" Value="0">
                                                        <Setter Property="Fill" Value="LightGray"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CheckStatus}" Value="1">
                                                        <Setter Property="Fill" Value="LightGreen"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CheckStatus}" Value="2">
                                                        <Setter Property="Fill" Value="LightCoral"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="工站名称：" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Width="80" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                    <!--<ComboBox  Width="120"
                                         ItemsSource="{Binding DataContext.GlobalKeys, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         DisplayMemberPath="Desc"
                                         SelectedValuePath="Value"
                                         SelectedValue="{Binding SelectedGlobalKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,5,0"/>-->
                                    <Button Content="{Binding Name}"
                         Command="{Binding SaveStationConfigCommand}"
                         Margin="0,0,10,0"
                         HorizontalAlignment="Right"
                         />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!--<StackPanel Orientation="Horizontal" Margin="0,2">
                             <TextBlock Text="工站名称：" VerticalAlignment="Center" Margin="0,0,30,0"/>
                             <TextBox Width="80" Text="{Binding stationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                         </StackPanel>-->
                    <StackPanel Orientation="Horizontal" Margin="0">
                        <TextBlock Text="工站选择：" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox  Width="120" x:Name="cmbStationNames"
                    ItemsSource="{Binding DataContext.stationNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    SelectedValue="{Binding SelectedStationName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,5,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,10,0">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,10,0">
                 <Run Text="写入全局变量"/>
                 <LineBreak/>
                 <Run Text="Ass_SelectedStation"/>
                        </TextBlock>
                        <ComboBox  Width="120" IsEnabled="false"
                    ItemsSource="{Binding DataContext.GlobalKeys, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    DisplayMemberPath="Desc"
                    SelectedValuePath="Value"
                    SelectedValue="{Binding SelectedGlobalKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,5,0"/>
                    </StackPanel>
                    <!--<Button Content="保存工站配置"
                         Command="{Binding SaveStationConfigCommand}"
                         Margin="0,10,0,0"
                         HorizontalAlignment="Right"
                         />-->
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Padding="3" Margin="0,5,1,0" 
                     Background="#F4F6FA" CornerRadius="3"
                     Visibility="{Binding IsChartVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="示教结果" FontWeight="Bold" FontSize="12" Margin="0,0,0,3"/>
                        <TextBlock Text="变量(double)" FontWeight="Normal" FontSize="12" Margin="160,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <TextBlock Text="当前轴偏差值(mm)：" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Width="100" Text="{Binding OffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Ass_offsetX" VerticalAlignment="Center" Visibility="Hidden"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Visibility="Collapsed">
                        <TextBlock Text="位置偏差Y(mm)：" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Width="100" Text="{Binding OffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Ass_offsetY" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Visibility="Collapsed">
                        <TextBlock Text="位置偏差U(mm)：" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Width="100" Text="{Binding OffsetU, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Ass_offsetU" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="保存为GodLine点位"
                                Margin="0,10,0,0"
                           Command="{Binding UpdateGodLinePositionsCommand}"
                        />
                        <Button Content="更新并保存点位"
                                Grid.Column="1"
                           Command="{Binding UpdatePositionsCommand}"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Right"
                          
                        />
                    </Grid>
                </StackPanel>
            </Border>
            <Border
                Grid.Row="1"
                Grid.Column="1"
                Margin="5"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="Collapsed"
                >
                <chart:CartesianChart
                    Grid.Row="1"
                    Margin="5"
                    Background="{DynamicResource RegionBrush}"
                    LegendLocation="Bottom"
                    Series="{Binding SeriesCollection}">
                    <chart:CartesianChart.AxisX>
                        <chart:Axis>
                            <chart:Axis.Separator>
                                <chart:Separator Step="1" />
                            </chart:Axis.Separator>
                        </chart:Axis>
                    </chart:CartesianChart.AxisX>
                    <chart:CartesianChart.AxisY>
                        <chart:Axis  MinValue="0" />
                    </chart:CartesianChart.AxisY>
                </chart:CartesianChart>
            </Border>
            <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Grid.Column="0">
                <Button Content="更新列表"   
                      Visibility="Collapsed"
                      Command="{Binding DataContext.UpdateItemsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                      Margin="5" 
                      Grid.Row="0" 
                      HorizontalAlignment="Left" />
                <local:CommonButton />
            </DockPanel>
        </Grid>
        <hc:Interaction.Triggers>
            <hc:EventTrigger EventName="Loaded">
                <hc:EventToCommand Command="{Binding LoadedCommand}" PassEventArgsToCommand="True" />
            </hc:EventTrigger>
        </hc:Interaction.Triggers>
    </Grid>
</UserControl>
