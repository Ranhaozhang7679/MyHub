<UserControl x:Class="Luster.Motion.DigitalSetup.Views.Validations.CommonValidationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:Configs="clr-namespace:Luster.Motion.DigitalSetup.ViewModel.Validations.Configs"
             xmlns:configs="clr-namespace:Luster.Motion.DigitalSetup.Views.Validations.Configs"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题区域 - 包含Name和操作按钮 -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0"
                           Text="{Binding ValidationName}"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                
                <!-- 操作按钮区域 - 靠右分布 -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="开始验证"
                            Command="{Binding StartValidationCommand}"
                            Style="{StaticResource ButtonPrimary}"
                            Width="100"
                            Height="32"
                            Margin="0,0,10,0"/>
                    <Button Content="停止验证"
                            Command="{Binding StopValidationCommand}"
                            Width="100"
                            Height="32"
                            Margin="0,0,10,0"/>
                    <Button Content="重置"
                            Command="{Binding ResetCommand}"
                            Width="100"
                            Height="32"/>
                </StackPanel>
            </Grid>

            <!-- 信息区域 -->
            <!--<Border Grid.Row="1"
                    Background="{DynamicResource RegionBrush}"
                    CornerRadius="5"
                    Padding="15"
                    Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="验证类型：通用验证"
                               FontSize="14"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Description}"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>-->

            <!-- 状态信息 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource RegionBrush}"
                    CornerRadius="5"
                    Padding="15"
                    Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="最后运行时间："
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding LastRunTime, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                   FontSize="14"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="运行状态："
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock FontSize="14" Margin="0,5,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="未运行"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Text" Value="运行中"/>
                                            <Setter Property="Foreground" Value="Green"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 配置菜单 - 可折叠 -->
            <Expander Grid.Row="3"
                      Header="脚本配置参数"
                      IsExpanded="True"
                      Background="{DynamicResource RegionBrush}"
                      Margin="0,0,0,15">
                <Border Background="{DynamicResource BackgroundBrush}"
                        Padding="15"
                        CornerRadius="0,0,5,5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- python运行路径配置 - 固定行 -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource SecondaryRegionBrush}"
                                CornerRadius="5"
                                Padding="1"
                                Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="运行终端路径（python.exe）:"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Margin="0,0,10,0"/>

                                <TextBox Grid.Column="1"
                                         Text="{Binding PyexePath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                         VerticalAlignment="Center"
                                         Padding="5"
                                         IsReadOnly="True"
                                         VerticalContentAlignment="Center"/>

                                <Button Grid.Column="2"
                                            Content="浏览..."
                                            Command="{Binding BrowsePyexeCommand}"
                                            Width="80"
                                            Height="28"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <!-- 脚本路径配置 - 固定行 -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource SecondaryRegionBrush}"
                                CornerRadius="5"
                                Padding="1"
                                Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="执行脚本文件(.py)路径："
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Margin="0,0,10,0"/>

                                <TextBox Grid.Column="1"
                                         Text="{Binding ScriptPath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                         VerticalAlignment="Center"
                                         Padding="5"
                                         IsReadOnly="True"
                                         VerticalContentAlignment="Center"/>

                                <Button Grid.Column="2"
                                        Content="浏览..."
                                        Command="{Binding BrowseScriptCommand}"
                                        Width="80"
                                        Height="28"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 配置操作按钮 -->
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,10">
                            <Button Content="添加配置项"
                                    Command="{Binding AddConfigCommand}"
                                    Style="{StaticResource ButtonPrimary}"
                                    Width="100"
                                    Height="28"
                                    Margin="0,0,10,0"/>
                            <Button Content="删除配置项"
                                    Command="{Binding RemoveConfigCommand}"
                                    Width="100"
                                    Height="28"/>
                        </StackPanel>

                        <!-- 动态配置列表 -->
                        <DataGrid Grid.Row="3"
                                  x:Name="ConfigItemsDataGrid"
                                  ItemsSource="{Binding ConfigItems}"
                                  SelectedItem="{Binding SelectedConfigItem}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                  Background="Transparent"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="{DynamicResource SecondaryRegionBrush}"
                                  MinHeight="50"
                                  MaxHeight="300"
                                  HorizontalScrollBarVisibility="Auto"
                                  VirtualizingStackPanel.IsVirtualizing="False">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Height" Value="Auto"/>
                                    <Setter Property="MinHeight" Value="30"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="键 (Key)" Width="60" MinWidth="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     VerticalAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     Padding="1,0"
                                                     TextWrapping="NoWrap"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="值 (Value)" Width="200" MinWidth="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     VerticalAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     Padding="2,0"
                                                     TextWrapping="NoWrap"
                                                     TextAlignment="Left"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="说明" Width="*" MinWidth="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0" Background="Transparent" Padding="2,5">
                                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         MinHeight="25"
                                                         VerticalAlignment="Stretch"
                                                         VerticalContentAlignment="Top"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Expander>

            <!-- 结果显示区域 -->
            <Border Grid.Row="4"
                    Background="{DynamicResource RegionBrush}"
                    CornerRadius="5"
                    Padding="15">
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="验证结果"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>
                    <TextBox Text="{Binding ValidationResult, Mode=OneWay}"
                             IsReadOnly="True"
                             Height="150"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>

            <!-- 特定验证类型的配置区域 - 使用Content绑定替代Region -->
            <Border Grid.Row="5"
                                Background="{DynamicResource SecondaryRegionBrush}"
                                CornerRadius="5"
                                Padding="10"
                                Margin="0,0,0,15"
                                Visibility="{Binding HasValidationTypeConfig, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="定制界面"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10"/>
                    <!-- 使用Content绑定替代Region导航 -->
                    <ContentControl Content="{Binding ConfigContent}">
                        <ContentControl.Resources>
                            <!--<DataTemplate DataType="{x:Type Configs:LoadCellCalibrationConfigVM}">
                                <configs:LoadCellCalibrationConfigControl/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type Configs:CCDCalibrationConfigVM}">
                                <configs:CCDCalibrationConfigControl/>
                            </DataTemplate>-->
                        </ContentControl.Resources>
                    </ContentControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
