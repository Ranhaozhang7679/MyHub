<UserControl x:Class="Luster.Motion.DigitalSetup.Views.LADUploadContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Luster.Motion.DigitalSetup.Views"
             xmlns:hc="https://handyorg.github.io/handycontrol"  
             xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
             xmlns:chart="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:conv="clr-namespace:Luster.Motion.DigitalSetup.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:ChartHeightConverter x:Key="ChartHeightConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 工站状态图标转换器 -->
        <conv:CheckStatusToIconConverter x:Key="CheckStatusToIconConverter"/>

        <!-- 定义图表项的模板 -->
        <DataTemplate x:Key="ChartItemTemplate">
            <Border Margin="2" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="5" Height="250">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧参数显示 -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PositionName}" FontWeight="Bold" 
                                   Foreground="{Binding PositionColor}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CPKValue, StringFormat='CPK: {0:F2}'}" 
                                   Foreground="Black" Margin="0,5"/>
                        <TextBlock Text="{Binding MaxValue, StringFormat='Max: {0:F1}'}" 
                                   Foreground="Black" Margin="0,5"/>
                        <TextBlock Text="{Binding TargetValue, StringFormat='Target: {0:F1}'}" 
                                   Foreground="Black" Margin="0,5"/>
                        <TextBlock Text="{Binding MinValue, StringFormat='Min: {0:F1}'}" 
                                   Foreground="Black" Margin="0,5"/>
                    </StackPanel>

                    <!-- 右侧图表 -->
                    <Border Grid.Column="1" Background="#F5F5F5" CornerRadius="3">
                        <chart:CartesianChart
                            Margin="2"
                            Background="Transparent"
                            LegendLocation="None"
                            Series="{Binding ChartSeriesCollection}"
                            DataTooltip="{x:Null}">
                            <chart:CartesianChart.AxisX>
                                <chart:Axis>
                                    <chart:Axis.Separator>
                                        <chart:Separator Step="1" />
                                    </chart:Axis.Separator>
                                </chart:Axis>
                            </chart:CartesianChart.AxisX>
                            <chart:CartesianChart.AxisY>
                                <chart:Axis MinValue="0" />
                            </chart:CartesianChart.AxisY>
                        </chart:CartesianChart>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航区域 -->
        <Grid Background="{DynamicResource BackgroundBrush}" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock  
                 Margin="20,10"  
                 HorizontalAlignment="Left"  
                 VerticalAlignment="Center"  
                 FontSize="10" 
                 Text="{lang:Lang Key={x:Static lang:LangKeys.LADUpload}}"/>

            <ListBox  
                 Name="lstDevice"  
                 Grid.Row="1"  
                 Margin="10,5,10,5"  
                 Padding="5"  
                 Background="#F4F6FA"  
                 BorderThickness="0"  
                 ItemsSource="{Binding Pages}"  
                 SelectedItem="{Binding SelectedReportPage}"  
                 SelectionMode="Single"  
                 VirtualizingStackPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <!-- 点检状态指示器 -->
                            <Ellipse Width="12" Height="12" Margin="5,0,5,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="LightGray"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CheckStatus}" Value="0">
                                                <Setter Property="Fill" Value="LightGray"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CheckStatus}" Value="1">
                                                <Setter Property="Fill" Value="LightGreen"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CheckStatus}" Value="2">
                                                <Setter Property="Fill" Value="LightCoral"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!-- 页面名称 -->
                            <hc:HighlightTextBlock
                                 Width="160"
                                 Padding="0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 SourceText="{lang:Lang Key={Binding Name}}"
                                 TextAlignment="Left" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListBoxItemBaseStyle}" TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Height" Value="35" />
                        <Setter Property="Background" Value="#DEE0E7" />
                        <Setter Property="hc:BorderElement.CornerRadius" Value="0,5,5,0" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextIconBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="SelectionChanged">
                        <hc:EventToCommand Command="{Binding SelectedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}, Path=SelectedItem}" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </ListBox>
        </Grid>

        <!-- 分隔线 -->
        <GridSplitter  
            Grid.Column="1"  
            Width="2"  
            Margin="0,10"  
            HorizontalAlignment="Stretch"  
            Foreground="{DynamicResource RegionBrush}" />

        <!-- 右侧主内容区域 -->
        <Grid Grid.Column="2" Background="{DynamicResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 工站选择区域 -->
            <Border Grid.Row="0" Margin="5" Padding="10" Background="#F4F6FA" CornerRadius="5" BorderBrush="LightGray" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 工站选择标题 -->
                    <TextBlock Grid.Column="0" Text="当前工站:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>

                    <!-- 工站选择 ComboBox -->
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding LADStations}"
                              SelectedItem="{Binding SelectedLADStation}"
                              Height="30"
                              Padding="5,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- 状态图标 -->
                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <Binding Path="CheckStatus" Converter="{StaticResource CheckStatusToIconConverter}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <!-- 工站名称 -->
                                    <TextBlock Text="{Binding StationName}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- 工站管理按钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button Content="编辑工站" Command="{Binding EditStationCommand}"
                                Width="80" Height="30" Margin="0,0,5,0"
                                Background="#FF9800" Foreground="White" FontWeight="Bold"
                                BorderThickness="0"/>
                        <Button Content="添加工站" Command="{Binding AddStationCommand}"
                                Width="80" Height="30" Margin="0,0,5,0"
                                Background="#2196F3" Foreground="White" FontWeight="Bold"
                                BorderThickness="0"/>
                        <Button Content="删除工站" Command="{Binding DeleteStationCommand}"
                                Width="80" Height="30"
                                Background="#F44336" Foreground="White" FontWeight="Bold"
                                BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 滚动图表区域 -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="5">
                <ItemsControl ItemsSource="{Binding AllChartItems}"
                              ItemTemplate="{StaticResource ChartItemTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- 底部控制区域 -->
            <Grid Grid.Row="2" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 控制按钮区域 -->
                <Border Grid.Row="0" Padding="15" Background="#F4F6FA" CornerRadius="5" BorderBrush="LightGray" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Content="一键点检"
Command="{Binding DataContext.OneKeyCheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
CommandParameter="{Binding ItemModels}"
Width="70" Height="35" Margin="0,0,10,0"
Background="#2196F3" Foreground="White" FontWeight="Bold"
BorderThickness="0"/>
                        <Button Content="CPK写入" Command="{Binding RunCommand}"
                    Width="70" Height="35" Margin="0,0,10,0"
                    Background="#4CAF50" Foreground="White" FontWeight="Bold"
                    BorderThickness="0"/>

                        <Button Content="Stop" Command="{Binding StopCommand}" 
                    Width="70" Height="35" Margin="0,0,15,0" 
                    Background="#F44336" Foreground="White" FontWeight="Bold"
                    BorderThickness="0"/>
                        <ProgressBar Value="{Binding ProgressValue}" Width="200" Height="22" Margin="0,0,25,0"/>
                        <Button Content="配置" Command="{Binding ConfigCommand}" 
                    Width="70" Height="35" Margin="0,0,0,0" 
                    Background="#FF9800" Foreground="White" FontWeight="Bold"
                    BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <!-- 日志显示区域 -->
                <Border Grid.Row="1" Margin="0,10,0,0" Padding="10" Background="#F4F6FA" CornerRadius="5" BorderBrush="LightGray" BorderThickness="1" Height="150">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="执行日志:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Grid.Row="1" Text="{Binding LogText}" 
                     IsReadOnly="True" 
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="#FFFFFF"
                     FontFamily="Consolas"
                     FontSize="11"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <hc:Interaction.Triggers>
            <hc:EventTrigger EventName="Loaded">
                <hc:EventToCommand Command="{Binding LoadedCommand}" PassEventArgsToCommand="True" />
            </hc:EventTrigger>
        </hc:Interaction.Triggers>
    </Grid>
</UserControl>