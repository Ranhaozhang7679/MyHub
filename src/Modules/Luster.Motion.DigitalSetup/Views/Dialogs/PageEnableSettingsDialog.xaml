<UserControl x:Class="Luster.Motion.DigitalSetup.Views.Dialogs.PageEnableSettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:Luster.Motion.DigitalSetup.Views.Dialogs"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             Height="500"             
             d:DesignHeight="500" d:DesignWidth="550">
    <UserControl.Resources>
        <!-- Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        
        <!-- 反向 Boolean to Visibility Converter -->
        <local:InverseBooleanToVisibilityConverter x:Key="BoolToVisReConverter"/>

        <!-- 树形节点样式 - 带动画的Expander -->
        <Style x:Key="TreeExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <!-- 头部区域 -->
                            <Border x:Name="HeaderSite"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"
                                    Padding="12,10"
                                    Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 展开/折叠箭头 -->
                                    <Path x:Name="ArrowPath"
                                          Grid.Column="0"
                                          Data="M 0,0 L 5,5 L 0,10 Z"
                                          Fill="{DynamicResource PrimaryTextBrush}"
                                          Width="8"
                                          Height="10"
                                          Stretch="Uniform"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="ArrowRotate" Angle="0"/>
                                        </Path.RenderTransform>
                                    </Path>

                                    <!-- 标题内容 -->
                                    <ContentPresenter Grid.Column="1"
                                                      Content="{TemplateBinding Header}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>

                                    <!-- 启用复选框 -->
                                    <CheckBox Grid.Column="2"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              Content="{lang:Lang Key=Enable}"
                                              VerticalAlignment="Center"
                                              Margin="15,0,0,0"
                                              Click="CheckBox_Click"/>
                                </Grid>
                            </Border>

                            <!-- 展开内容区域 -->
                            <Border x:Name="ExpandSite"
                                    Background="{DynamicResource SecondaryRegionBrush}"
                                    CornerRadius="5"
                                    Margin="20,5,0,10"
                                    Padding="10"
                                    Visibility="Collapsed">
                                <ContentPresenter Content="{TemplateBinding Content}"/>
                            </Border>
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="90" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 二级菜单项样式 -->
        <Style x:Key="SubPageItemStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="10,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="{lang:Lang Key=PageEnableSettings}"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- 页面列表 - 树形结构 -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding PageSettings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 一级菜单容器 -->
                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,10"
                                Background="{DynamicResource RegionBrush}"
                                Padding="5">
                            <Grid>
                                <!-- 有子菜单时显示可折叠的Expander -->
                                <Expander Style="{StaticResource TreeExpanderStyle}"
                                          IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          Visibility="{Binding HasSubPages, Converter={StaticResource BoolToVisConverter}}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- 一级菜单图标 -->
                                            <Path Data="M 3,0 L 3,14 M 0,3 L 6,3 M 0,7 L 6,7 M 0,11 L 6,11"
                                                  Stroke="{DynamicResource PrimaryBrush}"
                                                  StrokeThickness="1.5"
                                                  Width="14"
                                                  Height="14"
                                                  Stretch="Uniform"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center"/>
                                            
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Expander.Header>

                                    <!-- 二级菜单列表 -->
                                    <ItemsControl ItemsSource="{Binding SubPages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SubPageItemStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 树形连接线 -->
                                                        <Grid Grid.Column="0" Width="20" Margin="0,0,8,0">
                                                            <Path Data="M 0,0 L 10,0"
                                                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                                                  StrokeThickness="1"
                                                                  VerticalAlignment="Center"
                                                                  Stretch="Uniform"/>
                                                            <Ellipse Width="4"
                                                                     Height="4"
                                                                     Fill="{DynamicResource SecondaryTextBrush}"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,2,0"/>
                                                        </Grid>

                                                        <!-- 二级菜单名称 -->
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Name}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="13"/>

                                                        <!-- 二级菜单启用复选框 -->
                                                        <CheckBox Grid.Column="2"
                                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  Content="{lang:Lang Key=Enable}"
                                                                  VerticalAlignment="Center"
                                                                  FontSize="12"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>

                                <!-- 无子菜单时显示简单项 -->
                                <Grid Visibility="{Binding HasSubPages, Converter={StaticResource BoolToVisReConverter}}"
                                      Margin="12,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 叶子节点图标 -->
                                    <Path Grid.Column="0"
                                          Data="M 2,2 L 2,12 M 2,7 L 10,7"
                                          Stroke="{DynamicResource PrimaryBrush}"
                                          StrokeThickness="2"
                                          Width="12"
                                          Height="12"
                                          Stretch="Uniform"
                                          Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>

                                    <CheckBox Grid.Column="2"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              Content="{lang:Lang Key=Enable}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="{lang:Lang Key=Save}"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource ButtonPrimary}"
                    Width="80"
                    Height="32"
                    Margin="0,0,10,0"/>
            <Button Content="{lang:Lang Key=Cancel}"
                    Command="{Binding CancelCommand}"
                    Width="80"
                    Height="32"/>
        </StackPanel>
    </Grid>
</UserControl>
