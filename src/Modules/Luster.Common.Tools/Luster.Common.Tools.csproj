<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="Costura64\sntl_adminapi_net_windows.dll" />
        <None Remove="Costura64\sntl_adminapi_windows.dll" />
        <None Remove="Costura64\sntl_adminapi_windows_x64.dll" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Costura64\slm_runtime.dll" />
        <EmbeddedResource Include="Costura64\slm_runtime_dev.dll" />
        <EmbeddedResource Include="Costura64\sntl_adminapi_net_windows.dll" />
        <EmbeddedResource Include="Costura64\sntl_adminapi_windows.dll" />
        <EmbeddedResource Include="Costura64\sntl_adminapi_windows_x64.dll" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MinVer" />
        <PackageReference Include="Costura.Fody">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Magick.NET-Q16-AnyCPU" />
        <PackageReference Include="NLog" />
        <PackageReference Include="Newtonsoft.Json" />
        <PackageReference Include="Luster.SharpZipLib" />
        <PackageReference Include="SSH.NET" />
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="Luster.Aspose.Cells" />
        <PackageReference Include="Luster.Aspose.Words" />
        <PackageReference Include="Luster.DynamicExpresso" />
        <PackageReference Include="Luster.Microsoft.Msagl" />
        <PackageReference Include="Luster.Microsoft.Msagl.Drawing" />
        <PackageReference Include="Luster.Microsoft.Msagl.GraphViewerGdi" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Luster.Common.DataStruct\Luster.Common.DataStruct.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Microsoft.VisualBasic" />
        <Reference Include="sntl_adminapi_net_windows">
            <HintPath>Costura64\sntl_adminapi_net_windows.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="System.Net.Http" />
        <Reference Include="System.Web" />
        <Reference Include="System.Web.Services" />
        <Reference Include="System.Windows.Forms" />
    </ItemGroup>

    <PropertyGroup Condition=" '$(TargetFramework)' == 'net472'">
        <DefineConstants>NET45;NETFULL;NET40Plus</DefineConstants>
    </PropertyGroup>
</Project>
