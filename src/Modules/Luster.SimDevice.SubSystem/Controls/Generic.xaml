<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Luster.SimDevice.SubSystem.Controls"
    xmlns:hc="https://handyorg.github.io/handycontrol">
    <Style x:Key="PageControlBaseStyle" TargetType="ctrl:PageControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrl:PageControl">
                    <Border
                        Background="{DynamicResource RegionBrush}"
                        CornerRadius="10"
                        Effect="{StaticResource EffectShadow4}">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource TitleBrush}" CornerRadius="10,10,0,0">
                                <hc:SimplePanel Grid.Row="0">
                                    <hc:Watermark
                                        FontSize="20"
                                        FontWeight="Bold"
                                        MarkBrush="#0F000000"
                                        MarkMargin="3,0" />
                                    <TextBlock
                                        Foreground="White"
                                        Style="{StaticResource TextBlockDefault}"
                                        Text="{TemplateBinding Title}" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        FontSize="20"
                                        Foreground="{DynamicResource TextIconBrush}"
                                        Style="{StaticResource IconMid}"
                                        Text="{TemplateBinding Icon}" />
                                    <Button
                                        x:Name="PART_ButtonViewAdd"
                                        Width="30"
                                        Height="26"
                                        Margin="0,0,6,0"
                                        Padding="5"
                                        HorizontalAlignment="Right"
                                        hc:IconElement.Geometry="{StaticResource AddGeometry}"
                                        Foreground="{DynamicResource TextIconBrush}"
                                        Style="{StaticResource ButtonIcon}"
                                        Visibility="{TemplateBinding IsShowAdd,
                                                                     Converter={StaticResource Boolean2VisibilityConverter}}" />
                                </hc:SimplePanel>
                            </Border>

                            <ContentPresenter x:Name="ContentPresenterMain" Grid.Column="1" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ctrl:AdapterCtrl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrl:AdapterCtrl">
                    <Border
                        Background="{DynamicResource RegionBrush}"
                        CornerRadius="10"
                        Effect="{StaticResource EffectShadow4}">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <ComboBox x:Name="PART_Items" />
                            <hc:PropertyGrid
                                Grid.Row="1"
                                SelectedObject="{Binding Path=AdapterObj, RelativeSource={RelativeSource AncestorType=ctrl:AdapterCtrl}, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                ShowSortButton="False" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>