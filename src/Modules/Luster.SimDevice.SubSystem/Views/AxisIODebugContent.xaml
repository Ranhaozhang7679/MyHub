<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.AxisIODebugContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:Luster.Motion.DataStruct.DataModels;assembly=Luster.Motion.DataStruct"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Virtual"
    xmlns:m="clr-namespace:Luster.SimDevice.EngineUI.Models;assembly=Luster.SimDevice.EngineUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:extension="clr-namespace:Luster.SimDevice.SubSystem.Extension"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="800"
    d:DesignWidth="1366"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    
    <UserControl.Resources>
        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="hc:IconElement.Height" Value="12" />
            <Setter Property="hc:IconElement.Width" Value="12" />
            <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        </Style>
        
        <Style
            x:Key="DigitalStyle"
            BasedOn="{StaticResource ToggleButtonFlip.Small}"
            TargetType="ToggleButton">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NoFlashListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter SnapsToDevicePixels="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NoFlashListBox" TargetType="ListBox">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderOptions.EdgeMode" Value="Aliased"/>
        </Style>

        <DataTemplate x:Key="DigitalInTemplate" DataType="{x:Type m:IOModel}">
            <Border
                Name="BorderItem"
                Height="36"
                Margin="2"
                Padding="5,4"
                BorderThickness="1"
                Style="{StaticResource BorderRegion}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <Border HorizontalAlignment="Left">
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Text="{Binding Index, StringFormat={}X{0}}" />
                    </Border>

                    <TextBlock
                        Grid.Column="1"
                        Margin="3,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{DynamicResource InfoBrush}"
                        Text="{Binding SubDefinite}" />

                    <TextBlock
                        Grid.Column="2"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{Binding Name}"
                        ToolTip="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding IsSelected, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                    <TextBox
                        Grid.Column="2"
                        MaxHeight="22"
                        Style="{StaticResource TextBoxExtend.Small}"
                        Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding IsSelected, Converter={StaticResource Boolean2VisibilityConverter}}" />
                    <ToggleButton
                        Grid.Column="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        IsChecked="{Binding DigitalValue}"
                        IsEnabled="{Binding Path=DataContext.IsReal, Converter={StaticResource Boolean2BooleanReConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}}"
                        Style="{StaticResource DigitalStyle}">
                        <hc:StatusSwitchElement.CheckedElement>
                            <Border Background="Green" />
                        </hc:StatusSwitchElement.CheckedElement>
                        <Border Background="Gray" />
                    </ToggleButton>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="BorderItem" Property="Border.BorderBrush" Value="Green" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="DigitalOutTemplate" DataType="{x:Type m:IOModel}">
            <Border
                Name="BorderItem"
                Height="36"
                Margin="2"
                Padding="5,4"
                BorderThickness="1"
                Style="{StaticResource BorderRegion}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Border HorizontalAlignment="Left">
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Text="{Binding Index, StringFormat={}Y{0}}" />
                    </Border>

                    <TextBlock
                        Grid.Column="1"
                        Margin="3,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{DynamicResource InfoBrush}"
                        Text="{Binding SubDefinite}" />

                    <TextBlock
                        Grid.Column="2"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{Binding Name}"
                        ToolTip="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding IsSelected, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                    <TextBox
                        Grid.Column="2"
                        MaxHeight="22"
                        Style="{StaticResource TextBoxExtend.Small}"
                        Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding IsSelected, Converter={StaticResource Boolean2VisibilityConverter}}" />
                    <ToggleButton
                        Grid.Column="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        IsChecked="{Binding DigitalValue}"
                        Style="{StaticResource DigitalStyle}">
                        <hc:StatusSwitchElement.CheckedElement>
                            <Border Background="Green" />
                        </hc:StatusSwitchElement.CheckedElement>
                        <Border Background="Gray" />
                    </ToggleButton>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="BorderItem" Property="Border.BorderBrush" Value="Green" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <local:ValueTemplateSelector 
            x:Key="IoTemplate" 
            DigInTemplate="{StaticResource DigitalInTemplate}" 
            DigOutTemplate="{StaticResource DigitalOutTemplate}" />
        <local:IndexToOneBasedConverter x:Key="IndexToOneBasedConverter" />
        <extension:AxisMoveDirectionIconConverter x:Key="AxisMoveDirectionIconConverter" />
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="340" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <GroupBox
                Padding="10,5"
                hc:TitleElement.Background="{DynamicResource RegionBrush}"
                Style="{StaticResource GroupBoxTab}">
                <GroupBox.Header>
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <hc:ButtonGroup Grid.Column="0" Margin="0,3" Layout="Uniform">
                            <Button
                                Command="{Binding AxisCommand}"
                                CommandParameter="Stop"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.Stop}}"
                                Style="{StaticResource ButtonDashed}" />
                            <Button
                                Command="{Binding AxisCommand}"
                                CommandParameter="ClearError"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.ClearError}}"
                                Style="{StaticResource ButtonDashed}" />
                            <Button
                                Command="{Binding AxisCommand}"
                                CommandParameter="ServOn"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.UppperEnable}}"
                                Style="{StaticResource ButtonDashed}" />
                            <Button
                                Command="{Binding AxisCommand}"
                                CommandParameter="ServOff"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.DownEnable}}"
                                Style="{StaticResource ButtonDashed}" />
                            <Button
                                Command="{Binding AxisCommand}"
                                CommandParameter="Teach"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.Teach}}"
                                Style="{StaticResource ButtonDashed}" />
                        </hc:ButtonGroup>
                        <hc:ElementGroup Grid.Column="1" Margin="50,0,0,0" HorizontalAlignment="Right">
                            <hc:ElementGroup.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </ItemsPanelTemplate>
                            </hc:ElementGroup.ItemsPanel>
                            <TextBlock
                                Width="80"
                                VerticalAlignment="Center"
                                Foreground="Red"
                                Text="{lang:Lang Key={x:Static lang:LangKeys.SpeedCoefficient}}"
                                ToolTip="{lang:Lang Key={x:Static lang:LangKeys.SpeedTip}}" />
                            <Slider
                                Name="slider"
                                Grid.Column="1"
                                Width="200"
                                Margin="20,0,0,0"
                                hc:TipElement.Placement="Top"
                                hc:TipElement.Visibility="Visible"
                                IsSnapToTickEnabled="True"
                                Maximum="100"
                                Minimum="10"
                                Orientation="Horizontal"
                                TickFrequency="10"
                                TickPlacement="BottomRight"
                                Value="{Binding SpeedPercent}">
                                <hc:Interaction.Triggers>
                                    <hc:EventTrigger EventName="ValueChanged">
                                        <hc:EventToCommand Command="{Binding ChangeSpeedCommand}" PassEventArgsToCommand="True" />
                                    </hc:EventTrigger>
                                </hc:Interaction.Triggers>
                            </Slider>
                            <hc:NumericUpDown
                                Grid.Column="2"
                                Width="60"
                                Margin="5,0,0,0"
                                IsReadOnly="True"
                                Value="{Binding ElementName=slider, Path=Value}" />
                        </hc:ElementGroup>
                    </Grid>
                </GroupBox.Header>
                <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SubAxisList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <hc:UniformSpacingPanel
                                    VerticalAlignment="Top"
                                    ChildWrapping="Wrap"
                                    ScrollViewer.VerticalScrollBarVisibility="Visible" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="5,5"
                                    Padding="8"
                                    Background="{DynamicResource RegionBrush}"
                                    CornerRadius="5">
                                    <StackPanel Orientation="Vertical">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Margin="5,0,0,0"
                                                HorizontalAlignment="Left"
                                                FontSize="14"
                                                Foreground="Red"
                                                Text="{Binding Path=DataContext.Current.Name, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                HorizontalAlignment="Right"
                                                FontSize="14"
                                                Foreground="Blue"
                                                Text="{Binding Name}" />
                                        </Grid>

                                        <hc:ElementGroup Margin="0,15,0,0" ItemsSource="{Binding StatusList}">
                                            <hc:ElementGroup.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Path
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Data="M 0,0 A 5,5 45 1 1 0,1 Z"
                                                            Fill="{Binding Status, Converter={StaticResource Boolean2PassColorCoverter}}" />
                                                        <TextBlock
                                                            Margin="0,5,0,0"
                                                            HorizontalAlignment="Center"
                                                            FontSize="10"
                                                            Text="{Binding Alias}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </hc:ElementGroup.ItemTemplate>
                                        </hc:ElementGroup>

                                        <Grid Margin="5,10,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Margin="0,0,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="Blue"
                                                Text="{Binding CurrentPos, StringFormat={}实时 {0:N3} mm}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="0,0,5,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="Red"
                                                Text="{Binding TeachPos, StringFormat={}示教 {0:N3} mm}" />
                                        </Grid>

                                        <Grid Margin="5,5,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Text="{lang:Lang Key={x:Static lang:LangKeys.Priority}}" />
                                            <hc:ComboBox
                                                Grid.Column="1"
                                                hc:InfoElement.TitlePlacement="Left"
                                                DisplayMemberPath="Desc"
                                                ItemsSource="{Binding Path=DataContext.Priorities, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                SelectedValue="{Binding MovePriority}"
                                                SelectedValuePath="Value"
                                                Style="{StaticResource ComboBoxBaseStyle}" />
                                        </Grid>

                                        <TextBlock
                                            Margin="5,0,0,2"
                                            FontSize="10"
                                            Foreground="Red"
                                            Text="*步进距离最大不能超过±5mm" />
                                        <Grid Margin="5,0,0,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Text="{lang:Lang Key={x:Static lang:LangKeys.Diatance}}" />
                                            <RepeatButton Grid.Column="1"
                                                Command="{Binding MoveRelCommandAdd}"
                                                CommandParameter="1"
                                                Delay="500"
                                                Interval="200"
                                                Background="Transparent"
                                                BorderThickness="0">
                                                <Grid>
                                                    <Border
                                                        BorderBrush="#CCCCCC"
                                                        BorderThickness="1"
                                                        CornerRadius="4,0,0,4"
                                                        Width="100"
                                                        Height="30"/>
                                                    <Path
                                                        Fill="#333333"
                                                        Stretch="Uniform"
                                                        Width="10"
                                                        Height="12"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                        <Path.Data>
                                                            <MultiBinding Converter="{StaticResource AxisMoveDirectionIconConverter}">
                                                                <Binding Path="." />
                                                                <Binding Source="Positive" />
                                                            </MultiBinding>
                                                        </Path.Data>
                                                    </Path>
                                                </Grid>
                                            </RepeatButton>
                                            <hc:NumericUpDown Grid.Row="1"
                                                DecimalPlaces="3"
                                                Minimum="-5"
                                                Maximum="5"
                                                Value="{Binding DstPostion}" />
                                            <RepeatButton Grid.Row="1" Grid.Column="1"
                                                Command="{Binding MoveRelCommandSub}"
                                                CommandParameter="-1"
                                                Delay="500"
                                                Interval="200"
                                                Background="Transparent"
                                                BorderThickness="0">
                                                <Grid>
                                                    <Border
                                                        BorderBrush="#CCCCCC"
                                                        BorderThickness="1"
                                                        CornerRadius="0,4,4,0"
                                                        Width="100"
                                                        Height="30"/>
                                                    <Path
                                                        Fill="#333333"
                                                        Stretch="Uniform"
                                                        Width="10"
                                                        Height="12"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                        <Path.Data>
                                                            <MultiBinding Converter="{StaticResource AxisMoveDirectionIconConverter}">
                                                                <Binding Path="." />
                                                                <Binding Source="Negative" />
                                                            </MultiBinding>
                                                        </Path.Data>
                                                    </Path>
                                                </Grid>
                                            </RepeatButton>
                                        </Grid>

                                        <UniformGrid Margin="0,0,0,0" Columns="3" Rows="2">
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding HomeCommand}"
                                                CommandParameter="{Binding .}"
                                                Content="{lang:Lang Key={x:Static lang:LangKeys.HomeZero}}"
                                                IsEnabled="{Binding ShowHome}" />
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding StopCommand}"
                                                CommandParameter="{Binding .}"
                                                Content="{lang:Lang Key={x:Static lang:LangKeys.Stop}}" />
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding JogCommandAdd}"
                                                Content="+Jog" />
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding ClearErrorCommand}"
                                                CommandParameter="{Binding .}"
                                                Content="{lang:Lang Key={x:Static lang:LangKeys.ClearError}}" />
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}, Path=DataContext.TeachCommand}"
                                                CommandParameter="{Binding .}"
                                                Content="{lang:Lang Key={x:Static lang:LangKeys.Teach}}"
                                                Foreground="{StaticResource DangerBrush}" />
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding JogCommandSub}"
                                                Content="-Jog" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>
            <GridSplitter
                Grid.Column="1"
                Width="3"
                Margin="2"
                HorizontalAlignment="Stretch" />
            <GroupBox
                Grid.Column="2"
                MinWidth="150"
                Padding="0"
                hc:TitleElement.Background="{DynamicResource RegionBrush}"
                Header="模组列表(双击显示)"
                Style="{StaticResource GroupBoxTab}">
                <ListBox
                    Margin="0"
                    ItemsSource="{Binding StationDatas}"
                    SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="PreviewMouseDoubleClick">
                            <hc:EventToCommand Command="{Binding Path=DataContext.DoubleAddCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=SelectedItem}" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </ListBox>
            </GroupBox>
        </Grid>

        <GridSplitter
            Grid.Row="1"
            Height="3"
            Margin="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <TabControl Grid.Column="0" Padding="0" Style="{StaticResource TabControlInLine}">
                <TabItem Header="示教点位">
                    <Grid>
                        <Popup
                            x:Name="dgPopup"
                            AllowsTransparency="True"
                            IsHitTestVisible="False"
                            Placement="RelativePoint"
                            PlacementTarget="{Binding ElementName=dgPosGroups}">
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="8"
                                FontWeight="Normal"
                                Text="Dragging..." />
                        </Popup>
                        <DataGrid
                            x:Name="dgPosGroups"
                            Padding="0"
                            EnableRowVirtualization="False"
                            extension:DragDropRowBehavior.Edit="True"
                            extension:DragDropRowBehavior.Enabled="True"
                            extension:DragDropRowBehavior.PopupControl="{Binding ElementName=dgPopup}"
                            hc:DataGridAttach.ShowRowNumber="False"
                            hc:DataGridAttach.ShowSelectAllButton="False"
                            AlternationCount="{Binding PosGroups.Count}"
                            AutoGenerateColumns="False"
                            ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                            HeadersVisibility="Column"
                            IsReadOnly="False"
                            ItemsSource="{Binding PosGroups}"
                            RowStyle="{StaticResource CustomDataGridRowStyle}"
                            SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn
                        Width="50"
                        MinWidth="50"
                        hc:TitleElement.HorizontalAlignment="Center"
                        CanUserResize="False"
                        Header="序号"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                    Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=(DataGridRow.AlternationIndex), Converter={StaticResource IndexToOneBasedConverter}}"
                                    HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                        Width="*"
                        MinWidth="200"
                        Binding="{Binding Name}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="Black"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Point}}" />
                                <DataGridTemplateColumn
                        Width="150"
                        MinWidth="150"
                        hc:TitleElement.HorizontalAlignment="Center"
                        CanUserResize="False"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Operation}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <hc:ElementGroup HorizontalContentAlignment="Center" Orientation="Horizontal">
                                                <Button
                                            Margin="5,0,0,0"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.MoveCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.Move}}"
                                            Style="{StaticResource ButtonInfo.Small}" />
                                                <Button
                                            Margin="5,0,0,0"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.UpdateCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.Update}}"
                                            Style="{StaticResource ButtonWarning.Small}" />
                                                <Button
                                            Margin="0,0,0,0"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.RemoveCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.Delete}}"
                                            Style="{StaticResource ButtonDanger.Small}" />
                                            </hc:ElementGroup>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn
                        Width="80"
                        MinWidth="80"
                        Binding="{Binding X}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        FontSize="12"
                        Foreground="Blue"
                        Header="X (mm)"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="False" />
                            <DataGridTextColumn
                        Width="80"
                        MinWidth="80"
                        Binding="{Binding Y}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        FontSize="12"
                        Foreground="Blue"
                        Header="Y (mm)"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="False" />
                            <DataGridTextColumn
                        Width="80"
                        MinWidth="80"
                        Binding="{Binding U}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        FontSize="12"
                        Foreground="Blue"
                        Header="U (mm)"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="False" />
                            <DataGridTextColumn
                        Width="80"
                        MinWidth="80"
                        Binding="{Binding Z}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        FontSize="12"
                        Foreground="Blue"
                        Header="Z (mm)"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="False" />
                            <DataGridTextColumn
                        Width="80"
                        MinWidth="80"
                        Binding="{Binding U2}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        FontSize="12"
                        Foreground="Blue"
                        Header="U2 (mm)"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="False" />
                                <DataGridTextColumn
                        Width="80"
                        MinWidth="80"
                        Binding="{Binding Z2}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        FontSize="12"
                        Foreground="Blue"
                        Header="Z2 (mm)"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="False" />
                            </DataGrid.Columns>
                        <hc:Interaction.Triggers>
                            <hc:EventTrigger EventName="SelectionChanged">
                                <hc:EventToCommand Command="{Binding SelectedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}" />
                            </hc:EventTrigger>
                        </hc:Interaction.Triggers>
                    </DataGrid>
                    </Grid>
                </TabItem>
                <TabItem Header="仿真气缸">
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding CylinderList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <hc:UniformSpacingPanel
                                        VerticalAlignment="Top"
                                        ChildWrapping="Wrap"
                                        Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <GroupBox
                                        Width="150"
                                        Margin="0"
                                        Padding="5,10"
                                        hc:TitleElement.Background="{DynamicResource RegionBrush}"
                                        Style="{StaticResource GroupBoxTab}">
                                        <GroupBox.Header>
                                            <TextBlock
                                                Height="32"
                                                Padding="0,4,0,0"
                                                FontSize="14"
                                                Text="{Binding Name}" />
                                        </GroupBox.Header>
                                        <hc:UniformSpacingPanel
                                            Margin="0,15,0,0"
                                            Orientation="Vertical"
                                            Spacing="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <Path
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Data="M 0,0 A 8,8 45 1 1 0,1 Z"
                                                        Fill="{Binding StatusExtend, Converter={StaticResource Boolean2PassColorCoverter}}" />
                                                    <TextBlock
                                                        Margin="0,5,0,0"
                                                        HorizontalAlignment="Center"
                                                        FontSize="10"
                                                        Text="{Binding InExtendName}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <Path
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Data="M 0,0 A 8,8 45 1 1 0,1 Z"
                                                        Fill="{Binding StatusRetract, Converter={StaticResource Boolean2PassColorCoverter}}" />
                                                    <TextBlock
                                                        Margin="0,5,0,0"
                                                        HorizontalAlignment="Center"
                                                        FontSize="10"
                                                        Text="{Binding InRetractName}" />
                                                </StackPanel>
                                            </Grid>
                                            <hc:ButtonGroup>
                                                <Button
                                                    HorizontalAlignment="Center"
                                                    Command="{Binding DataContext.CylinderExtendCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                    CommandParameter="{Binding .}"
                                                    Content="{Binding ExtendName}"
                                                    FontSize="16" />
                                                <Button
                                                    HorizontalAlignment="Center"
                                                    Command="{Binding DataContext.CylinderRetractCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                    CommandParameter="{Binding .}"
                                                    Content="{Binding RetractName}"
                                                    FontSize="16" />
                                            </hc:ButtonGroup>
                                        </hc:UniformSpacingPanel>
                                    </GroupBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            <GridSplitter
                Grid.Column="1"
                Width="3"
                Margin="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch" />
            <Grid x:Name="GridIO" Grid.Column="2" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                        <hc:ElementGroup Margin="0,0,10,0">
                            <hc:ElementGroup.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </ItemsPanelTemplate>
                            </hc:ElementGroup.ItemsPanel>
                            <Label Content="{lang:Lang Key={x:Static lang:LangKeys.Frequency}}" />
                            <hc:NumericUpDown
                                Name="txtRate"
                                Grid.Column="1"
                                Width="80"
                                Minimum="0"
                                Value="{Binding SpanTime}" />
                        </hc:ElementGroup>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Padding="0"
                        Background="{DynamicResource BorderBrush}"
                        Style="{StaticResource BorderRegion}">
                        <ListBox
                            Name="itemsIn"
                            Style="{StaticResource NoFlashListBox}"
                            ItemTemplateSelector="{StaticResource IoTemplate}"
                            ItemsSource="{Binding IoInDatas}"
                            ItemContainerStyle="{StaticResource NoFlashListBoxItem}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Border>
                    <GridSplitter
                        Grid.Column="1"
                        Width="3"
                        Margin="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch" />
                    <Border
                        Grid.Column="2"
                        Padding="0"
                        Background="{DynamicResource BorderBrush}"
                        Style="{StaticResource BorderRegion}">
                        <ListBox
                            Name="itemsOut"
                            Style="{StaticResource NoFlashListBox}"
                            ItemTemplateSelector="{StaticResource IoTemplate}"
                            ItemsSource="{Binding IoOutDatas}"
                            ItemContainerStyle="{StaticResource NoFlashListBoxItem}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>