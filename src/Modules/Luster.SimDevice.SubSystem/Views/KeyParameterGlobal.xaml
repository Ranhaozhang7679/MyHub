<UserControl x:Class="Luster.SimDevice.SubSystem.Views.KeyParameterGlobal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Extension"
             d:DesignHeight="800"
             d:DesignWidth="1600"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource RegionBrush}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Grid.Row="1"
            Margin="5"
            Background="{DynamicResource RegionBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <ScrollViewer x:Name="HeaderScrollViewer"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              Background="Transparent">
                    <Grid x:Name="HeaderGrid" Margin="5,2" Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="Col0" Width="200" MinWidth="100" />
                            <ColumnDefinition x:Name="Col1" Width="100" MinWidth="80" />
                            <ColumnDefinition x:Name="Col2" Width="120" MinWidth="80" />
                            <ColumnDefinition x:Name="Col3" Width="150" MinWidth="100" />
                            <ColumnDefinition x:Name="Col4" Width="130" MinWidth="110" />
                        </Grid.ColumnDefinitions>

                        <GridSplitter Grid.Column="0" Width="3" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" DragDelta="GridSplitter_DragDelta" Tag="0"/>
                        <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" DragDelta="GridSplitter_DragDelta" Tag="1"/>
                        <GridSplitter Grid.Column="2" Width="3" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" DragDelta="GridSplitter_DragDelta" Tag="2"/>
                        <GridSplitter Grid.Column="3" Width="3" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" DragDelta="GridSplitter_DragDelta" Tag="3"/>

                        <TextBlock Grid.Column="0" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="变量名称"/>
                        <TextBlock Grid.Column="1" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="类型"/>
                        <TextBlock Grid.Column="2" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="当前值"/>
                        <TextBlock Grid.Column="3" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="默认值"/>
                        <TextBlock Grid.Column="4" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="操作"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <ScrollViewer Grid.Row="1"
                          x:Name="ContentScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          ScrollChanged="ContentScrollViewer_ScrollChanged">
                <ItemsControl x:Name="VariablesList"
                              ItemsSource="{Binding SelectedGlobalVariables}"
                              Background="White"
                              BorderThickness="0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RowBorder"
                                    Margin="0,0,0,1"
                                    Background="White"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid Margin="5,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding ElementName=Col0, Path=Width}" />
                                        <ColumnDefinition Width="{Binding ElementName=Col1, Path=Width}" />
                                        <ColumnDefinition Width="{Binding ElementName=Col2, Path=Width}" />
                                        <ColumnDefinition Width="{Binding ElementName=Col3, Path=Width}" />
                                        <ColumnDefinition Width="{Binding ElementName=Col4, Path=Width}" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 变量名称 -->
                                    <TextBlock Grid.Column="0" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="{Binding Name}"/>

                                    <!-- 类型 -->
                                    <TextBlock Grid.Column="1" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="{Binding TypeName}"/>

                                    <!-- 当前值 -->
                                    <TextBlock Grid.Column="2" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="{Binding Value}"/>

                                    <!-- 默认值 -->
                                    <TextBlock Grid.Column="3" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"
                                               Text="{Binding DefaultV}"/>
                                    <!--<hc:TextBox Grid.Column="3"
                                                Margin="5,3"
                                                HorizontalAlignment="Stretch"
                                                TextAlignment="Center"
                                                VerticalAlignment="Center"
                                                hc:InfoElement.Placeholder=""
                                                FontSize="12"
                                                Style="{StaticResource TextBoxExtend.Small}"
                                                Text="{Binding DefaultV, UpdateSourceTrigger=PropertyChanged}"/>-->

                                    <!-- 操作列 -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!--<Button Width="50"
                                                Height="25"
                                                Margin="2,3"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.SaveDefaultValueCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="保存"
                                                FontSize="11"
                                                Style="{StaticResource ButtonPrimary.Small}"/>-->

                                        <Button Width="50"
                                                Height="25"
                                                Margin="2,3"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.DeleteGlobalVariableCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="删除"
                                                FontSize="11"
                                                Style="{StaticResource ButtonDanger.Small}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedGlobalVariables.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空数据提示 -->
            <TextBlock Grid.Row="1"
                       Text="暂无数据，请点击新增按钮添加"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding SelectedGlobalVariables.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                       Foreground="#999" FontSize="14" Margin="0,50,0,0"/>
        </Grid>
    </Border>
</UserControl>