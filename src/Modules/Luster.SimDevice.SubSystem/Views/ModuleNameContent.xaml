<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.ModuleNameContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/" xmlns:viewmodel="clr-namespace:Luster.SimDevice.SubSystem.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:ErrorContentCustomVM}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <Grid Margin="5" Background="{DynamicResource RegionBrush}">
        <Grid Grid.Row="0" Margin="0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DataGrid
                Grid.Row="1"
                Padding="-5"
                AlternationCount="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1.5"
                ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                HeadersVisibility="Column"
                IsReadOnly="False"
                ItemsSource="{Binding ModuleDatas}"
                RowStyle="{StaticResource CustomDataGridRowStyle}"
                SelectionMode="Single"  
                SelectionUnit="FullRow">

                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="SelectionChanged">
                        <hc:EventToCommand Command="{Binding SelectionChangedCommand}" 
                              CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
                <DataGrid.Columns>

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="200"
                        Binding="{Binding Name}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="模块名称"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="True" />

                    <DataGridTemplateColumn
                        Width="*"
                        MinWidth="200"
                        hc:TitleElement.HorizontalAlignment="Center"
                        CanUserResize="False"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Operation}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <hc:ElementGroup HorizontalContentAlignment="Center" Orientation="Horizontal">
                                    <Button
                                    Margin="0,0,0,0"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.RemoveCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}"
                                    Content="{lang:Lang Key={x:Static lang:LangKeys.Delete}}"
                                    Style="{StaticResource ButtonDanger.Small}" />
                                </hc:ElementGroup>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
