<UserControl x:Class="Luster.SimDevice.SubSystem.Views.KeyParameterSFC"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Extension"
        d:DesignHeight="800"
        d:DesignWidth="1600"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Background="White"
        mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <!-- 竖排显示样式 -->
        <Style TargetType="Border" x:Key="ParameterGroupBorderStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <Style TargetType="Grid" x:Key="ParameterGridStyle">
            <Setter Property="Margin" Value="10,5"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ParameterLabelStyle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ParameterValueStyle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 复选框样式 -->
        <Style x:Key="ParameterCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Border Margin="5"
            Background="White"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            CornerRadius="5">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Padding="10">
            <ItemsControl x:Name="ParametersList"
                          ItemsSource="{Binding ParameterRows}"
                          Background="Transparent">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ParameterGroupBorderStyle}">
                            <Grid Style="{StaticResource ParameterGridStyle}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 通信服务器地址 -->
                                <Grid Grid.Row="0" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="通信服务器地址：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CommDevice}" 
                                               Style="{StaticResource ParameterValueStyle}"/>
                                </Grid>

                                <!-- SFC启用 -->
                                <Grid Grid.Row="1" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SFC启用：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IsSFCEnableDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsSFCEnableIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <CheckBox IsChecked="{Binding IsSFCEnableCheckBoxValue}"
                                                  Style="{StaticResource ParameterCheckBoxStyle}"
                                                  Visibility="{Binding ShowIsSFCEnableCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 动作类型 -->
                                <Grid Grid.Row="2" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="动作类型：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SfcMode}" 
                                               Style="{StaticResource ParameterValueStyle}"/>
                                </Grid>

                                <!-- 是否是首站 -->
                                <Grid Grid.Row="3" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="首站：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IsFirstStationDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsFirstStationIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <CheckBox IsChecked="{Binding IsFirstStationCheckBoxValue}"
                                                  Style="{StaticResource ParameterCheckBoxStyle}"
                                                  Visibility="{Binding ShowIsFirstStationCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 是否强制本站名称 -->
                                <Grid Grid.Row="4" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="强制本站名称：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IsForceStationNameDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsForceStationNameIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <CheckBox IsChecked="{Binding IsForceStationNameCheckBoxValue}"
                                                  Style="{StaticResource ParameterCheckBoxStyle}"
                                                  Visibility="{Binding ShowIsForceStationNameCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 本站名称 -->
                                <Grid Grid.Row="5" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="本站名称：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ForceStationNameDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding ForceStationNameIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding ForceStationName}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   Visibility="{Binding ForceStationNameIsBinding, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 本站Type -->
                                <Grid Grid.Row="6" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="本站Type：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ForceStationTypeDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding ForceStationTypeIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding ForceStationType}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   Visibility="{Binding ForceStationTypeIsBinding, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 是否查询上一站结果 -->
                                <Grid Grid.Row="7" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="查询上一站结果：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding QueryPrevStationDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding QueryPrevStationIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <CheckBox IsChecked="{Binding QueryPrevStationCheckBoxValue}"
                                                  Style="{StaticResource ParameterCheckBoxStyle}"
                                                  Visibility="{Binding ShowQueryPrevStationCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 是否解绑治具码 -->
                                <Grid Grid.Row="8" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="解绑治具码：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IsUnBindDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsUnBindIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <CheckBox IsChecked="{Binding IsUnBindCheckBoxValue}"
                                                  Style="{StaticResource ParameterCheckBoxStyle}"
                                                  Visibility="{Binding ShowIsUnBindCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 根据工单自动生成WIP -->
                                <Grid Grid.Row="9" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="自动生成WIP：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IsAutoBuildWipDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsAutoBuildWipIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <CheckBox IsChecked="{Binding IsAutoBuildWipCheckBoxValue}"
                                                  Style="{StaticResource ParameterCheckBoxStyle}"
                                                  Visibility="{Binding ShowIsAutoBuildWipCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- SN编码 -->
                                <Grid Grid.Row="10" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SN编码：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SNDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding SNIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding SN}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   Visibility="{Binding SNIsBinding, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 查两次 -->
                                <Grid Grid.Row="11" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="查两次：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IsTwoDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsTwoIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <CheckBox IsChecked="{Binding IsTwoCheckBoxValue}"
                                                  Style="{StaticResource ParameterCheckBoxStyle}"
                                                  Visibility="{Binding ShowIsTwoCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- LCFM -->
                                <Grid Grid.Row="12" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="LCFM：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LCFMDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding LCFMIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding LCFM}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   Visibility="{Binding LCFMIsBinding, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 治具码 -->
                                <Grid Grid.Row="13" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="治具码：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CarrierSNDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding CarrierSNIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding CarrierSN}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   Visibility="{Binding CarrierSNIsBinding, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Wip码长度 -->
                                <Grid Grid.Row="14" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Wip码长度：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WipLength}" 
                                               Style="{StaticResource ParameterValueStyle}"/>
                                </Grid>

                                <!-- Wip码长度2 -->
                                <Grid Grid.Row="15" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Wip码长度2：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WipLength2}" 
                                               Style="{StaticResource ParameterValueStyle}"/>
                                </Grid>

                                <!-- 上传Pass/Fail -->
                                <Grid Grid.Row="16" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="上传Pass/Fail：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IsOKDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsOKIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <CheckBox IsChecked="{Binding IsOKCheckBoxValue}"
                                                  Style="{StaticResource ParameterCheckBoxStyle}"
                                                  Visibility="{Binding ShowIsOKCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- SFCUrl2 -->
                                <Grid Grid.Row="17" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SFCUrl2：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SFCUrl2DisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding SFCUrl2IsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding SFCUrl2}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   Visibility="{Binding SFCUrl2IsBinding, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- UseSFCUrl2 -->
                                <Grid Grid.Row="18" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="UseSFCUrl2：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UseSFCUrl2DisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding UseSFCUrl2IsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <CheckBox IsChecked="{Binding UseSFCUrl2CheckBoxValue}"
                                                  Style="{StaticResource ParameterCheckBoxStyle}"
                                                  Visibility="{Binding ShowUseSFCUrl2CheckBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- NG码 -->
                                <Grid Grid.Row="19" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="NG码：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ErrorCodeDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding ErrorCodeIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding ErrorCode}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   Visibility="{Binding ErrorCodeIsBinding, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- NG信息 -->
                                <Grid Grid.Row="20" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="NG信息：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ErrorMsgDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding ErrorMsgIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding ErrorMsg}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   Visibility="{Binding ErrorMsgIsBinding, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- stationID -->
                                <Grid Grid.Row="21" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="stationID：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StationIDDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding StationIDIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding StationID}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   Visibility="{Binding StationIDIsBinding, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- check_flag -->
                                <Grid Grid.Row="22" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="check_flag：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CheckFlagDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding CheckFlagIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding CheckFlag}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   Visibility="{Binding CheckFlagIsBinding, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- sfcStationCode -->
                                <Grid Grid.Row="23" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="sfcStationCode：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SfcStationCodeDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding SfcStationCodeIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding SfcStationCode}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   Visibility="{Binding SfcStationCodeIsBinding, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- test_station_name -->
                                <Grid Grid.Row="24" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="test_station_name：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Test_station_nameDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding Test_station_nameIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Test_station_name}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   Visibility="{Binding Test_station_nameIsBinding, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- product -->
                                <Grid Grid.Row="25" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="product：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProductDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding ProductIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Product}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   Visibility="{Binding ProductIsBinding, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- StationName -->
                                <Grid Grid.Row="26" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="StationName：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StationNamePropDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding StationNamePropIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding StationNameProp}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   Visibility="{Binding StationNamePropIsBinding, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- mac_address -->
                                <Grid Grid.Row="27" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="mac_address：" Style="{StaticResource ParameterLabelStyle}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Mac_addressDisplayText}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding Mac_addressIsBinding, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding Mac_address}"
                                                   Style="{StaticResource ParameterValueStyle}"
                                                   Visibility="{Binding Mac_addressIsBinding, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 本站强制未做 -->
                                <Grid Grid.Row="28" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
