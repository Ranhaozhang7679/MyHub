<Border
    x:Class="Luster.SimDevice.SubSystem.Views.Virtual.VLineLaserContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Virtual"
    xmlns:m="clr-namespace:Luster.SimDevice.EngineUI.Models;assembly=Luster.SimDevice.EngineUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pg="clr-namespace:Luster.Common.Assets.ParamGrid;assembly=Luster.Common.Assets"
    xmlns:prism="http://prismlibrary.com/"
    MinWidth="800"
    d:DesignHeight="600"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    CornerRadius="10"
    mc:Ignorable="d">
    <Border.Resources>
        <Style BasedOn="{StaticResource ComboBoxExtend}" TargetType="hc:ComboBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="55" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        </Style>
    </Border.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="250" />
            <RowDefinition Height="5" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <GroupBox
            Grid.Row="0"
            hc:TitleElement.Background="{DynamicResource RegionBrush}"
            Header="{lang:Lang Key={x:Static lang:LangKeys.DeviceList}}"
            Style="{StaticResource GroupBoxTab}">
            <Grid>
                <DataGrid
                    Padding="-5"
                    AlternationCount="2"
                    ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                    HeadersVisibility="Column"
                    ItemsSource="{Binding VLaserModels}"
                    RowStyle="{StaticResource CustomDataGridRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="120"
                            MinWidth="100"
                            Binding="{Binding Module}"
                            CanUserSort="False"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}" />
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="100"
                            Binding="{Binding Name}"
                            CanUserSort="False"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.Name}}" />
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="100"
                            Binding="{Binding LaserName}"
                            CanUserSort="False"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.LaserName}}" />
                        <DataGridTextColumn
                            Width="200"
                            MinWidth="150"
                            Binding="{Binding LaserSN}"
                            CanUserSort="False"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.SerialNumber}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTemplateColumn
                            Width="110"
                            MinWidth="100"
                            hc:TitleElement.HorizontalAlignment="Center"
                            CanUserResize="False"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.Operation}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <hc:ElementGroup HorizontalContentAlignment="Center" Orientation="Horizontal">
                                        <Button
                                            Margin="0"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.RemoveCommand}"
                                            CommandParameter="{Binding}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.Delete}}"
                                            Style="{StaticResource ButtonDanger.Small}" />
                                    </hc:ElementGroup>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="SelectionChanged">
                            <hc:EventToCommand Command="{Binding SelectedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </DataGrid>
            </Grid>
        </GroupBox>
        <GridSplitter
            Grid.Row="1"
            Height="5"
            Margin="0,2"
            HorizontalAlignment="Stretch" />
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="890" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Width="100"
                        Padding="4,6"
                        HorizontalAlignment="Center"
                        hc:IconElement.Geometry="{StaticResource ApplyGeometry}"
                        Command="{Binding ConnectLaserCommand}"
                        Content="{lang:Lang Key={x:Static lang:LangKeys.Connect}}" />
                    <Button
                        Grid.Column="1"
                        Width="100"
                        Padding="4,6"
                        HorizontalAlignment="Center"
                        hc:IconElement.Geometry="{StaticResource ApplyGeometry}"
                        Command="{Binding OpenLaserCommand}"
                        Content="{lang:Lang Key={x:Static lang:LangKeys.Open}}" />
                    <Button
                        Grid.Column="2"
                        Width="100"
                        Padding="4,6"
                        HorizontalAlignment="Center"
                        hc:IconElement.Geometry="{StaticResource ApplyGeometry}"
                        Command="{Binding StopLaserCommand}"
                        Content="{lang:Lang Key={x:Static lang:LangKeys.Stop}}" />
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="530" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Row="1" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="90" />
                        </Grid.RowDefinitions>
                        <GroupBox
                            Grid.Row="0"
                            Padding="5"
                            hc:TitleElement.Background="{DynamicResource RegionBrush}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.LaserConfigutation}}"
                            Style="{StaticResource GroupBoxTab}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="40" />
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource BorderRegion}">
                                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                                        <ScrollViewer.Content>
                                            <StackPanel Orientation="Vertical">
                                                <Grid Background="{DynamicResource RegionBrush}" Visibility="{Binding JobPathVis, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <hc:TextBox
                                                        Height="30"
                                                        Margin="5"
                                                        hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.SelectLaserConfigutationPath}}"
                                                        hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.LaserConfigutationPath}}"
                                                        hc:InfoElement.TitlePlacement="Left"
                                                        hc:InfoElement.TitleWidth="80"
                                                        Text="{Binding JobPath}" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Width="80"
                                                        Margin="5,0,0,5"
                                                        Padding="4,6"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        hc:IconElement.Geometry="{StaticResource ApplyGeometry}"
                                                        Command="{Binding SelectJobPathCommand}"
                                                        Content="{lang:Lang Key={x:Static lang:LangKeys.Browse}}" />
                                                </Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <hc:UniformSpacingPanel
                                                        MaxWidth="235"
                                                        Margin="10,0,0,0"
                                                        Orientation="Vertical"
                                                        Spacing="10">
                                                        <hc:ComboBox
                                                            hc:InfoElement.Necessary="True"
                                                            hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.SelectLaserConfigutation}}"
                                                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.LaserJob}}"
                                                            DisplayMemberPath="."
                                                            ItemsSource="{Binding LaserJobs}"
                                                            SelectedValue="{Binding CurJob}"
                                                            Style="{StaticResource ComboBoxValidationStyle}" />
                                                        <hc:ComboBox
                                                            hc:InfoElement.Necessary="True"
                                                            hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.LaserStartTip}}"
                                                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.StartTrigger}}"
                                                            DisplayMemberPath="."
                                                            ItemsSource="{Binding StartTriggerModes}"
                                                            SelectedValue="{Binding CurStartTriMode}"
                                                            Style="{StaticResource ComboBoxValidationStyle}" />
                                                        <hc:ComboBox
                                                            hc:InfoElement.Necessary="True"
                                                            hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.LaserDataTriggerTip}}"
                                                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.DataTrigger}}"
                                                            DisplayMemberPath="."
                                                            ItemsSource="{Binding DataTriggerModes}"
                                                            SelectedValue="{Binding CurDataTriMode}"
                                                            Style="{StaticResource ComboBoxValidationStyle}" />
                                                        <hc:ComboBox
                                                            hc:InfoElement.Necessary="True"
                                                            hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.SelectEncoderTip}}"
                                                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.EncoderType}}"
                                                            DisplayMemberPath="."
                                                            ItemsSource="{Binding EncoderOut}"
                                                            SelectedValue="{Binding CurEncoderOut}"
                                                            Style="{StaticResource ComboBoxValidationStyle}"
                                                            Visibility="{Binding EncoderOutVis, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                                    </hc:UniformSpacingPanel>
                                                    <hc:UniformSpacingPanel
                                                        Margin="50,0,0,0"
                                                        Orientation="Vertical"
                                                        Spacing="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="100" />
                                                                <ColumnDefinition Width="100" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock VerticalAlignment="Center" Text="{lang:Lang Key={x:Static lang:LangKeys.ExposureTime}}" />
                                                            <hc:NumericUpDown Grid.Column="1" Value="{Binding Exposure}" />
                                                        </Grid>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="100" />
                                                                <ColumnDefinition Width="100" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock VerticalAlignment="Center" Text="{lang:Lang Key={x:Static lang:LangKeys.CollectRows}}" />
                                                            <hc:NumericUpDown Grid.Column="1" Value="{Binding RowNum}" />
                                                        </Grid>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="100" />
                                                                <ColumnDefinition Width="100" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock VerticalAlignment="Center" Text="{lang:Lang Key={x:Static lang:LangKeys.Frame}}" />
                                                            <hc:NumericUpDown Grid.Column="1" Value="{Binding FrameRate}" />
                                                        </Grid>
                                                    </hc:UniformSpacingPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </ScrollViewer.Content>
                                    </ScrollViewer>
                                </Border>
                                <StackPanel
                                    Grid.Row="1"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                                    <Button
                                        Width="60"
                                        Margin="0,0,5,0"
                                        Padding="4,6"
                                        HorizontalAlignment="Right"
                                        hc:IconElement.Geometry="{StaticResource ApplyGeometry}"
                                        Command="{Binding SetLaserCommand}"
                                        Content="{lang:Lang Key={x:Static lang:LangKeys.Write}}" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        <GroupBox
                            Grid.Row="1"
                            Margin="0,5,0,0"
                            Padding="5"
                            hc:TitleElement.Background="{DynamicResource RegionBrush}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.LaserHardTrrigerConfigutation}}"
                            Style="{StaticResource GroupBoxTab}">
                            <Grid Background="{DynamicResource RegionBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <hc:ComboBox
                                    Margin="5"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.LaserStartIO}}"
                                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.StartIO}}"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding TriggerDOs}"
                                    SelectedValue="{Binding CurrentTriggerDO}"
                                    Style="{StaticResource ComboBoxValidationStyle}" />
                                <Button
                                    Grid.Column="1"
                                    Width="80"
                                    Margin="5"
                                    Padding="4,6"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    hc:IconElement.Geometry="{StaticResource ApplyGeometry}"
                                    Command="{Binding SetTriggerCommand}"
                                    Content="{lang:Lang Key={x:Static lang:LangKeys.Sure}}" />
                            </Grid>
                        </GroupBox>
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="90" />
                        </Grid.RowDefinitions>
                        <GroupBox
                            Grid.Row="0"
                            Margin="5,0"
                            Padding="5"
                            hc:TitleElement.Background="{DynamicResource RegionBrush}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.MotionTest}}"
                            Style="{StaticResource GroupBoxTab}">
                            <StackPanel Background="{DynamicResource RegionBrush}">
                                <hc:ComboBox
                                    Margin="5"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.SelectAxis}}"
                                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Axis}}"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding Axises}"
                                    SelectedValue="{Binding CurrentAxis}"
                                    Style="{StaticResource ComboBoxValidationStyle}">
                                    <hc:Interaction.Triggers>
                                        <hc:EventTrigger EventName="SelectionChanged">
                                            <hc:EventToCommand Command="{Binding AxisChangedCommand}" PassEventArgsToCommand="True" />
                                        </hc:EventTrigger>
                                    </hc:Interaction.Triggers>
                                </hc:ComboBox>
                                <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                                    <hc:Divider
                                        Height="1"
                                        Margin="0"
                                        LineStrokeDashArray="2,2" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{lang:Lang Key={x:Static lang:LangKeys.Position}}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="Blue"
                                            Text="{Binding AxisPos}" />
                                        <Button
                                            Grid.Column="2"
                                            Margin="0,0,5,0"
                                            HorizontalAlignment="Right"
                                            Command="{Binding ClearErrorCommand}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.ClearError}}" />
                                    </Grid>
                                    <hc:Divider
                                        Height="1"
                                        Margin="0"
                                        LineStrokeDashArray="2,2" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{lang:Lang Key={x:Static lang:LangKeys.MoveDistance}}" />
                                        <hc:NumericUpDown Grid.Column="1" Value="{Binding MovePos}" />
                                        <Button
                                            Grid.Column="2"
                                            Command="{Binding MoveAbsCommand}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.AbsoluteMove}}" />
                                        <Button
                                            Grid.Column="3"
                                            Margin="0,0,5,0"
                                            HorizontalAlignment="Right"
                                            Command="{Binding MoveRelCommand}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.RelativeMove}}" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                    <hc:Divider
                                        Height="1"
                                        Margin="0"
                                        LineStrokeDashArray="2,2" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Grid.Column="0"
                                            Margin="5,0,0,0"
                                            HorizontalAlignment="Left"
                                            hc:IconElement.Geometry="{StaticResource AddGeometry}"
                                            Content="JOG">
                                            <hc:Interaction.Triggers>
                                                <hc:EventTrigger EventName="PreviewMouseDown">
                                                    <hc:EventToCommand Command="{Binding JogCommandAdd}" />
                                                </hc:EventTrigger>
                                                <hc:EventTrigger EventName="PreviewMouseUp">
                                                    <hc:EventToCommand Command="{Binding StopCommand}" />
                                                </hc:EventTrigger>
                                            </hc:Interaction.Triggers>
                                        </Button>
                                        <Button
                                            Grid.Column="1"
                                            Margin="0,0,5,0"
                                            HorizontalAlignment="Right"
                                            hc:IconElement.Geometry="{StaticResource SubGeometry}"
                                            hc:IconElement.Width="15"
                                            Content="JOG">
                                            <hc:Interaction.Triggers>
                                                <hc:EventTrigger EventName="PreviewMouseDown">
                                                    <hc:EventToCommand Command="{Binding JogCommandSub}" />
                                                </hc:EventTrigger>
                                                <hc:EventTrigger EventName="PreviewMouseUp">
                                                    <hc:EventToCommand Command="{Binding StopCommand}" />
                                                </hc:EventTrigger>
                                            </hc:Interaction.Triggers>
                                        </Button>
                                    </Grid>
                                    <hc:Divider
                                        Height="1"
                                        Margin="0"
                                        LineStrokeDashArray="2,2" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Grid.Column="0"
                                            Margin="5,0,0,0"
                                            HorizontalAlignment="Left"
                                            Command="{Binding HomeCommand}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.HomeZero}}"
                                            IsEnabled="{Binding Current.NeedHome}" />
                                        <Button
                                            Grid.Column="1"
                                            Margin="0,0,5,0"
                                            HorizontalAlignment="Right"
                                            Command="{Binding StopCommand}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.Stop}}" />
                                    </Grid>
                                </hc:UniformSpacingPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox
                            Grid.Row="1"
                            Margin="5,5,5,0"
                            Padding="5"
                            hc:TitleElement.Background="{DynamicResource RegionBrush}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.OfflineConfigutation}}"
                            Style="{StaticResource GroupBoxTab}">
                            <Grid Background="{DynamicResource RegionBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <hc:TextBox
                                    Height="30"
                                    Margin="5"
                                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.SelectOfflinePointCloud}}"
                                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.OfflinePointCloud}}"
                                    hc:InfoElement.TitlePlacement="Left"
                                    hc:InfoElement.TitleWidth="55"
                                    Text="{Binding SelectedLaserModel.PointCloudPath}" />
                                <Button
                                    Grid.Column="1"
                                    Width="80"
                                    Margin="0,0,5,5"
                                    Padding="4,6"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    hc:IconElement.Geometry="{StaticResource ApplyGeometry}"
                                    Command="{Binding SelectFileCommand}"
                                    Content="{lang:Lang Key={x:Static lang:LangKeys.Browse}}" />
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </Grid>
            <Border
                Grid.Column="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Name="bd_depthImage"
                            Grid.Column="0"
                            BorderBrush="LightGray"
                            BorderThickness="1">
                            <Button
                                Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}}"
                                HorizontalAlignment="Center"
                                BorderThickness="0"
                                Command="{Binding ShowSelectedCommand}"
                                CommandParameter="{Binding Content, RelativeSource={RelativeSource Mode=Self}}"
                                Content="{lang:Lang Key={x:Static lang:LangKeys._2_5DDepthMap}}" />
                        </Border>
                        <Border
                            Grid.Column="1"
                            BorderBrush="LightGray"
                            BorderThickness="1">
                            <Button
                                Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}}"
                                HorizontalAlignment="Center"
                                BorderThickness="0"
                                Command="{Binding ShowSelectedCommand}"
                                CommandParameter="{Binding Content, RelativeSource={RelativeSource Mode=Self}}"
                                Content="{lang:Lang Key={x:Static lang:LangKeys._2DSkeletonMap}}" />
                        </Border>
                    </Grid>
                    <Border
                        x:Name="bd_Profile"
                        Grid.Row="1"
                        Background="Black"
                        MouseLeftButtonDown="Image_MouseLeftButtonDown"
                        MouseLeftButtonUp="Image_MouseLeftButtonUp"
                        MouseMove="Image_MouseMove"
                        MouseWheel="Image_MouseWheel">
                        <Canvas x:Name="cv_Image" ClipToBounds="True">
                            <Image
                                x:Name="image_Pro"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                Source="{Binding HeightImage}"
                                Stretch="Uniform">
                                <Image.RenderTransform>
                                    <MatrixTransform x:Name="xMatrix" />
                                </Image.RenderTransform>
                            </Image>
                        </Canvas>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Border>
