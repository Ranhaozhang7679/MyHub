<Border
    x:Class="Luster.SimDevice.SubSystem.Views.Virtual.VRobotContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Virtual"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="600"
    d:DesignWidth="1400"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    CornerRadius="10"
    mc:Ignorable="d">
    <Border.Resources>
        <FrameworkElement
            x:Key="ProxyElement"
            DataContext="{Binding}"
            Visibility="Collapsed" />
        <Style BasedOn="{StaticResource ComboBoxExtend}" TargetType="hc:ComboBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="55" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        </Style>
        <Style
            x:Key="RobotMoveButton"
            BasedOn="{StaticResource {x:Type Button}}"
            TargetType="Button">
            <Setter Property="Width" Value="100" />
            <!--<Setter Property="Command" Value="{Binding RobotMoveCommand}" />
            <Setter Property="CommandParameter" Value="{Binding Content, RelativeSource={RelativeSource Mode=Self}}" />-->
        </Style>
    </Border.Resources>
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="250" />
                <RowDefinition Height="5" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <GroupBox
                Grid.Row="0"
                hc:TitleElement.Background="{DynamicResource RegionBrush}"
                Header="{lang:Lang Key={x:Static lang:LangKeys.DeviceList}}"
                Style="{StaticResource GroupBoxTab}">
                <Grid>
                    <DataGrid
                        Padding="-5"
                        AlternationCount="2"
                        ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                        HeadersVisibility="Column"
                        ItemsSource="{Binding VRobotModels}"
                        RowStyle="{StaticResource CustomDataGridRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="120"
                                MinWidth="100"
                                Binding="{Binding Module}"
                                CanUserSort="False"
                                ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}" />
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="100"
                                Binding="{Binding Name}"
                                CanUserSort="False"
                                ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.Name}}" />
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="100"
                                Binding="{Binding RobotName}"
                                CanUserSort="False"
                                ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.RobotName}}" />
                            <!--<DataGridTextColumn
                            Width="200"
                            MinWidth="150"
                            Binding="{Binding LaserSN}"
                            CanUserSort="False"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.SerialNumber}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />-->
                            <DataGridTemplateColumn
                                Width="110"
                                MinWidth="100"
                                hc:TitleElement.HorizontalAlignment="Center"
                                CanUserResize="False"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.Operation}}"
                                HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <hc:ElementGroup HorizontalContentAlignment="Center" Orientation="Horizontal">
                                            <Button
                                                Margin="0"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.RemoveCommand}"
                                                CommandParameter="{Binding}"
                                                Content="{lang:Lang Key={x:Static lang:LangKeys.Delete}}"
                                                Style="{StaticResource ButtonDanger.Small}" />
                                        </hc:ElementGroup>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <hc:Interaction.Triggers>
                            <hc:EventTrigger EventName="SelectionChanged">
                                <hc:EventToCommand Command="{Binding SelectedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}" />
                            </hc:EventTrigger>
                        </hc:Interaction.Triggers>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GridSplitter
                Grid.Row="1"
                Height="5"
                Margin="0,2"
                HorizontalAlignment="Stretch" />

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Width="100"
                        Padding="4,6"
                        HorizontalAlignment="Center"
                        hc:IconElement.Geometry="{StaticResource ApplyGeometry}"
                        Command="{Binding ConnectRobotCommand}"
                        Content="{lang:Lang Key={x:Static lang:LangKeys.Connect}}" />
                    <Button
                        Grid.Column="1"
                        Width="100"
                        Padding="4,6"
                        HorizontalAlignment="Center"
                        hc:IconElement.Geometry="{StaticResource ApplyGeometry}"
                        Command="{Binding DisConnectRobotCommand}"
                        Content="{lang:Lang Key={x:Static lang:LangKeys.Close}}" />
                    <Button
                        Grid.Column="2"
                        Width="100"
                        Padding="4,6"
                        HorizontalAlignment="Center"
                        hc:IconElement.Geometry="{StaticResource ApplyGeometry}"
                        Command="{Binding ServoOnCommand}"
                        Content="{lang:Lang Key={x:Static lang:LangKeys.UppperEnable}}" />
                    <Button
                        Grid.Column="3"
                        Width="100"
                        Padding="4,6"
                        HorizontalAlignment="Center"
                        hc:IconElement.Geometry="{StaticResource ApplyGeometry}"
                        Command="{Binding ServoOffCommand}"
                        Content="{lang:Lang Key={x:Static lang:LangKeys.Disable}}" />
                    <Button
                        Grid.Column="4"
                        Width="100"
                        Padding="4,6"
                        HorizontalAlignment="Center"
                        hc:IconElement.Geometry="{StaticResource ApplyGeometry}"
                        Command="{Binding ServoDragCommand}"
                        Content="{lang:Lang Key={x:Static lang:LangKeys.Drag}}" />
                    <hc:ElementGroup
                        Grid.Column="5"
                        Margin="1,10,0,0"
                        ItemsSource="{Binding Current.StatusList}">
                        <hc:ElementGroup.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Path
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="M 0,0 A 5,5 45 1 1 0,1 Z"
                                        Fill="{Binding Status, Converter={StaticResource Boolean2PassColorCoverter}}" />
                                    <TextBlock
                                        Margin="0,5,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Text="{Binding Alias}" />
                                </StackPanel>
                            </DataTemplate>
                        </hc:ElementGroup.ItemTemplate>
                    </hc:ElementGroup>

                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <GroupBox
                            Padding="5"
                            hc:TitleElement.Background="{DynamicResource RegionBrush}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.MotionTest}}"
                            Style="{StaticResource GroupBoxTab}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <hc:UniformSpacingPanel
                                        MaxWidth="235"
                                        Margin="10,0,0,0"
                                        Orientation="Vertical"
                                        Spacing="10">
                                        <hc:ComboBox
                                            hc:InfoElement.Necessary="True"
                                            hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.CoordinateSystem}}"
                                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.CoordinateSystem}}"
                                            DisplayMemberPath="Desc"
                                            IsEditable="False"
                                            ItemsSource="{Binding CoordTypes}"
                                            SelectedValue="{Binding CurCoordType}"
                                            SelectedValuePath="Value"
                                            Style="{StaticResource ComboBoxValidationStyle}" />
                                        <hc:ComboBox
                                            hc:InfoElement.Necessary="True"
                                            hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.RobotRunModelTip}}"
                                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.RobotRunModel}}"
                                            DisplayMemberPath="."
                                            ItemsSource="{Binding RobotRunModes}"
                                            SelectedValue="{Binding CurRobotRunMode}"
                                            Style="{StaticResource ComboBoxValidationStyle}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Margin="5,0,0,0"
                                                VerticalAlignment="Center"
                                                Text="{lang:Lang Key={x:Static lang:LangKeys.SpeedCoefficient}}"
                                                ToolTip="{lang:Lang Key={x:Static lang:LangKeys.SpeedTip}}" />
                                            <hc:NumericUpDown
                                                Grid.Column="1"
                                                DecimalPlaces="0"
                                                Maximum="100"
                                                Minimum="1"
                                                Value="{Binding SpeedCoefficient}" />
                                        </Grid>
                                    </hc:UniformSpacingPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Background="{DynamicResource RegionBrush}">
                                    <Grid Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Name="Bt1"
                                            Content="{Binding RobotAxis1Name}"
                                            Style="{StaticResource RobotMoveButton}">
                                            <hc:Interaction.Triggers>
                                                <hc:EventTrigger EventName="PreviewMouseDown">
                                                    <hc:EventToCommand Command="{Binding PreMouseDownCommand}" CommandParameter="{Binding ElementName=Bt1, Path=Content}" />
                                                </hc:EventTrigger>
                                                <hc:EventTrigger EventName="PreviewMouseUp">
                                                    <hc:EventToCommand Command="{Binding PreMouseUpCommand}" CommandParameter="{Binding ElementName=Bt1, Path=Content}" />
                                                </hc:EventTrigger>
                                            </hc:Interaction.Triggers>
                                        </Button>
                                        <Button
                                            Name="Bt2"
                                            Grid.Column="1"
                                            Content="{Binding RobotAxis2Name}"
                                            Style="{StaticResource RobotMoveButton}">
                                            <hc:Interaction.Triggers>
                                                <hc:EventTrigger EventName="PreviewMouseDown">
                                                    <hc:EventToCommand Command="{Binding PreMouseDownCommand}" CommandParameter="{Binding ElementName=Bt2, Path=Content}" />
                                                </hc:EventTrigger>
                                                <hc:EventTrigger EventName="PreviewMouseUp">
                                                    <hc:EventToCommand Command="{Binding PreMouseUpCommand}" CommandParameter="{Binding ElementName=Bt2, Path=Content}" />
                                                </hc:EventTrigger>
                                            </hc:Interaction.Triggers>
                                        </Button>
                                    </Grid>
                                    <Grid Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Name="Bt3"
                                            Content="{Binding RobotAxis3Name}"
                                            Style="{StaticResource RobotMoveButton}">
                                            <hc:Interaction.Triggers>
                                                <hc:EventTrigger EventName="PreviewMouseDown">
                                                    <hc:EventToCommand Command="{Binding PreMouseDownCommand}" CommandParameter="{Binding ElementName=Bt3, Path=Content}" />
                                                </hc:EventTrigger>
                                                <hc:EventTrigger EventName="PreviewMouseUp">
                                                    <hc:EventToCommand Command="{Binding PreMouseUpCommand}" CommandParameter="{Binding ElementName=Bt3, Path=Content}" />
                                                </hc:EventTrigger>
                                            </hc:Interaction.Triggers>
                                        </Button>
                                        <Button
                                            Name="Bt4"
                                            Grid.Column="1"
                                            Content="{Binding RobotAxis4Name}"
                                            Style="{StaticResource RobotMoveButton}">
                                            <hc:Interaction.Triggers>
                                                <hc:EventTrigger EventName="PreviewMouseDown">
                                                    <hc:EventToCommand Command="{Binding PreMouseDownCommand}" CommandParameter="{Binding ElementName=Bt4, Path=Content}" />
                                                </hc:EventTrigger>
                                                <hc:EventTrigger EventName="PreviewMouseUp">
                                                    <hc:EventToCommand Command="{Binding PreMouseUpCommand}" CommandParameter="{Binding ElementName=Bt4, Path=Content}" />
                                                </hc:EventTrigger>
                                            </hc:Interaction.Triggers>
                                        </Button>
                                    </Grid>
                                    <Grid Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Name="Bt5"
                                            Content="{Binding RobotAxis5Name}"
                                            Style="{StaticResource RobotMoveButton}">
                                            <hc:Interaction.Triggers>
                                                <hc:EventTrigger EventName="PreviewMouseDown">
                                                    <hc:EventToCommand Command="{Binding PreMouseDownCommand}" CommandParameter="{Binding ElementName=Bt5, Path=Content}" />
                                                </hc:EventTrigger>
                                                <hc:EventTrigger EventName="PreviewMouseUp">
                                                    <hc:EventToCommand Command="{Binding PreMouseUpCommand}" CommandParameter="{Binding ElementName=Bt5, Path=Content}" />
                                                </hc:EventTrigger>
                                            </hc:Interaction.Triggers>
                                        </Button>
                                        <Button
                                            Name="Bt6"
                                            Grid.Column="1"
                                            Content="{Binding RobotAxis6Name}"
                                            Style="{StaticResource RobotMoveButton}">
                                            <hc:Interaction.Triggers>
                                                <hc:EventTrigger EventName="PreviewMouseDown">
                                                    <hc:EventToCommand Command="{Binding PreMouseDownCommand}" CommandParameter="{Binding ElementName=Bt6, Path=Content}" />
                                                </hc:EventTrigger>
                                                <hc:EventTrigger EventName="PreviewMouseUp">
                                                    <hc:EventToCommand Command="{Binding PreMouseUpCommand}" CommandParameter="{Binding ElementName=Bt6, Path=Content}" />
                                                </hc:EventTrigger>
                                            </hc:Interaction.Triggers>
                                        </Button>
                                    </Grid>
                                    <Grid Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Name="Bt7"
                                            Content="{Binding RobotAxis7Name}"
                                            Style="{StaticResource RobotMoveButton}">
                                            <hc:Interaction.Triggers>
                                                <hc:EventTrigger EventName="PreviewMouseDown">
                                                    <hc:EventToCommand Command="{Binding PreMouseDownCommand}" CommandParameter="{Binding ElementName=Bt7, Path=Content}" />
                                                </hc:EventTrigger>
                                                <hc:EventTrigger EventName="PreviewMouseUp">
                                                    <hc:EventToCommand Command="{Binding PreMouseUpCommand}" CommandParameter="{Binding ElementName=Bt7, Path=Content}" />
                                                </hc:EventTrigger>
                                            </hc:Interaction.Triggers>
                                        </Button>
                                        <Button
                                            Name="Bt8"
                                            Grid.Column="1"
                                            Content="{Binding RobotAxis8Name}"
                                            Style="{StaticResource RobotMoveButton}">
                                            <hc:Interaction.Triggers>
                                                <hc:EventTrigger EventName="PreviewMouseDown">
                                                    <hc:EventToCommand Command="{Binding PreMouseDownCommand}" CommandParameter="{Binding ElementName=Bt8, Path=Content}" />
                                                </hc:EventTrigger>
                                                <hc:EventTrigger EventName="PreviewMouseUp">
                                                    <hc:EventToCommand Command="{Binding PreMouseUpCommand}" CommandParameter="{Binding ElementName=Bt8, Path=Content}" />
                                                </hc:EventTrigger>
                                            </hc:Interaction.Triggers>
                                        </Button>
                                    </Grid>
                                    <Grid Margin="5" Visibility="{Binding IsSixRobot, Converter={StaticResource Boolean2VisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Name="Bt9"
                                            Content="{Binding RobotAxis9Name}"
                                            Style="{StaticResource RobotMoveButton}">
                                            <hc:Interaction.Triggers>
                                                <hc:EventTrigger EventName="PreviewMouseDown">
                                                    <hc:EventToCommand Command="{Binding PreMouseDownCommand}" CommandParameter="{Binding ElementName=Bt9, Path=Content}" />
                                                </hc:EventTrigger>
                                                <hc:EventTrigger EventName="PreviewMouseUp">
                                                    <hc:EventToCommand Command="{Binding PreMouseUpCommand}" CommandParameter="{Binding ElementName=Bt9, Path=Content}" />
                                                </hc:EventTrigger>
                                            </hc:Interaction.Triggers>
                                        </Button>
                                        <Button
                                            Name="Bt10"
                                            Grid.Column="1"
                                            Content="{Binding RobotAxis10Name}"
                                            Style="{StaticResource RobotMoveButton}">
                                            <hc:Interaction.Triggers>
                                                <hc:EventTrigger EventName="PreviewMouseDown">
                                                    <hc:EventToCommand Command="{Binding PreMouseDownCommand}" CommandParameter="{Binding ElementName=Bt10, Path=Content}" />
                                                </hc:EventTrigger>
                                                <hc:EventTrigger EventName="PreviewMouseUp">
                                                    <hc:EventToCommand Command="{Binding PreMouseUpCommand}" CommandParameter="{Binding ElementName=Bt10, Path=Content}" />
                                                </hc:EventTrigger>
                                            </hc:Interaction.Triggers>
                                        </Button>
                                    </Grid>
                                    <Grid Margin="5" Visibility="{Binding IsSixRobot, Converter={StaticResource Boolean2VisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Name="Bt11"
                                            Content="{Binding RobotAxis11Name}"
                                            Style="{StaticResource RobotMoveButton}">
                                            <hc:Interaction.Triggers>
                                                <hc:EventTrigger EventName="PreviewMouseDown">
                                                    <hc:EventToCommand Command="{Binding PreMouseDownCommand}" CommandParameter="{Binding ElementName=Bt11, Path=Content}" />
                                                </hc:EventTrigger>
                                                <hc:EventTrigger EventName="PreviewMouseUp">
                                                    <hc:EventToCommand Command="{Binding PreMouseUpCommand}" CommandParameter="{Binding ElementName=Bt11, Path=Content}" />
                                                </hc:EventTrigger>
                                            </hc:Interaction.Triggers>
                                        </Button>
                                        <Button
                                            Name="Bt12"
                                            Grid.Column="1"
                                            Content="{Binding RobotAxis12Name}"
                                            Style="{StaticResource RobotMoveButton}">
                                            <hc:Interaction.Triggers>
                                                <hc:EventTrigger EventName="PreviewMouseDown">
                                                    <hc:EventToCommand Command="{Binding PreMouseDownCommand}" CommandParameter="{Binding ElementName=Bt12, Path=Content}" />
                                                </hc:EventTrigger>
                                                <hc:EventTrigger EventName="PreviewMouseUp">
                                                    <hc:EventToCommand Command="{Binding PreMouseUpCommand}" CommandParameter="{Binding ElementName=Bt12, Path=Content}" />
                                                </hc:EventTrigger>
                                            </hc:Interaction.Triggers>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                            </Grid>
                        </GroupBox>
                    </Grid>
                    <Grid Grid.Column="1">
                        <GroupBox
                            Grid.Row="0"
                            Margin="10,0,0,0"
                            hc:TitleElement.Background="{DynamicResource RegionBrush}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.Point}}"
                            Style="{StaticResource GroupBoxTab}">
                            <Grid>
                                <DataGrid
                                    Padding="-5"
                                    AlternationCount="2"
                                    ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                                    HeadersVisibility="Column"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding RobotPoints}"
                                    RowStyle="{StaticResource CustomDataGridRowStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="*"
                                            MinWidth="100"
                                            Binding="{Binding Key}"
                                            CanUserSort="False"
                                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                            Header="{lang:Lang Key={x:Static lang:LangKeys.Name}}" />
                                        <DataGridTextColumn
                                            Width="*"
                                            MinWidth="100"
                                            Binding="{Binding Value}"
                                            CanUserSort="False"
                                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                            Header="{lang:Lang Key={x:Static lang:LangKeys.Position}}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </Grid>

        </Grid>

        <GridSplitter
            Grid.Column="1"
            Width="3"
            Margin="2"
            HorizontalAlignment="Stretch" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <GroupBox
                Margin="5,0"
                Padding="5"
                hc:TitleElement.Background="{DynamicResource RegionBrush}"
                Header="{lang:Lang Key={x:Static lang:LangKeys.MotionTest}}"
                Style="{StaticResource GroupBoxTab}">
                <StackPanel Background="{DynamicResource RegionBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="单轴相对运动距离:"
                            ToolTip="{lang:Lang Key={x:Static lang:LangKeys.SpeedTip}}" />
                        <hc:NumericUpDown
                            Grid.Column="1"
                            DecimalPlaces="0"
                            Value="{Binding MovePos}" />
                    </Grid>
                    <hc:ButtonGroup>
                        <Button Command="{Binding MAcceptCommand}" Content="获取运动权限" />
                        <Button Command="{Binding MReleaseCommand}" Content="释放运动权限" />
                    </hc:ButtonGroup>
                    <hc:ButtonGroup>
                        <Button
                            Command="{Binding MovPRCommand}"
                            CommandParameter="{Binding Content, RelativeSource={RelativeSource Mode=Self}}"
                            Content="X" />
                        <Button
                            Command="{Binding MovPRCommand}"
                            CommandParameter="{Binding Content, RelativeSource={RelativeSource Mode=Self}}"
                            Content="Y" />
                        <Button
                            Command="{Binding MovPRCommand}"
                            CommandParameter="{Binding Content, RelativeSource={RelativeSource Mode=Self}}"
                            Content="Z" />
                        <Button
                            Command="{Binding MovPRCommand}"
                            CommandParameter="{Binding Content, RelativeSource={RelativeSource Mode=Self}}"
                            Content="C" />
                    </hc:ButtonGroup>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                        <hc:Divider
                            Height="1"
                            Margin="0"
                            LineStrokeDashArray="2,2" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <hc:Divider
                            Height="1"
                            Margin="0"
                            LineStrokeDashArray="2,2" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding MovPCommand}"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.Move}}"
                                IsEnabled="{Binding Current.NeedHome}" />
                            <Button
                                Grid.Column="1"
                                Margin="0,0,5,0"
                                HorizontalAlignment="Right"
                                Command="{Binding JumpCommand}"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.Jump}}" />
                        </Grid>
                        <hc:ButtonGroup>
                            <Button
                                Name="Home"
                                Command="{Binding HomeCommand}"
                                CommandParameter="{Binding Current}"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.HomeZero}}"
                                IsEnabled="{Binding Current.ShowHome}" />
                            <Button
                                Command="{Binding StopCommand}"
                                CommandParameter="{Binding Current}"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.Stop}}" />
                            <Button
                                Command="{Binding ClearErrorCommand}"
                                CommandParameter="{Binding Current}"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.ClearError}}" />
                            <Button
                                Command="{Binding TeachCommand}"
                                CommandParameter="{Binding Current}"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.Teach}}" />
                        </hc:ButtonGroup>
                        <ContentControl Content="{StaticResource ProxyElement}" Visibility="Collapsed" />

                    </hc:UniformSpacingPanel>
                </StackPanel>
            </GroupBox>

            <DataGrid
                x:Name="dgPosition"
                Grid.Row="1"
                MaxHeight="300"
                Padding="-5"
                hc:DataGridAttach.ShowRowNumber="False"
                hc:DataGridAttach.ShowSelectAllButton="False"
                AlternationCount="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CanUserSortColumns="False"
                ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding RobotPointItems}"
                RowStyle="{StaticResource CustomDataGridRowStyle}"
                SelectedCellsChanged="DataGrid_SelectedCellsChanged"
                SelectionMode="Single"
                Visibility="{Binding IsSixRobot, Converter={StaticResource Boolean2VisibilityReConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="80"
                        Binding="{Binding Name}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="False" />
                    <DataGridTemplateColumn
                        Width="200"
                        hc:TitleElement.HorizontalAlignment="Center"
                        CanUserResize="False"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Operation}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <hc:ElementGroup HorizontalContentAlignment="Right" Orientation="Horizontal">
                                    <Button
                                        Margin="0"
