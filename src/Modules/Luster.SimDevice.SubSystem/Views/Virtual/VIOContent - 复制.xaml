<Border
    x:Class="Luster.SimDevice.SubSystem.Views.Virtual.VIOContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Virtual"
    xmlns:m="clr-namespace:Luster.SimDevice.EngineUI.Models;assembly=Luster.SimDevice.EngineUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    MinWidth="800"
    d:DesignHeight="600"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    CornerRadius="10"
    mc:Ignorable="d">
    <Border.Resources>
        <DataTemplate x:Key="DoTemplate" DataType="{x:Type m:IOModel}">
            <ToggleButton
                HorizontalAlignment="Center"
                IsChecked="{Binding DigitalValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource ToggleButtonSwitch}" />
        </DataTemplate>

        <!--  数字量的值  -->
        <DataTemplate x:Key="DTemplate" DataType="{x:Type m:IOModel}">
            <CheckBox HorizontalAlignment="Center" IsChecked="{Binding DigitalValue}" />
        </DataTemplate>
        <!--  数字量的默认值  -->
        <DataTemplate x:Key="DefaultDTemplate" DataType="{x:Type m:IOModel}">
            <CheckBox HorizontalAlignment="Center" IsChecked="{Binding DefaultValue}" />
        </DataTemplate>

        <!--  模拟量的值  -->
        <DataTemplate x:Key="ATemplate" DataType="{x:Type m:IOModel}">
            <TextBlock HorizontalAlignment="Center" Text="{Binding AnalogValue}" />
        </DataTemplate>

        <!--  模拟量的默认值  -->
        <DataTemplate x:Key="DefaultATemplate" DataType="{x:Type m:IOModel}">
            <CheckBox HorizontalAlignment="Center" IsChecked="{Binding DefaultValue}" />
        </DataTemplate>

        <!--  数字量状态模板  -->
        <DataTemplate x:Key="DigitalTemplate" DataType="{x:Type m:IOModel}">
            <Path
                x:Name="PART_Status"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="M 0,0 A 8,8 45 1 1 0,1 Z"
                Fill="Gray" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DigitalValue}" Value="true">
                    <Setter TargetName="PART_Status" Property="Fill" Value="Green" />
                    <Setter TargetName="PART_Status" Property="Data" Value="M 0,0 A 10,10 45 1 1 0,1 Z" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  模拟量的状态模板  -->
        <DataTemplate x:Key="StatusATemplate" DataType="{x:Type m:IOModel}">
            <hc:HighlightTextBlock
                HorizontalAlignment="Center"
                HighlightBrush="{StaticResource PrimaryTextBrush}"
                Text="{Binding AnalogValue}" />
        </DataTemplate>

        <!--  默认值的模板  -->
        <local:ValueTemplateSelector
            x:Key="DefaultVTemplate"
            AnalogTemplate="{StaticResource DefaultDTemplate}"
            DigitalTemplate="{StaticResource DefaultATemplate}" />

        <local:ValueTemplateSelector
            x:Key="StatusTemplate"
            AnalogTemplate="{StaticResource StatusATemplate}"
            DigitalTemplate="{StaticResource DoTemplate}" />

        <local:ValueTemplateSelector
            x:Key="StatusDTemplate"
            AnalogTemplate="{StaticResource StatusATemplate}"
            DigitalTemplate="{StaticResource DigitalTemplate}" />
        <Style
            x:Key="cbkInSelectStyle"
            BasedOn="{StaticResource DataGridColumnHeaderStyle.Small}"
            TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <CheckBox
                            HorizontalAlignment="Center"
                            Command="{Binding Path=DataContext.SelectAllCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="Input"
                            IsChecked="{Binding Path=DataContext.IsInSelectAll, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="cbkOutSelectStyle"
            BasedOn="{StaticResource DataGridColumnHeaderStyle.Small}"
            TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <CheckBox
                            HorizontalAlignment="Center"
                            Command="{Binding Path=DataContext.SelectAllCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="Output"
                            IsChecked="{Binding Path=DataContext.IsOutSelectAll, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Border.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <hc:ButtonGroup Style="{StaticResource ButtonGroupSolid}">
                <RadioButton
                    Command="{Binding ChangeIOTypeCommand}"
                    CommandParameter="Digital"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.DigitalIO}}"
                    IsChecked="{Binding IsDigital}" />
                <RadioButton
                    Command="{Binding ChangeIOTypeCommand}"
                    CommandParameter="Analog"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.AnalogIO}}"
                    IsChecked="{Binding IsAnalog}" />
                <Button
                    Margin="5,0,0,0"
                    Command="{Binding BatchImportCommand}"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Inport}}" />
                <Button
                    Margin="5,0,0,0"
                    Command="{Binding BatchExportCommand}"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Export}}" />
            </hc:ButtonGroup>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <hc:ElementGroup Margin="0,0,10,0">
                    <hc:ElementGroup.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </ItemsPanelTemplate>
                    </hc:ElementGroup.ItemsPanel>
                    <Label Content="{lang:Lang Key={x:Static lang:LangKeys.Frequency}}" />
                    <hc:NumericUpDown
                        Name="txtRate"
                        Grid.Column="1"
                        Width="80"
                        Minimum="0"
                        Value="{Binding SpanTime}" />
                </hc:ElementGroup>

                <hc:ElementGroup Margin="0,0,20,0" Orientation="Horizontal">
                    <hc:ElementGroup.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </ItemsPanelTemplate>
                    </hc:ElementGroup.ItemsPanel>
                    <hc:NumericUpDown
                        x:Name="txtValue"
                        Width="100"
                        Minimum="0"
                        Value="0" />
                    <Button
                        Grid.Column="1"
                        MinWidth="80"
                        Margin="0,0,0,0"
                        Command="{Binding SimulationCommnad}"
                        CommandParameter="{Binding ElementName=txtValue, Path=Value}"
                        Content="{Binding SetValueBtnName}" />
                </hc:ElementGroup>
                <hc:SearchBar
                    x:Name="txtSearch"
                    Width="150"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.ModuleOrName}}"
                    Command="{Binding SearchCommand}"
                    Style="{StaticResource SearchBarExtend}"
                    Text="{Binding SearchParas}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>
            <GroupBox
                Padding="0"
                hc:TitleElement.Background="{DynamicResource RegionBrush}"
                Header="{Binding InputHeader}"
                Style="{StaticResource GroupBoxTab}">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid
                        Name="dgInput"
                        Padding="-5"
                        hc:DataGridAttach.ShowRowNumber="False"
                        hc:DataGridAttach.ShowSelectAllButton="False"
                        AlternationCount="2"
                        ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                        HeadersVisibility="Column"
                        IsReadOnly="False"
                        ItemsSource="{Binding InputDatas}"
                        RowStyle="{StaticResource CustomDataGridRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40" HeaderStyle="{StaticResource cbkInSelectStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Margin="16,0,0,0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="95"
                                MinWidth="90"
                                Binding="{Binding CardName}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.MotionCard}}"
                                IsReadOnly="True" />
                            <DataGridComboBoxColumn
                                Width="100"
                                MinWidth="100"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                                HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                                IsReadOnly="False">
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding Path=DataContext.Modules, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                        <Setter Property="SelectedValue" Value="{Binding Module, UpdateSourceTrigger=PropertyChanged}" />
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="ItemsSource" Value="{Binding Path=DataContext.Modules, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                        <Setter Property="SelectedValue" Value="{Binding Module}" />
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="120"
                                Binding="{Binding Name}"
                                ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                                IsReadOnly="False" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Index}"
                                ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.Index}}"
                                HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                                IsReadOnly="True" />
                            <DataGridTemplateColumn
                                Width="120"
                                CellTemplateSelector="{StaticResource StatusDTemplate}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.CurrentValue}}"
                                HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                                IsReadOnly="True" />
                        </DataGrid.Columns>
                        <hc:Interaction.Triggers>
                            <hc:EventTrigger EventName="Loaded">
                                <hc:EventToCommand Command="{Binding LoadedCommand}" />
                            </hc:EventTrigger>
                        </hc:Interaction.Triggers>
                    </DataGrid>
                    <StackPanel
                        Grid.Row="2"
                        Margin="0,5"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <hc:NumericUpDown
                            Height="30"
                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.PerPageCount}}"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:InfoElement.TitleWidth="90"
                            Minimum="1"
                            Style="{StaticResource NumericUpDownExtend}"
                            Value="{Binding InputPerPageCount}">
                            <hc:Interaction.Triggers>
                                <hc:EventTrigger EventName="ValueChanged">
                                    <hc:EventToCommand Command="{Binding QueryInputCommand}" />
                                </hc:EventTrigger>
                            </hc:Interaction.Triggers>
                        </hc:NumericUpDown>
                        <hc:Pagination
                            Margin="5,0"
                            AutoHiding="False"
                            DataCountPerPage="{Binding InputPerPageCount}"
                            IsJumpEnabled="True"
                            MaxPageCount="{Binding InputPageCount}"
                            MaxPageInterval="3"
                            PageIndex="{Binding InputPageIndex, Mode=TwoWay}">
                            <hc:Interaction.Triggers>
                                <hc:EventTrigger EventName="PageUpdated">
                                    <hc:EventToCommand Command="{Binding InPutPageUpdatedCommand}" PassEventArgsToCommand="True" />
                                </hc:EventTrigger>
                            </hc:Interaction.Triggers>
                        </hc:Pagination>
                    </StackPanel>
                </Grid>
            </GroupBox>
            <GridSplitter
                Grid.Column="1"
                Width="3"
                Margin="2"
                HorizontalAlignment="Stretch" />
            <GroupBox
                Grid.Column="2"
                Padding="0"
                hc:TitleElement.Background="{DynamicResource RegionBrush}"
                Header="{Binding OutputHeader}"
                Style="{StaticResource GroupBoxTab}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid
                        Name="dgOutput"
                        Padding="-5"
                        hc:DataGridAttach.ShowRowNumber="False"
                        hc:DataGridAttach.ShowSelectAllButton="False"
                        AlternationCount="2"
                        ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                        HeadersVisibility="Column"
                        IsReadOnly="False"
                        ItemsSource="{Binding OutputDatas}"
                        RowStyle="{StaticResource CustomDataGridRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40" HeaderStyle="{StaticResource cbkOutSelectStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Margin="16,0,0,0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn
                                Width="95"
                                MinWidth="95"
                                Binding="{Binding CardName}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.MotionCard}}"
                                IsReadOnly="True" />
                            <DataGridComboBoxColumn
                                Width="100"
                                MinWidth="100"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                                HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                                IsReadOnly="False">
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding Path=DataContext.Modules, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                        <Setter Property="SelectedValue" Value="{Binding Module, UpdateSourceTrigger=PropertyChanged}" />
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="ItemsSource" Value="{Binding Path=DataContext.Modules, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                        <Setter Property="SelectedValue" Value="{Binding Module}" />
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="120"
                                Binding="{Binding Name}"
                                ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.Name}}" />
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding Index}"
                                ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.Index}}"
                                HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                                IsReadOnly="True" />

                            <!--<DataGridTemplateColumn
                            Width="80"
                            CellTemplateSelector="{StaticResource DefaultVTemplate}"
                            Header="默认值"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                            IsReadOnly="True" />-->

                            <DataGridTemplateColumn
                                Width="100"
                                CellTemplateSelector="{StaticResource StatusTemplate}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.CurrentValue}}"
                                HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                                IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel
                        Grid.Row="2"
                        Margin="0,5"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <hc:NumericUpDown
                            Height="30"
                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.PerPageCount}}"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:InfoElement.TitleWidth="90"
                            Minimum="1"
                            Style="{StaticResource NumericUpDownExtend}"
                            Value="{Binding OutputPerPageCount}">
                            <hc:Interaction.Triggers>
                                <hc:EventTrigger EventName="ValueChanged">
                                    <hc:EventToCommand Command="{Binding QueryOutPutCommand}" />
                                </hc:EventTrigger>
                            </hc:Interaction.Triggers>
                        </hc:NumericUpDown>
                        <hc:Pagination
                            Margin="5,0"
                            AutoHiding="False"
                            DataCountPerPage="{Binding OutputPerPageCount}"
                            IsJumpEnabled="True"
                            MaxPageCount="{Binding OutputPageCount}"
                            MaxPageInterval="3"
                            PageIndex="{Binding OutputPageIndex, Mode=TwoWay}">
                            <hc:Interaction.Triggers>
                                <hc:EventTrigger EventName="PageUpdated">
                                    <hc:EventToCommand Command="{Binding OutPutPageUpdatedCommand}" PassEventArgsToCommand="True" />
                                </hc:EventTrigger>
                            </hc:Interaction.Triggers>
                        </hc:Pagination>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Border>
