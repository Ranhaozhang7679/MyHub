<Border
    x:Class="Luster.SimDevice.SubSystem.Views.Virtual.VCylinderContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:g="clr-namespace:Luster.Common.Assets.Global;assembly=Luster.Common.Assets"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Virtual"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    MinWidth="600"
    d:DesignHeight="720"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    CornerRadius="10"
    IsEnabled="{Binding Path=DataContext.PageEnabled, RelativeSource={RelativeSource Mode=Self}}"
    mc:Ignorable="d">
    <Border.Resources>
        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
            <Setter Property="Width" Value="70" />
            <Setter Property="hc:IconElement.Height" Value="12" />
            <Setter Property="hc:IconElement.Width" Value="12" />
        </Style>
    </Border.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <hc:ButtonGroup Style="{StaticResource ButtonGroupSolid}">
                <RadioButton
                    Command="{Binding ChangeParamCommand}"
                    CommandParameter="Normal"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.NormalParas}}"
                    IsChecked="{Binding IsShowParam, Converter={StaticResource Boolean2BooleanReConverter}}" />

            </hc:ButtonGroup>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <hc:SearchBar
                    x:Name="txtSearch"
                    Width="200"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.ModuleOrName}}"
                    Command="{Binding SearchCommand}"
                    CommandParameter="{Binding ElementName=txtSearch, Path=Text}"
                    Style="{StaticResource SearchBarExtend}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="53" />
                <ColumnDefinition Width="547" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DataGrid
                Grid.ColumnSpan="2"
                Padding="-5"
                hc:DataGridAttach.ShowRowNumber="False"
                hc:DataGridAttach.ShowSelectAllButton="False"
                AlternationCount="2"
                ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding CylinderList}"
                RowStyle="{StaticResource CustomDataGridRowStyle}"
                SelectionMode="Single"
                Visibility="{Binding IsShowParam, Converter={StaticResource Boolean2VisibilityReConverter}}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40" HeaderStyle="{StaticResource DataColumnHeaderSelectAllStyle}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Margin="16,0,0,0" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        MinWidth="80"
                        Binding="{Binding Module}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="120"
                        Binding="{Binding Name}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                    <DataGridTextColumn
                        MinWidth="90"
                        Binding="{Binding Category}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.CylinderType}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                    <DataGridTextColumn
                        MinWidth="120"
                        Binding="{Binding ExtendDOName}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.ExtendDO}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                    <DataGridTextColumn
                        MinWidth="120"
                        Binding="{Binding RetractDOName}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.RetractDO}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                    <DataGridTextColumn
                        MinWidth="120"
                        Binding="{Binding ExtendDIName}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.ExtendDI}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                    <DataGridTextColumn
                        MinWidth="120"
                        Binding="{Binding RetractDIName}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.RetractDI}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                    <DataGridTemplateColumn
                        Width="110"
                        MinWidth="100"
                        hc:TitleElement.HorizontalAlignment="Center"
                        CanUserResize="False"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Operation}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <hc:ElementGroup HorizontalContentAlignment="Center" Orientation="Horizontal">
                                    <Button
                                        Margin="0"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.EditCommand}"
                                        CommandParameter="{Binding .}"
                                        Content="{lang:Lang Key={x:Static lang:LangKeys.Edit}}"
                                        Style="{StaticResource ButtonInfo.Small}" />
                                </hc:ElementGroup>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="CellEditEnding">
                        <hc:EventToCommand Command="{Binding EditCommand}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </DataGrid>

            <GridSplitter
                Grid.Column="2"
                Width="2"
                Margin="2,10,2,10"
                HorizontalAlignment="Stretch" />
            <Border Grid.Column="3" Style="{StaticResource BorderRegion}">
                <ScrollViewer>
                    <ItemsControl IsEnabled="{Binding Path=(g:GlobalProperty.IsEnabeld), UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" ItemsSource="{Binding SelectedList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <hc:UniformSpacingPanel
                                    VerticalAlignment="Top"
                                    ChildWrapping="Wrap"
                                    ScrollViewer.VerticalScrollBarVisibility="Visible"
                                    Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <GroupBox
                                    Width="150"
                                    Margin="0"
                                    Padding="5,10"
                                    hc:TitleElement.Background="{DynamicResource RegionBrush}"
                                    Style="{StaticResource GroupBoxTab}">
                                    <GroupBox.Header>
                                        <TextBlock
                                            Height="32"
                                            Padding="0,4,0,0"
                                            FontSize="14"
                                            Text="{Binding Name}" />
                                    </GroupBox.Header>
                                    <hc:UniformSpacingPanel
                                        Margin="0,15,0,0"
                                        Orientation="Vertical"
                                        Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <Path
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="M 0,0 A 8,8 45 1 1 0,1 Z"
                                                    Fill="{Binding StatusExtend, Converter={StaticResource Boolean2PassColorCoverter}}" />
                                                <TextBlock
                                                    Margin="0,5,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="10"
                                                    Text="{Binding InExtendName}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <Path
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="M 0,0 A 8,8 45 1 1 0,1 Z"
                                                    Fill="{Binding StatusRetract, Converter={StaticResource Boolean2PassColorCoverter}}" />
                                                <TextBlock
                                                    Margin="0,5,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="10"
                                                    Text="{Binding InRetractName}" />
                                            </StackPanel>
                                        </Grid>
                                        <hc:ButtonGroup>
                                            <Button
                                                HorizontalAlignment="Center"
                                                Command="{Binding DataContext.CylinderExtendCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                CommandParameter="{Binding .}"
                                                Content="{Binding ExtendName}"
                                                FontSize="16" />
                                            <Button
                                                Grid.Column="0"
                                                HorizontalAlignment="Center"
                                                Command="{Binding DataContext.CylinderRetractCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                CommandParameter="{Binding .}"
                                                Content="{Binding RetractName}"
                                                FontSize="16" />
                                        </hc:ButtonGroup>
                                    </hc:UniformSpacingPanel>
                                </GroupBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Border>


