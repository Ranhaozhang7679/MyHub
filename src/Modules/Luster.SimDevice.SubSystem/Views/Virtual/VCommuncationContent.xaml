<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.Virtual.VCommuncationContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:g="clr-namespace:Luster.Common.Assets.Global;assembly=Luster.Common.Assets"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Virtual"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    MinWidth="600"
    d:DesignHeight="720"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    IsEnabled="{Binding Path=DataContext.PageEnabled, RelativeSource={RelativeSource Mode=Self}}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
            <Setter Property="Width" Value="70" />
            <Setter Property="hc:IconElement.Height" Value="12" />
            <Setter Property="hc:IconElement.Width" Value="12" />
            <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel Margin="2,5" Orientation="Horizontal">
            <hc:SearchBar
                x:Name="txtSearch"
                Width="150"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.ModuleOrName}}"
                Command="{Binding SearchCommand}"
                CommandParameter="{Binding ElementName=txtSearch, Path=Text}"
                Style="{StaticResource SearchBarExtend}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="600" />
            </Grid.ColumnDefinitions>
            <GroupBox
                Padding="0"
                hc:TitleElement.Background="{DynamicResource RegionBrush}"
                Header="{lang:Lang Key={x:Static lang:LangKeys.DeviceList}}"
                Style="{StaticResource GroupBoxTab}">
                <DataGrid
                    Padding="-5"
                    hc:DataGridAttach.ShowRowNumber="False"
                    hc:DataGridAttach.ShowSelectAllButton="False"
                    AlternationCount="2"
                    AutoGenerateColumns="False"
                    ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                    HeadersVisibility="Column"
                    IsReadOnly="False"
                    RowStyle="{StaticResource CustomDataGridRowStyle}"
                    SelectionMode="Single"
                    ItemsSource="{Binding Sockets}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="85"
                            Binding="{Binding Module}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="120"
                            MinWidth="120"
                            Binding="{Binding Name}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                            IsReadOnly="False" />
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="100"
                            Binding="{Binding Communication, Converter={StaticResource Object2StringConverter}}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.Communcation}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                            IsReadOnly="True" />
                        <DataGridTemplateColumn
                            Width="155"
                            MinWidth="150"
                            hc:TitleElement.HorizontalAlignment="Center"
                            CanUserResize="False"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.Operation}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <hc:ElementGroup HorizontalContentAlignment="Center" Orientation="Horizontal">
                                        <Button
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.AddActionCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.Add}}"
                                            Style="{StaticResource ButtonDanger.Small}" />
                                        <Button
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.EditCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.Edit}}"
                                            Style="{StaticResource ButtonDanger.Small}" />
                                        <Button
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.RemoveCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.Delete}}"
                                            Style="{StaticResource ButtonDanger.Small}" />
                                    </hc:ElementGroup>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="SelectionChanged">
                            <hc:EventToCommand Command="{Binding SelectedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </DataGrid>
            </GroupBox>
            <GridSplitter
                Grid.Column="1"
                Width="3"
                Margin="3,0"
                HorizontalAlignment="Stretch" />
            <Grid Grid.Column="2" x:Name="gridAction" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <GroupBox
                    Grid.ColumnSpan="2"
                    hc:TitleElement.Background="{DynamicResource RegionBrush}"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.CommuncationTest}}"
                    IsEnabled="{Binding Path=(g:GlobalProperty.IsEnabeld), UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource GroupBoxTab}">
                    <hc:UniformSpacingPanel Orientation="Vertical">
                        <TextBox
                            Margin="5"
                            hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Communcation}}"
                            hc:TitleElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="80"
                            IsReadOnly="True"
                            Style="{StaticResource TextBoxExtendBaseStyle}"
                            Text="{Binding Communication, Converter={StaticResource Object2StringConverter}}">
                            <TextBox.InputBindings>
                                <MouseBinding Command="{Binding DataContext.EditCommuncationCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" MouseAction="LeftDoubleClick" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100*" />
                                <ColumnDefinition Width="150*" />
                                <ColumnDefinition Width="190*" />
                                <ColumnDefinition Width="140*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                Grid.ColumnSpan="2"
                                Margin="5,5,5,5"
                                hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Protocol}}"
                                hc:TitleElement.TitlePlacement="Left"
                                hc:TitleElement.TitleWidth="80"
                                DisplayMemberPath="Desc"
                                ItemsSource="{Binding Protocols}"
                                SelectedValue="{Binding ProtocolType}"
                                SelectedValuePath="Value"
                                Style="{StaticResource ComboBoxExtendBaseStyle}" />
                            <ComboBox
                                Grid.Column="2"                               
                                Margin="5,5,5,5"
                                hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Brand}}"
                                hc:TitleElement.TitlePlacement="Left"
                                hc:TitleElement.TitleWidth="80"
                                DisplayMemberPath="Desc"
                                ItemsSource="{Binding Brands}"
                                SelectedValue="{Binding Brand}"
                                SelectedValuePath="Value"
                                Style="{StaticResource ComboBoxExtendBaseStyle}" />
                            <hc:ElementGroup
                                Grid.Column="3"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Layout="Stack">
                                <Button Command="{Binding ConnectCommand}" Content="{lang:Lang Key={x:Static lang:LangKeys.Connect}}" />
                                <Button
                                    Command="{Binding CloseCommand}"
                                    Content="{lang:Lang Key={x:Static lang:LangKeys.Close}}"
                                    IsEnabled="{Binding IsConnected}" />
                            </hc:ElementGroup>
                        </Grid>
                        <ComboBox
                            Grid.Row="0"
                            Margin="5,0,10,0"
                            hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.DataType}}"
                            hc:TitleElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="80"
                            DisplayMemberPath="Desc"
                            IsEnabled="{Binding IsConnected}"
                            ItemsSource="{Binding DataTypes}"
                            SelectedValue="{Binding DataType}"
                            SelectedValuePath="Value"
                            Style="{StaticResource ComboBoxExtendBaseStyle}" />
                        <Grid IsEnabled="{Binding IsConnected}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <GroupBox
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="5"
                                hc:TitleElement.Background="{DynamicResource RegionBrush}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.ReadData}}"
                                Style="{StaticResource GroupBoxTab}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <hc:ElementGroup Grid.Row="0" Layout="Stack">
                                        <hc:ElementGroup.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                </Grid>
                                            </ItemsPanelTemplate>
                                        </hc:ElementGroup.ItemsPanel>
                                        <TextBox
                                            Margin="0,5"
                                            hc:TitleElement.TitlePlacement="Left"
                                            Text="{Binding ReadMsg}" />
                                        <Button
                                            Grid.Column="1"
                                            Command="{Binding ReadCommand}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.SendPacket}}"
                                            IsEnabled="{Binding IsConnect}" />
                                        <Button
                                            Grid.Column="2"
                                            Command="{Binding WaitCommand}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.ContinuousSend}}"
                                            IsEnabled="{Binding IsConnect}" />
                                    </hc:ElementGroup>
                                    <TextBox
                                        Grid.Row="1"
                                        VerticalAlignment="Top"
                                        hc:TitleElement.Title="报文命令"
                                        hc:TitleElement.TitlePlacement="Left"
                                        AcceptsReturn="True"
                                        Text="{Binding ResultMsg}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </GroupBox>
                            <GroupBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="5,5,10,0"
                                hc:TitleElement.Background="{DynamicResource RegionBrush}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.WriteData}}"
                                Style="{StaticResource GroupBoxTab}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox
                                        hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.WriteValue}}"
                                        hc:TitleElement.TitlePlacement="Left"
                                        MaxLines="20"
                                        Style="{StaticResource TextBoxExtendBaseStyle}"
                                        Text="{Binding WriteValue}" />
                                    <hc:ElementGroup Grid.Row="1">
                                        <hc:ElementGroup.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                </Grid>
                                            </ItemsPanelTemplate>
                                        </hc:ElementGroup.ItemsPanel>
                                        <TextBox
                                            Margin="0,5,0,5"
                                            hc:TitleElement.TitlePlacement="Left"
                                            Text="{Binding WriteMsg}" />
                                        <Button
                                            Grid.Column="1"
                                            Command="{Binding WriteCommand}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.WritePacket}}"
                                            IsEnabled="{Binding IsConnect}" />
                                    </hc:ElementGroup>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </hc:UniformSpacingPanel>
                </GroupBox>
                <GroupBox
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Visibility="{Binding IsViewDgAction}"
                    Margin="0,5"
                    x:Name="dgAction"
                    hc:TitleElement.Background="{DynamicResource RegionBrush}"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.ActionArea}}"
                    Style="{StaticResource GroupBoxTab}">
                    <hc:ScrollViewer>
                        <ItemsControl ItemsSource="{Binding ActionModels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <hc:WaterfallPanel hc:PanelElement.FluidMoveBehavior="{StaticResource BehaviorXY200}" Groups="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="280"
                                        Margin="0,10"
                                        Background="{DynamicResource RegionBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        Effect="{StaticResource EffectShadow4}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <Grid Background="{DynamicResource RegionBrush}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel
                                                    Margin="10,5"
                                                    HorizontalAlignment="Stretch"
                                                    Orientation="Horizontal">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        hc:InfoElement.Necessary="True"
                                                        hc:InfoElement.Placeholder="动作名称"
                                                        hc:TitleElement.TitlePlacement="Left"
                                                        Foreground="Red"
                                                        Text="{Binding Name}" />
                                                    <CheckBox
                                                        Margin="10,0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Content="{lang:Lang Key={x:Static lang:LangKeys.ReadOnly}}"
                                                        Foreground="Red"
                                                        IsChecked="{Binding IsRead}"
                                                        IsEnabled="False" />
                                                </StackPanel>
                                                <hc:ButtonGroup
                                                    Grid.Column="1"
                                                    Margin="5"
                                                    HorizontalAlignment="Right"
                                                    DockPanel.Dock="Right">
                                                    <Button
                                                        hc:IconElement.Geometry="{StaticResource RemoveGeometry}"
                                                        Command="{Binding DataContext.RemoveActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding .}" />
                                                    <Button
                                                        hc:IconElement.Geometry="{StaticResource EditGeometry}"
                                                        hc:IconElement.Height="14"
                                                        Command="{Binding DataContext.EditActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding .}" />
                                                    <Button
                                                        hc:IconElement.Geometry="{StaticResource RunAllGeometry}"
                                                        hc:IconElement.Height="16"
                                                        Command="{Binding DataContext.RunActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding .}"
                                                        Visibility="{Binding IsCheck, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                                                </hc:ButtonGroup>
                                            </Grid>
                                            <hc:Divider
                                                Grid.Row="1"
                                                Height="2"
                                                Margin="10,2"
                                                BorderBrush="{StaticResource BorderBrush}" />
                                            <hc:UniformSpacingPanel
                                                Grid.Row="2"
                                                Margin="10,5"
                                                Orientation="Vertical"
                                                Spacing="10">
                                                <hc:ComboBox
                                                    hc:InfoElement.Placeholder="数据类型"
                                                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.DataType}}"
                                                    DisplayMemberPath="Desc"
                                                    ItemsSource="{Binding DataContext.DataTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    SelectedValue="{Binding DataType}"
                                                    SelectedValuePath="Value"
                                                    Style="{StaticResource ComboBoxValidationStyle}" />
                                                <TextBox
                                                    hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.PacketData}}"
                                                    hc:TitleElement.TitlePlacement="Left"
                                                    Style="{StaticResource TextBoxValidationStyle}"
                                                    Text="{Binding Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox
                                                    hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.WriteValue}}"
                                                    hc:TitleElement.TitlePlacement="Left"
                                                    Style="{StaticResource TextBoxValidationStyle}"
                                                    Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Visibility="{Binding IsRead, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                                            </hc:UniformSpacingPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </hc:ScrollViewer>
                </GroupBox>
                <DataGrid
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Visibility="{Binding IsViewDgSlave}"
                    Padding="-5"
                    x:Name="dgSlave"
                    hc:DataGridAttach.ShowRowNumber="False"
                    hc:DataGridAttach.ShowSelectAllButton="False"
                    AlternationCount="2"
                    AutoGenerateColumns="False"
                    ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                    HeadersVisibility="Column"
                    IsReadOnly="False"
                    RowStyle="{StaticResource CustomDataGridRowStyle}"
                    SelectionMode="Single"
                    ItemsSource="{Binding SlaveModels}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*" 
                            MinWidth="120"
                            Header="名称"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                            Binding="{Binding Name}"
                            IsReadOnly="True"/>
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="120"
                            Header="值"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Binding="{Binding Value}">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn
                            Width="105"
                            MinWidth="100"
                            hc:TitleElement.HorizontalAlignment="Center"
                            CanUserResize="False"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.Operation}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <hc:ElementGroup HorizontalContentAlignment="Center" Orientation="Horizontal">
                                        <Button
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.RemoveSlaveCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.Delete}}"
                                            Style="{StaticResource ButtonDanger.Small}" />
                                    </hc:ElementGroup>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>


