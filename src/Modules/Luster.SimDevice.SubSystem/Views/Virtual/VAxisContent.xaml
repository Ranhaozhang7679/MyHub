<Border
    x:Class="Luster.SimDevice.SubSystem.Views.Virtual.VAxisContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extension="clr-namespace:Luster.SimDevice.SubSystem.Extension"
    xmlns:g="clr-namespace:Luster.Common.Assets.Global;assembly=Luster.Common.Assets"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Virtual"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="600"
    d:DesignWidth="1200"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    CornerRadius="10"
    IsEnabled="{Binding Path=DataContext.PageEnabled, RelativeSource={RelativeSource Mode=Self}}"
    mc:Ignorable="d">
    <Border.Resources>
        <ResourceDictionary>
            <FrameworkElement x:Key="ProxyElement" DataContext="{Binding}" Visibility="Collapsed" />
            <extension:AxisForwardOppositeConverter x:Key="AxisForwardOppositeConverter" />
            <extension:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
            <local:IndexToOneBasedConverter x:Key="IndexToOneBasedConverter" />
        </ResourceDictionary>
    </Border.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <hc:ButtonGroup Style="{StaticResource ButtonGroupSolid}">
                <RadioButton
                    Command="{Binding ChangeParamCommand}"
                    CommandParameter="Normal"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.NormalParas}}"
                    IsChecked="{Binding IsShowHome, Converter={StaticResource Boolean2BooleanReConverter}}" />
                <RadioButton
                    Command="{Binding ChangeParamCommand}"
                    CommandParameter="Home"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.HomeParas}}"
                    IsChecked="{Binding IsShowHome}" />
                <Button
                    Margin="5,0,0,0"
                    Command="{Binding BatchImportCommand}"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Inport}}" />
                <Button
                    Margin="5,0,0,0"
                    Command="{Binding BatchExportCommand}"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Export}}" />
                <Button
                    Margin="5,0,0,0"
                    Command="{Binding ExportToTxtCommand}"
                    Content="导出到文本" />
            </hc:ButtonGroup>

            <hc:ElementGroup Grid.Column="1" Margin="10,0,0,0">
                <hc:ElementGroup.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </hc:ElementGroup.ItemsPanel>
                <TextBlock
                    Width="80"
                    VerticalAlignment="Center"
                    Foreground="Red"
                    Text="{lang:Lang Key={x:Static lang:LangKeys.SpeedCoefficient}}"
                    ToolTip="{lang:Lang Key={x:Static lang:LangKeys.SpeedTip}}" />
                <Slider
                    Name="slider"
                    Grid.Column="1"
                    Width="200"
                    Margin="20,0,0,0"
                    hc:TipElement.Placement="Top"
                    hc:TipElement.Visibility="Visible"
                    IsSnapToTickEnabled="True"
                    Maximum="100"
                    Minimum="10"
                    Orientation="Horizontal"
                    TickFrequency="10"
                    TickPlacement="BottomRight"
                    Value="{Binding SpeedPercent}">
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="ValueChanged">
                            <hc:EventToCommand Command="{Binding ChangeSpeedCommand}" PassEventArgsToCommand="True" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </Slider>
                <hc:NumericUpDown
                    Grid.Column="2"
                    Width="60"
                    Margin="5,0,0,0"
                    IsReadOnly="True"
                    Value="{Binding ElementName=slider, Path=Value}" />
            </hc:ElementGroup>
            <TextBlock
                   Grid.Column="1"
                   Margin="370,0,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Text="{Binding ModeSpeedText}" />
            <CheckBox Grid.Column="2" 
                   IsChecked="{Binding UseModeSpecificSpeed}" 
                   Content=""
                   Margin="5,0"
                   VerticalAlignment="Center"
                   ToolTip="是否调试使用,勾选后用于调试,无法保存"/>
            <StackPanel
                Grid.Column="3"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <hc:SearchBar
                    x:Name="txtSearch"
                    Width="120"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.ModuleOrName}}"
                    Command="{Binding SearchCommand}"
                    CommandParameter="{Binding ElementName=txtSearch, Path=Text}"
                    Style="{StaticResource SearchBarExtend}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DataGrid
                    Padding="-5"
                    hc:DataGridAttach.ShowRowNumber="False"
                    hc:DataGridAttach.ShowSelectAllButton="False"
                    AlternationCount="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                    HeadersVisibility="Column"
                    IsReadOnly="{Binding IsAllowUpdate}"
                    ItemsSource="{Binding AxisList}"
                    MouseDoubleClick="DataGrid_MouseDoubleClick"
                    RowStyle="{StaticResource CustomDataGridRowStyle}"
                    SelectedCellsChanged="DataGrid_SelectedCellsChanged_1"
                    SelectionMode="Single"
                    Visibility="{Binding IsShowHome, Converter={StaticResource Boolean2VisibilityReConverter}}">
                    <DataGrid.Columns>
                        <DataGridComboBoxColumn
                            MinWidth="100"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                            SelectedValueBinding="{Binding Module, UpdateSourceTrigger=PropertyChanged}">
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource" Value="{Binding Path=DataContext.ModuleNameList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    <Setter Property="SelectedValue" Value="{Binding Module, UpdateSourceTrigger=PropertyChanged}" />
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="ItemsSource" Value="{Binding Path=DataContext.ModuleNameList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    <Setter Property="SelectedValue" Value="{Binding Module}" />
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                        </DataGridComboBoxColumn>
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="120"
                            Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTextColumn
                            MinWidth="60"
                            Binding="{Binding AxisNo}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.AxisNo}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridComboBoxColumn
                            MinWidth="90"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.AxisType}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="DisplayMemberPath" Value="Desc" />
                                    <Setter Property="SelectedValuePath" Value="Value" />
                                    <Setter Property="ItemsSource" Value="{Binding Path=DataContext.AxisTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    <Setter Property="SelectedValue" Value="{Binding AxisType, UpdateSourceTrigger=PropertyChanged}" />
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="DisplayMemberPath" Value="Desc" />
                                    <Setter Property="SelectedValuePath" Value="Value" />
                                    <Setter Property="ItemsSource" Value="{Binding Path=DataContext.AxisTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    <Setter Property="SelectedValue" Value="{Binding AxisType}" />
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                        </DataGridComboBoxColumn>
                        <DataGridComboBoxColumn
                            MinWidth="90"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.AxisPML}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                            SortMemberPath="AxisPML">
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="DisplayMemberPath" Value="Desc" />
                                    <Setter Property="SelectedValuePath" Value="Value" />
                                    <Setter Property="ItemsSource" Value="{Binding Path=DataContext.AxisPMLList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    <Setter Property="SelectedValue" Value="{Binding AxisPML, UpdateSourceTrigger=PropertyChanged}" />
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="DisplayMemberPath" Value="Desc" />
                                    <Setter Property="SelectedValuePath" Value="Value" />
                                    <Setter Property="ItemsSource" Value="{Binding Path=DataContext.AxisPMLList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    <Setter Property="SelectedValue" Value="{Binding AxisPML}" />
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                        </DataGridComboBoxColumn>
                        <DataGridComboBoxColumn
                            MinWidth="90"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.AxisForward}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                            SortMemberPath="AxisForward">
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="DisplayMemberPath" Value="Desc" />
                                    <Setter Property="SelectedValuePath" Value="Value" />
                                    <Setter Property="ItemsSource" Value="{Binding Path=DataContext.AxisForwardList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    <Setter Property="SelectedValue" Value="{Binding AxisForward, UpdateSourceTrigger=PropertyChanged}" />
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="DisplayMemberPath" Value="Desc" />
                                    <Setter Property="SelectedValuePath" Value="Value" />
                                    <Setter Property="ItemsSource" Value="{Binding Path=DataContext.AxisForwardList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    <Setter Property="SelectedValue" Value="{Binding AxisForward}" />
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                        </DataGridComboBoxColumn>
                        <DataGridTextColumn
                            MinWidth="90"
                            Binding="{Binding Acc}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.AccSpeed}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTextColumn
                            MinWidth="90"
                            Binding="{Binding Dec}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.DccSpeed}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTextColumn
                            MinWidth="80"
                            Binding="{Binding MoveSpeed}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.RunSpeed}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTextColumn
                            MinWidth="80"
                            Binding="{Binding JogSpeed}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.JogSpped}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTextColumn
                            MinWidth="80"
                            Binding="{Binding PerPluse}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.PulseRatio}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTextColumn
                            MinWidth="80"
                            Binding="{Binding SoftLimitPL}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.ForwardTrip}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTextColumn
                            MinWidth="80"
                            Binding="{Binding SoftLimitML}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.NegativeTrip}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTextColumn
                            MinWidth="80"
                            Binding="{Binding Stime}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.PlaceTime}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTextColumn
                            MinWidth="80"
                            Binding="{Binding AxisBand}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.PulseCount}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridCheckBoxColumn
                            MinWidth="80"
                            Binding="{Binding HaveTransmission}"
                            ElementStyle="{StaticResource DataColumnCkBoxElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.HaveTransmission}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTextColumn
                            MinWidth="80"
                            Binding="{Binding CommandPulse}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.CommandPulse}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTextColumn
                            MinWidth="80"
                            Binding="{Binding CircleDisplacement}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.CircleDisplacement}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTextColumn
                            MinWidth="80"
                            Binding="{Binding GearRatioNumerator}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.GearRatioNumerator}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTextColumn
                            MinWidth="80"
                            Binding="{Binding GearRatioDenominator}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.GearRatioDenominator}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTemplateColumn />
                        <DataGridTemplateColumn
                            Width="80"
                            MinWidth="80"
                            hc:TitleElement.HorizontalAlignment="Center"
                            CanUserResize="False"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.Calculate}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <hc:ElementGroup HorizontalContentAlignment="Center" Orientation="Horizontal">
                                        <Button
                                            Margin="0"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.EditCommand}"
                                            CommandParameter="{Binding .}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.Calculate}}"
                                            Style="{StaticResource ButtonInfo.Small}" />
                                    </hc:ElementGroup>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="CellEditEnding">
                            <hc:EventToCommand Command="{Binding EditCommand}" PassEventArgsToCommand="True" />
                        </hc:EventTrigger>
                        <hc:EventTrigger EventName="SelectionChanged">
                            <hc:EventToCommand Command="{Binding SelectedCommand}" PassEventArgsToCommand="True" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </DataGrid>
                <DataGrid
                    Padding="-5"
                    hc:DataGridAttach.ShowRowNumber="False"
                    hc:DataGridAttach.ShowSelectAllButton="False"
                    AlternationCount="2"
                    ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                    Focusable="True"
                    HeadersVisibility="Column"
                    IsReadOnly="{Binding IsAllowUpdate}"
                    ItemsSource="{Binding AxisList}"
                    MouseDoubleClick="DataGrid_MouseDoubleClick"
                    RowStyle="{StaticResource CustomDataGridRowStyle}"
                    SelectedCellsChanged="DataGrid_SelectedCellsChanged"
                    SelectedIndex="{Binding SelectHomeIndex}"
                    SelectionMode="Single"
                    Visibility="{Binding IsShowHome, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="120"
                            Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTextColumn
                            Width="60"
                            Binding="{Binding AxisNo}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.AxisNo}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridComboBoxColumn
                            MinWidth="90"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.HomeType}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                            SortMemberPath="HomeMode">
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="DisplayMemberPath" Value="Desc" />
                                    <Setter Property="SelectedValuePath" Value="Value" />
                                    <Setter Property="ItemsSource" Value="{Binding Path=DataContext.HomeDirList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    <Setter Property="SelectedValue" Value="{Binding HomeMode, UpdateSourceTrigger=PropertyChanged}" />
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="DisplayMemberPath" Value="Desc" />
                                    <Setter Property="SelectedValuePath" Value="Value" />
                                    <Setter Property="ItemsSource" Value="{Binding Path=DataContext.HomeDirList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    <Setter Property="SelectedValue" Value="{Binding HomeMode}" />
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                        </DataGridComboBoxColumn>
                        <DataGridTextColumn
                            MinWidth="80"
                            Binding="{Binding HomeSpeedHigh}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.HighSpeed}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTextColumn
                            MinWidth="80"
                            Binding="{Binding HomeSpeedLow}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.LowSpeed}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTextColumn
                            MinWidth="90"
                            Binding="{Binding HomeAcc}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.AccSpeed}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTextColumn
                            MinWidth="90"
                            Binding="{Binding HomeDec}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.DccSpeed}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTextColumn
                            MinWidth="80"
                            Binding="{Binding HomeOffset}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.ZeroOffset}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridComboBoxColumn
                            MinWidth="90"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.Priority}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                            SortMemberPath="HomePriority">
                            <DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="DisplayMemberPath" Value="Desc" />
                                    <Setter Property="SelectedValuePath" Value="Value" />
                                    <Setter Property="ItemsSource" Value="{Binding Path=DataContext.PriorityList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    <Setter Property="SelectedValue" Value="{Binding HomePriority, UpdateSourceTrigger=PropertyChanged}" />
                                </Style>
                            </DataGridComboBoxColumn.EditingElementStyle>
                            <DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="DisplayMemberPath" Value="Desc" />
                                    <Setter Property="SelectedValuePath" Value="Value" />
                                    <Setter Property="ItemsSource" Value="{Binding Path=DataContext.PriorityList, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                    <Setter Property="SelectedValue" Value="{Binding HomePriority}" />
                                </Style>
                            </DataGridComboBoxColumn.ElementStyle>
                        </DataGridComboBoxColumn>
                        <DataGridTextColumn
                            MinWidth="80"
                            Binding="{Binding HomePos}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.AxisPosition}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                    </DataGrid.Columns>
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="CellEditEnding">
                            <hc:EventToCommand Command="{Binding EditCommand}" PassEventArgsToCommand="True" />
                        </hc:EventTrigger>
                        <hc:EventTrigger EventName="SelectionChanged">
                            <hc:EventToCommand Command="{Binding SelectedCommand}" PassEventArgsToCommand="True" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>

                </DataGrid>
                <GroupBox
                    Name="gb"
                    Grid.Row="1"
                    Margin="0,5,0,0"
                    hc:TitleElement.Background="{DynamicResource RegionBrush}"
                    IsEnabled="{Binding IsEnabled}"
                    Style="{StaticResource GroupBoxTab}">
                    <GroupBox.Header>
                        <Grid Width="{Binding ElementName=gb, Path=ActualWidth}" Height="36">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Text="{lang:Lang Key={x:Static lang:LangKeys.AxisMotionPremise}}" />
                            <Button
                                Margin="0,0,24,0"
                                HorizontalAlignment="Right"
                                hc:IconElement.Geometry="{StaticResource AddGeometry}"
                                Command="{Binding AddSafeCommand}"
                                CommandParameter="{Binding Current}"
                                Style="{StaticResource ButtonDanger.Small}" />
                        </Grid>
                    </GroupBox.Header>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding SafeRegions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="5"
                                        Background="{DynamicResource RegionBrush}"
                                        CornerRadius="5">
                                        <Grid Margin="5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <Grid MinHeight="28">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Padding="5,2"
                                                    HorizontalAlignment="Right"
                                                    hc:IconElement.Geometry="{StaticResource RemoveGeometry}"
                                                    Command="{Binding Path=DataContext.RemoveSafeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource ButtonDanger.Small}"
                                                    Visibility="{Binding Path=DataContext.SysRole, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource RoleVisibilityConverter}, ConverterParameter=Admin}" />
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="55" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="55" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Text="{lang:Lang Key={x:Static lang:LangKeys.MinPosition}}" />
                                                <hc:NumericUpDown
                                                    Grid.Column="1"
                                                    Margin="5,0,0,0"
                                                    IsEnabled="{Binding Path=DataContext.SysRole, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource RoleEnabledCoverter}, ConverterParameter=Admin}"
                                                    Value="{Binding Min}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{lang:Lang Key={x:Static lang:LangKeys.MaxPosition}}" />
                                                <hc:NumericUpDown
                                                    Grid.Column="3"
                                                    Margin="5,0,0,0"
                                                    IsEnabled="{Binding Path=DataContext.SysRole, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource RoleEnabledCoverter}, ConverterParameter=Admin}"
                                                    Value="{Binding Max}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </GroupBox>
            </Grid>
            <GridSplitter
                Grid.Column="1"
                Width="3"
                Margin="2"
                HorizontalAlignment="Stretch" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <GroupBox
                    Padding="10,5"
                    hc:TitleElement.Background="{DynamicResource RegionBrush}"
                    Header="{Binding Current.Name}"
                    IsEnabled="{Binding IsEnabled}"
                    Style="{StaticResource GroupBoxTab}">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <hc:ElementGroup Margin="0,10,0,0" ItemsSource="{Binding Current.StatusList}">
                                <hc:ElementGroup.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Path
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Data="M 0,0 A 5,5 45 1 1 0,1 Z"
                                                Fill="{Binding Status, Converter={StaticResource Boolean2PassColorCoverter}}" />
                                            <TextBlock
                                                Margin="0,5,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="10"
                                                Text="{Binding Alias}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </hc:ElementGroup.ItemTemplate>
                            </hc:ElementGroup>
                            <StackPanel
                                Grid.Column="1"
                                Width="100"
                                VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="Blue"
                                    Text="{Binding Current.CurrentPos, StringFormat={}{0:N3} mm}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="{lang:Lang Key={x:Static lang:LangKeys.Position}}" />

                            <hc:NumericUpDown
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                DecimalPlaces="3"
                                Value="{Binding MovePos}" />

                            <!--<Button
                                Grid.Column="2"
                                Width="80"
                                Padding="0,2"
                                HorizontalAlignment="Right"
                                Command="{Binding MotionCondictionsCommand}"
                                CommandParameter="{Binding Current}"
                                Content="运动条件"
                                Style="{StaticResource ButtonPrimary}" />-->
                        </Grid>
                        <hc:ButtonGroup>
                            <Button
                                Name="JogUp"
                                hc:IconElement.Geometry="{StaticResource AddGeometry}"
                                hc:IconElement.Height="12"
                                hc:IconElement.Width="10"
                                Content="JOG"
                                ToolTip="{Binding Current.AxisForward, Converter={StaticResource EnumDescriptionConverter}}"
                                >
                                <hc:Interaction.Triggers>
                                    <hc:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                        <hc:EventToCommand Command="{Binding JogCommandAdd}" CommandParameter="{Binding Current}" />
                                    </hc:EventTrigger>
                                    <hc:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                        <hc:EventToCommand Command="{Binding StopCommand}" CommandParameter="{Binding Current}" />
                                    </hc:EventTrigger>
                                </hc:Interaction.Triggers>
                            </Button>
                            <Button
                                Name="JogDown"
                                hc:IconElement.Geometry="{StaticResource SubGeometry}"
                                hc:IconElement.Height="12"
                                hc:IconElement.Width="10"
                                Content="JOG"
                                ToolTip="{Binding Current.AxisForward, Converter={StaticResource AxisForwardOppositeConverter}}"
                                >
                                <hc:Interaction.Triggers>
                                    <hc:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                        <hc:EventToCommand Command="{Binding JogCommandSub}" CommandParameter="{Binding Current}" />
                                    </hc:EventTrigger>
                                    <hc:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                        <hc:EventToCommand Command="{Binding StopCommand}" CommandParameter="{Binding Current}" />
                                    </hc:EventTrigger>
                                </hc:Interaction.Triggers>
                            </Button>
                            <Button
                                Padding="0,2"
                                Command="{Binding MoveAbsCommand}"
                                CommandParameter="{Binding Current}"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.AbsoluteMove}}" />
                            <Button
                                Padding="0,2"
                                Command="{Binding MoveRelCommand}"
                                CommandParameter="{Binding Current}"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.RelativeMove}}" />
                            <Button
                                Command="{Binding TeachCommand}"
                                CommandParameter="{Binding Current}"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.Teach}}" />
                        </hc:ButtonGroup>
                        <hc:ButtonGroup>
                            <Button
                                Name="Home"
                                Command="{Binding HomeCommand}"
                                CommandParameter="{Binding Current}"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.HomeZero}}"
                                IsEnabled="{Binding Current.ShowHome}" />
                            <Button
                                Command="{Binding StopCommand}"
                                CommandParameter="{Binding Current}"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.Stop}}" />
                            <Button
                                Command="{Binding ClearErrorCommand}"
                                CommandParameter="{Binding Current}"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.ClearError}}" />
                            <Button
                                Command="{Binding DisEnableCommand}"
                                CommandParameter="{Binding Current}"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.DownEnable}}" />
                            <Button
                                Command="{Binding EnableCommand}"
                                CommandParameter="{Binding Current}"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.UppperEnable}}" />
                        </hc:ButtonGroup>
                        <Popup
                            x:Name="dgPopup"
                            AllowsTransparency="True"
                            IsHitTestVisible="False"
                            Placement="RelativePoint"
                            PlacementTarget="{Binding ElementName=dgPosition}">
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="8"
                                FontWeight="Normal"
                                Text="Dragging..." />
                        </Popup>
                        <ContentControl Content="{StaticResource ProxyElement}" Visibility="Collapsed" />
                        <DataGrid
                            x:Name="dgPosition"
                            MaxHeight="300"
                            Padding="-5"
                            EnableRowVirtualization="False"
                            extension:DragDropRowBehavior.Edit="True"
                            extension:DragDropRowBehavior.Enabled="True"
                            extension:DragDropRowBehavior.PopupControl="{Binding ElementName=dgPopup}"
                            hc:DataGridAttach.ShowRowNumber="False"
                            hc:DataGridAttach.ShowSelectAllButton="False"
                            AlternationCount="{Binding AxisPositions.Count}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CanUserSortColumns="False"
                            ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding AxisPositions}"
                            RowStyle="{StaticResource CustomDataGridRowStyle}"
                            SelectedCellsChanged="dgPosition_SelectedCellsChanged"
                            SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn
                                    Width="50"
                                    MinWidth="50"
                                    hc:TitleElement.HorizontalAlignment="Center"
                                    CanUserResize="False"
                                    Header="序号"
                                    HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=(DataGridRow.AlternationIndex), Converter={StaticResource IndexToOneBasedConverter}}"
                                                HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="80"
                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                    Header="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                                    HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                                    IsReadOnly="False" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="70"
                                    Binding="{Binding Position}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="{lang:Lang Key={x:Static lang:LangKeys.Position}}"
                                    HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                                    IsReadOnly="False"
                                    Visibility="{Binding DataContext.IsRead, Source={StaticResource ProxyElement}, Converter={StaticResource Boolean2VisibilityConverter}}">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="{x:Type DataGridCell}">
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="85"
                                    Binding="{Binding Position}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="{lang:Lang Key={x:Static lang:LangKeys.Position}}"
                                    HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                                    IsReadOnly="True"
                                    Visibility="{Binding DataContext.IsRead, Source={StaticResource ProxyElement}, Converter={StaticResource Boolean2VisibilityReConverter}}">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="{x:Type DataGridCell}">
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <EventSetter Event="MouseDoubleClick" Handler="DataGridCell_MouseDoubleClick" />
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn
                                    Width="200"
                                    hc:TitleElement.HorizontalAlignment="Center"
                                    CanUserResize="False"
                                    Header="{lang:Lang Key={x:Static lang:LangKeys.Operation}}"
                                    HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <hc:ElementGroup HorizontalContentAlignment="Right" Orientation="Horizontal">
                                                <Button
                                                    Margin="0"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.MoveTeachLimitCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="配置"
                                                    IsEnabled="{Binding SysRole, Converter={StaticResource RoleEnabledCoverter}, ConverterParameter=Engineer}"
                                                    Style="{StaticResource ButtonPrimary.Small}" />
                                                <Button
                                                    Margin="0"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.MoveTeachCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="{lang:Lang Key={x:Static lang:LangKeys.Move}}"
                                                    IsEnabled="{Binding SysRole, Converter={StaticResource RoleEnabledCoverter}, ConverterParameter=Engineer}"
                                                    Style="{StaticResource ButtonSuccess.Small}" />
                                                <Button
                                                    Margin="0"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.UpdateTeachCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="{lang:Lang Key={x:Static lang:LangKeys.Update}}"
                                                    IsEnabled="{Binding SysRole, Converter={StaticResource RoleEnabledCoverter}, ConverterParameter=Engineer}"
                                                    Style="{StaticResource ButtonWarning.Small}" />
                                                <Button
                                                    Margin="0"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.RemovePositionCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="{lang:Lang Key={x:Static lang:LangKeys.Delete}}"
                                                    IsEnabled="{Binding SysRole, Converter={StaticResource RoleEnabledCoverter}, ConverterParameter=Engineer}"
                                                    Style="{StaticResource ButtonDanger.Small}" />
                                            </hc:ElementGroup>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            <hc:Interaction.Triggers>
                                <hc:EventTrigger EventName="SelectionChanged">
                                    <hc:EventToCommand Command="{Binding SelectedPosionCommand}" PassEventArgsToCommand="True" />
                                </hc:EventTrigger>
                            </hc:Interaction.Triggers>
                        </DataGrid>
                    </hc:UniformSpacingPanel>
                </GroupBox>
                <GroupBox
                    Name="gbPosion"
                    Grid.Row="1"
                    Margin="0,5,0,0"
                    hc:TitleElement.Background="{DynamicResource RegionBrush}"
                    IsEnabled="{Binding IsEnabledPosion}"
                    Style="{StaticResource GroupBoxTab}">
                    <GroupBox.Header>
                        <Grid Width="{Binding ElementName=gbPosion, Path=ActualWidth}" Height="36">
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Text="{lang:Lang Key={x:Static lang:LangKeys.PosionMotionPremise}}" />
                            <Button
                                Margin="0,0,24,0"
                                HorizontalAlignment="Right"
                                hc:IconElement.Geometry="{StaticResource AddGeometry}"
                                Command="{Binding AddPosionSafeCommand}"
                                CommandParameter="{Binding CurrentPosion}"
                                Style="{StaticResource ButtonDanger.Small}" />
                        </Grid>
                    </GroupBox.Header>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding PosionSafeRegions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="5"
                                        Background="{DynamicResource RegionBrush}"
                                        CornerRadius="5">
                                        <Grid Margin="5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <Grid MinHeight="28">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Padding="5,2"
                                                    HorizontalAlignment="Right"
                                                    hc:IconElement.Geometry="{StaticResource RemoveGeometry}"
                                                    Command="{Binding Path=DataContext.RemovePosionSafeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource ButtonDanger.Small}"
                                                    Visibility="{Binding Path=DataContext.SysRole, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource RoleVisibilityConverter}, ConverterParameter=Admin}" />
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="55" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="55" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Text="{lang:Lang Key={x:Static lang:LangKeys.MinPosition}}" />
                                                <hc:NumericUpDown
                                                    Grid.Column="1"
                                                    Margin="5,0,0,0"
                                                    IsEnabled="{Binding Path=DataContext.SysRole, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource RoleEnabledCoverter}, ConverterParameter=Admin}"
                                                    Value="{Binding Min}" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{lang:Lang Key={x:Static lang:LangKeys.MaxPosition}}" />
                                                <hc:NumericUpDown
                                                    Grid.Column="3"
                                                    Margin="5,0,0,0"
                                                    IsEnabled="{Binding Path=DataContext.SysRole, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource RoleEnabledCoverter}, ConverterParameter=Admin}"
                                                    Value="{Binding Max}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</Border>
