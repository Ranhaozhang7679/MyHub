<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.Virtual.VIOSimulationContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Virtual"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="1024"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="hc:IconElement.Height" Value="12" />
            <Setter Property="hc:IconElement.Width" Value="12" />
            <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Margin="2,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <hc:SearchBar
                x:Name="txtSearch"
                Width="200"
                HorizontalAlignment="Left"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.ModuleOrName}}"
                Command="{Binding SearchCommand}"
                CommandParameter="{Binding ElementName=txtSearch, Path=Text}"
                Style="{StaticResource SearchBarExtend}" />

        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox
                Padding="0"
                hc:TitleElement.Background="{DynamicResource RegionBrush}"
                Header="{lang:Lang Key={x:Static lang:LangKeys.DeviceList}}"
                Style="{StaticResource GroupBoxTab}">
                <DataGrid
                    Padding="-5"
                    hc:DataGridAttach.ShowRowNumber="False"
                    hc:DataGridAttach.ShowSelectAllButton="False"
                    AlternationCount="2"
                    AutoGenerateColumns="False"
                    ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                    HeadersVisibility="Column"
                    IsReadOnly="False"
                    ItemsSource="{Binding SimModels}"
                    RowStyle="{StaticResource CustomDataGridRowStyle}"
                    SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="120"
                            MinWidth="110"
                            Binding="{Binding Module}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="80"
                            Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.Name}}" />
                        <DataGridTemplateColumn
                            Width="130"
                            MinWidth="120"
                            hc:TitleElement.HorizontalAlignment="Center"
                            CanUserResize="False"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.Operation}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <hc:ElementGroup
                                        HorizontalContentAlignment="Center"
                                        Layout="Uniform"
                                        Orientation="Horizontal">
                                        <Button
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.AddActionCommand}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.Add}}"
                                            Style="{StaticResource ButtonPrimary.Small}" />
                                        <Button
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.RemoveCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.Delete}}"
                                            Style="{StaticResource ButtonDanger.Small}" />
                                    </hc:ElementGroup>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="SelectionChanged">
                            <hc:EventToCommand Command="{Binding SelectedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </DataGrid>
            </GroupBox>
            <GridSplitter
                Grid.Column="1"
                Width="3"
                Margin="2"
                HorizontalAlignment="Stretch" />
            <GroupBox
                Grid.Column="2"
                Padding="10,5"
                hc:TitleElement.Background="{DynamicResource RegionBrush}"
                Header="{lang:Lang Key={x:Static lang:LangKeys.ActionArea}}"
                Style="{StaticResource GroupBoxTab}">
                <hc:ScrollViewer>
                    <ItemsControl ItemsSource="{Binding ActionModels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <hc:UniformSpacingPanel
                                    VerticalAlignment="Top"
                                    ChildWrapping="Wrap"
                                    ScrollViewer.VerticalScrollBarVisibility="Visible" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="430"
                                    Margin="5,10"
                                    BorderBrush="{StaticResource EditorSelectionBorder}"
                                    BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Grid
                                            Height="40"
                                            Margin="0"
                                            Background="{StaticResource RegionBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Padding="5,0"
                                                VerticalAlignment="Center"
                                                hc:InfoElement.Necessary="True"
                                                hc:InfoElement.Placeholder="动作名称"
                                                hc:TitleElement.TitlePlacement="Left"
                                                FontSize="18"
                                                Foreground="Red"
                                                Text="{Binding Action}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <CheckBox
                                                    Width="90"
                                                    Content="{lang:Lang Key={x:Static lang:LangKeys.NeedHome}}"
                                                    Foreground="Red"
                                                    IsChecked="{Binding IsHome}"
                                                    IsEnabled="False" />
                                                <CheckBox
                                                    Width="60"
                                                    Margin="5,0"
                                                    Content="{lang:Lang Key={x:Static lang:LangKeys.Detector}}"
                                                    Foreground="Red"
                                                    IsChecked="{Binding IsCheck}"
                                                    IsEnabled="False" />
                                            </StackPanel>
                                            <hc:ButtonGroup
                                                Grid.Column="2"
                                                Margin="5,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                                <Button
                                                    hc:IconElement.Geometry="{StaticResource RemoveGeometry}"
                                                    Command="{Binding DataContext.RemoveActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding .}" />
                                                <Button
                                                    hc:IconElement.Geometry="{StaticResource EditGeometry}"
                                                    hc:IconElement.Height="14"
                                                    Command="{Binding DataContext.EditActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding .}" />
                                                <Button
                                                    hc:IconElement.Geometry="{StaticResource RunAllGeometry}"
                                                    hc:IconElement.Height="16"
                                                    Command="{Binding DataContext.RunActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding .}"
                                                    Visibility="{Binding IsCheck, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                                            </hc:ButtonGroup>
                                        </Grid>
                                        <DataGrid
                                            Grid.Row="1"
                                            hc:DataGridAttach.ShowRowNumber="False"
                                            hc:DataGridAttach.ShowSelectAllButton="False"
                                            AlternationCount="2"
                                            ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                                            HeadersVisibility="Column"
                                            IsReadOnly="False"
                                            ItemsSource="{Binding Actions}"
                                            RowStyle="{StaticResource CustomDataGridRowStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn
                                                    Width="*"
                                                    MinWidth="100"
                                                    Binding="{Binding IO.Name}"
                                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                                    Header="{lang:Lang Key={x:Static lang:LangKeys.IOName}}"
                                                    HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                                                    IsReadOnly="True" />
                                                <DataGridTemplateColumn
                                                    Width="60"
                                                    MinWidth="60"
                                                    Header="{lang:Lang Key={x:Static lang:LangKeys.Value}}"
                                                    HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                                                    IsReadOnly="True">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ToggleButton
                                                                HorizontalAlignment="Center"
                                                                IsChecked="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Style="{StaticResource ToggleButtonSwitch}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn
                                                    Width="100"
                                                    MinWidth="80"
                                                    Header="{lang:Lang Key={x:Static lang:LangKeys.Operation}}"
                                                    HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                                                    IsReadOnly="True">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <hc:ButtonGroup>
                                                                <Button
                                                                    Height="20"
                                                                    Padding="2"
                                                                    Command="{Binding DataContext.TopActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding .}"
                                                                    Content="{lang:Lang Key={x:Static lang:LangKeys.Up}}" />
                                                                <Button
                                                                    Height="20"
                                                                    Padding="2"
                                                                    Command="{Binding DataContext.BottomActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding .}"
                                                                    Content="{lang:Lang Key={x:Static lang:LangKeys.Down}}" />
                                                            </hc:ButtonGroup>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </hc:ScrollViewer>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
