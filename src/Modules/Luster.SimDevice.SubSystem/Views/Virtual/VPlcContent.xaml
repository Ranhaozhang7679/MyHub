<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.Virtual.VPlcContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:Luster.SimDevice.SubSystem.Extension"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Virtual"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converter:NumberToboolConverter x:Key="NumberToboolConverter" />
        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
            <Setter Property="Width" Value="70" />
            <Setter Property="hc:IconElement.Height" Value="12" />
            <Setter Property="hc:IconElement.Width" Value="12" />
            <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        </Style>
        <Style BasedOn="{StaticResource NumericUpDownPlus}" TargetType="hc:NumericUpDown">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource ComboBoxExtend}" TargetType="hc:ComboBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource TextBoxExtendBaseStyle}" TargetType="TextBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10,5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <GroupBox
            Padding="0"
            hc:TitleElement.Background="{DynamicResource RegionBrush}"
            Header="{lang:Lang Key={x:Static lang:LangKeys.DeviceList}}"
            Style="{StaticResource GroupBoxTab}">
            <ListBox
                Background="Transparent"
                ItemsSource="{Binding VPlcDevices}"
                Style="{DynamicResource ListBoxCustom}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <hc:UniformSpacingPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            ChildWrapping="Wrap" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0"
                            Padding="5"
                            Background="{DynamicResource RegionBrush}"
                            BorderBrush="{DynamicResource RegionBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                            <StackPanel Margin="5,10">
                                <hc:ComboBox
                                    Height="30"
                                    VerticalAlignment="Center"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Placeholder="选择隶属模组"
                                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                                    hc:InfoElement.TitleWidth="110"
                                    ItemsSource="{Binding Path=DataContext.Modules, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    SelectedValue="{Binding Module}" />
                                <TextBox
                                    Margin="0,10"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Placeholder="设备名称"
                                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                                    hc:InfoElement.TitleWidth="110"
                                    Text="{Binding Name}" />
                                <ComboBox
                                    hc:InfoElement.TitleWidth="110"
                                    hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Protocol}}"
                                    hc:TitleElement.TitlePlacement="Left"
                                    DisplayMemberPath="Desc"
                                    ItemsSource="{Binding Path=DataContext.Protocols, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    SelectedValue="{Binding ProtocolType}"
                                    SelectedValuePath="Value"
                                    Style="{StaticResource ComboBoxExtendBaseStyle}" />
                                <ComboBox
                                    Margin="0,10"
                                    hc:InfoElement.TitleWidth="110"
                                    hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.EndianType}}"
                                    hc:TitleElement.TitlePlacement="Left"
                                    DisplayMemberPath="Desc"
                                    ItemsSource="{Binding Path=DataContext.EndianTypes, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    SelectedValue="{Binding EndianType}"
                                    SelectedValuePath="Value"
                                    Style="{StaticResource ComboBoxExtendBaseStyle}" />
                                <TextBox
                                    hc:InfoElement.TitleWidth="110"
                                    hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Communcation}}"
                                    hc:TitleElement.TitlePlacement="Left"
                                    IsReadOnly="True"
                                    Text="{Binding PlcComm, Converter={StaticResource Object2StringConverter}}">
                                    <TextBox.InputBindings>
                                        <MouseBinding
                                            Command="{Binding DataContext.EditCommuncationCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}}"
                                            CommandParameter="{Binding .}"
                                            MouseAction="LeftDoubleClick" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <hc:NumericUpDown
                                    Margin="0,10"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Placeholder="刷新频率"
                                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Frequency}}"
                                    hc:InfoElement.TitleWidth="110"
                                    Minimum="0"
                                    Value="{Binding Frequency}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="启用监控" />
                                    <ToggleButton
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        IsChecked="{Binding IsMonitor}"
                                        Style="{StaticResource ToggleButtonSwitch}" />
                                </Grid>
                                <hc:ElementGroup Margin="0,10,0,0">
                                    <hc:ElementGroup.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                            </Grid>
                                        </ItemsPanelTemplate>
                                    </hc:ElementGroup.ItemsPanel>
                                    <Button
                                        Grid.Column="0"
                                        Width="100"
                                        Command="{Binding Path=DataContext.BatchImportCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding .}"
                                        Content="{lang:Lang Key={x:Static lang:LangKeys.Inport}}" />
                                    <Button
                                        Grid.Column="1"
                                        Command="{Binding Path=DataContext.BatchExportCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding .}"
                                        Content="{lang:Lang Key={x:Static lang:LangKeys.Export}}" />
                                    <Button
                                        Grid.Column="2"
                                        Command="{Binding Path=DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding .}"
                                        Content="{lang:Lang Key={x:Static lang:LangKeys.Delete}}" />
                                </hc:ElementGroup>
                                <hc:ElementGroup Margin="0,10,0,0">
                                    <hc:ElementGroup.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                            </Grid>
                                        </ItemsPanelTemplate>
                                    </hc:ElementGroup.ItemsPanel>
                                    <Button
                                        Grid.Column="0"
                                        Width="100"
                                        Command="{Binding Path=DataContext.AddAddressCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding .}"
                                        Content="{lang:Lang Key={x:Static lang:LangKeys.AddAddress}}" />
                                    <Button
                                        Grid.Column="1"
                                        Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding .}"
                                        Content="{lang:Lang Key={x:Static lang:LangKeys.Connect}}" />
                                    <Button
                                        Grid.Column="2"
                                        Command="{Binding Path=DataContext.ReadAllCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding .}"
                                        Content="{lang:Lang Key={x:Static lang:LangKeys.ReadAll}}"
                                        IsEnabled="{Binding IsConnect}" />
                                </hc:ElementGroup>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListBoxItemBaseStyle}" TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,10" />
                        <Setter Property="Padding" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" Value="Transparent" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Background" Value="Transparent" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="SelectionChanged">
                        <hc:EventToCommand Command="{Binding SelectCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}, Path=SelectedItem}" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </ListBox>
        </GroupBox>
        <GridSplitter
            Grid.Column="1"
            Width="3"
            Margin="3,0"
            HorizontalAlignment="Stretch" />
        <GroupBox
            Grid.Column="2"
            Padding="0"
            hc:TitleElement.Background="{DynamicResource RegionBrush}"
            Header="{lang:Lang Key={x:Static lang:LangKeys.AddressList}}"
            Style="{StaticResource GroupBoxTab}">
            <DataGrid
                Grid.Row="1"
                Padding="-5"
                hc:DataGridAttach.ShowRowNumber="False"
                hc:DataGridAttach.ShowSelectAllButton="False"
                AlternationCount="2"
                AutoGenerateColumns="False"
                ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                HeadersVisibility="Column"
                IsReadOnly="False"
                ItemsSource="{Binding AddressItems}"
                RowStyle="{StaticResource CustomDataGridRowStyle}"
                SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="110"
                        MinWidth="100"
                        Binding="{Binding Address}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Address}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="True" />
                    <DataGridComboBoxColumn
                        Width="110"
                        MinWidth="100"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.DataType}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="DisplayMemberPath" Value="Desc" />
                                <Setter Property="SelectedValuePath" Value="Value" />
                                <Setter Property="ItemsSource" Value="{Binding Path=DataContext.DataTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                <Setter Property="SelectedValue" Value="{Binding DataType, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="DisplayMemberPath" Value="Desc" />
                                <Setter Property="SelectedValuePath" Value="Value" />
                                <Setter Property="ItemsSource" Value="{Binding Path=DataContext.DataTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                <Setter Property="SelectedValue" Value="{Binding DataType}" />
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>
                    </DataGridComboBoxColumn>
                    <DataGridComboBoxColumn
                        Width="110"
                        MinWidth="100"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.ReadOrWrite}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="DisplayMemberPath" Value="Desc" />
                                <Setter Property="SelectedValuePath" Value="Value" />
                                <Setter Property="ItemsSource" Value="{Binding Path=DataContext.PlcAddrTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                <Setter Property="SelectedValue" Value="{Binding AddrType, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="DisplayMemberPath" Value="Desc" />
                                <Setter Property="SelectedValuePath" Value="Value" />
                                <Setter Property="ItemsSource" Value="{Binding Path=DataContext.PlcAddrTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                <Setter Property="SelectedValue" Value="{Binding AddrType}" />
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>
                    </DataGridComboBoxColumn>
                    <DataGridTemplateColumn
                        Width="110"
                        MinWidth="100"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.DataValue}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Background="Transparent"
                                    IsEnabled="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Value}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataType}" Value="Bool">
                                                    <Setter Property="Text" Value="{Binding Value, Converter={StaticResource NumberToboolConverter}}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding Desc}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.AddressDescription}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                    <DataGridTemplateColumn
                        Width="80"
                        MinWidth="70"
                        hc:TitleElement.HorizontalAlignment="Center"
                        CanUserResize="False"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Operation}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.RemoveAddressCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}"
                                    Content="{lang:Lang Key={x:Static lang:LangKeys.Delete}}"
                                    Style="{StaticResource ButtonDanger.Small}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
