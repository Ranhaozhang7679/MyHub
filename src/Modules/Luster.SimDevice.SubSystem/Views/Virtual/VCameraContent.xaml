<Border
    x:Class="Luster.SimDevice.SubSystem.Views.Virtual.VCameraContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Virtual"
    xmlns:m="clr-namespace:Luster.SimDevice.EngineUI.Models;assembly=Luster.SimDevice.EngineUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pg="clr-namespace:Luster.Common.Assets.ParamGrid;assembly=Luster.Common.Assets"
    xmlns:prism="http://prismlibrary.com/"
    MinWidth="800"
    d:DesignHeight="600"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    CornerRadius="10"
    mc:Ignorable="d">
    <Border.Resources>
        <Style BasedOn="{StaticResource ComboBoxExtend}" TargetType="hc:ComboBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="55" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        </Style>
    </Border.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="250" />
            <RowDefinition Height="5" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <GroupBox
            Grid.Row="0"
            hc:TitleElement.Background="{DynamicResource RegionBrush}"
            Header="{lang:Lang Key={x:Static lang:LangKeys.DeviceList}}"
            Style="{StaticResource GroupBoxTab}">
            <Grid>
                <DataGrid
                    Padding="-5"
                    AlternationCount="2"
                    ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                    HeadersVisibility="Column"
                    ItemsSource="{Binding VCameraModels}"
                    RowStyle="{StaticResource CustomDataGridRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="120"
                            MinWidth="100"
                            Binding="{Binding Module}"
                            CanUserSort="False"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}" />
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="100"
                            Binding="{Binding Name}"
                            CanUserSort="False"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.Name}}" />
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="100"
                            Binding="{Binding CameraName}"
                            CanUserSort="False"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.Camera}}" />
                        <DataGridTextColumn
                            Width="200"
                            MinWidth="150"
                            Binding="{Binding CameraSerialNumber}"
                            CanUserSort="False"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.SerialNumber}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTextColumn
                            Width="150"
                            MinWidth="90"
                            Binding="{Binding LightName}"
                            CanUserSort="False"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.LightController}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTextColumn
                            Width="120"
                            MinWidth="120"
                            Binding="{Binding ChannelCount}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.ChannelCount}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                        <DataGridTemplateColumn
                            Width="110"
                            MinWidth="100"
                            hc:TitleElement.HorizontalAlignment="Center"
                            CanUserResize="False"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.Operation}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <hc:ElementGroup HorizontalContentAlignment="Center" Orientation="Horizontal">
                                        <Button
                                            Margin="0"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.RemoveCommand}"
                                            CommandParameter="{Binding}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.Delete}}"
                                            Style="{StaticResource ButtonDanger.Small}" />
                                    </hc:ElementGroup>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="SelectionChanged">
                            <hc:EventToCommand Command="{Binding SelectedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </DataGrid>
            </Grid>
        </GroupBox>
        <GridSplitter
            Grid.Row="1"
            Height="5"
            Margin="0,2"
            HorizontalAlignment="Stretch" />
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox
                Grid.Row="0"
                Padding="5"
                hc:TitleElement.Background="{DynamicResource RegionBrush}"
                Header="{lang:Lang Key={x:Static lang:LangKeys.CameraConfigutation}}"
                Style="{StaticResource GroupBoxTab}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource BorderRegion}">
                        <pg:PropertyGrid IsGroup="False" SelectedObject="{Binding PropertyObj}" />
                    </Border>
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Stretch"
                        Orientation="Horizontal">
                        <Button
                            Width="70"
                            Margin="0,0,2,0"
                            Padding="4,6"
                            HorizontalAlignment="Right"
                            hc:IconElement.Geometry="{StaticResource ApplyGeometry}"
                            Command="{Binding OpenCameraCommand}"
                            Content="{lang:Lang Key={x:Static lang:LangKeys.Open}}" />
                        <Button
                            Width="70"
                            Margin="0,0,2,0"
                            Padding="4,6"
                            HorizontalAlignment="Right"
                            hc:IconElement.Geometry="{StaticResource ApplyGeometry}"
                            Command="{Binding StartGrabCommand}"
                            Content="{lang:Lang Key={x:Static lang:LangKeys.Grab}}" />
                        <Button
                            Width="70"
                            Margin="0,0,5,0"
                            Padding="4,6"
                            HorizontalAlignment="Right"
                            hc:IconElement.Geometry="{StaticResource ApplyGeometry}"
                            Command="{Binding ShotScreenCommand}"
                            Content="{lang:Lang Key={x:Static lang:LangKeys.Shot}}" />
                        <Button
                            Width="70"
                            Margin="0,0,2,0"
                            Padding="4,6"
                            HorizontalAlignment="Right"
                            hc:IconElement.Geometry="{StaticResource ApplyGeometry}"
                            Command="{Binding CloseCameraCommand}"
                            Content="{lang:Lang Key={x:Static lang:LangKeys.Close}}" />
                        <Button
                            Width="70"
                            Margin="0,0,2,0"
                            Padding="4,6"
                            HorizontalAlignment="Right"
                            hc:IconElement.Geometry="{StaticResource ApplyGeometry}"
                            Command="{Binding ApplyCameraCommand}"
                            Content="{lang:Lang Key={x:Static lang:LangKeys.Open}}" />
                    </StackPanel>
                </Grid>
            </GroupBox>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="90" />
                </Grid.RowDefinitions>
                <GroupBox
                    Grid.Row="0"
                    Margin="5,0"
                    Padding="5"
                    hc:TitleElement.Background="{DynamicResource RegionBrush}"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.LightConfigutation}}"
                    Style="{StaticResource GroupBoxTab}">
                    <StackPanel Background="{DynamicResource RegionBrush}">
                        <hc:NumericUpDown
                            Margin="5"
                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.LightDelayToOff}}"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:InfoElement.TitleWidth="135"
                            Style="{DynamicResource NumericUpDownExtend}"
                            Value="{Binding SelectedVCameraModel.DelayTime, UpdateSourceTrigger=PropertyChanged}" />
                        <ListBox
                            Padding="5"
                            BorderThickness="0"
                            ItemsSource="{Binding LightModels}"
                            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Style="{StaticResource ListBoxCustom}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5,5" Background="{DynamicResource RegionBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.5*" />
                                            <ColumnDefinition Width="0.5*" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <hc:NumericUpDown
                                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Channel}}"
                                            hc:InfoElement.TitleWidth="60"
                                            Minimum="1"
                                            Value="{Binding ChannelId}">
                                            <hc:NumericUpDown.Style>
                                                <Style BasedOn="{StaticResource NumericUpDownPlus}" TargetType="hc:NumericUpDown">
                                                    <Setter Property="hc:InfoElement.TitleWidth" Value="35" />
                                                    <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
                                                </Style>
                                            </hc:NumericUpDown.Style>
                                        </hc:NumericUpDown>
                                        <hc:TextBox
                                            Grid.Column="1"
                                            Margin="5,0"
                                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Brightness}}"
                                            hc:InfoElement.TitlePlacement="Left"
                                            hc:InfoElement.TitleWidth="70"
                                            Text="{Binding ElementName=IntensitySlider, Path=Value}" />
                                        <Slider
                                            x:Name="IntensitySlider"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True"
                                            Maximum="255"
                                            Minimum="0"
                                            Value="{Binding Intensity}">
                                            <hc:Interaction.Triggers>
                                                <hc:EventTrigger EventName="ValueChanged">
                                                    <hc:EventToCommand Command="{Binding Path=DataContext.SetIntensityCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=DataContext}" />
                                                </hc:EventTrigger>
                                            </hc:Interaction.Triggers>
                                        </Slider>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </GroupBox>
                <GroupBox
                    Grid.Row="1"
                    Margin="5,5,5,0"
                    Padding="5"
                    hc:TitleElement.Background="{DynamicResource RegionBrush}"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.OtherConfigutation}}"
                    Style="{StaticResource GroupBoxTab}">
                    <Grid Background="{DynamicResource RegionBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <hc:TextBox
                            Margin="5"
                            hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.SelectOfflineImage}}"
                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.OfflineImage}}"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:InfoElement.TitleWidth="70"
                            Text="{Binding SelectedVCameraModel.ImagePath}" />
                        <Button
                            Grid.Column="1"
                            Width="80"
                            Margin="0,0,5,5"
                            Padding="4,6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            hc:IconElement.Geometry="{StaticResource ApplyGeometry}"
                            Command="{Binding SelectFileCommand}"
                            Content="{lang:Lang Key={x:Static lang:LangKeys.Browse}}" />
                    </Grid>
                </GroupBox>
            </Grid>
            <Border
                Grid.Column="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="5,5,0,0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource TextBlockDefaultBold}"
                        Text="{lang:Lang Key={x:Static lang:LangKeys.CameraWindow}}" />
                    <Border
                        Grid.Row="1"
                        Margin="0,5,0,0"
                        Background="{StaticResource BackgroundBrush}">
                        <hc:ImageViewer ImageSource="{Binding FrameData}" />


                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Border>
