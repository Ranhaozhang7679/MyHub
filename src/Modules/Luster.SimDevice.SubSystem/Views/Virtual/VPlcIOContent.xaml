<Border
    x:Class="Luster.SimDevice.SubSystem.Views.Virtual.VPlcIOContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:m="clr-namespace:Luster.SimDevice.EngineUI.Models;assembly=Luster.SimDevice.EngineUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    CornerRadius="10"
    mc:Ignorable="d">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  工具栏  -->
        <hc:UniformSpacingPanel
            Margin="0,0,0,8"
            HorizontalAlignment="Stretch"
            Orientation="Horizontal"
            Spacing="8">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="13"
                Text="仿真通信:" />
            <ComboBox
                Width="160"
                VerticalAlignment="Center"
                DisplayMemberPath="Name"
                ItemsSource="{Binding CommDevices}"
                SelectedItem="{Binding CurrentComm}">
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="SelectionChanged">
                        <hc:EventToCommand Command="{Binding CommSelectionChangedCommand}" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </ComboBox>

            <TextBlock
                VerticalAlignment="Center"
                FontSize="13"
                Text="刷新(ms):" />
            <hc:NumericUpDown
                Width="90"
                VerticalAlignment="Center"
                Minimum="100"
                Style="{StaticResource NumericUpDown.Small}"
                Value="{Binding Frequency}" />

            <ToggleButton
                VerticalAlignment="Center"
                Content="开启监控"
                IsChecked="{Binding IsMonitorOn, Mode=TwoWay}"
                Style="{StaticResource ToggleButtonFlip}" />

            <Button
                VerticalAlignment="Center"
                Command="{Binding ConnectCommand}"
                Content="连接"
                Style="{StaticResource ButtonPrimary.Small}"
                Visibility="{Binding IsConnected, Converter={StaticResource Boolean2VisibilityReConverter}}" />
            <Button
                VerticalAlignment="Center"
                Command="{Binding DisconnectCommand}"
                Content="断开"
                Style="{StaticResource ButtonDanger.Small}"
                Visibility="{Binding IsConnected, Converter={StaticResource Boolean2VisibilityConverter}}" />
        </hc:UniformSpacingPanel>

        <!--  Tab 栏：模块选择 + 导入导出 + Tab操作  -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,8"
            Padding="4"
            Background="{DynamicResource SecondaryRegionBrush}"
            CornerRadius="4">
            <DockPanel>
                <!--  右侧按钮组  -->
                <StackPanel
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <Button
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Command="{Binding BatchImportCommand}"
                        Content="导入"
                        Style="{StaticResource ButtonInfo.Small}" />
                    <Button
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Command="{Binding BatchExportCommand}"
                        Content="导出"
                        Style="{StaticResource ButtonInfo.Small}" />
                    <Button
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Command="{Binding ExportTemplateCommand}"
                        Content="导出模板"
                        Style="{StaticResource ButtonInfo.Small}" />

                    <Separator Margin="4,2" Width="1" Background="{DynamicResource BorderBrush}" />

                    <Button
                        Margin="0,0,2,0"
                        VerticalAlignment="Center"
                        Command="{Binding RenameTabCommand}"
                        Content="✎ 重命名"
                        Style="{StaticResource ButtonInfo.Small}" />
                    <Button
                        Margin="0,0,2,0"
                        VerticalAlignment="Center"
                        Command="{Binding RemoveTabCommand}"
                        Content="✕ 删除"
                        Style="{StaticResource ButtonDanger.Small}" />
                    <Button
                        VerticalAlignment="Center"
                        Command="{Binding AddTabCommand}"
                        Content="+ 添加模块"
                        Style="{StaticResource ButtonPrimary.Small}" />
                </StackPanel>

                <!--  Tab 头列表  -->
                <ListBox
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab}"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Center">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="12,4"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Text="{Binding TabName}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border
                                            x:Name="Bd"
                                            Padding="4,4"
                                            Margin="1,0"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0,0,0,2"
                                            CornerRadius="4"
                                            Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RegionBrush}" />
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RegionBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!--  左右分栏：输入 | 输出  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  输入区域  -->
            <GroupBox Header="输入">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  输入操作按钮  -->
                    <StackPanel
                        Margin="0,0,0,4"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Command="{Binding AddInputCommand}"
                            Content="+ 添加"
                            Style="{StaticResource ButtonInfo.Small}" />
                        <Button
                            VerticalAlignment="Center"
                            Command="{Binding DeleteInputCommand}"
                            Content="✕ 删除选中"
                            Style="{StaticResource ButtonDanger.Small}" />
                    </StackPanel>

                    <!--  输入 DataGrid  -->
                    <DataGrid
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        BorderThickness="1"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserResizeRows="False"
                        CellEditEnding="InputDataGrid_CellEditEnding"
                        HeadersVisibility="Column"
                        IsReadOnly="False"
                        ItemsSource="{Binding InputDatas}"
                        SelectedItem="{Binding SelectedInput}"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="Auto"
                                Binding="{Binding Index}"
                                Header="序号"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Address, UpdateSourceTrigger=LostFocus}"
                                Header="PLC地址" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                Header="名称" />
                            <DataGridTemplateColumn
                                Width="Auto"
                                Header="状态"
                                IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type m:PlcIOModel}">
                                        <Ellipse
                                            Width="16"
                                            Height="16"
                                            Margin="4,0"
                                            HorizontalAlignment="Center"
                                            Fill="{Binding BoolValue, Converter={StaticResource Boolean2PassColorCoverter}}"
                                            Stroke="{DynamicResource BorderBrush}"
                                            StrokeThickness="1" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GridSplitter
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource BorderBrush}" />

            <!--  输出区域  -->
            <GroupBox Grid.Column="2" Header="输出">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  输出操作按钮  -->
                    <StackPanel
                        Margin="0,0,0,4"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Command="{Binding AddOutputCommand}"
                            Content="+ 添加"
                            Style="{StaticResource ButtonInfo.Small}" />
                        <Button
                            VerticalAlignment="Center"
                            Command="{Binding DeleteOutputCommand}"
                            Content="✕ 删除选中"
                            Style="{StaticResource ButtonDanger.Small}" />
                    </StackPanel>

                    <!--  输出 DataGrid（点击圆圈切换 0/1）  -->
                    <DataGrid
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        BorderThickness="1"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserResizeRows="False"
                        CellEditEnding="OutputDataGrid_CellEditEnding"
                        HeadersVisibility="Column"
                        IsReadOnly="False"
                        ItemsSource="{Binding OutputDatas}"
                        SelectedItem="{Binding SelectedOutput}"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="Auto"
                                Binding="{Binding Index}"
                                Header="序号"
                                IsReadOnly="True" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Address, UpdateSourceTrigger=LostFocus}"
                                Header="PLC地址" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                Header="名称" />
                            <DataGridTemplateColumn
                                Width="Auto"
                                Header="状态操作"
                                IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type m:PlcIOModel}">
                                        <Border
                                            Background="Transparent"
                                            Cursor="Hand"
                                            ToolTip="点击切换 0/1">
                                            <Ellipse
                                                Width="20"
                                                Height="20"
                                                Margin="4,0"
                                                HorizontalAlignment="Center"
                                                Fill="{Binding BoolValue, Converter={StaticResource Boolean2PassColorCoverter}}"
                                                Stroke="{DynamicResource BorderBrush}"
                                                StrokeThickness="1.5" />
                                            <hc:Interaction.Triggers>
                                                <hc:EventTrigger EventName="MouseLeftButtonUp">
                                                    <hc:EventToCommand Command="{Binding DataContext.ToggleOutputCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                                </hc:EventTrigger>
                                            </hc:Interaction.Triggers>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </Grid>

        <!--  底部分页  -->
        <Grid Grid.Row="3" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <hc:Pagination
                Margin="5,0"
                HorizontalAlignment="Left"
                AutoHiding="False"
                DataCountPerPage="{Binding InputPerPageCount, Mode=TwoWay}"
                IsJumpEnabled="False"
                MaxPageCount="{Binding InputPageCount}"
                MaxPageInterval="10"
                PageIndex="{Binding InputPageIndex, Mode=TwoWay}">
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="PageUpdated">
                        <hc:EventToCommand Command="{Binding PageUpdatedCommand}" CommandParameter="Input" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </hc:Pagination>
            <hc:Pagination
                Grid.Column="1"
                Margin="5,0"
                HorizontalAlignment="Right"
                AutoHiding="False"
                DataCountPerPage="{Binding OutputPerPageCount, Mode=TwoWay}"
                IsJumpEnabled="False"
                MaxPageCount="{Binding OutputPageCount}"
                MaxPageInterval="10"
                PageIndex="{Binding OutputPageIndex, Mode=TwoWay}">
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="PageUpdated">
                        <hc:EventToCommand Command="{Binding PageUpdatedCommand}" CommandParameter="Output" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </hc:Pagination>
        </Grid>
    </Grid>
</Border>
