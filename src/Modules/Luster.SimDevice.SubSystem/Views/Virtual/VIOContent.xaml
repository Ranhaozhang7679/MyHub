<Border
    x:Class="Luster.SimDevice.SubSystem.Views.Virtual.VIOContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Virtual"
    xmlns:m="clr-namespace:Luster.SimDevice.EngineUI.Models;assembly=Luster.SimDevice.EngineUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    MinWidth="800"
    d:DesignHeight="600"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    CornerRadius="10"
    mc:Ignorable="d">
    <Border.Resources>
        <Style
            x:Key="DigitalStyle"
            BasedOn="{StaticResource ToggleButtonFlip.Small}"
            TargetType="ToggleButton">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!--  数字量输入模板  -->
        <DataTemplate x:Key="DigitalInTemplate" DataType="{x:Type m:IOModel}">
            <Border
                Name="BorderItem"
                Height="30"
                Margin="2"
                Padding="5,1"
                BorderThickness="0"
                MouseRightButtonDown="BorderItem_MouseRightButtonDown1"
                Style="{StaticResource BorderRegion}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="20" />
                    </Grid.ColumnDefinitions>
                    <Border HorizontalAlignment="Left">
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Text="{Binding Index, StringFormat={}X{0}}" />
                    </Border>

                    <TextBlock
                        Grid.Column="1"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{DynamicResource InfoBrush}"
                        Text="{Binding SubDefinite}" />

                    <TextBlock
                        Grid.Column="2"
                        Margin="5,2"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="{Binding Name}"
                        ToolTip="{Binding Name}"
                        Visibility="{Binding IsSelected, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                    <TextBox
                        Grid.Column="2"
                        Width="180"
                        MaxHeight="22"
                        Style="{StaticResource TextBoxExtend.Small}"
                        Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding IsSelected, Converter={StaticResource Boolean2VisibilityConverter}}" />
                    <ToggleButton
                        Grid.Column="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        IsChecked="{Binding DigitalValue}"
                        IsEnabled="{Binding Path=DataContext.IsReal, Converter={StaticResource Boolean2BooleanReConverter}, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}}"
                        Style="{StaticResource DigitalStyle}">
                        <hc:StatusSwitchElement.CheckedElement>
                            <Border Background="Green" />
                        </hc:StatusSwitchElement.CheckedElement>
                        <Border Background="Gray" />
                    </ToggleButton>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="BorderItem" Property="Border.BorderBrush" Value="Green" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  数字量输出模板  -->
        <DataTemplate x:Key="DigitalOutTemplate" DataType="{x:Type m:IOModel}">
            <Border
                x:Name="BorderItem1"
                Height="30"
                Margin="2"
                Padding="5,1"
                BorderThickness="0"
                MouseRightButtonDown="BorderItem_MouseRightButtonDown"
                Style="{StaticResource BorderRegion}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="20" />
                    </Grid.ColumnDefinitions>
                    <Border HorizontalAlignment="Left">
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Text="{Binding Index, StringFormat={}Y{0}}" />
                    </Border>

                    <TextBlock
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{DynamicResource InfoBrush}"
                        Text="{Binding SubDefinite}" />

                    <TextBlock
                        Grid.Column="2"
                        Margin="5,2"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="{Binding Name}"
                        ToolTip="{Binding Name}"
                        Visibility="{Binding IsSelected, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                    <TextBox
                        Grid.Column="2"
                        Width="180"
                        MaxHeight="22"
                        Style="{StaticResource TextBoxExtend.Small}"
                        Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding IsSelected, Converter={StaticResource Boolean2VisibilityConverter}}" />
                    <ToggleButton
                        Grid.Column="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        IsChecked="{Binding DigitalValue}"
                        Style="{StaticResource DigitalStyle}">
                        <hc:StatusSwitchElement.CheckedElement>
                            <Border Background="Green" />
                        </hc:StatusSwitchElement.CheckedElement>
                        <Border Background="Gray" />
                    </ToggleButton>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="BorderItem1" Property="Border.BorderBrush" Value="Green" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  模拟量输入模板  -->
        <DataTemplate x:Key="AnalogInTemplate" DataType="{x:Type m:IOModel}">
            <Border
                x:Name="BorderItem"
                Margin="2"
                Padding="5,4"
                BorderThickness="1"
                MouseLeftButtonDown="BorderItem_MouseLeftButtonDown"
                MouseRightButtonDown="BorderItem_MouseRightButtonDown_AnalogIn"
                Style="{StaticResource BorderRegion}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Border HorizontalAlignment="Left">
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Text="{Binding Index, StringFormat={}Ai{0}}" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{Binding Name}"
                        ToolTip="{Binding Name}"
                        Visibility="{Binding IsSelected, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                    <TextBox
                        Grid.Column="1"
                        Width="200"
                        MaxHeight="22"
                        Style="{StaticResource TextBoxExtend.Small}"
                        Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding IsSelected, Converter={StaticResource Boolean2VisibilityConverter}}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryBrush}"
                        Text="{Binding AnalogValue}" />
                    <hc:ElementGroup Grid.Column="3" Margin="5,0,0,0">
                        <hc:ElementGroup.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </ItemsPanelTemplate>
                        </hc:ElementGroup.ItemsPanel>
                        <TextBox
                            MinWidth="170"
                            IsReadOnly="True"
                            Text="{Binding Express}" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding Path=DataContext.ConfigCommand, ElementName=GridIO}"
                            CommandParameter="{Binding .}"
                            Content="配置"
                            Style="{StaticResource ButtonPrimary}" />
                    </hc:ElementGroup>
                    <TextBlock
                        Grid.Column="4"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding FinalValue}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="BorderItem" Property="BorderThickness" Value="2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  模拟量输出模板  -->
        <DataTemplate x:Key="AnalogOutTemplate" DataType="{x:Type m:IOModel}">
            <Border
                x:Name="BorderItem"
                Margin="2"
                Padding="5,4"
                BorderThickness="1"
                MouseLeftButtonDown="BorderItem_MouseLeftButtonDown"
                MouseRightButtonDown="BorderItem_MouseRightButtonDown_AnalogOut"
                Style="{StaticResource BorderRegion}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Border HorizontalAlignment="Left">
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Text="{Binding Index, StringFormat={}Ao{0}}" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{Binding Name}"
                        ToolTip="{Binding Name}"
                        Visibility="{Binding IsSelected, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                    <TextBox
                        Grid.Column="1"
                        Width="200"
                        MaxHeight="22"
                        Style="{StaticResource TextBoxExtend.Small}"
                        Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding IsSelected, Converter={StaticResource Boolean2VisibilityConverter}}" />
                    <hc:NumericUpDown
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Style="{StaticResource NumericUpDownExtend.Small}"
                        Value="{Binding AnalogValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <hc:ElementGroup Grid.Column="3" Margin="5,0,0,0">
                        <hc:ElementGroup.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </ItemsPanelTemplate>
                        </hc:ElementGroup.ItemsPanel>
                        <TextBox
                            MinWidth="170"
                            IsReadOnly="True"
                            Text="{Binding Express}" />
                        <Button
                            Grid.Column="1"
                            Command="{Binding Path=DataContext.ConfigCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid, AncestorLevel=2}}"
                            CommandParameter="{Binding .}"
                            Content="配置"
                            Style="{StaticResource ButtonPrimary}" />
                    </hc:ElementGroup>
                    <TextBlock
                        Grid.Column="4"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding FinalValue}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="BorderItem" Property="BorderBrush" Value="Green" />
                    <Setter TargetName="BorderItem" Property="BorderThickness" Value="2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <local:ValueTemplateSelector
            x:Key="IoTemplate"
            AnaInTemplate="{StaticResource AnalogInTemplate}"
            AnaOutTemplate="{StaticResource AnalogOutTemplate}"
            DigInTemplate="{StaticResource DigitalInTemplate}"
            DigOutTemplate="{StaticResource DigitalOutTemplate}" />

        <Style
            x:Key="cbkInSelectStyle"
            BasedOn="{StaticResource DataGridColumnHeaderStyle.Small}"
            TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <CheckBox
                            HorizontalAlignment="Center"
                            Command="{Binding Path=DataContext.SelectAllCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="Input"
                            IsChecked="{Binding Path=DataContext.IsInSelectAll, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="cbkOutSelectStyle"
            BasedOn="{StaticResource DataGridColumnHeaderStyle.Small}"
            TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <CheckBox
                            HorizontalAlignment="Center"
                            Command="{Binding Path=DataContext.SelectAllCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="Output"
                            IsChecked="{Binding Path=DataContext.IsOutSelectAll, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Border.Resources>
    <Grid x:Name="GridIO" Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    Name="combCard"
                    ItemsSource="{Binding Cards}"
                    SelectedValue="{Binding CurrentCard}">
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="SelectionChanged">
                            <hc:EventToCommand Command="{Binding ChangeCardCommand}" CommandParameter="{Binding ElementName=combCard, Path=SelectedItem}" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </ComboBox>
                <hc:ComboBox
                    x:Name="comModule"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                    ItemsSource="{Binding Modules}"
                    SelectedValue="{Binding Module}"
                    Style="{StaticResource ComboBoxValidationStyle}">
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="SelectionChanged">
                            <hc:EventToCommand Command="{Binding ChangeModuleCommand}" CommandParameter="{Binding ElementName=comModule, Path=SelectedItem}" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </hc:ComboBox>

                <hc:ComboBox
                    x:Name="comIo"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.IOType}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.IOType}}"
                    SelectedIndex="0"
                    Style="{StaticResource ComboBoxValidationStyle}">

                    <ComboBoxItem Content="{lang:Lang Key={x:Static lang:LangKeys.DigitalIO}}" Tag="Digital" />
                    <ComboBoxItem Content="{lang:Lang Key={x:Static lang:LangKeys.AnalogIO}}" Tag="Analog" />

                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="SelectionChanged">
                            <hc:EventToCommand Command="{Binding ChangeIOTypeCommand}" CommandParameter="{Binding ElementName=comIo, Path=SelectedItem}" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </hc:ComboBox>

            </StackPanel>
            <hc:ButtonGroup Grid.Column="1" Style="{StaticResource ButtonGroupSolid}">
                <Button
                    Margin="5,0,0,0"
                    Command="{Binding BatchImportCommand}"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Inport}}" />
                <Button
                    Margin="5,0,0,0"
                    Command="{Binding BatchExportCommand}"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Export}}" />
            </hc:ButtonGroup>
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <hc:ElementGroup Margin="0,0,10,0">
                    <hc:ElementGroup.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </ItemsPanelTemplate>
                    </hc:ElementGroup.ItemsPanel>
                    <Label Content="{lang:Lang Key={x:Static lang:LangKeys.Frequency}}" />
                    <hc:NumericUpDown
                        Name="txtRate"
                        Grid.Column="1"
                        Width="80"
                        Minimum="0"
                        Value="{Binding SpanTime}" />
                </hc:ElementGroup>

                <hc:SearchBar
                    x:Name="txtSearch"
                    Width="200"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.ModuleOrName}}"
                    Command="{Binding SearchCommand}"
                    Style="{StaticResource SearchBarExtend}"
                    Text="{Binding SearchParas}" />
            </StackPanel>
        </Grid>
        <Border
            Grid.Row="1"
            Padding="0"
            Background="{DynamicResource BorderBrush}"
            Style="{StaticResource BorderRegion}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <ListBox
                    Padding="0"
                    Background="Transparent"
                    ItemTemplateSelector="{StaticResource IoTemplate}"
                    ItemsSource="{Binding InputDatas}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    Style="{StaticResource ListBoxCustom}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <hc:UniformSpacingPanel
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                ChildWrapping="Wrap"
                                Orientation="Vertical"
                                ScrollViewer.VerticalScrollBarVisibility="Visible" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="Loaded">
                            <hc:EventToCommand Command="{Binding LoadedCommand}" PassEventArgsToCommand="True" />
                        </hc:EventTrigger>
                        <hc:EventTrigger EventName="SizeChanged">
                            <hc:EventToCommand Command="{Binding SizeChangedCommand}" PassEventArgsToCommand="True" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                
                <ListBox
                    Name="items"
                    Grid.Column="1"
                    Padding="0"
                    Background="Transparent"
                    ItemTemplateSelector="{StaticResource IoTemplate}"
                    ItemsSource="{Binding IoDatas}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    Style="{StaticResource ListBoxCustom}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <hc:UniformSpacingPanel
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                ChildWrapping="Wrap"
                                Orientation="Vertical"
                                ScrollViewer.VerticalScrollBarVisibility="Visible" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="Loaded">
                            <hc:EventToCommand Command="{Binding LoadedCommand}" PassEventArgsToCommand="True" />
                        </hc:EventTrigger>
                        <hc:EventTrigger EventName="SizeChanged">
                            <hc:EventToCommand Command="{Binding SizeChangedCommand}" PassEventArgsToCommand="True" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--<hc:ButtonGroup
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Style="{StaticResource ButtonGroupSolid}">
                <RadioButton
                    Command="{Binding ChangeIOTypeCommand}"
                    CommandParameter="Digital_In"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.DigitalIn}}"
                    IsChecked="{Binding IsDigitalIn}" />
                <RadioButton
                    Command="{Binding ChangeIOTypeCommand}"
                    CommandParameter="Digital_Out"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.DigitalOut}}"
                    IsChecked="{Binding IsDigitalOut}" />
                <RadioButton
                    Command="{Binding ChangeIOTypeCommand}"
                    CommandParameter="Anglog_In"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.AnalogIn}}"
                    IsChecked="{Binding IsAnalogIn}" />
                <RadioButton
                    Command="{Binding ChangeIOTypeCommand}"
                    CommandParameter="Anglog_Out"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.AnalogOut}}"
                    IsChecked="{Binding IsAnalogOut}" />
            </hc:ButtonGroup>-->

            <hc:Pagination
                Grid.Row="1"
                Margin="5,0"
                HorizontalAlignment="Left"
                AutoHiding="False"
                DataCountPerPage="{Binding PerPageCount2, Mode=TwoWay}"
                IsJumpEnabled="False"
                MaxPageCount="{Binding PageCount2}"
                MaxPageInterval="10"
                PageIndex="{Binding PageIndex2, Mode=TwoWay}">
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="PageUpdated">
                        <hc:EventToCommand Command="{Binding PageUpdatedCommand}" CommandParameter="Input" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </hc:Pagination>
            <hc:Pagination
                Grid.Column="1"
                Margin="5,0"
                HorizontalAlignment="Right"
                AutoHiding="False"
                DataCountPerPage="{Binding PerPageCount, Mode=TwoWay}"
                IsJumpEnabled="False"
                MaxPageCount="{Binding PageCount}"
                MaxPageInterval="10"
                PageIndex="{Binding PageIndex, Mode=TwoWay}">
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="PageUpdated">
                        <hc:EventToCommand Command="{Binding PageUpdatedCommand}" CommandParameter="Out" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </hc:Pagination>
        </Grid>
    </Grid>
</Border>
    