<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.Virtual.VPCylinderContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Virtual"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    MinWidth="600"
    d:DesignHeight="720"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
            <Setter Property="hc:IconElement.Height" Value="12" />
            <Setter Property="hc:IconElement.Width" Value="12" />
            <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        </Style>
        <Style BasedOn="{StaticResource TextBoxExtendBaseStyle}" TargetType="TextBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="100" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource TextBoxExtendBaseStyle}" TargetType="hc:TextBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="100" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource NumericUpDownPlus}" TargetType="hc:NumericUpDown">
            <Setter Property="hc:InfoElement.TitleWidth" Value="100" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource ComboBoxExtend}" TargetType="hc:ComboBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="100" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel Margin="2,5" Orientation="Horizontal">
            <hc:SearchBar
                x:Name="txtSearch"
                Width="250"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.ModuleOrName}}"
                Command="{Binding SearchCommand}"
                CommandParameter="{Binding ElementName=txtSearch, Path=Text}"
                Style="{StaticResource SearchBarExtend}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="600" />
            </Grid.ColumnDefinitions>
            <GroupBox
                Padding="0"
                hc:TitleElement.Background="{DynamicResource RegionBrush}"
                Header="{lang:Lang Key={x:Static lang:LangKeys.DeviceList}}"
                Style="{StaticResource GroupBoxTab}">
                <DataGrid
                    Padding="-5"
                    hc:DataGridAttach.ShowRowNumber="False"
                    hc:DataGridAttach.ShowSelectAllButton="False"
                    AlternationCount="2"
                    AutoGenerateColumns="False"
                    ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                    HeadersVisibility="Column"
                    IsReadOnly="False"
                    ItemsSource="{Binding Cylinders}"
                    RowStyle="{StaticResource CustomDataGridRowStyle}"
                    SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="85"
                            Binding="{Binding Module}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="120"
                            MinWidth="120"
                            Binding="{Binding Name}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                            IsReadOnly="False" />
                        <DataGridTextColumn
                            Width="60"
                            MinWidth="60"
                            Binding="{Binding AddrNo}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.StationNO}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                            IsReadOnly="False" />
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="100"
                            Binding="{Binding Communication, Converter={StaticResource Object2StringConverter}}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.Communcation}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                            IsReadOnly="True" />
                        <DataGridTemplateColumn
                            Width="160"
                            MinWidth="140"
                            hc:TitleElement.HorizontalAlignment="Center"
                            CanUserResize="False"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.Operation}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <hc:ElementGroup HorizontalContentAlignment="Center" Orientation="Horizontal">
                                        <Button
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.EditCommand}"
                                            CommandParameter="{Binding .}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.Edit}}"
                                            Style="{StaticResource ButtonWarning.Small}" />
                                        <Button
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.RemoveCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.Delete}}"
                                            Style="{StaticResource ButtonDanger.Small}" />
                                        <Button
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.AddPointPosCommand}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.Add}}"
                                            Style="{StaticResource ButtonPrimary.Small}" />
                                    </hc:ElementGroup>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="SelectionChanged">
                            <hc:EventToCommand Command="{Binding SelectedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </DataGrid>
            </GroupBox>
            <GridSplitter
                Grid.Column="1"
                Width="3"
                Margin="3,0"
                HorizontalAlignment="Stretch" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <GroupBox
                    Grid.ColumnSpan="2"
                    hc:TitleElement.Background="{DynamicResource RegionBrush}"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.CommuncationTest}}"
                    Style="{StaticResource GroupBoxTab}">
                    <hc:UniformSpacingPanel Orientation="Vertical">
                        <TextBox
                            Margin="5"
                            hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Communcation}}"
                            hc:TitleElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="100"
                            IsReadOnly="True"
                            Style="{StaticResource TextBoxExtendBaseStyle}"
                            Text="{Binding Communication, Converter={StaticResource Object2StringConverter}}">
                            <TextBox.InputBindings>
                                <MouseBinding Command="{Binding DataContext.EditCommuncationCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" MouseAction="LeftDoubleClick" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="109*" />
                                <ColumnDefinition Width="181*" />
                                <ColumnDefinition Width="290*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                Grid.ColumnSpan="2"
                                Margin="5,5,5,5"
                                hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Protocol}}"
                                hc:TitleElement.TitlePlacement="Left"
                                hc:TitleElement.TitleWidth="100"
                                DisplayMemberPath="Desc"
                                ItemsSource="{Binding Protocols}"
                                SelectedValue="{Binding ProtocolType}"
                                SelectedValuePath="Value"
                                Style="{StaticResource ComboBoxExtendBaseStyle}" />
                            <hc:ElementGroup
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Layout="Stack">
                                <Button Command="{Binding ConnectCommand}" Content="{lang:Lang Key={x:Static lang:LangKeys.Connect}}" />
                                <Button
                                    Command="{Binding CloseCommand}"
                                    Content="{lang:Lang Key={x:Static lang:LangKeys.Close}}"
                                    IsEnabled="{Binding IsConnected}" />
                                <Button
                                    Command="{Binding ClearErrorCommand}"
                                    Content="{lang:Lang Key={x:Static lang:LangKeys.ClearError}}"
                                    IsEnabled="{Binding IsConnected}" />
                                <Button
                                    Command="{Binding LoadCommand}"
                                    Content="{lang:Lang Key={x:Static lang:LangKeys.Load}}"
                                    IsEnabled="{Binding IsConnected}" />
                                <Button
                                    Command="{Binding HomeCommand}"
                                    Content="{lang:Lang Key={x:Static lang:LangKeys.HomeZero}}"
                                    IsEnabled="{Binding IsConnected}" />
                                <Button
                                    Command="{Binding SaveCommand}"
                                    Content="{lang:Lang Key={x:Static lang:LangKeys.Save}}"
                                    IsEnabled="{Binding IsConnected}" />
                            </hc:ElementGroup>
                        </Grid>
                    </hc:UniformSpacingPanel>
                </GroupBox>
                <GroupBox
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="0,5"
                    hc:TitleElement.Background="{DynamicResource RegionBrush}"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.Point}}"
                    IsEnabled="{Binding IsConnected}"
                    Style="{StaticResource GroupBoxTab}">
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding PointPosModels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,5"
                                        Padding="10,5"
                                        Background="{DynamicResource RegionBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5,5,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    Width="250"
                                                    VerticalAlignment="Center"
                                                    hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Point}}"
                                                    Text="{Binding PointNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TextWrapping="NoWrap"
                                                    ToolTip="{Binding PointNo}" />
                                                <hc:ComboBox
                                                    Grid.Column="1"
                                                    Width="250"
                                                    hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.MoveType}}"
                                                    DisplayMemberPath="Desc"
                                                    ItemsSource="{Binding DataContext.CmdTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    SelectedValue="{Binding CmdType}"
                                                    SelectedValuePath="Value" />
                                            </Grid>
                                            <Grid
                                                Grid.Row="1"
                                                Margin="0,5"
                                                Visibility="{Binding IsMove, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <hc:NumericUpDown
                                                    Width="250"
                                                    hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Acc}}"
                                                    Value="{Binding Acc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <hc:NumericUpDown
                                                    Grid.Column="1"
                                                    Width="250"
                                                    hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Dcc}}"
                                                    Value="{Binding Dec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                            <Grid Grid.Row="2" Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <hc:NumericUpDown
                                                    Width="250"
                                                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Speed}}"
                                                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Speed}}"
                                                    hc:InfoElement.TitlePlacement="Left"
                                                    DecimalPlaces="3"
                                                    Value="{Binding Speed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <hc:NumericUpDown
                                                    Grid.Column="1"
                                                    Width="250"
                                                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.LocationRange}}"
                                                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.LocationRange}}"
                                                    hc:InfoElement.TitlePlacement="Left"
                                                    DecimalPlaces="3"
                                                    Minimum="0.1"
                                                    Value="{Binding Range, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                            <Grid
                                                Grid.Row="3"
                                                Margin="0,5"
                                                Visibility="{Binding IsMove, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <hc:NumericUpDown
                                                    Width="250"
                                                    VerticalAlignment="Center"
                                                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Position}}"
                                                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Position}}"
                                                    hc:InfoElement.TitlePlacement="Left"
                                                    DecimalPlaces="2"
                                                    Value="{Binding Pos, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <hc:NumericUpDown
                                                    Grid.Column="1"
                                                    Width="250"
                                                    VerticalAlignment="Center"
                                                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.NextCommand}}"
                                                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.NextCommand}}"
                                                    hc:InfoElement.TitlePlacement="Left"
                                                    Value="{Binding Next, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                            <Grid
                                                Grid.Row="4"
                                                Margin="0,5"
                                                Visibility="{Binding IsMove, Converter={StaticResource Boolean2VisibilityReConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <hc:NumericUpDown
                                                    Grid.Column="0"
                                                    Width="250"
                                                    hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Pressure}}"
                                                    Value="{Binding Pressure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <hc:NumericUpDown
                                                    Grid.Column="1"
                                                    Width="250"
                                                    hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.PressDistance}}"
                                                    Value="{Binding PreDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                            <Grid Grid.Row="5" Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <hc:NumericUpDown
                                                    Width="250"
                                                    hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Delay}}"
                                                    Value="{Binding Delay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <hc:ElementGroup
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <hc:ElementGroup.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                            </Grid>
                                                        </ItemsPanelTemplate>
                                                    </hc:ElementGroup.ItemsPanel>
                                                    <Button
                                                        Grid.Column="0"
                                                        Command="{Binding DataContext.MoveCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                        CommandParameter="{Binding .}"
                                                        Content="{lang:Lang Key={x:Static lang:LangKeys.Move}}" />
                                                    <Button
                                                        Grid.Column="1"
                                                        Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                        CommandParameter="{Binding .}"
                                                        Content="{lang:Lang Key={x:Static lang:LangKeys.Stop}}" />
                                                    <Button
                                                        Grid.Column="2"
                                                        Command="{Binding DataContext.RemovePointPosCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding .}"
                                                        Content="{lang:Lang Key={x:Static lang:LangKeys.Delete}}" />
                                                </hc:ElementGroup>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>


