<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.MaintainContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <FrameworkElement x:Key="ProxyElement" DataContext="{Binding}" />
    </UserControl.Resources>
    <Grid Margin="5" Background="{DynamicResource RegionBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox
                Name="lstDevice"
                Margin="0,5"
                Padding="0"
                BorderThickness="0"
                ItemsSource="{Binding DeviceItems}"
                SelectedItem="{Binding SelectedDeviceItem}"
                SelectionMode="Single"
                VirtualizingStackPanel.IsVirtualizing="True">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Background="Transparent" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Width="80"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}}"
                            Style="{DynamicResource TextBlockDefault}"
                            Text="{lang:Lang Key={Binding ItemName}}"
                            TextAlignment="Center" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListBoxItemBaseStyle}" TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,5,0" />
                        <Setter Property="Background" Value="#DEE0E7" />
                        <Setter Property="hc:BorderElement.CornerRadius" Value="5" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextIconBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="SelectionChanged">
                        <hc:EventToCommand Command="{Binding SelectedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}, Path=SelectedItem}" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </ListBox>
            <StackPanel
                Grid.Column="2"
                Height="50"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <hc:NumericUpDown
                    Width="190"
                    VerticalAlignment="Center"
                    hc:InfoElement.Title="{Binding FullTitle, StringFormat={}{0}:}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="100"
                    Minimum="1"
                    Style="{DynamicResource NumericUpDownExtend}"
                    Value="{Binding MaxHP}" />
                <hc:NumericUpDown
                    Width="190"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    hc:InfoElement.Title="{Binding MaintainTitle, StringFormat={}{0}:}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="125"
                    Minimum="1"
                    Style="{DynamicResource NumericUpDownExtend}"
                    Value="{Binding MaintainHP}" />
                <Button
                    Width="60"
                    Margin="10,0,0,0"
                    Command="{Binding SetAllMaintainDeviceCommand}"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Set}}"
                    Style="{DynamicResource ButtonInfo}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <DataGrid
                Padding="-5"
                AlternationCount="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1.5"
                ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                HeadersVisibility="Column"
                IsReadOnly="False"
                ItemsSource="{Binding MaintainModels}"
                RowStyle="{StaticResource CustomDataGridRowStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="150"
                        MinWidth="100"
                        Binding="{Binding Name}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="150"
                        MinWidth="100"
                        Binding="{Binding MaxHP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{Binding DataContext.FullTitle, Source={StaticResource ProxyElement}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                    <DataGridTextColumn
                        Width="150"
                        MinWidth="100"
                        Binding="{Binding UsedHP}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{Binding DataContext.UsedTitle, Source={StaticResource ProxyElement}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="120"
                        MinWidth="100"
                        Binding="{Binding MaintainHP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{Binding DataContext.MaintainTitle, Source={StaticResource ProxyElement}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                    <DataGridTextColumn
                        Width="200"
                        MinWidth="150"
                        Binding="{Binding CurrentHP}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{Binding DataContext.CurrentTitle, Source={StaticResource ProxyElement}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="True" />
                    <DataGridTemplateColumn
                        Width="100"
                        MinWidth="90"
                        hc:TitleElement.HorizontalAlignment="Center"
                        CanUserResize="False"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Operation}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="0"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.ResetMaintainTimeCommand}"
                                    CommandParameter="{Binding .}"
                                    Content="{lang:Lang Key={x:Static lang:LangKeys.Clear}}"
                                    Style="{StaticResource ButtonInfo.Small}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="*"
                        MinWidth="70"
                        hc:TitleElement.HorizontalAlignment="Center"
                        CanUserResize="False"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Process}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar
                                        Grid.Column="0"
                                        Grid.ColumnSpan="5"
                                        Foreground="{Binding ForeColor}"
                                        Value="{Binding Percent}" />
                                    <Path
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        Data="M0,2 L0,36"
                                        Stroke="{DynamicResource AccentBrush}"
                                        StrokeDashArray="2 2"
                                        StrokeThickness="2" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="100"
                        MinWidth="90"
                        hc:TitleElement.HorizontalAlignment="Center"
                        CanUserResize="False"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Operation}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="0"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.SetSelectedMaintainDeviceCommand}"
                                    CommandParameter="{Binding .}"
                                    Content="{lang:Lang Key={x:Static lang:LangKeys.Set}}"
                                    Style="{StaticResource ButtonInfo.Small}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <ContentControl Content="{StaticResource ProxyElement}" Visibility="Collapsed" />
    </Grid>
</UserControl>
