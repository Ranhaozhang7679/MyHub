<UserControl x:Class="Luster.SimDevice.SubSystem.Views.FXTCPContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- 日志级别转换器 -->
        <local:LogLevelToBrushConverter x:Key="LogLevelConverter">
            <local:LogLevelToBrushConverter.DebugBrush>
                <SolidColorBrush Color="Gray"/>
            </local:LogLevelToBrushConverter.DebugBrush>
            <local:LogLevelToBrushConverter.InfoBrush>
                <SolidColorBrush Color="White"/>
            </local:LogLevelToBrushConverter.InfoBrush>
            <local:LogLevelToBrushConverter.WarningBrush>
                <SolidColorBrush Color="Orange"/>
            </local:LogLevelToBrushConverter.WarningBrush>
            <local:LogLevelToBrushConverter.ErrorBrush>
                <SolidColorBrush Color="Red"/>
            </local:LogLevelToBrushConverter.ErrorBrush>
            <local:LogLevelToBrushConverter.SuccessBrush>
                <SolidColorBrush Color="LightGreen"/>
            </local:LogLevelToBrushConverter.SuccessBrush>
        </local:LogLevelToBrushConverter>

        <!-- 布尔到状态文本转换器 -->
        <local:BoolToStatusConverter x:Key="StatusConverter"/>

        <!-- 布尔到状态颜色转换器 -->
        <local:BoolToStatusColorConverter x:Key="StatusColorConverter"/>

        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 控制面板 -->
        <Border Grid.Row="0" Background="White" BorderBrush="Blue" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 服务状态 -->
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="{Binding IsServiceRunning, Converter={StaticResource StatusConverter}}" 
                               Foreground="{Binding IsServiceRunning, Converter={StaticResource StatusColorConverter}}"
                               FontWeight="Bold" Margin="10,0,10,0" />
                    <!-- 连接状态 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="连接状态:" Margin="10,0,10,0"/>
                        <TextBlock Text="{Binding ConnectionStatus}" Foreground="LightBlue" FontWeight="Bold"/>
                    </StackPanel>
                    <ComboBox 
                        ItemsSource="{Binding Source={x:Static local:EnumBindingSourceExtension.AspectModeEnumValues}}"
                        SelectedValue="{Binding AspectMode, Mode=TwoWay}"
                        SelectedValuePath="Key"
                        DisplayMemberPath="Value"
                        Width="200"
                        Margin="10"/>
                </StackPanel>
                              
                <!-- 配置 -->
                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                    <!-- 第一对：IP -->
                    <StackPanel Orientation="Horizontal" Margin="10,0">
                        <TextBlock Text="连接IP:" Margin="10,5,10,0"/>
                        <TextBox Text="{Binding IP}" Foreground="LightBlue" FontWeight="Bold" 
                 IsReadOnly="{Binding IsServiceRunning}" Margin="10,0,10,5"/>
                    </StackPanel>

                    <!-- 第二对：Port -->
                    <StackPanel Orientation="Horizontal" Margin="10,0">
                        <TextBlock Text="连接Port:" Margin="10,5,10,0"/>
                        <TextBox Text="{Binding Port}" Foreground="LightBlue" FontWeight="Bold" 
                 IsReadOnly="{Binding IsServiceRunning}" Margin="10,0,10,5"/>
                    </StackPanel>

                    <!-- 第三对：导出路径 -->
                    <StackPanel Orientation="Horizontal" Margin="10,0">
                        <TextBlock Text="导出xml路径:" Margin="10,5,10,0"/>
                        <TextBox Text="{Binding FolderPath}" Foreground="LightBlue" FontWeight="Bold" 
                 IsReadOnly="{Binding IsServiceRunning}" Margin="10,0,10,5"/>
                    </StackPanel>

                    <!-- 第四对：TCP间隔 -->
                    <StackPanel Orientation="Horizontal" Margin="10,0">
                        <TextBlock Text="TCP接受间隔MS:" Margin="10,5,10,0"/>
                        <TextBox Text="{Binding ReceiveTimeSpan}" Foreground="LightBlue" FontWeight="Bold" 
                 IsReadOnly="{Binding IsServiceRunning}" Margin="10,0,10,5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,0">
                        <TextBlock Text="TCP接受指令长度:" Margin="10,5,10,0"/>
                        <TextBox Text="{Binding ReceiveLen}" Foreground="LightBlue" FontWeight="Bold" 
                IsReadOnly="{Binding IsServiceRunning}" Margin="10,0,10,5"/>
                    </StackPanel>
                </StackPanel>

                <!-- 控制按钮 -->
                <StackPanel Grid.Column="2" Orientation="Vertical">
                    <Button Content="启动服务" Command="{Binding StartServiceCommand}" 
            Width="100" Height="30" Margin="5,0"
            IsEnabled="{Binding StartServiceCommand.CanExecute}"
            Background="#FF1E6F3C" Foreground="White"/>

                    <Button Content="停止服务" Command="{Binding StopServiceCommand}" 
            Width="100" Height="30" Margin="5,0"
            IsEnabled="{Binding StopServiceCommand.CanExecute}"
            Background="#FF8B0000" Foreground="White"/>

                    <Button Content="清空日志" Command="{Binding ClearLogsCommand}" 
            Width="80" Height="30" Margin="5,0"
            Background="#FF2D2D30" Foreground="White"/>

                    <Button Content="保存配置/导出XML" Command="{Binding ExportVIOVAxisCommand}" 
             Width="140" Height="30" Margin="5,0"
             Background="PaleGreen" Foreground="White"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- 日志区域 -->
        <Grid Grid.Row="1">
            <TabControl>
                <!-- 表格视图日志 -->
                <TabItem Header="表格视图">
                    <DataGrid ItemsSource="{Binding LogEntries}" AutoGenerateColumns="False" 
                              IsReadOnly="True" GridLinesVisibility="None" 
                              Background="White" RowBackground="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat='HH:mm:ss'}" 
                                                Width="80" Foreground="LightGray"/>
                            <DataGridTextColumn Header="日志内容" Binding="{Binding Message}" 
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="Foreground" Value="{Binding Level, Converter={StaticResource LogLevelConverter}}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="级别" Binding="{Binding Level}" 
                                                Width="80" Foreground="LightGray"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- 文本视图日志 -->
                <TabItem Header="文本视图">
                    <TextBox Text="{Binding LogText, Mode=OneWay}" 
                             IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 忙状态指示器 -->
        <Grid Grid.Row="1" Background="#80000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="20" Margin="10"/>
                <TextBlock Text="处理中..." HorizontalAlignment="Center" Margin="10" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
