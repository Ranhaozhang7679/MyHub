<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.Dialog.VideoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="400"
    Height="335"
    Loaded="ViewLoaded"
    PreviewMouseDown="ViewPreviewMouseDown"
    PreviewMouseMove="ViewPreviewMouseMove"
    mc:Ignorable="d">
    <Grid Margin="5" Background="{StaticResource BorderBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource BackgroundBrush}">
            <Image Source="{Binding FrameData}" Stretch="Uniform" />
        </Border>
        <Button
            Grid.Row="1"
            Width="100"
            Margin="5,0"
            Padding="4,6"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            hc:IconElement.Geometry="{StaticResource ApplyGeometry}"
            Command="{Binding CloseCameraCommand}"
            Content="{lang:Lang Key={x:Static lang:LangKeys.Close}}" />
    </Grid>
</UserControl>
