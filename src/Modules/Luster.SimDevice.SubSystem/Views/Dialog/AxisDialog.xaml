<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.Dialog.AxisDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pg="clr-namespace:Luster.Common.Assets.ParamGrid;assembly=Luster.Common.Assets"
    xmlns:prism="http://prismlibrary.com/"
    MinWidth="500"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource TextBoxExtendBaseStyle}" TargetType="TextBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="Red" />
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style BasedOn="{StaticResource NumericUpDownPlus}" TargetType="hc:NumericUpDown">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="Red" />
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style BasedOn="{StaticResource ComboBoxExtend}" TargetType="hc:ComboBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="Red" />
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="10">
        <GroupBox
            hc:TitleElement.Background="{DynamicResource RegionBrush}"
            Header="{lang:Lang Key={x:Static lang:LangKeys.NormalParas}}"
            Style="{StaticResource GroupBoxTab}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <hc:ComboBox
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.SelectMotinCard}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.MotionCard}}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding MotionCardList}"
                    SelectedValue="{Binding MDevice}" />
                <TextBox
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.PleaseInputAxisName}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                    Text="{Binding AxisName}" />
                <hc:NumericUpDown
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.StartIndex}}"
                    Value="{Binding StartNo}" />
                <hc:NumericUpDown
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="10,10,0,0"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.AxisCount}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.AxisCount}}"
                    Value="{Binding AxisNumber}" />
            </Grid>
        </GroupBox>
        <GroupBox
            Margin="0,10,0,0"
            hc:TitleElement.Background="{DynamicResource RegionBrush}"
            Header="{lang:Lang Key={x:Static lang:LangKeys.NormalParas}}"
            Style="{StaticResource GroupBoxTab}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <hc:NumericUpDown hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.AccSpeed}}" Value="{Binding Acc}" />
                <hc:NumericUpDown
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.DccSpeed}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.DccSpeed}}"
                    Value="{Binding Dec}" />
                <hc:NumericUpDown
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.RunSpeed}}"
                    Value="{Binding MoveSpeed}" />
                <hc:NumericUpDown
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="10,10,0,0"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.JogSpped}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.JogSpped}}"
                    Value="{Binding JogSpeed}" />

                <hc:NumericUpDown
                    Grid.Row="2"
                    Margin="0,10,0,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.PulseRatio}}"
                    Value="{Binding PerPluse}" />
                <hc:NumericUpDown
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="10,10,0,0"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.PlaceTime}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.PlaceTime}}"
                    Value="{Binding Stime}" />
                <hc:NumericUpDown
                    Grid.Row="3"
                    Margin="0,10,0,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.ForwardTrip}}"
                    Value="{Binding SoftLimitPL}" />
                <hc:NumericUpDown
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="10,10,0,0"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.NegativeTrip}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.NegativeTrip}}"
                    Value="{Binding SoftLimitML}" />
            </Grid>
        </GroupBox>
        <GroupBox
            Margin="0,10,0,0"
            hc:TitleElement.Background="{DynamicResource RegionBrush}"
            Header="{lang:Lang Key={x:Static lang:LangKeys.HomeParas}}"
            Style="{StaticResource GroupBoxTab}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <hc:ComboBox
                    Grid.Column="0"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                    ItemsSource="{Binding Modules}"
                    SelectedValue="{Binding Module}" />
                <hc:ComboBox
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.HomeType}}"
                    DisplayMemberPath="Desc"
                    ItemsSource="{Binding HomeDirList}"
                    SelectedValue="{Binding HomeMode}"
                    SelectedValuePath="Value" />

                <hc:NumericUpDown
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.HighSpeed}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.HighSpeed}}"
                    Value="{Binding HomeSpeedHigh}" />
                <hc:NumericUpDown
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="10,10,0,0"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.LowSpeed}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.LowSpeed}}"
                    Value="{Binding HomeSpeedLow}" />

                <hc:NumericUpDown
                    Grid.Row="2"
                    Margin="0,10,0,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.AccSpeed}}"
                    Value="{Binding HomeAcc}" />
                <hc:NumericUpDown
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="10,10,0,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.DccSpeed}}"
                    Value="{Binding HomeDec}" />
                <hc:NumericUpDown
                    Grid.Row="3"
                    Margin="0,10,0,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.ZeroOffset}}"
                    Value="{Binding HomeOffset}" />

                <hc:ComboBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="10,10,0,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Priority}}"
                    DisplayMemberPath="Desc"
                    ItemsSource="{Binding PriorityList}"
                    SelectedValue="{Binding HomePriority}"
                    SelectedValuePath="Value" />
            </Grid>
        </GroupBox>
        <GroupBox
            Margin="0,10,0,0"
            hc:TitleElement.Background="{DynamicResource RegionBrush}"
            Header="{lang:Lang Key={x:Static lang:LangKeys.PulseCal}}"
            Style="{StaticResource GroupBoxTab}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <CheckBox
                    Grid.Row="0"                 
                    Margin="10,10,0,0"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.HaveTransmission}}"
                    IsChecked="{Binding HaveTransmission}" />
                <Button
                    Grid.Row="0"                 
                    Grid.Column="1"                 
                    Margin="10,10,0,0"                   
                    Width="80"
                    HorizontalAlignment="Center"
                    Command="{Binding CalCommand}"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.PulseCal}}" />
                
                <hc:NumericUpDown
                    Grid.Row="1"
                    Margin="10,10,0,0"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.CommandPulse}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.CommandPulse}}"
                    Value="{Binding CommandPulse}" />
                <hc:NumericUpDown
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="10,10,0,0"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.CircleDisplacement}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.CircleDisplacement}}"
                    Value="{Binding CircleDisplacement}" />
                <hc:NumericUpDown
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="10,10,0,0"
                    Visibility="{Binding HaveTransmission, Converter={StaticResource Boolean2VisibilityConverter}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.GearRatioNumerator}}"
                    Value="{Binding GearRatioNumerator}" />
                <hc:NumericUpDown
                    Grid.Row="2"
                    Grid.Column="1"                  
                    Margin="10,10,0,0"
                    Visibility="{Binding HaveTransmission, Converter={StaticResource Boolean2VisibilityConverter}}"               
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.GearRatioDenominator}}"
                    Value="{Binding GearRatioDenominator}" />
            </Grid>
        </GroupBox>
        <Grid Margin="0,10,0,0">
            <Button
                Width="80"
                HorizontalAlignment="Left"
                Command="{Binding ScanCommand}"
                Content="{lang:Lang Key={x:Static lang:LangKeys.AutoScan}}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="80"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="cancel"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
                <Button
                    Width="80"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="Ok"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Sure}}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
