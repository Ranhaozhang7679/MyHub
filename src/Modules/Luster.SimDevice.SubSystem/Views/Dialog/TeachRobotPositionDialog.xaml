<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.Dialog.TeachRobotPositionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="350"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource NumericUpDownPlus}" TargetType="hc:NumericUpDown">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="10">
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="20">
            <TextBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                Style="{StaticResource TextBoxValidationStyle}"
                Text="{Binding Name}" />
            <hc:NumericUpDown
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Position}}"
                hc:InfoElement.Title="PointX"
                Value="{Binding Point_X}" />
            <hc:NumericUpDown
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Position}}"
                hc:InfoElement.Title="PointY"
                Value="{Binding Point_Y}" />
            <hc:NumericUpDown
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Position}}"
                hc:InfoElement.Title="PointZ"
                Value="{Binding Point_Z}" />
            <hc:NumericUpDown
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Position}}"
                hc:InfoElement.Title="PointU"
                Value="{Binding Point_U}" />

            <hc:NumericUpDown
                Visibility="{Binding IsSixRobot, Converter={StaticResource Boolean2VisibilityConverter}}"
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Position}}"
                hc:InfoElement.Title="PointV"
                Value="{Binding Point_V}" />

            <hc:NumericUpDown
                Visibility="{Binding IsSixRobot, Converter={StaticResource Boolean2VisibilityConverter}}"
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Position}}"
                hc:InfoElement.Title="PointW"
                Value="{Binding Point_W}" />

            <hc:NumericUpDown
                Visibility="{Binding IsSixRobot, Converter={StaticResource Boolean2VisibilityReConverter}}"
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Position}}"
                hc:InfoElement.Title="PointHand"
                Value="{Binding Point_H}" />
        </hc:UniformSpacingPanel>
        <Grid Margin="0,10,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="80"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="cancel"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
                <Button
                    Width="80"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="ok"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Sure}}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
