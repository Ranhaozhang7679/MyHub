<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.Dialog.DeviceDialogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Width="350"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource TextBoxExtendBaseStyle}" TargetType="TextBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource NumericUpDownPlus}" TargetType="hc:NumericUpDown">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource ComboBoxExtend}" TargetType="hc:ComboBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <hc:ComboBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{Binding BrandPlaceholder}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Brand}}"
                DisplayMemberPath="Desc"
                ItemsSource="{Binding BrandList}"
                SelectedValue="{Binding DeviceType}"
                SelectedValuePath="Value"
                Style="{StaticResource ComboBoxValidationStyle}" />
            <TextBox
                Grid.Row="1"
                Margin="0,15,0,0"
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{Binding NamePlaceholder}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                Style="{StaticResource TextBoxValidationStyle}"
                Text="{Binding Name}" />
            <hc:NumericUpDown
                Grid.Row="2"
                Margin="0,15,0,0"
                hc:InfoElement.Placeholder="请输入通道数"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.ChannelCount}}"
                Minimum="1"
                Visibility="{Binding IsLightController, Converter={StaticResource Boolean2VisibilityConverter}}"
                Value="{Binding ChannelCount}" />
            <hc:ComboBox
                Grid.Row="3"
                Margin="0,15,0,0"
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.PleaseSelectCommType}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.CommType}}"
                DisplayMemberPath="Desc"
                ItemsSource="{Binding ConnectionTypes}"
                SelectedValue="{Binding Adapter}"
                SelectedValuePath="Value"
                Style="{StaticResource ComboBoxValidationStyle}" />
            <hc:UniformSpacingPanel
                Grid.Row="4"
                Margin="0,15,0,0"
                Orientation="Vertical"
                Spacing="15"
                Visibility="{Binding IsTcp, Converter={StaticResource Boolean2VisibilityConverter}}">
                <TextBox
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.IPAddress}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.IPAddress}}"
                    Text="{Binding IpAddress, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                <hc:NumericUpDown
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Port}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Port}}"
                    Minimum="1"
                    Value="{Binding Port}" />
            </hc:UniformSpacingPanel>
            <hc:UniformSpacingPanel
                Grid.Row="4"
                Margin="0,15,0,0"
                Orientation="Vertical"
                Visibility="{Binding IsPCIe, Converter={StaticResource Boolean2VisibilityConverter}}">
                <hc:ComboBox
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="PCIe插槽"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Slot}}"
                    DisplayMemberPath="Desc"
                    ItemsSource="{Binding SlotList}"
                    SelectedValue="{Binding PCIe}"
                    SelectedValuePath="Value" />
            </hc:UniformSpacingPanel>
            <hc:UniformSpacingPanel
                Grid.Row="4"
                Margin="0,15,0,0"
                Orientation="Vertical"
                Visibility="{Binding IsCom, Converter={StaticResource Boolean2VisibilityConverter}}">
                <hc:ComboBox
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="Com口"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Comm}}"
                    DisplayMemberPath="Desc"
                    ItemsSource="{Binding Coms}"
                    SelectedValue="{Binding ComName}"
                    SelectedValuePath="Value" />
                <hc:ComboBox
                    Margin="0,15,0,0"
                    VerticalAlignment="Top"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="选择波特率"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.BaudRate}}"
                    ItemsSource="{Binding BaudRateList}"
                    SelectedValue="{Binding BaudRate}" />
                <hc:NumericUpDown
                    Margin="0,15,0,0"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="输入数据位"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.DataBits}}"
                    Value="{Binding DataBits}" />
                <hc:ComboBox
                    Margin="0,15,0,0"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="选择停止位"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.StopBits}}"
                    DisplayMemberPath="Desc"
                    ItemsSource="{Binding StopBitsList}"
                    SelectedValue="{Binding StopBits}"
                    SelectedValuePath="Value" />
                <hc:ComboBox
                    Margin="0,15,0,0"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="选择奇偶校验位"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Parity}}"
                    DisplayMemberPath="Desc"
                    ItemsSource="{Binding ParityList}"
                    SelectedValue="{Binding Parity}"
                    SelectedValuePath="Value" />
            </hc:UniformSpacingPanel>
            <hc:UniformSpacingPanel
                Grid.Row="4"
                Margin="0,15,0,0"
                Orientation="Vertical"
                Visibility="{Binding IsUsb, Converter={StaticResource Boolean2VisibilityConverter}}">
                <hc:ComboBox
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.USB}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.USB}}"
                    DisplayMemberPath="Desc"
                    ItemsSource="{Binding Usbs}"
                    SelectedValue="{Binding Usb}"
                    SelectedValuePath="Value" />
            </hc:UniformSpacingPanel>
        </Grid>
        <StackPanel
            Margin="0,15,5,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Command="{Binding CloseCommand}"
                CommandParameter="cancel"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
            <Button
                Width="80"
                Margin="10,0,0,0"
                Command="{Binding CloseCommand}"
                CommandParameter="ok"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Sure}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
