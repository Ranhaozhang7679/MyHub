<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.Dialog.IODialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pg="clr-namespace:Luster.Common.Assets.ParamGrid;assembly=Luster.Common.Assets"
    xmlns:prism="http://prismlibrary.com/"
    MinWidth="400"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource TextBoxExtendBaseStyle}" TargetType="TextBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="0" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="true">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style BasedOn="{StaticResource NumericUpDownPlus}" TargetType="hc:NumericUpDown">
            <Setter Property="hc:InfoElement.TitleWidth" Value="70" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource ComboBoxExtend}" TargetType="hc:ComboBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="70" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="10">
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="20">
            <hc:ComboBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.SelectMotinCard}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.MotionCard}}"
                DisplayMemberPath="Name"
                ItemsSource="{Binding MotionCardList}"
                SelectedValue="{Binding MDevice}"
                Style="{StaticResource ComboBoxValidationStyle}" />
            <hc:ComboBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                ItemsSource="{Binding Modules}"
                SelectedValue="{Binding Module}"
                Style="{StaticResource ComboBoxValidationStyle}" />
            <hc:ComboBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="数字信号Or模拟信号"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.IOType}}"
                DisplayMemberPath="Desc"
                ItemsSource="{Binding IOTypes}"
                SelectedValue="{Binding IoType}"
                SelectedValuePath="Value"
                Style="{StaticResource ComboBoxValidationStyle}" />
            <hc:ComboBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="输入信号Or输出信号"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Behavior}}"
                DisplayMemberPath="Desc"
                ItemsSource="{Binding IOBehaviors}"
                SelectedValue="{Binding IOBehavior}"
                SelectedValuePath="Value"
                Style="{StaticResource ComboBoxValidationStyle}" />
            <TextBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                Style="{StaticResource TextBoxValidationStyle}"
                Text="{Binding Name}" />
            <hc:NumericUpDown
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.StartIndex}}"
                Style="{StaticResource NumericUpDownValidationStyle}"
                Value="{Binding StartNo}" />
            <hc:NumericUpDown
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.IOCount}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.IOCount}}"
                Style="{StaticResource NumericUpDownValidationStyle}"
                Value="{Binding Number}" />

            <hc:NumericUpDown
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Default}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Default}}"
                Style="{StaticResource NumericUpDownValidationStyle}"
                Visibility="{Binding IsShowDefault, Converter={StaticResource Boolean2VisibilityConverter}}"
                Value="{Binding DefaultValue}" />
        </hc:UniformSpacingPanel>
        <Grid Margin="0,10,0,0">
            <Button
                Width="80"
                HorizontalAlignment="Left"
                Command="{Binding ScanCommand}"
                Content="{lang:Lang Key={x:Static lang:LangKeys.AutoScan}}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="80"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="cancel"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
                <Button
                    Width="80"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="ok"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Sure}}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
