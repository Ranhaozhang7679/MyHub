<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.Dialog.VAxisMDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Padding="10"
    d:DesignWidth="300"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource TextBoxExtendBaseStyle}" TargetType="TextBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource NumericUpDownPlus}" TargetType="hc:NumericUpDown">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource ComboBoxExtend}" TargetType="hc:ComboBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="15">
            <hc:ComboBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                DisplayMemberPath=""
                ItemsSource="{Binding Modules}"
                SelectedValue="{Binding Module}"
                Style="{StaticResource ComboBoxValidationStyle}" />
            <TextBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                Style="{StaticResource TextBoxValidationStyle}"
                Text="{Binding Name}" />
            <hc:ComboBox
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.AxisCount}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.AxisCount}}"
                DisplayMemberPath="Desc"
                ItemsSource="{Binding AxisNums}"
                SelectedValue="{Binding AxisNumber}"
                SelectedValuePath="Value" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <hc:ComboBox
                    Margin="0,0,0,15"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.PleaseInputAxisName}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.FirstAxis}}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding VList}"
                    SelectedValue="{Binding Axis1}" />
                <hc:ComboBox
                    Grid.Row="1"
                    Margin="0,0,0,15"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.PleaseInputAxisName}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.SecondAxis}}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding VList}"
                    SelectedValue="{Binding Axis2}" />
                <hc:ComboBox
                    Grid.Row="2"
                    Margin="0,0,0,15"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.PleaseInputAxisName}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.ThirdAxis}}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding VList}"
                    SelectedValue="{Binding Axis3}"
                    Visibility="{Binding IsThree, Converter={StaticResource Boolean2VisibilityConverter}}" />
                <hc:ComboBox
                    Grid.Row="3"
                    Margin="0,0,0,15"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.PleaseInputAxisName}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.FourthAxis}}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding VList}"
                    SelectedValue="{Binding Axis4}"
                    Visibility="{Binding IsFour, Converter={StaticResource Boolean2VisibilityConverter}}" />
            </Grid>
        </hc:UniformSpacingPanel>
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Command="{Binding CloseCommand}"
                CommandParameter="cancel"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
            <Button
                Width="80"
                Margin="10,0"
                Command="{Binding CloseCommand}"
                CommandParameter="ok"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Sure}}" />
        </StackPanel>
    </Grid>

</UserControl>
