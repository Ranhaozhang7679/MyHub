<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.Dialog.IOActionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="clr-namespace:Luster.SimDevice.SubSystem.Extension"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pg="clr-namespace:Luster.Common.Assets.ParamGrid;assembly=Luster.Common.Assets"
    xmlns:prism="http://prismlibrary.com/"
    MinWidth="350"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ex:NumToVisibilityConverter x:Key="NumToVisibilityConverter" />
        <Style BasedOn="{StaticResource TextBoxExtendBaseStyle}" TargetType="TextBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource NumericUpDownPlus}" TargetType="hc:NumericUpDown">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource ComboBoxExtend}" TargetType="hc:ComboBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="10">
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="1">
            <TextBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.ActionName}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.ActionName}}"
                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
            <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{lang:Lang Key={x:Static lang:LangKeys.ActionType}}" />
                <hc:ButtonGroup Grid.Column="1">
                    <ToggleButton
                        Grid.Column="1"
                        Content="{lang:Lang Key={x:Static lang:LangKeys.NeedDetetor}}"
                        IsChecked="{Binding IsCheck}" />
                    <ToggleButton
                        Grid.Column="2"
                        Content="{lang:Lang Key={x:Static lang:LangKeys.NeedHome}}"
                        IsChecked="{Binding IsHome}" />
                </hc:ButtonGroup>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{lang:Lang Key={x:Static lang:LangKeys.IOCount}}" />
                <Slider
                    x:Name="IONum"
                    Grid.Column="1"
                    IsSnapToTickEnabled="True"
                    Maximum="8"
                    Minimum="1"
                    TickFrequency="1"
                    Value="{Binding IoNum}" />
            </Grid>

            <hc:ComboBox
                Margin="0,10"
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.FirstIO}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.FirstIO}}"
                DisplayMemberPath="Name"
                ItemsSource="{Binding IOList}"
                SelectedValue="{Binding IO1}"
                Style="{StaticResource ComboBoxValidationStyle}" />

            <hc:ComboBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.SecondIO}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.SecondIO}}"
                DisplayMemberPath="Name"
                ItemsSource="{Binding IOList}"
                SelectedValue="{Binding IO2}"
                Style="{StaticResource ComboBoxValidationStyle}"
                Visibility="{Binding ElementName=IONum, Path=Value, Converter={StaticResource NumToVisibilityConverter}, ConverterParameter=2}" />

            <hc:ComboBox
                Margin="0,10"
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.ThirdIO}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.ThirdIO}}"
                DisplayMemberPath="Name"
                ItemsSource="{Binding IOList}"
                SelectedValue="{Binding IO3}"
                Style="{StaticResource ComboBoxValidationStyle}"
                Visibility="{Binding ElementName=IONum, Path=Value, Converter={StaticResource NumToVisibilityConverter}, ConverterParameter=3}" />

            <hc:ComboBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.FourthIO}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.FourthIO}}"
                DisplayMemberPath="Name"
                ItemsSource="{Binding IOList}"
                SelectedValue="{Binding IO4}"
                Style="{StaticResource ComboBoxValidationStyle}"
                Visibility="{Binding ElementName=IONum, Path=Value, Converter={StaticResource NumToVisibilityConverter}, ConverterParameter=4}" />

            <hc:ComboBox
                Margin="0,10,0,0"
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.FifthIO}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.FifthIO}}"
                DisplayMemberPath="Name"
                ItemsSource="{Binding IOList}"
                SelectedValue="{Binding IO5}"
                Style="{StaticResource ComboBoxValidationStyle}"
                Visibility="{Binding ElementName=IONum, Path=Value, Converter={StaticResource NumToVisibilityConverter}, ConverterParameter=5}" />
            <hc:ComboBox
                Margin="0,10,0,0"
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.SixthIO}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.SixthIO}}"
                DisplayMemberPath="Name"
                ItemsSource="{Binding IOList}"
                SelectedValue="{Binding IO6}"
                Style="{StaticResource ComboBoxValidationStyle}"
                Visibility="{Binding ElementName=IONum, Path=Value, Converter={StaticResource NumToVisibilityConverter}, ConverterParameter=6}" />
            <hc:ComboBox
                Margin="0,10,0,0"
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.SeventhIO}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.SeventhIO}}"
                DisplayMemberPath="Name"
                ItemsSource="{Binding IOList}"
                SelectedValue="{Binding IO7}"
                Style="{StaticResource ComboBoxValidationStyle}"
                Visibility="{Binding ElementName=IONum, Path=Value, Converter={StaticResource NumToVisibilityConverter}, ConverterParameter=7}" />
            <hc:ComboBox
                Margin="0,10,0,0"
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.EighthIO}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.EighthIO}}"
                DisplayMemberPath="Name"
                ItemsSource="{Binding IOList}"
                SelectedValue="{Binding IO8}"
                Style="{StaticResource ComboBoxValidationStyle}"
                Visibility="{Binding ElementName=IONum, Path=Value, Converter={StaticResource NumToVisibilityConverter}, ConverterParameter=8}" />
        </hc:UniformSpacingPanel>
        <Grid Margin="0,10,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="80"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="cancel"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
                <Button
                    Width="80"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="ok"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Sure}}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>


