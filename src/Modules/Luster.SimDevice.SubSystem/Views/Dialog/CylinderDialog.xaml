<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.Dialog.CylinderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pg="clr-namespace:Luster.Common.Assets.ParamGrid;assembly=Luster.Common.Assets"
    xmlns:prism="http://prismlibrary.com/"
    MinWidth="350"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style BasedOn="{StaticResource TextBoxExtendBaseStyle}" TargetType="TextBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="70" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource NumericUpDownPlus}" TargetType="hc:NumericUpDown">
            <Setter Property="hc:InfoElement.TitleWidth" Value="70" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource ComboBoxExtend}" TargetType="hc:ComboBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="70" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="10">
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="20">
            <hc:ElementGroup>
                <hc:ElementGroup.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </hc:ElementGroup.ItemsPanel>
                <hc:ComboBox
                    Name="combModule"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                    ItemsSource="{Binding Modules}"
                    SelectedValue="{Binding Module}"
                    Style="{StaticResource ComboBoxValidationStyle}" />
                <Button
                    Grid.Column="1"
                    hc:IconElement.Geometry="{StaticResource RemoveGeometry}"
                    Command="{Binding RemoveCommand}"
                    CommandParameter="{Binding ElementName=combModule}" />
            </hc:ElementGroup>


            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{lang:Lang Key={x:Static lang:LangKeys.CylinderType}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton
                        Content="{lang:Lang Key={x:Static lang:LangKeys.SingleControl}}"
                        GroupName="Category"
                        IsChecked="{Binding IsSingle}" />
                    <RadioButton
                        Margin="10,0"
                        Content="{lang:Lang Key={x:Static lang:LangKeys.DoubleControl}}"
                        GroupName="Category"
                        IsChecked="{Binding IsSingle, Converter={StaticResource Boolean2BooleanReConverter}}" />
                </StackPanel>
            </Grid>
            <TextBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                Style="{StaticResource TextBoxValidationStyle}"
                Text="{Binding CylinderName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

            <hc:NumericUpDown
                Margin="0,0,0,0"
                hc:TitleElement.Title="最小动作时间"
                Style="{StaticResource NumericUpDownValidationStyle}"
                Value="{Binding MinValue}" />

            <hc:NumericUpDown
                Margin="0,0,0,0"
                hc:TitleElement.Title="最大动作时间"
                Style="{StaticResource NumericUpDownValidationStyle}"
                Value="{Binding MaxValue}" />

            <hc:NumericUpDown
                Margin="0,0,0,0"
                hc:TitleElement.Title="目标动作时间"
                Style="{StaticResource NumericUpDownValidationStyle}"
                Value="{Binding TargetValue}" />

            <hc:ElementGroup>
                <hc:ElementGroup.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </hc:ElementGroup.ItemsPanel>
                <hc:ComboBox
                    Name="combExtendDO"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.OutIOName}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Extend}}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding DOList}"
                    SelectedValue="{Binding CylinderExtendDO}"
                    Style="{StaticResource ComboBoxValidationStyle}" />
                <Button
                    Grid.Column="1"
                    hc:IconElement.Geometry="{StaticResource RemoveGeometry}"
                    Command="{Binding RemoveCommand}"
                    CommandParameter="{Binding ElementName=combExtendDO}" />
            </hc:ElementGroup>

            <hc:ElementGroup Visibility="{Binding IsSingle, Converter={StaticResource Boolean2VisibilityReConverter}}">
                <hc:ElementGroup.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </hc:ElementGroup.ItemsPanel>
                <hc:ComboBox
                    Name="combRetract"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.OutIOName}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Retract}}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding DOList}"
                    SelectedValue="{Binding CylinderRetractDO}"
                    Style="{StaticResource ComboBoxValidationStyle}" />
                <Button
                    Grid.Column="1"
                    hc:IconElement.Geometry="{StaticResource RemoveGeometry}"
                    Command="{Binding RemoveCommand}"
                    CommandParameter="{Binding ElementName=combRetract}" />
            </hc:ElementGroup>

            <hc:ElementGroup>
                <hc:ElementGroup.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </hc:ElementGroup.ItemsPanel>
                <hc:ComboBox
                    x:Name="combExtendDI"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.InIOName}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.ExtendDetetor}}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding DIList}"
                    SelectedValue="{Binding CylinderExtendDI}"
                    Style="{StaticResource ComboBoxValidationStyle}" />
                <Button
                    Grid.Column="1"
                    hc:IconElement.Geometry="{StaticResource RemoveGeometry}"
                    Command="{Binding RemoveCommand}"
                    CommandParameter="{Binding ElementName=combExtendDI}" />
            </hc:ElementGroup>

            <hc:ElementGroup>
                <hc:ElementGroup.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </hc:ElementGroup.ItemsPanel>
                <hc:ComboBox
                    x:Name="combRetractDI"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.InIOName}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.RetractDetetor}}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding DIList}"
                    SelectedValue="{Binding CylinderRetractDI}"
                    Style="{StaticResource ComboBoxValidationStyle}" />
                <Button
                    Grid.Column="1"
                    hc:IconElement.Geometry="{StaticResource RemoveGeometry}"
                    Command="{Binding RemoveCommand}"
                    CommandParameter="{Binding ElementName=combRetractDI}" />
            </hc:ElementGroup>

            <TextBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.ExtendName}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.ExtendName}}"
                Style="{StaticResource TextBoxValidationStyle}"
                Text="{Binding ExtendName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

            <TextBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.RetractName}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.RetractName}}"
                Style="{StaticResource TextBoxValidationStyle}"
                Text="{Binding RetractName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

            <TextBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.InExtendName}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.InExtendName}}"
                Style="{StaticResource TextBoxValidationStyle}"
                Text="{Binding InExtendName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

            <TextBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.InRetractName}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.InRetractName}}"
                Style="{StaticResource TextBoxValidationStyle}"
                Text="{Binding InRetractName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />


        </hc:UniformSpacingPanel>
        <Grid Margin="0,10,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="80"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="cancel"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
                <Button
                    Width="80"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="ok"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Sure}}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>


