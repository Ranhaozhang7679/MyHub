<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.Dialog.VPlcDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pg="clr-namespace:Luster.Common.Assets.ParamGrid;assembly=Luster.Common.Assets"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignWidth="400"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource TextBoxExtendBaseStyle}" TargetType="TextBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource NumericUpDownPlus}" TargetType="hc:NumericUpDown">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource ComboBoxExtend}" TargetType="hc:ComboBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Vertical">
            <hc:ComboBox
                Height="30"
                VerticalAlignment="Center"
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                ItemsSource="{Binding Modules}"
                SelectedValue="{Binding Module}" />
            <TextBox
                Margin="0,10"
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                Text="{Binding Name}" />
            <hc:ComboBox
                Height="30"
                VerticalAlignment="Center"
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.CommType}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.CommType}}"
                ItemsSource="{Binding CommTypes}"
                SelectedValue="{Binding CommType}" />
            <TextBox
                Margin="0,10"
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.IPAddress}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.IPAddress}}"
                Text="{Binding IpAddress}"
                Visibility="{Binding IsSocket, Converter={StaticResource Boolean2VisibilityConverter}}" />
            <TextBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Port}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Port}}"
                Text="{Binding Port}"
                Visibility="{Binding IsSocket, Converter={StaticResource Boolean2VisibilityConverter}}" />

            <hc:ComboBox
                Margin="0,10"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Comm}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Comm}}"
                ItemsSource="{Binding COMNameList}"
                SelectedValue="{Binding COMName}"
                Visibility="{Binding IsSocket, Converter={StaticResource Boolean2VisibilityReConverter}}" />

            <hc:ComboBox
                VerticalAlignment="Top"
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.BaudRate}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.BaudRate}}"
                ItemsSource="{Binding BaudRateList}"
                SelectedValue="{Binding BaudRate}"
                Visibility="{Binding IsSocket, Converter={StaticResource Boolean2VisibilityReConverter}}" />
            <TextBox
                Margin="0,10"
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.DataBits}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.DataBits}}"
                Text="{Binding DataBits}"
                Visibility="{Binding IsSocket, Converter={StaticResource Boolean2VisibilityReConverter}}" />
            <hc:ComboBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.StopBits}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.StopBits}}"
                DisplayMemberPath="Desc"
                ItemsSource="{Binding StopBitsList}"
                SelectedValue="{Binding StopBits}"
                SelectedValuePath="Value"
                Visibility="{Binding IsSocket, Converter={StaticResource Boolean2VisibilityReConverter}}" />
            <hc:ComboBox
                Margin="0,10"
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Parity}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Parity}}"
                DisplayMemberPath="Desc"
                ItemsSource="{Binding ParityList}"
                SelectedValue="{Binding Parity}"
                SelectedValuePath="Value"
                Visibility="{Binding IsSocket, Converter={StaticResource Boolean2VisibilityReConverter}}" />
            <ComboBox
                Margin="0,10,0,0"
                hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Protocol}}"
                hc:TitleElement.TitlePlacement="Left"
                hc:TitleElement.TitleWidth="80"
                DisplayMemberPath="Desc"
                ItemsSource="{Binding Protocols}"
                SelectedValue="{Binding ProtocolType}"
                SelectedValuePath="Value"
                Style="{StaticResource ComboBoxExtendBaseStyle}" />

            <ComboBox
                Margin="0,10,0,0"
                hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.EndianType}}"
                hc:TitleElement.TitlePlacement="Left"
                hc:TitleElement.TitleWidth="80"
                DisplayMemberPath="Desc"
                ItemsSource="{Binding EndianTypes}"
                SelectedValue="{Binding EndianType}"
                SelectedValuePath="Value"
                Style="{StaticResource ComboBoxExtendBaseStyle}" />
        </StackPanel>
        <hc:Divider Grid.Row="1" Margin="0,5" />
        <StackPanel
            Grid.Row="2"
            Margin="0,5,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                HorizontalAlignment="Right"
                Command="{Binding CloseCommand}"
                CommandParameter="cancel"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
            <Button
                Width="80"
                Margin="10,0,0,0"
                HorizontalAlignment="Right"
                Command="{Binding CloseCommand}"
                CommandParameter="ok"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Sure}}" />
        </StackPanel>
    </Grid>
</UserControl>
