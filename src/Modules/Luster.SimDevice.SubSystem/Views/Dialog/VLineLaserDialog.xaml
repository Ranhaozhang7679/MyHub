<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.Dialog.VLineLaserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="350"
    mc:Ignorable="d">
    <StackPanel Margin="10">
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="20">
            <hc:ComboBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.ModuleName}}"
                DisplayMemberPath=""
                ItemsSource="{Binding Modules}"
                SelectedValue="{Binding Module}"
                Style="{StaticResource ComboBoxValidationStyle}" />
            <TextBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                Style="{StaticResource TextBoxValidationStyle}"
                Text="{Binding Name}" />
            <hc:ComboBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.LineLaser}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.LineLaser}}"
                DisplayMemberPath="Name"
                ItemsSource="{Binding LaserLists}"
                SelectedValue="{Binding Laser}"
                Style="{StaticResource ComboBoxValidationStyle}" />
        </hc:UniformSpacingPanel>
        <Grid Margin="0,10,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="80"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="cancel"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
                <Button
                    Width="80"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="ok"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Sure}}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
