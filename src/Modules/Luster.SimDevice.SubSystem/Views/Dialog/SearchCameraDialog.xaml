<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.Dialog.SearchCameraDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Width="450"
    Height="500"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="10,10" Orientation="Horizontal">
            <hc:ComboBox
                Width="400"
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.SelectBrand}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Brand}}"
                hc:InfoElement.TitlePlacement="Left"
                hc:InfoElement.TitleWidth="60"
                DisplayMemberPath="Desc"
                ItemsSource="{Binding BrandList}"
                SelectedValue="{Binding DeviceType}"
                SelectedValuePath="Value" />
            <Button
                Width="30"
                Padding="0"
                HorizontalAlignment="Right"
                hc:IconElement.Geometry="{StaticResource SearchGeometry}"
                hc:IconElement.Height="20"
                hc:IconElement.Width="20"
                Command="{Binding SearchCommad}"
                Foreground="{DynamicResource PrimaryBrush}"
                Style="{StaticResource ButtonIcon}" />
        </StackPanel>
        <GroupBox
            Grid.Row="1"
            Margin="10,5"
            hc:TitleElement.Background="{DynamicResource RegionBrush}"
            Header="{lang:Lang Key={x:Static lang:LangKeys.DeviceList}}"
            Style="{StaticResource GroupBoxTab}">
            <DataGrid IsReadOnly="False" ItemsSource="{Binding Devices}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="60"
                        Binding="{Binding Name}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                    <DataGridTextColumn
                        Width="140"
                        MinWidth="120"
                        Binding="{Binding SerialNumber}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.SerialNumber}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                    <DataGridComboBoxColumn
                        Width="140"
                        MinWidth="120"
                        DisplayMemberPath="Name"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Match}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="DisplayMemberPath" Value="Desc" />
                                <Setter Property="ItemsSource" Value="{Binding Path=DataContext.ExistDevices, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                <Setter Property="SelectedItem" Value="{Binding Path=DataContext.SelectDevice, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}" />
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="DisplayMemberPath" Value="Desc" />
                                <Setter Property="ItemsSource" Value="{Binding Path=DataContext.ExistDevices, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                <Setter Property="SelectedItem" Value="{Binding Path=DataContext.SelectDevice, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>
                    </DataGridComboBoxColumn>
                </DataGrid.Columns>
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="CellEditEnding">
                        <hc:EventToCommand Command="{Binding EditCommand}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </DataGrid>
        </GroupBox>
        <StackPanel
            Grid.Row="2"
            Margin="10,5"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Command="{Binding CloseCommand}"
                CommandParameter="cancel"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
            <Button
                Width="80"
                Margin="10,0,0,0"
                Command="{Binding CloseCommand}"
                CommandParameter="ok"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Sure}}" />
        </StackPanel>
    </Grid>
</UserControl>
