<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.Dialog.SocketActionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="clr-namespace:Luster.SimDevice.SubSystem.Extension"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pg="clr-namespace:Luster.Common.Assets.ParamGrid;assembly=Luster.Common.Assets"
    xmlns:prism="http://prismlibrary.com/"
    MinWidth="350"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ex:NumToVisibilityConverter x:Key="NumToVisibilityConverter" />
        <Style BasedOn="{StaticResource TextBoxExtendBaseStyle}" TargetType="TextBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource NumericUpDownPlus}" TargetType="hc:NumericUpDown">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
        <Style BasedOn="{StaticResource ComboBoxExtend}" TargetType="hc:ComboBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="10">
        <hc:UniformSpacingPanel Orientation="Vertical" Spacing="1">
            <TextBox
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.ActionName}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.ActionName}}"
                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
            <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{lang:Lang Key={x:Static lang:LangKeys.ActionType}}" />
                <hc:ButtonGroup Grid.Column="1">
                    <ToggleButton
                        Grid.Column="1"
                        Content="{lang:Lang Key={x:Static lang:LangKeys.Read}}"
                        IsChecked="{Binding IsRead}" />
                    <ToggleButton
                        Grid.Column="2"
                        Content="{lang:Lang Key={x:Static lang:LangKeys.Write}}"
                        IsChecked="{Binding IsRead, Converter={StaticResource Boolean2BooleanReConverter}}" />
                </hc:ButtonGroup>
            </Grid>
            <hc:ComboBox
                Margin="0,10"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.DataType}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.DataType}}"
                DisplayMemberPath="Desc"
                ItemsSource="{Binding DataTypes}"
                SelectedValue="{Binding DataType}"
                SelectedValuePath="Value" />
        </hc:UniformSpacingPanel>
        <Grid Margin="0,5,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="80"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="cancel"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
                <Button
                    Width="80"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="ok"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Sure}}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>


