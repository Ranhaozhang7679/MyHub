<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.Device.ImportAddressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Device"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="300"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource TextBoxExtendBaseStyle}" TargetType="TextBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="70" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="true">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel Margin="10">
        <hc:UniformSpacingPanel
            Width="300"
            Orientation="Vertical"
            Spacing="15">
            <TextBox
                Width="300"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                IsEnabled="False"
                Style="{StaticResource TextBoxValidationStyle}"
                Text="{Binding Plc.Name}" />
            <hc:ElementGroup>
                <hc:ElementGroup.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </hc:ElementGroup.ItemsPanel>
                <TextBox
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.SelectExcelFile}}"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.ExcelFile}}"
                    IsEnabled="False"
                    Style="{StaticResource TextBoxValidationStyle}"
                    Text="{Binding ExcelFile}" />
                <Button
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    Command="{Binding SelectFileCommand}"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Browse}}" />
            </hc:ElementGroup>

        </hc:UniformSpacingPanel>
        <StackPanel
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                HorizontalAlignment="Right"
                Command="{Binding CloseCommand}"
                CommandParameter="cancel"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
            <Button
                Width="80"
                Margin="10,0,0,0"
                HorizontalAlignment="Right"
                Command="{Binding CloseCommand}"
                CommandParameter="ok"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Sure}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
