<Border
    x:Class="Luster.SimDevice.SubSystem.Views.MainContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:g="clr-namespace:Luster.Common.Assets.Global;assembly=Luster.Common.Assets"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="600"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <Border.Resources>
        <g:GlobalProperty x:Key="GProperty" />
    </Border.Resources>
    <Border
        Background="{DynamicResource RegionBrush}"
        CornerRadius="0"
        IsEnabled="{Binding Source={StaticResource GProperty}, Path=IsEnabled}">
        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="#F4F6FA" CornerRadius="0">
                <hc:SimplePanel Grid.Row="0">
                    <hc:Watermark
                        FontSize="20"
                        FontWeight="Bold"
                        MarkBrush="#0F000000"
                        MarkMargin="3,0" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Style="{StaticResource TextBlockDefaultBold}"
                        Text="{Binding Title}" />

                    <TextBlock
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        FontSize="20"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Style="{StaticResource IconMid}"
                        Text="{Binding Icon}" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            Width="30"
                            Margin="0,0,5,0"
                            Padding="5"
                            HorizontalAlignment="Right"
                            hc:IconElement.Geometry="{StaticResource SearchGeometry}"
                            hc:IconElement.Height="14"
                            hc:IconElement.Width="14"
                            Command="{Binding AutoSearchCommand}"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Style="{StaticResource ButtonIcon}"
                            Visibility="{Binding IsShowAuto, Converter={StaticResource Boolean2VisibilityConverter}}" />
                        <Button
                            Width="30"
                            Margin="0,0,5,0"
                            Padding="5"
                            HorizontalAlignment="Right"
                            hc:IconElement.Geometry="{StaticResource AddGeometry}"
                            hc:IconElement.Height="14"
                            hc:IconElement.Width="14"
                            Command="{Binding AddNewCommand}"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Style="{StaticResource ButtonIcon}"
                            Visibility="{Binding IsShowAdd, Converter={StaticResource Boolean2VisibilityConverter}}" />
                        <Button
                            Margin="0,0,5,0"
                            HorizontalAlignment="Right"
                            hc:IconElement.Geometry="{StaticResource DeleteGeometry}"
                            hc:IconElement.Height="12"
                            hc:IconElement.Width="12"
                            Command="{Binding RemoveCommand}"
                            Foreground="{DynamicResource PrimaryBrush}"
                            Style="{StaticResource ButtonIcon}"
                            Visibility="{Binding IsShowRemove, Converter={StaticResource Boolean2VisibilityConverter}}" />
                    </StackPanel>

                </hc:SimplePanel>
            </Border>
            <ContentControl
                Grid.Row="1"
                prism:RegionManager.RegionName="ContentRegion"
                Background="Transparent" />
        </Grid>
    </Border>
</Border>
