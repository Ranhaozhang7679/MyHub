<Grid
    x:Class="Luster.SimDevice.SubSystem.Views.NonClientAreaContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ex="clr-namespace:Luster.Common.Assets.Extension;assembly=Luster.Common.Assets"
    xmlns:g="clr-namespace:Luster.SimDevice.SubSystem.Config"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:langs="clr-namespace:Luster.Common.Assets.Langs;assembly=Luster.Common.Assets"
    xmlns:prism="http://prismlibrary.com/"
    x:Name="nonclient"
    MinWidth="400"
    Margin="10,3,0,3"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid.Resources>
        <Style
            x:Key="iconText"
            BasedOn="{StaticResource IconMid}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
        </Style>
    </Grid.Resources>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Orientation="Horizontal">
        <Image
            Height="16"
            VerticalAlignment="Stretch"
            Source="/Luster.Common.Assets;component/Image/logo.ico" />
    </StackPanel>
    <Menu
        Grid.Column="1"
        Margin="20,0,0,0"
        VerticalAlignment="Center">
        <MenuItem Header="文件">
            <MenuItem Command="{x:Static g:GlobalCommands.SaveProjCommand}" Header="保存" />
            <MenuItem Command="{x:Static g:GlobalCommands.LoadProjCommand}" Header="打开" />
        </MenuItem>
        <MenuItem Header="|" />
        <MenuItem Header="{Binding ModeTitle}">
            <MenuItem
                Command="{Binding ChangeModeCommand}"
                CommandParameter="Virtual"
                Header="离线模式" />
            <MenuItem
                Command="{Binding ChangeModeCommand}"
                CommandParameter="Real"
                Header="在线模式" />
        </MenuItem>
        <MenuItem Header="|" />
        <MenuItem CommandParameter="Offline" Header="动作">

            <MenuItem
                Command="{Binding ActionCommand}"
                CommandParameter="Home"
                Header="回零" />
            <MenuItem
                Command="{Binding ActionCommand}"
                CommandParameter="Pause"
                Header="暂停" />
            <MenuItem
                Command="{Binding ActionCommand}"
                CommandParameter="Recovery"
                Header="恢复" />
        </MenuItem>
    </Menu>
    <StackPanel
        Grid.Column="2"
        Margin="20,0,0,0"
        HorizontalAlignment="Center"
        Orientation="Horizontal">

        <Border
            Margin="10,0,0,0"
            Padding="10,4"
            VerticalAlignment="Center"
            Background="{DynamicResource SecondaryRegionBrush}"
            CornerRadius="2">
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="Bold"
                Foreground="{DynamicResource PrimaryTextBrush}"
                Text="{Binding ProjectName}" />
            <hc:Interaction.Triggers>
                <hc:EventTrigger EventName="MouseDown">
                    <hc:EventToCommand Command="{Binding EnterProjCommand}" />
                </hc:EventTrigger>
            </hc:Interaction.Triggers>
        </Border>
        <TextBlock
            Margin="10"
            VerticalAlignment="Center"
            FontWeight="Bold"
            Foreground="{DynamicResource DangerBrush}"
            Text="{Binding InfoTip}" />
    </StackPanel>
    <Button
        Name="ButtonConfig"
        Grid.Column="3"
        hc:IconElement.Geometry="{StaticResource ConfigGeometry}"
        Click="ButtonConfig_OnClick"
        FontWeight="Bold"
        Style="{StaticResource ButtonIcon}" />
    <Popup
        Name="PopupConfig"
        Grid.Column="1"
        AllowsTransparency="True"
        HorizontalOffset="-20"
        PlacementTarget="{Binding ElementName=ButtonConfig}"
        StaysOpen="False"
        VerticalOffset="0">
        <Border
            Margin="16"
            Background="{DynamicResource SecondaryRegionBrush}"
            CornerRadius="4"
            Effect="{StaticResource EffectShadow2}">
            <StackPanel Orientation="Horizontal">
                <hc:UniformSpacingPanel
                    MaxHeight="134"
                    Margin="10"
                    Button.Click="ButtonLangs_OnClick"
                    ChildWrapping="Wrap"
                    Orientation="Vertical"
                    Spacing="10">
                    <Button Style="{StaticResource ButtonCustom}" Tag="zh-cn">
                        <Image Width="32" Source="/Luster.Common.Assets;component/Image/Flag/cn.png" />
                    </Button>
                    <Button Style="{StaticResource ButtonCustom}" Tag="en">
                        <Image Width="32" Source="/Luster.Common.Assets;component/Image/Flag/en.png" />
                    </Button>
                </hc:UniformSpacingPanel>
                <hc:Divider
                    Margin="0,20"
                    LineStrokeDashArray="2,2"
                    LineStrokeThickness="2"
                    Orientation="Vertical" />
                <StackPanel Margin="10,10,10,10" Button.Click="ButtonSkins_OnClick">
                    <Button Style="{StaticResource ButtonCustom}" Tag="{x:Static hc:SkinType.Default}">
                        <Border
                            Width="32"
                            Height="21"
                            Background="White"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="2" />
                    </Button>
                    <Button
                        Margin="0,10,0,0"
                        Style="{StaticResource ButtonCustom}"
                        Tag="{x:Static hc:SkinType.Dark}">
                        <Border
                            Width="32"
                            Height="21"
                            Background="Black"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="2" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Popup>
</Grid>
