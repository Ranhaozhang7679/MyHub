<Border
    x:Class="Luster.SimDevice.SubSystem.Views.LogContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    MinHeight="28"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <Border
        Background="{DynamicResource RegionBrush}"
        CornerRadius="0"
        Effect="{StaticResource EffectShadow4}">
        <TextBlock
            Margin="20,0,0,0"
            VerticalAlignment="Center"
            Foreground="{Binding ForeBrush, Converter={StaticResource String2BrushConverter}}"
            Text="{Binding LogMessage}" />
    </Border>
</Border>
