<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.ErrorContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <FrameworkElement x:Key="ProxyElement" DataContext="{Binding}" />
    </UserControl.Resources>
    <Grid Margin="5" Background="{DynamicResource RegionBrush}">
        <Grid Grid.Row="0" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox
                Name="lstDevice"
                Grid.Column="0"
                MinWidth="120"
                Margin="0,5"
                Padding="0"
                BorderThickness="0"
                ItemsSource="{Binding DeviceItems}"
                SelectedItem="{Binding SelectedDeviceItem}"
                SelectionMode="Single"
                VirtualizingStackPanel.IsVirtualizing="True">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <hc:UniformSpacingPanel
                            Background="Transparent"
                            Orientation="Vertical"
                            Spacing="10" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Width="80"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}}"
                            Style="{DynamicResource TextBlockDefault}"
                            Text="{lang:Lang Key={Binding ItemName}}"
                            TextAlignment="Center" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListBoxItemBaseStyle}" TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,5,0" />
                        <Setter Property="Background" Value="#DEE0E7" />
                        <Setter Property="hc:BorderElement.CornerRadius" Value="5" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextIconBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="SelectionChanged">
                        <hc:EventToCommand Command="{Binding SelectedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}, Path=SelectedItem}" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </ListBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Button
                        Margin="0,0,120,0"
                        Command="{Binding BatchImportCommand}"
                        Content="导入"
                        Style="{StaticResource ButtonPrimary}" Width="100" HorizontalAlignment="Right" />
                    <Button
                        Margin="0,0,0,0"
                        Command="{Binding BatchExportCommand}"
                        Content="导出"
                        Style="{StaticResource ButtonPrimary}" Width="100" HorizontalAlignment="Right" />
                </Grid>
                <DataGrid
                    Grid.Row="1"
                    Padding="-5"
                    AlternationCount="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1.5"
                    ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                    HeadersVisibility="Column"
                    IsReadOnly="False"
                    ItemsSource="{Binding ErrorDatas}"
                    RowStyle="{StaticResource CustomDataGridRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                        Width="*"
                        MinWidth="200"
                        Binding="{Binding DeviceName}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.DeviceName}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="True" />

                    <DataGridTextColumn
                        Width="150"
                        MinWidth="150"
                        Binding="{Binding Name}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="True" />

                    <DataGridTextColumn
                        Width="150"
                        MinWidth="150"
                        Binding="{Binding ErrorCode}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.AlarmCode}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="False" />

                    <DataGridTextColumn
                        Width="150"
                        MinWidth="150"
                        Binding="{Binding ErrorForeignMessage}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.AlarmConfig}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="False" />

                    <DataGridTemplateColumn
                        Width="150"
                        MinWidth="150"
                        Header="报警种类"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox
                                    ItemsSource="{Binding AlarmCategoryOptions}"
                                    SelectedItem="{Binding AlarmCategory, UpdateSourceTrigger=PropertyChanged}"
                                    IsEditable="False"
                                    HorizontalContentAlignment="Center"
                                    BorderThickness="0"
                                    Background="Transparent" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Width="150"
                        MinWidth="150"
                        Binding="{Binding RepairAction, UpdateSourceTrigger=LostFocus}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="维修动作"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        IsReadOnly="False" />

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
        <ContentControl Content="{StaticResource ProxyElement}" Visibility="Collapsed" />
    </Grid>
</UserControl>
