<UserControl x:Class="Luster.SimDevice.SubSystem.Views.PositionParameterContent"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/" 
        xmlns:viewmodel="clr-namespace:Luster.SimDevice.SubSystem.ViewModel" 
        d:DesignHeight="800"
        d:DesignWidth="1366"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Background="{DynamicResource RegionBrush}"
        Loaded="UserControl_Loaded"
        Unloaded="UserControl_Unloaded"
        mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="5"
            Background="{DynamicResource RegionBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="5">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="工站选择："/>

                <hc:ComboBox
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding StationComboBoxItems}"
                    SelectedItem="{Binding SelectedStationItem}"
                    DisplayMemberPath="DisplayName"
                    hc:InfoElement.Placeholder="请选择工站"
                    DropDownOpened="ComboBox_DropDownOpened"
                    Style="{StaticResource ComboBoxExtend}">
                </hc:ComboBox>

                <Button
                    Grid.Column="3"
                    Margin="10,0,0,0"
                    Width="80"
                    Height="25"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Command="{Binding ExportCommand}"
                    Content="导出"
                    FontSize="12"
                    Style="{StaticResource ButtonPrimary.Small}"/>
            </Grid>
        </Border>

        <Border
                Grid.Row="1"
                Margin="5"
                Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border
                      Grid.Row="0"
                      Background="{DynamicResource RegionBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="0,0,0,1"
                      x:Name="HeaderBorder">
                    <ScrollViewer
                          x:Name="HeaderScrollViewer"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          Background="Transparent">
                        <Grid x:Name="HeaderGrid" Margin="5,2" Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="Col0" Width="220" MinWidth="80" />
                                <ColumnDefinition x:Name="Col1" Width="220" MinWidth="80" />
                                <ColumnDefinition x:Name="Col2" Width="170" MinWidth="60" />
                                <ColumnDefinition x:Name="Col3" Width="120" MinWidth="60" />
                                <ColumnDefinition x:Name="Col4" Width="120" MinWidth="60" />
                                <ColumnDefinition x:Name="Col5" Width="120" MinWidth="60" />
                                <ColumnDefinition x:Name="Col6" Width="120" MinWidth="60" />
                                <ColumnDefinition x:Name="Col7" Width="120" MinWidth="80" />
                                <ColumnDefinition x:Name="Col8" Width="80" MinWidth="60" />
                            </Grid.ColumnDefinitions>

                            <GridSplitter Grid.Column="0" Width="3" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" DragDelta="GridSplitter_DragDelta" Tag="0"/>
                            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" DragDelta="GridSplitter_DragDelta" Tag="1"/>
                            <GridSplitter Grid.Column="2" Width="3" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" DragDelta="GridSplitter_DragDelta" Tag="2"/>
                            <GridSplitter Grid.Column="3" Width="3" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" DragDelta="GridSplitter_DragDelta" Tag="3"/>
                            <GridSplitter Grid.Column="4" Width="3" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" DragDelta="GridSplitter_DragDelta" Tag="4"/>
                            <GridSplitter Grid.Column="5" Width="3" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" DragDelta="GridSplitter_DragDelta" Tag="5"/>
                            <GridSplitter Grid.Column="6" Width="3" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" DragDelta="GridSplitter_DragDelta" Tag="6"/>
                            <GridSplitter Grid.Column="7" Width="3" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" DragDelta="GridSplitter_DragDelta" Tag="7"/>

                            <TextBlock Grid.Column="0" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="工站名称"/>
                            <TextBlock Grid.Column="1" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="点位名称"/>
                            <TextBlock Grid.Column="2" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="轴名称"/>
                            <TextBlock Grid.Column="3" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="当前位置"/>
                            <TextBlock Grid.Column="4" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="加速度"/>
                            <TextBlock Grid.Column="5" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="减速度"/>
                            <TextBlock Grid.Column="6" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="运动速度"/>
                            <TextBlock Grid.Column="7" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="优先级"/>
                            <TextBlock Grid.Column="8" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="操作"/>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <ScrollViewer
                        Grid.Row="1"
                        x:Name="ContentScrollViewer"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        ScrollChanged="ContentScrollViewer_ScrollChanged">
                    <ItemsControl
                            x:Name="UnifiedList"
                            ItemsSource="{Binding UnifiedRows}"
                            Background="White"
                            BorderThickness="0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                        x:Name="RowBorder"
                                        Margin="0,0,0,1"
                                        Background="White"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        MouseEnter="Row_MouseEnter"
                                        MouseLeave="Row_MouseLeave"
                                        MouseLeftButtonUp="Row_MouseLeftButtonUp"
                                        Cursor="Hand">
                                    <Grid Margin="5,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding ElementName=Col0, Path=Width}" />
                                            <ColumnDefinition Width="{Binding ElementName=Col1, Path=Width}" />
                                            <ColumnDefinition Width="{Binding ElementName=Col2, Path=Width}" />
                                            <ColumnDefinition Width="{Binding ElementName=Col3, Path=Width}" />
                                            <ColumnDefinition Width="{Binding ElementName=Col4, Path=Width}" />
                                            <ColumnDefinition Width="{Binding ElementName=Col5, Path=Width}" />
                                            <ColumnDefinition Width="{Binding ElementName=Col6, Path=Width}" />
                                            <ColumnDefinition Width="{Binding ElementName=Col7, Path=Width}" />
                                            <ColumnDefinition Width="{Binding ElementName=Col8, Path=Width}" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding StationName}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowStationName}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="1" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding PointGroup.Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowPointName}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="2" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding AxisPosItem.Name}" />
                                        <TextBlock Grid.Column="3" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding AxisPosItem.Position, StringFormat={}{0:N3}}"/>

                                        <TextBox Grid.Column="4" Width="80" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" hc:InfoElement.Placeholder="加速度" FontSize="12" Style="{StaticResource TextBoxExtend.Small}" Text="{Binding AxisPosItem.Acc, StringFormat={}{0:N3}, UpdateSourceTrigger=PropertyChanged}" Background="Transparent"/>
                                        <TextBox Grid.Column="5" Width="80" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" hc:InfoElement.Placeholder="减速度" FontSize="12" Style="{StaticResource TextBoxExtend.Small}" Text="{Binding AxisPosItem.Dec, StringFormat={}{0:N3}, UpdateSourceTrigger=PropertyChanged}" Background="Transparent"/>
                                        <TextBox Grid.Column="6" Width="80" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" hc:InfoElement.Placeholder="速度" FontSize="12" Style="{StaticResource TextBoxExtend.Small}" Text="{Binding AxisPosItem.Speed, StringFormat={}{0:N3}, UpdateSourceTrigger=PropertyChanged}" Background="Transparent"/>

                                        <hc:ComboBox Grid.Column="7" Width="100" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" DisplayMemberPath="Desc" ItemsSource="{Binding Path=DataContext.Priorities, ElementName=UnifiedList}" SelectedValue="{Binding AxisPosItem.Priority}" SelectedValuePath="Value" FontSize="12" Style="{StaticResource ComboBoxExtend}" Background="Transparent"/>

                                        <Button Grid.Column="8" Width="60" Margin="2,3" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding Path=DataContext.UpdateCommand, ElementName=UnifiedList}" CommandParameter="{Binding}" Content="更新" FontSize="12" Style="{StaticResource ButtonWarning.Small}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UnifiedRows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>