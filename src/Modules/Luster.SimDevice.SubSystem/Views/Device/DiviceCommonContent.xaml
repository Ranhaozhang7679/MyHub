<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.Device.DiviceCommonContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views.Device"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <FrameworkElement x:Key="ProxyElement" DataContext="{Binding}" />
    </UserControl.Resources>
    <GroupBox
        hc:TitleElement.Background="{DynamicResource RegionBrush}"
        Header="{lang:Lang Key={x:Static lang:LangKeys.DeviceList}}"
        Style="{StaticResource GroupBoxTab}">
        <Grid>
            <DataGrid
                AlternationCount="2"
                ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                HeadersVisibility="Column"
                ItemsSource="{Binding DeviceList}"
                RowStyle="{StaticResource CustomDataGridRowStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Brand}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Brand}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding Name}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Name}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                    <DataGridTextColumn
                        Width="200"
                        MinWidth="150"
                        Binding="{Binding SerialNumber}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.SerialNumber}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        Visibility="{Binding DataContext.IsCameraDevice, Converter={StaticResource Boolean2VisibilityConverter}, Source={StaticResource ProxyElement}}" />
                    <DataGridTextColumn
                        Width="150"
                        MinWidth="140"
                        Binding="{Binding AdapterType.Name}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.CommuncationType}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                    <DataGridTextColumn
                        Width="200"
                        MinWidth="150"
                        Binding="{Binding AdapterAddress}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.CommuncationAddress}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                    <DataGridTextColumn
                        Width="120"
                        MinWidth="120"
                        Binding="{Binding ChannelCount}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.ChannelCount}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}"
                        Visibility="{Binding DataContext.IsLightController, Converter={StaticResource Boolean2VisibilityConverter}, Source={StaticResource ProxyElement}}" />
                    <!--<DataGridTextColumn
                        Width="120"
                        MinWidth="120"
                        Binding="{Binding Gateway}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="网关"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                    <DataGridTextColumn
                        Width="60"
                        Binding="{Binding Com}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="Com"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                    <DataGridTextColumn
                        Width="60"
                        Binding="{Binding PCIe, Converter={StaticResource SlotFromatConverter}}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="插槽"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                    <DataGridTextColumn
                        Width="60"
                        Binding="{Binding Usb}"
                        CanUserSort="False"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="USB"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />-->
                    <DataGridTemplateColumn
                        Width="120"
                        MinWidth="100"
                        CanUserResize="False"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Status}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource IconSmall}" Text="{Binding Status}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Width="110"
                        MinWidth="100"
                        hc:TitleElement.HorizontalAlignment="Center"
                        CanUserResize="False"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Operation}}"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <hc:ElementGroup HorizontalContentAlignment="Center" Orientation="Horizontal">
                                    <Button
                                        Margin="0"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.EditCommand}"
                                        CommandParameter="{Binding .}"
                                        Content="{lang:Lang Key={x:Static lang:LangKeys.Edit}}"
                                        Style="{StaticResource ButtonInfo.Small}" />
                                    <Button
                                        Margin="0"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.RemoveCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{lang:Lang Key={x:Static lang:LangKeys.Delete}}"
                                        Style="{StaticResource ButtonDanger.Small}" />
                                </hc:ElementGroup>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="SelectionChanged">
                        <hc:EventToCommand Command="{Binding SelectedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </DataGrid>
            <ContentControl Content="{StaticResource ProxyElement}" Visibility="Collapsed" />
        </Grid>
    </GroupBox>
</UserControl>
