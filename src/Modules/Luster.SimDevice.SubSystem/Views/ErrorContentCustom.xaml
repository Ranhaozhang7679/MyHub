<UserControl
    x:Class="Luster.SimDevice.SubSystem.Views.ErrorContentCustom"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.SimDevice.SubSystem.Langs"
    xmlns:local="clr-namespace:Luster.SimDevice.SubSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/" xmlns:viewmodel="clr-namespace:Luster.SimDevice.SubSystem.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:ErrorContentCustomVM}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <Grid Margin="5" Background="{DynamicResource RegionBrush}">
        <Grid Grid.Row="0" Margin="0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Button
                    Margin="0,0,120,0"
                    Command="{Binding BatchImportCommand}"
                    Content="导入"
                    Style="{StaticResource ButtonPrimary}" Width="100" HorizontalAlignment="Right" />
                <Button
                    Margin="0,0,0,0"
                    Command="{Binding BatchExportCommand}"
                    Content="导出"
                    Style="{StaticResource ButtonPrimary}" Width="100" HorizontalAlignment="Right" />
            </Grid>
            <DataGrid
                    Grid.Row="1"
                    Padding="-5"
                    AlternationCount="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1.5"
                    ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                    HeadersVisibility="Column"
                    IsReadOnly="False"
                    ItemsSource="{Binding ErrorList}"
                    RowStyle="{StaticResource CustomDataGridRowStyle}"
                    SelectionMode="Single"  
                    SelectionUnit="FullRow">

                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="Unloaded">
                        <hc:EventToCommand Command="{Binding UnLoadedCommand}"  CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}, Path=ItemsSource}" />
                    </hc:EventTrigger>
                    <hc:EventTrigger EventName="SelectionChanged">
                        <hc:EventToCommand Command="{Binding SelectionChangedCommand}" 
                              CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
                <DataGrid.Columns>
                    <DataGridTextColumn
                            Width="*"
                            MinWidth="200"
                            Binding="{Binding AlarmCode, UpdateSourceTrigger=LostFocus}"
                            CanUserSort="False"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.AlarmCode}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />

                    <DataGridTextColumn
                            Width="150"
                            MinWidth="150"
                            Binding="{Binding AlarmContent, UpdateSourceTrigger=LostFocus}"
                            CanUserSort="False"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="报警内容"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />

                    <DataGridTextColumn
                            Width="150"
                            MinWidth="150"
                            Binding="{Binding AlarmEnglish, UpdateSourceTrigger=LostFocus}"
                            CanUserSort="False"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="报警英文"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
