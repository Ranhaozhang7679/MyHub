<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Luster.Control.Wpf.Motion.Controls"
    xmlns:ex="clr-namespace:Luster.Common.Assets.Extension;assembly=Luster.Common.Assets"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:interactivity="https://handyorg.github.io/handycontrol"
    xmlns:langs="clr-namespace:Luster.Common.Assets.Langs;assembly=Luster.Common.Assets"
    xmlns:local="clr-namespace:Luster.Control.Wpf.Motion"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:tx="clr-namespace:Luster.Control.Wpf.Motion.TreeEx">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ParamGrid/Generic.xaml" />
        <ResourceDictionary Source="/Luster.Control.Wpf.Motion;component/TreeEx/Common.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!--  ToolButton 菜单  -->
    <system:Double x:Key="MaxTextWidth">125</system:Double>

    <!--  文件选择器  -->
    <Style TargetType="ctrl:FileSelector">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="StrokeDashArray" Value="2,2" />
        <Setter Property="hc:IconSwitchElement.Geometry" Value="{StaticResource AddGeometry}" />
        <Setter Property="hc:IconSwitchElement.GeometrySelected" Value="{StaticResource RemoveGeometry}" />
        <Setter Property="hc:BorderElement.CornerRadius" Value="{StaticResource DefaultCornerRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctrl:FileSelector">
                    <Button
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Command="interactivity:ControlCommands.Switch"
                        Style="{StaticResource ButtonCustom}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{Binding Path=(hc:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                            <hc:DashedBorder
                                Background="{TemplateBinding PreviewBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderDashArray="{TemplateBinding StrokeDashArray}"
                                BorderDashThickness="{TemplateBinding StrokeThickness}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding Path=(hc:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                                <Border
                                    Width="30"
                                    Height="30"
                                    HorizontalAlignment="Right"
                                    Background="{TemplateBinding Background}"
                                    Style="{StaticResource BorderCircular}">
                                    <hc:ToggleBlock IsChecked="{TemplateBinding HasValue}">
                                        <hc:ToggleBlock.CheckedContent>
                                            <Path
                                                Width="12"
                                                Height="12"
                                                Data="{TemplateBinding hc:IconSwitchElement.GeometrySelected}"
                                                Fill="{DynamicResource PrimaryBrush}" />
                                        </hc:ToggleBlock.CheckedContent>
                                        <hc:ToggleBlock.UnCheckedContent>
                                            <Path
                                                Width="16"
                                                Height="16"
                                                Data="{TemplateBinding hc:IconSwitchElement.Geometry}"
                                                Fill="{DynamicResource PrimaryBrush}" />
                                        </hc:ToggleBlock.UnCheckedContent>
                                    </hc:ToggleBlock>
                                </Border>
                            </hc:DashedBorder>
                        </Border>
                    </Button>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  范围组件  -->
    <Style TargetType="ctrl:RangeCtrl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <hc:ElementGroup Layout="Stack" Orientation="Horizontal">
                            <hc:ElementGroup.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </ItemsPanelTemplate>
                            </hc:ElementGroup.ItemsPanel>
                            <hc:NumericUpDown
                                IsReadOnly="{Binding Path=IsReadOnly, RelativeSource={RelativeSource AncestorType=ctrl:RangeCtrl}}"
                                Maximum="{Binding RelativeSource={RelativeSource AncestorType={x:Type ctrl:RangeCtrl}}, Path=MaxVal}"
                                Minimum="{Binding RelativeSource={RelativeSource AncestorType={x:Type ctrl:RangeCtrl}}, Path=MinVal}"
                                Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type ctrl:RangeCtrl}}, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Path=Min}" />
                            <hc:NumericUpDown
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                IsReadOnly="{Binding Path=IsReadOnly, RelativeSource={RelativeSource AncestorType=ctrl:RangeCtrl}}"
                                Maximum="{Binding RelativeSource={RelativeSource AncestorType={x:Type ctrl:RangeCtrl}}, Path=MaxVal}"
                                Minimum="{Binding RelativeSource={RelativeSource AncestorType={x:Type ctrl:RangeCtrl}}, Path=MinVal}"
                                Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type ctrl:RangeCtrl}}, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Path=Max}" />
                        </hc:ElementGroup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  多选枚举  -->
    <Style TargetType="{x:Type ctrl:CheckGroup}">
        <Setter Property="ItemsPanel" Value="{StaticResource CheckGroupHorizontalItemsPanelTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="5" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Config 选择器  -->
    <Style TargetType="ctrl:ConfigCtrl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <hc:ElementGroup Orientation="Horizontal">
                        <hc:ElementGroup.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </ItemsPanelTemplate>
                        </hc:ElementGroup.ItemsPanel>
                        <TextBox IsReadOnly="True" Text="{Binding Path=Text, RelativeSource={RelativeSource AncestorType=ctrl:ConfigCtrl}}" />
                        <Button
                            x:Name="PART_BtnConfig"
                            Grid.Column="1"
                            hc:IconElement.Geometry="{StaticResource SearchGeometry}"
                            IsEnabled="{Binding Path=IsReadOnly, RelativeSource={RelativeSource AncestorType=ctrl:ConfigCtrl}, Converter={StaticResource Boolean2BooleanReConverter}}" />
                    </hc:ElementGroup>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Device 选择器  -->
    <Style TargetType="ctrl:DeviceCtrl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <hc:ElementGroup Orientation="Horizontal">
                        <hc:ElementGroup.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </ItemsPanelTemplate>
                        </hc:ElementGroup.ItemsPanel>
                        <TextBox IsReadOnly="True" Text="{Binding Path=Text, RelativeSource={RelativeSource AncestorType=ctrl:DeviceCtrl}}" />
                        <Button
                            x:Name="PART_BtnConfig"
                            Grid.Column="1"
                            hc:IconElement.Geometry="{StaticResource SearchGeometry}"
                            IsEnabled="{Binding Path=IsReadOnly, RelativeSource={RelativeSource AncestorType=ctrl:DeviceCtrl}, Converter={StaticResource Boolean2BooleanReConverter}}" />
                    </hc:ElementGroup>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Slave 选择器  -->
    <Style TargetType="ctrl:SlaveCtrl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <hc:ElementGroup Orientation="Horizontal">
                        <hc:ElementGroup.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </ItemsPanelTemplate>
                        </hc:ElementGroup.ItemsPanel>
                        <TextBox IsReadOnly="True" Text="{Binding Path=Text, RelativeSource={RelativeSource AncestorType=ctrl:SlaveCtrl}}" />
                        <Button
                            x:Name="PART_BtnConfig"
                            Grid.Column="1"
                            hc:IconElement.Geometry="{StaticResource SearchGeometry}"
                            IsEnabled="{Binding Path=IsReadOnly, RelativeSource={RelativeSource AncestorType=ctrl:SlaveCtrl}, Converter={StaticResource Boolean2BooleanReConverter}}" />
                    </hc:ElementGroup>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--  AlarmCtrl 选择器（只读显示报警代码，可复制文本）  -->
    <Style TargetType="ctrl:AlarmCtrl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <TextBox
                        IsReadOnly="True"
                        Text="{Binding Text, RelativeSource={RelativeSource AncestorType=ctrl:AlarmCtrl}, Mode=OneWay}"
                        BorderThickness="0"
                        Background="Transparent"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        IsReadOnlyCaretVisible="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  VAxisM 示教  -->
    <Style TargetType="ctrl:VAxisMCtrl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <hc:ElementGroup Orientation="Horizontal">
                        <hc:ElementGroup.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </ItemsPanelTemplate>
                        </hc:ElementGroup.ItemsPanel>
                        <TextBox IsReadOnly="True" Text="{Binding Path=Text, RelativeSource={RelativeSource AncestorType=ctrl:VAxisMCtrl}}" />
                        <Button
                            x:Name="PART_BtnConfig"
                            Grid.Column="1"
                            hc:IconElement.Geometry="{StaticResource SearchGeometry}"
                            IsEnabled="{Binding Path=IsReadOnly, RelativeSource={RelativeSource AncestorType=ctrl:VAxisMCtrl}, Converter={StaticResource Boolean2BooleanReConverter}}" />
                    </hc:ElementGroup>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  IpAddress  -->
    <Style TargetType="{x:Type ctrl:IpAddressCtrl}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:IpAddressCtrl}">
                    <Border
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource DefaultCornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <hc:TextBox
                                x:Name="PART_TextBox1"
                                Grid.Column="0"
                                Background="Transparent"
                                BorderThickness="0"
                                MaxLength="3"
                                Text="{Binding Path=Value1, RelativeSource={RelativeSource AncestorType=ctrl:IpAddressCtrl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextType="Int" />

                            <TextBlock
                                Grid.Column="1"
                                Width="2"
                                VerticalAlignment="Center"
                                Text="." />

                            <hc:TextBox
                                x:Name="PART_TextBox2"
                                Grid.Column="2"
                                Background="Transparent"
                                BorderThickness="0"
                                MaxLength="3"
                                Text="{Binding Path=Value2, RelativeSource={RelativeSource AncestorType=ctrl:IpAddressCtrl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextType="Int" />

                            <TextBlock
                                Grid.Column="3"
                                Width="2"
                                VerticalAlignment="Center"
                                Text="." />

                            <hc:TextBox
                                x:Name="PART_TextBox3"
                                Grid.Column="4"
                                Background="Transparent"
                                BorderThickness="0"
                                MaxLength="3"
                                Text="{Binding Path=Value3, RelativeSource={RelativeSource AncestorType=ctrl:IpAddressCtrl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextType="Int" />

                            <TextBlock
                                Grid.Column="5"
                                Width="2"
                                VerticalAlignment="Center"
                                Text="." />

                            <hc:TextBox
                                x:Name="PART_TextBox4"
                                Grid.Column="6"
                                Background="Transparent"
                                BorderThickness="0"
                                MaxLength="3"
                                Text="{Binding Path=Value4, RelativeSource={RelativeSource AncestorType=ctrl:IpAddressCtrl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextType="Int" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource SelectedBorder}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ctrl:NetworkCtrl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:NetworkCtrl}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <hc:ElementGroup Orientation="Horizontal">
                            <hc:ElementGroup.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </ItemsPanelTemplate>
                            </hc:ElementGroup.ItemsPanel>
                            <TextBox
                                IsReadOnly="True"
                                Text="{Binding RelativeSource={RelativeSource AncestorType=ctrl:NetworkCtrl}, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Path=Network, Converter={StaticResource Object2StringConverter}}"
                                TextWrapping="NoWrap" />
                            <Button
                                Name="PART_ViewButtonPOINT"
                                Grid.Column="1"
                                hc:IconElement.Geometry="{StaticResource PinPointGeometry}"
                                hc:IconElement.Width="16"
                                Foreground="Green"
                                Tag="{Binding}" />
                        </hc:ElementGroup>
                        <hc:DashedBorder
                            Grid.Row="1"
                            Margin="0,3"
                            Padding="5"
                            hc:BorderElement.CornerRadius="10"
                            BorderBrush="{DynamicResource lusterColor}"
                            BorderDashArray="2,2"
                            BorderThickness="1"
                            Visibility="{Binding RelativeSource={RelativeSource AncestorType=ctrl:NetworkCtrl}, UpdateSourceTrigger=PropertyChanged, Path=ShowPinPop, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <Grid
                                Name="pConfig"
                                Grid.Row="1"
                                Background="{DynamicResource RegionBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <ctrl:IpAddressCtrl Grid.Row="0" IpAddress="{Binding Path=Ip, RelativeSource={RelativeSource AncestorType=ctrl:NetworkCtrl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <hc:TextBox
                                    Grid.Row="1"
                                    Margin="0,4"
                                    hc:InfoElement.Placeholder="端口"
                                    MaxLength="5"
                                    Text="{Binding Path=Port, RelativeSource={RelativeSource AncestorType=ctrl:NetworkCtrl}}"
                                    TextType="Int" />
                            </Grid>
                        </hc:DashedBorder>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ctrl:LogCtrl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <RichTextBox
                            x:Name="PART_RichTextBox"
                            Grid.Row="2"
                            Margin="0"
                            Padding="5"
                            FontSize="14"
                            IsReadOnly="True" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource {x:Type ListBox}}" TargetType="{x:Type tx:TreeListBox}">
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type tx:TreeListBoxItem}">
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="{Binding LevelPadding, RelativeSource={RelativeSource Self}}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type tx:TreeListBoxItem}">
                                <Border
                                    x:Name="Bd"
                                    Margin="5,0"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="0"
                                    SnapsToDevicePixels="true">
                                    <Border
                                        x:Name="Bd2"
                                        Padding="{TemplateBinding Padding}"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ToggleButton
                                                    x:Name="Expander"
                                                    Margin="0,5,0,0"
                                                    IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                    Style="{StaticResource ExpandCollapseToggleStyle}" />
                                            </StackPanel>

                                            <ContentPresenter x:Name="content" Grid.Column="1">
                                                <ContentPresenter.InputBindings>
                                                    <MouseBinding Command="{Binding ToggleExpandCommand, RelativeSource={RelativeSource TemplatedParent}}" Gesture="LeftDoubleClick" />
                                                </ContentPresenter.InputBindings>
                                            </ContentPresenter>
                                        </Grid>
                                    </Border>
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource MouseOverBackground}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource MouseOverBorder}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.BorderBrush>
                                        <DrawingBrush
                                            TileMode="Tile"
                                            Viewport="0,0,8,8"
                                            ViewportUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <GeometryDrawing Brush="{DynamicResource BorderBrush}">
                                                        <GeometryDrawing.Geometry>
                                                            <GeometryGroup>
                                                                <RectangleGeometry Rect="0,0,50,50" />
                                                                <RectangleGeometry Rect="50,50,50,50" />
                                                            </GeometryGroup>
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Border.BorderBrush>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="HasItems" Value="false">
                                        <Setter TargetName="Expander" Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                    <Trigger Property="IsDropTarget" Value="True">
                                        <Setter TargetName="Bd2" Property="Background" Value="{StaticResource MouseOverBackground}" />
                                        <Setter TargetName="Bd2" Property="BorderBrush" Value="{StaticResource MouseOverBorder}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="true">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBackground}" />
                                        <Setter TargetName="Bd" Property="CornerRadius" Value="2" />
                                        <Setter TargetName="Bd2" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="false">
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource SelectedForeground}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>