<UserControl
    x:Class="Luster.Motion.ReportUI.Views.CTLogStatContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chart="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:converter="clr-namespace:Luster.Motion.CommonUI.Converter;assembly=Luster.Motion.CommonUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Luster.Motion.ReportUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="650"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <DockPanel>
        <Button DockPanel.Dock="Top" Content="导入 CSV" Command="{Binding ImportCsvCmd}"
                Margin="5" Padding="10,2"/>
        <TabControl ItemsSource="{Binding Pages}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel  HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" Margin="0,0,0,0"/>
                        <!-- 关闭按钮 -->
                        <Button DockPanel.Dock="Right"
                        Content="×" Padding="0"
                        Command="{Binding CloseCmd}"
                        Width="16" Height="16"
                        Margin="4,0,0,0" 
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Background="Transparent" BorderThickness="0"
                        FontSize="12" FontWeight="Bold" Foreground="black"/>
                    </DockPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate>
                    <local:CTLogChildContent/>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>

</UserControl>
