<UserControl
    x:Class="Luster.Motion.ReportUI.Views.CTReportContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.ReportUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel
                Height="40"
                Margin="0,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="{DynamicResource BackgroundBrush}"
                Orientation="Horizontal">
                <hc:DateTimePicker
                    Width="225"
                    Height="30"
                    Margin="10,0,0,0"
                    DateTimeFormat="yyyy-MM-dd HH"
                    hc:InfoElement.Placeholder="开始日期时间"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.StartTime}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="70"
                    hc:InfoElement.VerticalAlignment="Center"
                    SelectedDateTime="{Binding StartTime}"
                    Style="{StaticResource DateTimePickerExtend}" />
                <hc:DateTimePicker
                    Width="225"
                    Height="30"
                    DateTimeFormat="yyyy-MM-dd HH"
                    Margin="10,0,0,0"
                    hc:InfoElement.Placeholder="结束日期时间"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.EndTime}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="70"
                    hc:InfoElement.VerticalAlignment="Center"
                    SelectedDateTime="{Binding EndTime}"
                    Style="{StaticResource DateTimePickerExtend}" />
                <hc:SearchBar
                    Width="160"
                    Height="30"
                    Margin="10,0"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.PleaseEnterSNCode}}"
                    Command="{Binding QueryCommand}"
                    Style="{StaticResource SearchBarExtend}"
                    Text="{Binding SearchParas, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Width="100"
                    Margin="0,0,5,0"
                    Command="{Binding ExportCommand}"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.ExportData}}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Background="{DynamicResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <DataGrid
                Padding="0"
                AlternationCount="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="2"
                CanUserResizeColumns="True"
                CanUserSortColumns="False"
                ClipboardCopyMode="ExcludeHeader"
                ColumnHeaderStyle="{DynamicResource CustomDataGridColumnHeaderStyle}"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding CtItemModels}"
                RowStyle="{DynamicResource CustomDataGridRowStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="60"
                        MinWidth="60"
                        Binding="{Binding Id}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="ID" />
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding SnCode}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="SN" />
                    <DataGridTextColumn
                        Width="150"
                        MinWidth="100"
                        Binding="{Binding StationName}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Module}}" />
                    <DataGridTextColumn
                        Width="180"
                        MinWidth="120"
                        Binding="{Binding ModuleName}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Action}}" />
                    <DataGridTextColumn
                        Width="220"
                        MinWidth="200"
                        Binding="{Binding StartTime, StringFormat='yyyy-MM-dd HH:mm:ss:fff'}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.StartTime}}" />
                    <DataGridTextColumn
                        Width="220"
                        MinWidth="200"
                        Binding="{Binding EndTime, StringFormat='yyyy-MM-dd HH:mm:ss:fff'}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.EndTime}}" />
                    <DataGridTextColumn
                        Width="100"
                        MinWidth="100"
                        Binding="{Binding CtTime}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Actual_CT}}" />
                    <DataGridTextColumn
                        Width="100"
                        MinWidth="100"
                        Binding="{Binding StandardCtTime}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Target_CT}}" />
                    <DataGridTextColumn
                        Width="100"
                        MinWidth="100"
                        Binding="{Binding Differ}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Gap}}" />

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding XSpd}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.X_Speed_Actual}}" />

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding XAcc}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.X_AccelerationTime_Actual}}" />

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding XSpdTarget}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.X_Speed_Target}}" />

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding XAccTarget}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.X_Acceleration_Target}}" />

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding YSpd}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Y_Speed_Actual}}" />

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding YAcc}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Y_AccelerationTime_Actual}}" />

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding YSpdTarget}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Y_Speed_Target}}" />

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding YAccTarget}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Y_Acceleration_Target}}" />


                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding ZSpd}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Z_Speed_Actual}}" />

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding ZAcc}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Z_AccelerationTime_Actual}}" />

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding ZSpdTarget}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Z_Speed_Target}}" />

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding ZAccTarget}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Z_Acceleration_Target}}" />


                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding USpd}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.U_Speed_Actual}}" />

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding UAcc}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.U_AccelerationTime_Actual}}" />

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding USpdTarget}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.U_Speed_Target}}" />

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding UAccTarget}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.U_Acceleration_Target}}" />


                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding RSpd}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.R_Speed_Actual}}" />

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding RAcc}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.R_AccelerationTime_Actual}}" />

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding RSpdTarget}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.R_Speed_Target}}" />

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding RAccTarget}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.R_Acceleration_Target}}" />

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding Delay}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Delay}}" />

                </DataGrid.Columns>
            </DataGrid>
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <hc:NumericUpDown
                    Height="30"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.MaxPerPage}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Minimum="1"
                    Style="{StaticResource NumericUpDownExtend}"
                    Value="{Binding PerPageCount}">
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="ValueChanged">
                            <hc:EventToCommand Command="{Binding QueryCommand}" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </hc:NumericUpDown>
                <hc:Pagination
                    Margin="5,5,0,5"
                    AutoHiding="False"
                    DataCountPerPage="{Binding PerPageCount}"
                    IsJumpEnabled="True"
                    MaxPageCount="{Binding PageCount}"
                    MaxPageInterval="3"
                    PageIndex="{Binding PageIndex, Mode=TwoWay}">
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="PageUpdated">
                            <hc:EventToCommand Command="{Binding PageUpdatedCommand}" PassEventArgsToCommand="True" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </hc:Pagination>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
