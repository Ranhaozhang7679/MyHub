<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chart="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    x:Class="Luster.Motion.ReportUI.Views.TaikeAnnotatedContent"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4" VerticalAlignment="Center">
            <Button
                Content="导入曲线数据"
                Command="{Binding ImportCommand}"
                Style="{StaticResource ButtonPrimary}"
                Width="130" Margin="0,0,8,0" />
            <Button
                Content="步骤配置"
                Command="{Binding OpenStepConfigCommand}"
                Style="{StaticResource ButtonInfo}"
                Width="100" Margin="0,0,16,0" />

            <TextBlock Text="X轴间隔(ms):" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0" />
            <TextBox
                Text="{Binding XAxisStep, UpdateSourceTrigger=PropertyChanged}"
                Width="60" Height="24" VerticalAlignment="Center"
                VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />


            <!--<Separator Style="{StaticResource SeparatorVertical}" Margin="8,2" />-->
            <TextBlock Text="Y轴间隔(kgf):" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0" />
            <TextBox
                Text="{Binding YAxisStep, UpdateSourceTrigger=PropertyChanged}"
                Width="60" Height="24" VerticalAlignment="Center"
                VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
            <TextBlock Text="Y轴上限:" VerticalAlignment="Center" FontSize="12" Margin="8,0,4,0" />
            <TextBox
                Text="{Binding YAxisMax, UpdateSourceTrigger=PropertyChanged}"
                Width="60" Height="24" VerticalAlignment="Center"
                VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
            <Button
                Content="刷新"
                Command="{Binding RefreshChartCommand}"
                Width="50" Height="30" Margin="4,0,0,0" />
        </StackPanel>

        <!-- 单图表 -->
        <Border Grid.Row="1" Margin="8,4" Padding="4"
                BorderBrush="#57a9fd" BorderThickness="1">
            <chart:CartesianChart
                Series="{Binding Series}"
                XAxes="{Binding XAxes}"
                YAxes="{Binding YAxes}"
                LegendPosition="Hidden"
                TooltipPosition="Hidden" />
        </Border>
    </Grid>

</UserControl>
