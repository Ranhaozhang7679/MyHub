<UserControl
    x:Class="Luster.Motion.ReportUI.Views.ProductReportContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chart="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.ReportUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style TargetType="chart:LineSeries">
                <Setter Property="Fill" Value="Transparent" />
            </Style>
            <Style
                x:Key="ReportRadioButtonStyle"
                BasedOn="{StaticResource RadioButtonSameAsButtonDefault}"
                TargetType="RadioButton">
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SecondaryBorderBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextIconBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="5" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Border
                Grid.Row="0"
                Margin="5"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="10">
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
                    <chart:CartesianChart
                        Grid.Row="1"
                        MinWidth="{Binding ChartWidth}"
                        Margin="5"
                        Background="{DynamicResource RegionBrush}"
                        DisableAnimations="True"
                        LegendLocation="None"
                        Series="{Binding RateSeriesCollection}">
                        <chart:CartesianChart.AxisX>
                            <chart:Axis Labels="{Binding RateLabels}">
                                <chart:Axis.Separator>
                                    <chart:Separator Step="1" />
                                </chart:Axis.Separator>
                            </chart:Axis>
                        </chart:CartesianChart.AxisX>
                        <chart:CartesianChart.AxisY>
                            <chart:Axis LabelFormatter="{Binding RateFormatter}" ScrollViewer.HorizontalScrollBarVisibility="Visible" />
                        </chart:CartesianChart.AxisY>
                    </chart:CartesianChart>
                </ScrollViewer>
            </Border>

            <Border
                Grid.Row="1"
                Margin="5"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="10">
                <ScrollViewer HorizontalScrollBarVisibility="Auto">
                    <chart:CartesianChart
                        MinWidth="{Binding ChartWidth}"
                        Margin="5"
                        Background="{DynamicResource RegionBrush}"
                        DisableAnimations="True"
                        LegendLocation="Bottom"
                        Series="{Binding CapacitySeriesCollection}">
                        <chart:CartesianChart.AxisX>
                            <chart:Axis Labels="{Binding CapacityLabels}">
                                <chart:Axis.Separator>
                                    <chart:Separator Step="1" />
                                </chart:Axis.Separator>
                            </chart:Axis>
                        </chart:CartesianChart.AxisX>
                        <chart:CartesianChart.AxisY>
                            <chart:Axis LabelFormatter="{Binding CapacityFormatter}" MinValue="0" />
                        </chart:CartesianChart.AxisY>
                    </chart:CartesianChart>
                </ScrollViewer>
            </Border>
        </Grid>
        <GridSplitter Width="1" HorizontalAlignment="Right" />
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <StackPanel
                    Height="40"
                    Margin="0,5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{DynamicResource BackgroundBrush}"
                    Orientation="Horizontal">
                    <hc:DateTimePicker
                        Width="200"
                        Height="30"
                        Margin="10,0,0,0"
                        hc:InfoElement.Placeholder="开始日期时间"
                        hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.StartTime}}"
                        hc:InfoElement.TitlePlacement="Left"
                        hc:InfoElement.TitleWidth="60"
                        hc:InfoElement.VerticalAlignment="Center"
                        DateTimeFormat="yyyy-MM-dd HH"
                        SelectedDateTime="{Binding StartTime}"
                        Style="{StaticResource DateTimePickerExtend}" />
                    <hc:DateTimePicker
                        Width="200"
                        Height="30"
                        Margin="10,0,0,0"
                        hc:InfoElement.Placeholder="结束日期时间"
                        hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.EndTime}}"
                        hc:InfoElement.TitlePlacement="Left"
                        hc:InfoElement.TitleWidth="60"
                        hc:InfoElement.VerticalAlignment="Center"
                        DateTimeFormat="yyyy-MM-dd HH"
                        SelectedDateTime="{Binding EndTime}"
                        Style="{StaticResource DateTimePickerExtend}" />
                    <hc:SearchBar
                        Width="160"
                        Height="30"
                        Margin="10,0"
                        hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.PleaseEnterSNCode}}"
                        Command="{Binding QueryCommand}"
                        Style="{StaticResource SearchBarExtend}"
                        Text="{Binding SearchParas, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Command="{Binding ExportCommand}"
                        Content="{lang:Lang Key={x:Static lang:LangKeys.ExportData}}"
                        Style="{StaticResource ButtonPrimary}" />
                </StackPanel>
            </Grid>
            <Grid
                Grid.Row="1"
                Margin="5,0,0,0"
                Background="{DynamicResource BackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Visible">
                    <DataGrid
                        x:Name="DgReport"
                        Padding="-5"
                        AlternationCount="2"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="2"
                        CanUserSortColumns="False"
                        ClipboardCopyMode="ExcludeHeader"
                        ColumnHeaderStyle="{DynamicResource CustomDataGridColumnHeaderStyle}"
                        HeadersVisibility="Column"
                        HorizontalScrollBarVisibility="Auto"
                        IsReadOnly="False"
                        ItemsSource="{Binding ReportItemVMs}"
                        RowStyle="{DynamicResource CustomDataGridRowStyle}"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="100"
                                MinWidth="80"
                                Binding="{Binding Id}"
                                ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                                Header="ID" />
                            <DataGridTextColumn
                                Width="160"
                                MinWidth="140"
                                Binding="{Binding BarCode}"
                                ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.SNCode}}" />
                            <DataGridTextColumn
                                Width="140"
                                MinWidth="120"
                                Binding="{Binding Jig}"
                                ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.Fixture}}" />
                            <DataGridTextColumn
                                Width="120"
                                MinWidth="100"
                                Binding="{Binding Result}"
                                ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.FinalResult}}" />
                            <DataGridTextColumn
                                Width="120"
                                MinWidth="100"
                                Binding="{Binding NgReason}"
                                ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.NGReason}}" />
                            <DataGridTemplateColumn
                                Width="*"
                                MinWidth="100"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.PictureStoragePath}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Grid.Row="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{Binding ImagePath}">
                                            <TextBlock.TextDecorations>
                                                <TextDecoration
                                                    PenOffset="2"
                                                    PenOffsetUnit="Pixel"
                                                    PenThicknessUnit="Pixel">
                                                    <TextDecoration.Pen>
                                                        <Pen Brush="{DynamicResource PrimaryBrush}" Thickness="2">
                                                            <!--<Pen.DashStyle>
                                                            <DashStyle Dashes="2,2" />
                                                        </Pen.DashStyle>-->
                                                        </Pen>
                                                    </TextDecoration.Pen>
                                                </TextDecoration>
                                            </TextBlock.TextDecorations>
                                            <TextBlock.InputBindings>
                                                <MouseBinding Command="{Binding DataContext.ChangeSeriesCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" MouseAction="LeftDoubleClick" />
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="155"
                                MinWidth="145"
                                Binding="{Binding EnterTime, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.InboundTime}}" />
                            <DataGridTextColumn
                                Width="155"
                                MinWidth="145"
                                Binding="{Binding OutTime, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.OutBoundTime}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
                <StackPanel
                    Grid.Row="1"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <hc:NumericUpDown
                        Height="30"
                        hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.MaxPerPage}}"
                        hc:InfoElement.TitlePlacement="Left"
                        hc:InfoElement.TitleWidth="80"
                        Minimum="1"
                        Style="{StaticResource NumericUpDownExtend}"
                        Value="{Binding PerPageCount}">
                        <hc:Interaction.Triggers>
                            <hc:EventTrigger EventName="ValueChanged">
                                <hc:EventToCommand Command="{Binding QueryCommand}" />
                            </hc:EventTrigger>
                        </hc:Interaction.Triggers>
                    </hc:NumericUpDown>
                    <hc:Pagination
                        Margin="5,5,0,5"
                        AutoHiding="False"
                        DataCountPerPage="{Binding PerPageCount}"
                        IsJumpEnabled="True"
                        MaxPageCount="{Binding PageCount}"
                        MaxPageInterval="3"
                        PageIndex="{Binding PageIndex, Mode=TwoWay}">
                        <hc:Interaction.Triggers>
                            <hc:EventTrigger EventName="PageUpdated">
                                <hc:EventToCommand Command="{Binding PageUpdatedCommand}" PassEventArgsToCommand="True" />
                            </hc:EventTrigger>
                        </hc:Interaction.Triggers>
                    </hc:Pagination>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
