<UserControl
    x:Class="Luster.Motion.ReportUI.Views.ChangeContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.ReportUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel
                Height="40"
                Margin="0,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="{DynamicResource BackgroundBrush}"
                Orientation="Horizontal">
                <hc:DatePicker
                    Width="225"
                    Height="30"
                    Margin="10,0,0,0"
                    hc:InfoElement.Placeholder="开始时间"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.StartTime}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="70"
                    hc:InfoElement.VerticalAlignment="Center"
                    SelectedDate="{Binding StartTime}"
                    Style="{StaticResource DatePickerExtend}" />
                <hc:DatePicker
                    Width="225"
                    Height="30"
                    Margin="10,0,0,0"
                    hc:InfoElement.Placeholder="结束时间"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.EndTime}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="70"
                    hc:InfoElement.VerticalAlignment="Center"
                    SelectedDate="{Binding EndTime}"
                    Style="{StaticResource DatePickerExtend}" />
                <hc:SearchBar
                    Width="160"
                    Height="30"
                    Margin="10,0"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.SearchFileKeywords}}"
                    Command="{Binding QueryCommand}"
                    Style="{StaticResource SearchBarExtend}"
                    Text="{Binding SearchParas, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Background="{DynamicResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <DataGrid
                Padding="0"
                AlternationCount="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="2"
                CanUserResizeColumns="True"
                CanUserSortColumns="False"
                ClipboardCopyMode="ExcludeHeader"
                ColumnHeaderStyle="{DynamicResource CustomDataGridColumnHeaderStyle}"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding ChangeReports}"
                RowStyle="{DynamicResource CustomDataGridRowStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="60"
                        MinWidth="60"
                        Binding="{Binding ID}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="ID" />

                    <DataGridTextColumn
                        Width="100"
                        MinWidth="100"
                        Binding="{Binding ChangeType}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.ChangeType}}" />

                    <DataGridTextColumn
                        Width="150"
                        MinWidth="100"
                        Binding="{Binding Module}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Module}}" />

                    <DataGridTextColumn
                        Width="180"
                        MinWidth="120"
                        Binding="{Binding Property}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Property}}" />

                    <DataGridTextColumn
                        Width="220"
                        MinWidth="200"
                        Binding="{Binding CreateTime, StringFormat='yyyy-MM-dd HH:mm:ss:fff'}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.CreateTime}}" />

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="120"
                        Binding="{Binding Content}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Content}}" />

                    <DataGridTextColumn
                        Width="*"
                        MinWidth="120"
                        Binding="{Binding Role}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.UserName}}" />


                </DataGrid.Columns>
            </DataGrid>
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <hc:NumericUpDown
                    Height="30"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.MaxPerPage}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Minimum="1"
                    Style="{StaticResource NumericUpDownExtend}"
                    Value="{Binding PerPageCount}">
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="ValueChanged">
                            <hc:EventToCommand Command="{Binding QueryCommand}" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </hc:NumericUpDown>
                <hc:Pagination
                    Margin="5,5,0,5"
                    AutoHiding="False"
                    DataCountPerPage="{Binding PerPageCount}"
                    IsJumpEnabled="True"
                    MaxPageCount="{Binding PageCount}"
                    MaxPageInterval="3"
                    PageIndex="{Binding PageIndex, Mode=TwoWay}">
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="PageUpdated">
                            <hc:EventToCommand Command="{Binding PageUpdatedCommand}" PassEventArgsToCommand="True" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </hc:Pagination>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
