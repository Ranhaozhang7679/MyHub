<UserControl
    x:Class="Luster.Motion.ReportUI.Views.FlingMaterialContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.ReportUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel
                Height="40"
                Margin="0,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="{DynamicResource BackgroundBrush}"
                Orientation="Horizontal">
                <hc:DatePicker
                    Width="225"
                    Height="30"
                    Margin="10,0,0,0"
                    hc:InfoElement.Placeholder="开始日期时间"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.StartTime}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="70"
                    hc:InfoElement.VerticalAlignment="Center"
                    SelectedDate="{Binding StartTime}"
                    Style="{StaticResource DatePickerExtend}" />
                <hc:DatePicker
                    Width="225"
                    Height="30"
                    Margin="10,0,0,0"
                    hc:InfoElement.Placeholder="结束日期时间"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.EndTime}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="70"
                    hc:InfoElement.VerticalAlignment="Center"
                    SelectedDate="{Binding EndTime}"
                    Style="{StaticResource DatePickerExtend}" />
                <hc:SearchBar
                    Width="160"
                    Height="30"
                    Margin="10,0"
                    hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.EnterStationName}}"
                    Command="{Binding QueryCommand}"
                    Style="{StaticResource SearchBarExtend}"
                    Text="{Binding SearchParas, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Background="{DynamicResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <DataGrid
                Padding="0"
                AlternationCount="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="2"
                CanUserResizeColumns="True"
                CanUserSortColumns="False"
                ColumnHeaderStyle="{DynamicResource CustomDataGridColumnHeaderStyle}"
                HeadersVisibility="Column"
                ItemsSource="{Binding ItemModels}"
                RowStyle="{DynamicResource CustomDataGridRowStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="60"
                        MinWidth="60"
                        Binding="{Binding ID}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="ID" />
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding Station}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.StationName}}" />
                    <DataGridTextColumn
                        Width="170"
                        MinWidth="150"
                        Binding="{Binding Material}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.AccessoriesName}}" />
                    <DataGridTextColumn
                        Width="180"
                        MinWidth="120"
                        Binding="{Binding Reason}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Reason}}" />
                    <DataGridTextColumn
                        Width="220"
                        MinWidth="200"
                        Binding="{Binding CreateTime, StringFormat='yyyy-MM-dd HH:mm:ss:fff'}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.CreateTime}}" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <hc:NumericUpDown
                    Height="30"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.MaxPerPage}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Minimum="1"
                    Style="{StaticResource NumericUpDownExtend}"
                    Value="{Binding PerPageCount}">
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="ValueChanged">
                            <hc:EventToCommand Command="{Binding QueryCommand}" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </hc:NumericUpDown>
                <hc:Pagination
                    Margin="5,5,0,5"
                    AutoHiding="False"
                    DataCountPerPage="{Binding PerPageCount}"
                    IsJumpEnabled="True"
                    MaxPageCount="{Binding PageCount}"
                    MaxPageInterval="3"
                    PageIndex="{Binding PageIndex, Mode=TwoWay}">
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="PageUpdated">
                            <hc:EventToCommand Command="{Binding PageUpdatedCommand}" PassEventArgsToCommand="True" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </hc:Pagination>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
