<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chart="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:converter="clr-namespace:Luster.Motion.CommonUI.Converter;assembly=Luster.Motion.CommonUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Luster.Motion.ReportUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:Motion="clr-namespace:Luster.Control.Wpf.Motion;assembly=Luster.Control.Wpf.Motion"
    x:Class="Luster.Motion.ReportUI.Views.TaikeContent"
    d:DesignHeight="650"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--<Grid Grid.Row="0" Visibility="{Binding IsVisible, Converter={StaticResource Boolean2VisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <hc:SimplePanel
                Grid.Row="0"
                Height="32"
                Background="#F4F6FA">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource PrimaryBrush}"
                    Style="{StaticResource TextBlockDefaultBold}"
                    Text="扭力曲线" />
                <Button
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    hc:IconElement.Geometry="{StaticResource SettingGeometry}"
                    Command="{Binding SetCommand}"
                    Foreground="{DynamicResource PrimaryBrush}"
                    IsEnabled="{Binding BtnEnable}"
                    Style="{StaticResource ButtonIcon}"
                    Visibility="Hidden" />
            </hc:SimplePanel>
        </Grid>-->

        <Grid Grid.Row="0" MinHeight="600" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Row 1 -->
            <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed" />

            <!-- AngleTorque -->
            <Border Grid.Row="1" Grid.Column="0" Margin="4" Padding="4" BorderBrush="#57a9fd" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="2" FontSize="12" Text="AngleTorque" />
                    <chart:CartesianChart x:Name="AngleTorqueChart" Margin="0" TooltipPosition="Hidden" />
                </DockPanel>
            </Border>

            <!-- TimeTorque -->
            <Border Grid.Row="1" Grid.Column="1" Margin="4" Padding="4" BorderBrush="#57a9fd" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="2" FontSize="12" Text="Torque/Angle/Press-time" />
                    <chart:CartesianChart x:Name="Time_TorqueAnglePressChart" Margin="0" TooltipPosition="Hidden" />
                </DockPanel>
            </Border>

            <!-- TimePress -->
            <Border Grid.Row="1" Grid.Column="2" Margin="4" Padding="4" BorderBrush="#57a9fd" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="2" FontSize="12" Text="Press" />
                    <chart:CartesianChart x:Name="TimePressChart" Margin="0" TooltipPosition="Hidden" />
                </DockPanel>
            </Border>

            <!-- ToeIn XForce -->
            <Border Grid.Row="2" Grid.Column="0" Margin="4" Padding="4" BorderBrush="#57a9fd" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="2" FontSize="12" Text="ToeIn XForce" />
                    <chart:CartesianChart x:Name="ToeInXForceChart" Margin="0" TooltipPosition="Hidden" />
                </DockPanel>
            </Border>

            <!-- ToeIn YForce -->
            <Border Grid.Row="2" Grid.Column="1" Margin="4" Padding="4" BorderBrush="#57a9fd" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="2" FontSize="12" Text="ToeIn YForce" />
                    <chart:CartesianChart x:Name="ToeInYForceChart" Margin="0" TooltipPosition="Hidden" />
                </DockPanel>
            </Border>

            <!-- ToeIn ZForce -->
            <Border Grid.Row="2" Grid.Column="2" Margin="4" Padding="4" BorderBrush="#57a9fd" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="2" FontSize="12" Text="ToeIn ZForce" />
                    <chart:CartesianChart x:Name="ToeInZForceChart" Margin="0" TooltipPosition="Hidden" />
                </DockPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,2">
            <StackPanel.Resources>
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="FontSize" Value="10" />
                </Style>
            </StackPanel.Resources>
            <CheckBox Content="启用时间筛选"
                      IsChecked="{Binding EnableTimeFilter}"
                      VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" />
            <hc:DateTimePicker Width="210" Height="28"
                               SelectedDateTime="{Binding FilterStartTime}"
                               DateTimeFormat="yyyy-MM-dd HH:mm:ss"
                               hc:InfoElement.Title="开始"
                               hc:InfoElement.TitlePlacement="Left"
                               hc:InfoElement.TitleWidth="40"
                               Style="{StaticResource DateTimePickerExtend}" />
            <hc:DateTimePicker Width="210" Height="28" Margin="10,0,0,0"
                               SelectedDateTime="{Binding FilterEndTime}"
                               DateTimeFormat="yyyy-MM-dd HH:mm:ss"
                               hc:InfoElement.Title="结束"
                               hc:InfoElement.TitlePlacement="Left"
                               hc:InfoElement.TitleWidth="40"
                               Style="{StaticResource DateTimePickerExtend}" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,4">
            <Button
                        Margin="0,0,10,0"
                        Command="{Binding ImportTotalCommand}"
                        Content="导入曲线"
                        Style="{StaticResource ButtonPrimary}" Width="150" />
            <Button
                        Margin="10,0,0,0"
                        Command="{Binding ImportTotalAutoCommand}"
                        Content="一键导入"
                        Style="{StaticResource ButtonPrimary}" Width="150" />
        </StackPanel>

    </Grid>

    <hc:Interaction.Triggers>
        <hc:EventTrigger EventName="Loaded">
            <hc:EventToCommand Command="{Binding GetChartControls}">
                <hc:EventToCommand.CommandParameter>
                    <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                        <Binding ElementName="AngleTorqueChart" />
                    </MultiBinding>
                </hc:EventToCommand.CommandParameter>
            </hc:EventToCommand>
            <hc:EventToCommand Command="{Binding GetPressChartControls}">
                <hc:EventToCommand.CommandParameter>
                    <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                        <Binding ElementName="TimePressChart" />
                    </MultiBinding>
                </hc:EventToCommand.CommandParameter>
            </hc:EventToCommand>
            <hc:EventToCommand Command="{Binding GetTorqueChartControls}">
                <hc:EventToCommand.CommandParameter>
                    <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                        <Binding ElementName="Time_TorqueAnglePressChart" />
                    </MultiBinding>
                </hc:EventToCommand.CommandParameter>
            </hc:EventToCommand>

            <hc:EventToCommand Command="{Binding GetToeinXForceChartControls}">
                <hc:EventToCommand.CommandParameter>
                    <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                        <Binding ElementName="ToeInXForceChart" />
                    </MultiBinding>
                </hc:EventToCommand.CommandParameter>
            </hc:EventToCommand>

            <hc:EventToCommand Command="{Binding GetToeinYForceChartControls}">
                <hc:EventToCommand.CommandParameter>
                    <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                        <Binding ElementName="ToeInYForceChart" />
                    </MultiBinding>
                </hc:EventToCommand.CommandParameter>
            </hc:EventToCommand>

            <hc:EventToCommand Command="{Binding GetToeinZForceChartControls}">
                <hc:EventToCommand.CommandParameter>
                    <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                        <Binding ElementName="ToeInZForceChart" />
                    </MultiBinding>
                </hc:EventToCommand.CommandParameter>
            </hc:EventToCommand>
        </hc:EventTrigger>
    </hc:Interaction.Triggers>

</UserControl>
