<UserControl
    x:Class="Luster.Motion.ReportUI.Views.CTLogChildContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chart="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:converter="clr-namespace:Luster.Motion.CommonUI.Converter;assembly=Luster.Motion.CommonUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Luster.Motion.ReportUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="650"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <DataGrid x:Name="dataGrid"
              ItemsSource="{Binding GridRows}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              IsReadOnly="True"
              RowHeaderWidth="0"
              GridLinesVisibility="All"
              VerticalGridLinesBrush="LightGray"
              HorizontalGridLinesBrush="LightGray"
              HeadersVisibility="Column">
        <DataGrid.Resources>
            <Style x:Key="CenterHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <!-- 关键：让列头容器足够高 -->
                <Setter Property="MinHeight" Value="150"/>
                <Setter Property="Padding" Value="2,4"/>
                <!-- 允许内容自动换行 -->
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    VerticalAlignment="Center"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </DataGrid.Resources>
        <DataGrid.RowStyle>
        <Style TargetType="DataGridRow">
            <!-- Target行样式 -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTargetRow}" Value="True">
                    <Setter Property="Background" Value="#FFA8D8A8"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Height"      Value="24"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        </DataGrid.RowStyle>
        <!-- 行头模板：把 RowHeaderText 显示出来 (没效果)
        <DataGrid.RowHeaderTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding TargetText}"
                       VerticalAlignment="Center"
                       Margin="4,0,0,0"/>
            </DataTemplate>
        </DataGrid.RowHeaderTemplate>-->
        <DataGrid.Columns>
            <!-- 1. 开始时间 -->
                <DataGridTextColumn Header="开始时间" Binding="{Binding StartTime}" HeaderStyle="{StaticResource CenterHeaderStyle}"/>
            <!-- 2. SN -->
                <DataGridTextColumn Header="SN"       Binding="{Binding SN}" HeaderStyle="{StaticResource CenterHeaderStyle}"/>

            <!-- 3. 动态动作列（后置代码加） -->
        </DataGrid.Columns>
    </DataGrid>

</UserControl>
