<UserControl
    x:Class="Luster.Motion.ReportUI.Views.ToeInContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chart="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:converter="clr-namespace:Luster.Motion.CommonUI.Converter;assembly=Luster.Motion.CommonUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Luster.Motion.ReportUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="650"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Visibility="{Binding IsVisible, Converter={StaticResource Boolean2VisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <hc:SimplePanel
                Grid.Row="0"
                Height="32"
                Background="#F4F6FA">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource PrimaryBrush}"
                    Style="{StaticResource TextBlockDefaultBold}"
                    Text="ToeIn压力曲线" />
                <Button
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    hc:IconElement.Geometry="{StaticResource SettingGeometry}"
                    Command="{Binding SetCommand}"
                    Foreground="{DynamicResource PrimaryBrush}"
                    IsEnabled="{Binding BtnEnable}"
                    Style="{StaticResource ButtonIcon}"
                    Visibility="Hidden" />
            </hc:SimplePanel>
        </Grid>

        <Grid Grid.Row="1" MinHeight="600" Margin="0,0,0,-20">

            <Grid.RowDefinitions>
                <RowDefinition />
            </Grid.RowDefinitions>
            <Border
                Grid.Row="0"
                Margin="2,2,2,98"
                BorderBrush="#57a9fd"
                BorderThickness="1"
                CornerRadius="0" Grid.RowSpan="2">
                <Grid
                    x:Name="parent_chart_time"
                    Grid.Row="0"
                    Background="{DynamicResource RegionBrush}" Margin="0,0,0,-129">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MinWidth="385" />
                        <ColumnDefinition Width="175" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>
                            <chart:CartesianChart Name="AngleTorqueChart" IsHitTestVisible="False" 
                                 MaxHeight="1000" Margin="1,20,1,10" />

                            <chart:CartesianChart Name="TimePressChart" IsHitTestVisible="False" 
                                 MaxHeight="1000" Margin="1,10,1,10" Grid.Row="1"      />
                        </Grid>

                        <Grid  Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>
                            <chart:CartesianChart Name="TimeTorqueChart" IsHitTestVisible="False" 
                                 MaxHeight="1000" Margin="1,20,1,10" />
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Vertical">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="10" />
                            </Style>
                        </StackPanel.Resources>
                        <!--<Button
                             Margin="0,50,0,50"
                        Command="{Binding ImportCommand}"
                        Content="导入角度扭矩数据"
                        Style="{StaticResource ButtonPrimary}" Width="150" />-->
                        <Button
                        Margin="0,50,0,0"
                        Command="{Binding ImportTotalCommand}"
                        Content="导入三曲线"
                        Style="{StaticResource ButtonPrimary}" Width="150" />

                        <Label
                        Margin="0"
                        Content="X->Y->Z"
                         Width="200"  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

    </Grid>

    <hc:Interaction.Triggers>
        <hc:EventTrigger EventName="Loaded">
            <hc:EventToCommand Command="{Binding GetChartControls}">
                <hc:EventToCommand.CommandParameter>
                    <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                        <Binding ElementName="AngleTorqueChart" />
                    </MultiBinding>
                </hc:EventToCommand.CommandParameter>
            </hc:EventToCommand>
            <hc:EventToCommand Command="{Binding GetPressChartControls}">
                <hc:EventToCommand.CommandParameter>
                    <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                        <Binding ElementName="TimePressChart" />
                    </MultiBinding>
                </hc:EventToCommand.CommandParameter>
            </hc:EventToCommand>
            <hc:EventToCommand Command="{Binding GetTorqueChartControls}">
                <hc:EventToCommand.CommandParameter>
                    <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                        <Binding ElementName="TimeTorqueChart" />
                    </MultiBinding>
                </hc:EventToCommand.CommandParameter>
            </hc:EventToCommand>
        </hc:EventTrigger>
    </hc:Interaction.Triggers>

</UserControl>
