<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chart="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:measure="clr-namespace:LiveChartsCore.Measure;assembly=LiveChartsCore"
    xmlns:prism="http://prismlibrary.com/"
    x:Class="Luster.Motion.SubSystem.Views.DHVCMMonitorContent"
    d:DesignHeight="600"
    d:DesignWidth="1200"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 第一行：重置监听 + Time-Press 参数（字号 14，控件尺寸加倍） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,2">
            <Button Content="重置监听"
                    Command="{Binding ResetWatchersCommand}"
                    Width="130" Height="30" Margin="0,0,12,0"
                    FontSize="14" Padding="6,0"
                    Style="{StaticResource ButtonInfo}" />
            <TextBlock Text="【Time-Press】" FontWeight="Bold" VerticalAlignment="Center"
                       FontSize="14" Margin="0,0,6,0" Foreground="#57a9fd" />
            <TextBlock Text="X间隔(ms):" VerticalAlignment="Center" FontSize="14" Margin="0,0,3,0" />
            <TextBox Text="{Binding XAxisStep, UpdateSourceTrigger=PropertyChanged}"
                     Width="100" Height="28" VerticalAlignment="Center"
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="14" />
            <TextBlock Text="Y间隔(kgf):" VerticalAlignment="Center" FontSize="14" Margin="6,0,3,0" />
            <TextBox Text="{Binding YAxisStep, UpdateSourceTrigger=PropertyChanged}"
                     Width="100" Height="28" VerticalAlignment="Center"
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="14" />
            <TextBlock Text="Y上限(0自动):" VerticalAlignment="Center" FontSize="14" Margin="6,0,3,0" />
            <TextBox Text="{Binding YAxisMax, UpdateSourceTrigger=PropertyChanged}"
                     Width="100" Height="28" VerticalAlignment="Center"
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="14" />
            <CheckBox Content="只显示正数" IsChecked="{Binding OnlyShowPositiveIsEnabled, Mode=TwoWay}"
                      VerticalAlignment="Center" Margin="10,0,10,0" FontSize="14" />
            <CheckBox Content="平滑曲线" IsChecked="{Binding SmoothCurveProcessingsEnabled, Mode=TwoWay}"
                      VerticalAlignment="Center" Margin="0,0,6,0" FontSize="14" />
            <TextBlock Text="窗口:" VerticalAlignment="Center" FontSize="14" Margin="6,0,6,0" Foreground="#555" />
            <Slider Width="200" VerticalAlignment="Center"
                    Minimum="3" Maximum="51" TickFrequency="2" IsSnapToTickEnabled="True"
                    Value="{Binding SliderValue}" />
        </StackPanel>

        <!-- 第二行：Time-Position 参数 + 刷新 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,2">
            <TextBlock Text="【Time-Position】" FontWeight="Bold" VerticalAlignment="Center"
                       FontSize="14" Margin="0,0,6,0" Foreground="#57a9fd" />
            <TextBlock Text="Y间隔(mm):" VerticalAlignment="Center" FontSize="14" Margin="0,0,3,0" />
            <TextBox Text="{Binding YAxisStep2, UpdateSourceTrigger=PropertyChanged}"
                     Width="100" Height="28" VerticalAlignment="Center"
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="14" />
            <TextBlock Text="Y上限(mm,0自动):" VerticalAlignment="Center" FontSize="14" Margin="6,0,3,0" />
            <TextBox Text="{Binding YAxisMax2, UpdateSourceTrigger=PropertyChanged}"
                     Width="100" Height="28" VerticalAlignment="Center"
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="14" />
            <Button Content="刷新" Command="{Binding RefreshChartParamsCommand}"
                    Width="90" Height="30" Margin="12,0,0,0"
                    FontSize="14" Padding="6,0"
                    Style="{StaticResource ButtonInfo}" />
        </StackPanel>

        <!-- 第三行：今天标签 + 工位状态 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,2">
            <TextBlock Text="{Binding TodayLabel}" FontWeight="Bold"
                       VerticalAlignment="Center" FontSize="14"
                       Foreground="#57a9fd" Margin="0,0,20,0" />
            <TextBlock Text="工位一(NUM1):" VerticalAlignment="Center"
                       FontSize="14" Margin="10,0,4,0" Foreground="#555" />
            <TextBlock Text="{Binding StationStatus1}" VerticalAlignment="Center"
                       FontSize="14" Margin="0,0,20,0" />
            <TextBlock Text="工位二(NUM2):" VerticalAlignment="Center"
                       FontSize="14" Margin="10,0,4,0" Foreground="#555" />
            <TextBlock Text="{Binding StationStatus2}" VerticalAlignment="Center"
                       FontSize="14" />
        </StackPanel>

        <!-- 主区：左右双 CartesianChart，每个工位双 Y 轴合并图 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,2,0" Padding="2"
                    BorderBrush="#57a9fd" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="NUM1 / 工位一 - Time-Press / Time-Position"
                               FontWeight="Bold" HorizontalAlignment="Center"
                               FontSize="14" Margin="0,0" />
                    <chart:CartesianChart Grid.Row="1"
                        Series="{Binding SeriesMerge1}"
                        XAxes="{Binding XAxesMerge1}"
                        YAxes="{Binding YAxesMerge1}"
                        LegendPosition="Hidden"
                        TooltipPosition="Hidden">
                        <chart:CartesianChart.DrawMargin>
                            <measure:Margin Left="6" Top="4" Right="6" Bottom="4" />
                        </chart:CartesianChart.DrawMargin>
                    </chart:CartesianChart>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="2,0,0,0" Padding="2"
                    BorderBrush="#57a9fd" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="NUM2 / 工位二 - Time-Press / Time-Position"
                               FontWeight="Bold" HorizontalAlignment="Center"
                               FontSize="14" Margin="0,0" />
                    <chart:CartesianChart Grid.Row="1"
                        Series="{Binding SeriesMerge2}"
                        XAxes="{Binding XAxesMerge2}"
                        YAxes="{Binding YAxesMerge2}"
                        LegendPosition="Hidden"
                        TooltipPosition="Hidden">
                        <chart:CartesianChart.DrawMargin>
                            <measure:Margin Left="6" Top="4" Right="6" Bottom="4" />
                        </chart:CartesianChart.DrawMargin>
                    </chart:CartesianChart>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
