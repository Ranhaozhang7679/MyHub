<UserControl
    x:Class="Luster.Motion.SubSystem.Views.IntegratedHardwareContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.SubSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="600"
    d:DesignWidth="1200"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#F8F9FA"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标签页导航 - 下划线样式 -->
        <Grid Grid.Row="0" Background="#FFFFFF" Margin="24,24,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 配置标签页 -->
            <Border Grid.Column="0" Padding="0,0,24,0" Cursor="Hand">
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="MouseLeftButtonUp">
                        <hc:EventToCommand Command="{Binding SelectTabCommand}" CommandParameter="0" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="Normal">
                        <Run Text="1. " />
                        <Run Text="{lang:Lang Key={x:Static lang:LangKeys.Configuration}}" />
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#6B7280" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                        <Setter Property="Foreground" Value="#3B82F6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Height="2" Margin="0,12,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                        <Setter Property="Background" Value="#3B82F6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 调试标签页 -->
            <Border Grid.Column="1" Padding="0,0,24,0" Cursor="Hand">
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="MouseLeftButtonUp">
                        <hc:EventToCommand Command="{Binding SelectTabCommand}" CommandParameter="1" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="Normal">
                        <Run Text="2. " />
                        <Run Text="{lang:Lang Key={x:Static lang:LangKeys.Debug}}" />
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#6B7280" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                        <Setter Property="Foreground" Value="#3B82F6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Height="2" Margin="0,12,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                        <Setter Property="Background" Value="#3B82F6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 数字架线标签页 -->
            <Border Grid.Column="2" Cursor="Hand">
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="MouseLeftButtonUp">
                        <hc:EventToCommand Command="{Binding SelectTabCommand}" CommandParameter="2" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="Normal">
                        <Run Text="3. " />
                        <Run Text="{lang:Lang Key={x:Static lang:LangKeys.DigitalAss}}" />
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#6B7280" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                        <Setter Property="Foreground" Value="#3B82F6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Height="2" Margin="0,12,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                        <Setter Property="Background" Value="#3B82F6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 内容区域 -->
        <Grid Grid.Row="1" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 配置标签页内容 -->
            <Grid Grid.Column="0" Grid.ColumnSpan="3">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex, FallbackValue=0}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedTabIndex, FallbackValue=0}" Value="1">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedTabIndex, FallbackValue=0}" Value="2">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 配置侧边栏 -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <!-- 侧边栏标题 -->
                        <TextBlock
                            Margin="24,24,24,16"
                            FontSize="14"
                            FontWeight="Normal"
                            Foreground="#6B7280"
                            Text="{lang:Lang Key={x:Static lang:LangKeys.Configuration}}" />

                        <!-- 配置菜单项 -->
                        <ItemsControl ItemsSource="{Binding ConfigPages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Height="48"
                                        Padding="24,0,24,0"
                                        Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#EFF6FF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <!-- 左边框指示器 -->
                                            <Border
                                                Width="3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Stretch">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#3B82F6" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- 菜单项文本 -->
                                            <TextBlock
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="Normal">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}. {1}">
                                                        <Binding Path="Index" />
                                                        <Binding Path="DisplayName" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#374151" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="#3B82F6" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <hc:Interaction.Triggers>
                                            <hc:EventTrigger EventName="MouseLeftButtonUp">
                                                <hc:EventToCommand
                                                    Command="{Binding DataContext.NavigateConfigCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}" />
                                            </hc:EventTrigger>
                                        </hc:Interaction.Triggers>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 分隔线 -->
                <Border Grid.Column="1" Width="1" Background="#E5E7EB" />

                <!-- 配置内容区域 -->
                <hc:ScrollViewer Grid.Column="2" Background="#FFFFFF">
                    <Grid>
                        <!-- 页面标题 -->
                        <TextBlock
                            Margin="24,24,24,0"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#111827">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}. {1}">
                                    <Binding Path="SelectedConfigIndex" />
                                    <Binding Path="SelectedConfigDisplayName" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <!-- 占位符提示 -->
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowConfigPlaceholder, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <TextBlock FontSize="24" Foreground="#9CA3AF" Text="功能开发中" />
                            <TextBlock
                                Margin="0,12,0,0"
                                FontSize="14"
                                Foreground="#9CA3AF"
                                Text="此功能暂未开放，敬请期待" />
                        </StackPanel>

                        <!-- 内容区域 -->
                        <ContentControl
                            Margin="24,60,24,24"
                            prism:RegionManager.RegionName="ConfigContentRegion" />
                    </Grid>
                </hc:ScrollViewer>
            </Grid>

            <!-- 调试标签页内容 -->
            <Grid Grid.Column="0" Grid.ColumnSpan="3">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex, FallbackValue=0}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedTabIndex, FallbackValue=0}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedTabIndex, FallbackValue=0}" Value="2">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 调试侧边栏 -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <!-- 侧边栏标题 -->
                        <TextBlock
                            Margin="24,24,24,16"
                            FontSize="14"
                            FontWeight="Normal"
                            Foreground="#6B7280"
                            Text="{lang:Lang Key={x:Static lang:LangKeys.DebugFunction}}" />

                        <!-- 调试菜单项 -->
                        <ItemsControl ItemsSource="{Binding DebugPages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Height="48"
                                        Padding="24,0,24,0"
                                        Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#EFF6FF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <!-- 左边框指示器 -->
                                            <Border
                                                Width="3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Stretch">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#3B82F6" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- 菜单项文本 -->
                                            <TextBlock
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="Normal">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}. {1}">
                                                        <Binding Path="Index" />
                                                        <Binding Path="DisplayName" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#374151" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="#3B82F6" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <hc:Interaction.Triggers>
                                            <hc:EventTrigger EventName="MouseLeftButtonUp">
                                                <hc:EventToCommand
                                                    Command="{Binding DataContext.NavigateDebugCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}" />
                                            </hc:EventTrigger>
                                        </hc:Interaction.Triggers>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 分隔线 -->
                <Border Grid.Column="1" Width="1" Background="#E5E7EB" />

                <!-- 调试内容区域 -->
                <Border Grid.Column="2" Background="#FFFFFF">
                    <Grid>
                        <!-- 页面标题 -->
                        <TextBlock
                            Margin="24,24,24,0"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#111827">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}. {1}">
                                    <Binding Path="SelectedDebugIndex" />
                                    <Binding Path="SelectedDebugDisplayName" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <!-- 占位符提示 -->
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowDebugPlaceholder, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <TextBlock FontSize="24" Foreground="#9CA3AF" Text="功能开发中" />
                            <TextBlock
                                Margin="0,12,0,0"
                                FontSize="14"
                                Foreground="#9CA3AF"
                                Text="此功能暂未开放，敬请期待" />
                        </StackPanel>

                        <!-- 内容区域 -->
                        <ContentControl
                            Margin="24,60,24,24"
                            prism:RegionManager.RegionName="DebugContentRegion" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 数字架线标签页内容 -->
            <Grid Grid.Column="0" Grid.ColumnSpan="3">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTabIndex, FallbackValue=0}" Value="2">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedTabIndex, FallbackValue=0}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedTabIndex, FallbackValue=0}" Value="1">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 数字架线侧边栏 -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
                    <StackPanel>
                        <!-- 侧边栏标题 -->
                        <TextBlock
                            Margin="24,24,24,16"
                            FontSize="14"
                            FontWeight="Normal"
                            Foreground="#6B7280"
                            Text="数字架线" />

                        <!-- 占位提示 -->
                        <TextBlock
                            Margin="24,16,24,0"
                            FontSize="14"
                            Foreground="#9CA3AF"
                            Text="（功能开发中...）" />
                    </StackPanel>
                </Border>

                <!-- 分隔线 -->
                <Border Grid.Column="1" Width="1" Background="#E5E7EB" />

                <!-- 数字架线内容区域 -->
                <Border Grid.Column="2" Background="#FFFFFF">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock FontSize="24" Foreground="#9CA3AF" Text="数字架线功能" />
                        <TextBlock
                            Margin="0,12,0,0"
                            FontSize="14"
                            Foreground="#9CA3AF"
                            Text="由其他团队开发，敬请期待" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
