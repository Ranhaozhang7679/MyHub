<UserControl
    x:Class="Luster.Motion.SubSystem.Views.MainRightContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chart="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Luster.Motion.SubSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="*" />
            <RowDefinition Height="240" />
        </Grid.RowDefinitions>
        <Grid Width="300">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="border"
                Grid.Row="2"
                Grid.RowSpan="2"
                Grid.Column="2"
                Grid.ColumnSpan="2"
                Width="90"
                Height="90"
                Margin="5"
                CornerRadius="100">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#b0da97" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProductResult}" Value="OK">
                                <Setter Property="Background" Value="#b0da97" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ProductResult}" Value="NG">
                                <Setter Property="Background" Value="#e1928b" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock
                    x:Name="resultTxt"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="20"
                    Text="{Binding ProductResult}" />
            </Border>
            <chart:Gauge
                Grid.Row="1"
                Grid.RowSpan="2"
                Grid.Column="1"
                Grid.ColumnSpan="4"
                Margin="5"
                Foreground="Transparent"
                GaugeActiveFill="#e1928b"
                GaugeBackground="#b0da97"
                HighFontSize="20"
                InnerRadius="50"
                LabelsVisibility="Collapsed"
                Uses360Mode="False"
                Value="{Binding NYield}"
                From="0"
                To="100" />
            <chart:Gauge
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="0"
                Grid.ColumnSpan="6"
                Margin="5"
                Foreground="Transparent"
                FromColor="White"
                GaugeActiveFill="#b0da97"
                GaugeBackground="#e1928b"
                HighFontSize="20"
                InnerRadius="100"
                LabelsVisibility="Collapsed"
                Uses360Mode="False"
                Value="{Binding Yield}"
                From="0"
                To="100" />
            <StackPanel
                Grid.Row="3"
                Grid.Column="0"
                Orientation="Vertical">
                <TextBlock HorizontalAlignment="Center" Text="OK率" />
                <TextBlock HorizontalAlignment="Center" Text="{Binding Yield, StringFormat={}{0}%}" />
            </StackPanel>
            <StackPanel
                Grid.Row="3"
                Grid.Column="5"
                Orientation="Vertical">
                <TextBlock HorizontalAlignment="Left" Text="{Binding OkCount, StringFormat={}{0}/}" />
                <TextBlock HorizontalAlignment="Left" Text="{Binding ProductCount}" />
            </StackPanel>
            <StackPanel
                Grid.Row="3"
                Grid.Column="1"
                Orientation="Vertical">
                <TextBlock HorizontalAlignment="Center" Text="NG率" />
                <TextBlock HorizontalAlignment="Center" Text="{Binding NYield, StringFormat={}{0}%}" />
            </StackPanel>
            <StackPanel
                Grid.Row="3"
                Grid.Column="4"
                Orientation="Vertical">
                <TextBlock HorizontalAlignment="Left" Text="{Binding NgCount, StringFormat={}{0}/}" />
                <TextBlock HorizontalAlignment="Left" Text="{Binding ProductCount}" />
            </StackPanel>
        </Grid>
        <StackPanel Orientation="Vertical">
            <Button
                Grid.Column="5"
                Width="40"
                Height="40"
                Margin="5"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                hc:IconElement.Geometry="{StaticResource HomeChangeGeometry}"
                hc:IconElement.Height="35"
                hc:IconElement.Width="35"
                Command="{Binding HomeChangeCommand}"
                Foreground="{DynamicResource PrimaryTextBrush}"
                Style="{DynamicResource ButtonIcon}" />

            <Button
                Width="40"
                Height="40"
                Margin="5"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                hc:IconElement.Geometry="{StaticResource ResetCountGeometry}"
                hc:IconElement.Height="35"
                hc:IconElement.Width="35"
                Command="{Binding ResetProductCommand}"
                Foreground="{DynamicResource PrimaryTextBrush}"
                Style="{DynamicResource ButtonIcon}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <!--  运行状态  -->
            <!--
            <Grid Grid.Row="0">
                <UniformGrid Grid.Column="2" Columns="2">
                    <Button
                        Width="40"
                        Height="40"
                        Padding="0"
                        VerticalAlignment="Center"
                        hc:IconElement.Geometry="{StaticResource ResetCountGeometry}"
                        hc:IconElement.Height="35"
                        hc:IconElement.Width="35"
                        Command="{Binding ResetProductCommand}"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Style="{DynamicResource ButtonIcon}" />
                    <Button
                        Grid.Column="1"
                        Width="40"
                        Height="40"
                        Padding="0"
                        VerticalAlignment="Center"
                        hc:IconElement.Geometry="{StaticResource HomeChangeGeometry}"
                        hc:IconElement.Height="35"
                        hc:IconElement.Width="35"
                        Command="{Binding HomeChangeCommand}"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Style="{DynamicResource ButtonIcon}" />
                </UniformGrid>
            </Grid>-->
            <!--  产品统计相关显示  -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="10,5,0,0"
                    Background="White"
                    BorderBrush="#e9e9e9"
                    BorderThickness="1"
                    CornerRadius="10">
                    <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                Margin="0,5,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#333333"
                                Text="产品数" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="Black"
                                Text="{Binding ProductCount}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="10,5,0,0"
                    Background="White"
                    BorderBrush="#e9e9e9"
                    BorderThickness="1"
                    CornerRadius="10">
                    <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                Margin="0,5,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#333333"
                                Text="OK" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="Black"
                                Text="{Binding OkCount}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5,5,0,0"
                    Background="White"
                    BorderBrush="#e9e9e9"
                    BorderThickness="1"
                    CornerRadius="10">
                    <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                Margin="0,5,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#333333"
                                Text="良率" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="Black"
                                Text="{Binding Yield, StringFormat={}{0}%}" />

                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="5,5,0,0"
                    Background="White"
                    BorderBrush="#e9e9e9"
                    BorderThickness="1"
                    CornerRadius="10">
                    <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                Margin="0,5,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#333333"
                                Text="NG" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="Black"
                                Text="{Binding NgCount}" />

                        </StackPanel>
                    </DockPanel>
                </Border>



                <Border
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="5,5,0,0"
                    Background="White"
                    BorderBrush="#e9e9e9"
                    BorderThickness="1"
                    CornerRadius="10">
                    <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                Margin="0,5,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#333333"
                                Text="运行时间" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="Black"
                                Text="{Binding RunTime, StringFormat={}{0}min}" />

                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="5,5,0,0"
                    Background="White"
                    BorderBrush="#e9e9e9"
                    BorderThickness="1"
                    CornerRadius="10">
                    <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                Margin="0,5,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#333333"
                                Text="稼动率" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="Black"
                                Text="{Binding WorkRate, StringFormat={}{0}%}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border
                    Grid.Row="0"
                    Grid.Column="3"
                    Margin="5,5,0,0"
                    Background="White"
                    BorderBrush="#e9e9e9"
                    BorderThickness="1"
                    CornerRadius="10">
                    <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                Margin="0,5,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#333333"
                                Text="{Binding ThrowMaterialModels[0].MaterialName}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="Black"
                                Text="{Binding ThrowMaterialModels[0].Count}" />

                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="3"
                    Margin="5,5,0,0"
                    Background="White"
                    BorderBrush="#e9e9e9"
                    BorderThickness="1"
                    CornerRadius="10">
                    <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                Margin="0,5,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#333333"
                                Text="抛料率" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="Black"
                                Text="{Binding ThrowMaterialModels[0].Rate, StringFormat={}{0}%}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border
                    Grid.Row="0"
                    Grid.Column="4"
                    Margin="5,5,10,0"
                    Background="White"
                    BorderBrush="#e9e9e9"
                    BorderThickness="1"
                    CornerRadius="10">
                    <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                Margin="0,5,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#333333"
                                Text="{Binding ThrowMaterialModels[1].MaterialName}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="Black"
                                Text="{Binding ThrowMaterialModels[1].Count}" />

                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="4"
                    Margin="5,5,10,0"
                    Background="White"
                    BorderBrush="#e9e9e9"
                    BorderThickness="1"
                    CornerRadius="10">
                    <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                Margin="0,5,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#333333"
                                Text="抛料率" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="Black"
                                Text="{Binding ThrowMaterialModels[1].Rate, StringFormat={}{0}%}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

            </Grid>

            <!--  CT相关显示  -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Margin="10,5,0,0"
                    Background="White"
                    BorderBrush="#e9e9e9"
                    BorderThickness="1"
                    CornerRadius="10">
                    <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="#333333"
                                Text="当前CT:" />
                            <TextBlock
                                Margin="5,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="18"
                                Foreground="Black"
                                Text="{Binding RealCT, StringFormat={}{0}s}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Margin="10,5,10,0"
                    Background="White"
                    BorderBrush="#e9e9e9"
                    BorderThickness="1"
                    CornerRadius="10">
                    <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="15"
                                Foreground="#333333"
                                Text="理论CT:" />
                            <TextBlock
                                Margin="5,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="18"
                                Foreground="Black"
                                Text="{Binding TheoreticalCT, StringFormat={}{0}s}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
        <Border
            Grid.Row="2"
            Margin="5"
            Background="White"
            CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="10,5,10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="15"
                        Foreground="#4BA4FE"
                        Text="{Binding QualitySourceAlia, StringFormat=数据项：{0}}" />
                    <Button
                        Grid.Column="2"
                        Background="Transparent"
                        BorderBrush="#4BA4FE"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="QualitySetContent"
                        Content="质量定义"
                        Foreground="#4BA4FE" />
                </Grid>
                <chart:CartesianChart
                    Grid.Row="1"
                    Background="{DynamicResource RegionBrush}"
                    LegendLocation="Bottom">
                    <chart:CartesianChart.Series>
                        <chart:LineSeries
                            Title="测量值"
                            Fill="#99ffff"
                            LineSmoothness="0"
                            Opacity="0.3"
                            PointGeometry="{x:Null}"
                            Stroke="{StaticResource InfoBrush}"
                            Values="{Binding MeasureValues}" />
                        <chart:LineSeries
                            Title="标准值"
                            Fill="Transparent"
                            LineSmoothness="0"
                            PointGeometry="{x:Null}"
                            Stroke="{StaticResource SuccessBrush}"
                            StrokeThickness="1"
                            Values="{Binding StandardValues}"
                            Visibility="{Binding OnlyShowMeasure, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                        <chart:LineSeries
                            Title="上限"
                            Fill="Transparent"
                            LineSmoothness="0"
                            PointGeometry="{x:Null}"
                            Stroke="{StaticResource WarningBrush}"
                            StrokeThickness="1"
                            Values="{Binding UplimtValues}"
                            Visibility="{Binding OnlyShowMeasure, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                        <chart:LineSeries
                            Title="下限"
                            Fill="Transparent"
                            LineSmoothness="0"
                            PointGeometry="{x:Null}"
                            Stroke="{StaticResource SecondaryBorderBrush}"
                            StrokeThickness="1"
                            Values="{Binding LowlimtValues}"
                            Visibility="{Binding OnlyShowMeasure, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                    </chart:CartesianChart.Series>
                    <chart:CartesianChart.AxisX>
                        <chart:Axis Labels="{Binding XLables}">
                            <chart:Axis.Separator>
                                <chart:Separator Step="1" />
                            </chart:Axis.Separator>
                        </chart:Axis>
                    </chart:CartesianChart.AxisX>
                    <chart:CartesianChart.AxisY>
                        <chart:Axis LabelFormatter="{Binding YFormatter}" />
                    </chart:CartesianChart.AxisY>
                </chart:CartesianChart>
            </Grid>

        </Border>
    </Grid>
</UserControl>
