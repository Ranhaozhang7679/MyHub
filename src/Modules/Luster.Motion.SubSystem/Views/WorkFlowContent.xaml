<UserControl
    x:Class="Luster.Motion.SubSystem.Views.WorkFlowContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:flow="clr-namespace:Luster.Control.Wpf.Motion.Flow;assembly=Luster.Control.Wpf.Motion"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    MinHeight="300"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <Grid>
        <flow:FlowEditor
            Name="flowEditor"
            Padding="0"
            AutoCalcuGrid="True"
            BackgroundBrush="WhiteSmoke"
            ColumnWidth="200"
            HAlignment="Left"
            IsDataFlow="True"
            IsShowGridLine="False"
            IsShowRuler="False"
            IsShowStatus="False"
            ItemsSource="{Binding WorkItems}"
            LineThinkness="3"
            RowHeight="100">
            <hc:Interaction.Triggers>
                <hc:EventTrigger EventName="Loaded">
                    <hc:EventToCommand Command="{Binding LoadedCommand}" PassEventArgsToCommand="True" />
                </hc:EventTrigger>
            </hc:Interaction.Triggers>
        </flow:FlowEditor>
    </Grid>
</UserControl>
