<UserControl
    x:Class="Luster.Motion.SubSystem.Views.ProjectContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.SubSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource SecondaryRegionBrush}"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--  当前默认显示配方  -->
        <Grid Background="#f3f3f3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="7.5*" />
                <!--<RowDefinition Height="6*" />-->
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="1" Grid.Column="1">
                <Label
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.CurrentProject}}"
                    Foreground="#57a9fd"
                    Visibility="{Binding IsVisible}" />
                <Label
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="{Binding ProjectCurrent.Time}"
                    ContentStringFormat="{}{0:yyyy-MM-dd}" />
                <Label
                    Margin="0,-10"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="{Binding ProjectCurrent.ProjName}"
                    FontSize="20"
                    FontWeight="Bold" />
                <ListBox
                    Name="TreeProject"
                    MaxHeight="350"
                    Margin="0,5"
                    HorizontalAlignment="Left"
                    Background="#f3f3f3"
                    BorderThickness="0"
                    ItemsSource="{Binding ProjectCurrent.RecipeList}"
                    Style="{StaticResource ListBoxCustom}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="200" Margin="0">
                                <Border
                                    Name="border"
                                    Margin="4"
                                    Background="{Binding Path=Background, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}}"
                                    BorderBrush="#cdcdcd"
                                    BorderThickness="1">
                                    <Grid Margin="5">
                                        <TextBlock
                                            Grid.Row="1"
                                            Height="20"
                                            VerticalAlignment="Center"
                                            Text="{Binding Name}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListBoxItemCustom}" TargetType="{x:Type ListBoxItem}">
                            <Style.Triggers>
                                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                                    <Setter Property="ListBoxItem.Background" Value="#57a9fd" />
                                    <Setter Property="ListBoxItem.Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <StackPanel Orientation="Horizontal">
                    <Button
                        Width="100"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Center"
                        hc:IconElement.Geometry="{StaticResource ImportGeometry}"
                        Command="{Binding AddExistRecipeCommand}"
                        CommandParameter="{Binding ProjectCurrent.FullName}"
                        Content="{lang:Lang Key={x:Static lang:LangKeys.ImportRecipe}}"
                        Style="{StaticResource ButtonPrimary}"
                        Visibility="{Binding IsVisible}" />
                    <Button
                        Width="100"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Center"
                        hc:IconElement.Geometry="{StaticResource AddGeometry}"
                        Command="{Binding AddRecipeCommand}"
                        CommandParameter="{Binding ProjectCurrent.ProjName}"
                        Content="{lang:Lang Key={x:Static lang:LangKeys.NewRecipe}}"
                        Style="{StaticResource ButtonPrimary}"
                        Visibility="{Binding IsVisible}" />
                </StackPanel>
                
            </StackPanel>
        </Grid>
        <!--  项目列表试图  -->
        <Grid Grid.Column="1" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.7*" />
                    <RowDefinition Height="8.2*" />
                    <RowDefinition Height="1.4*" />
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Left"
                        FontSize="22"
                        Foreground="#5c5c5c"
                        Style="{StaticResource TextBlockSubTitleBold}"
                        Text="{lang:Lang Key={x:Static lang:LangKeys.LusterSmartCockpit}}" />
                    <hc:SearchBar
                        Name="btnSearch"
                        Grid.Row="1"
                        Grid.ColumnSpan="3"
                        Width="350"
                        Margin="0,10,0,10"
                        HorizontalAlignment="Left"
                        Background="White"
                        BorderBrush="#d6d6d6"
                        Command="{Binding SearchCommand}"
                        CommandParameter="{Binding Text, RelativeSource={RelativeSource Self}}"
                        Foreground="#5c5c5c"
                        ShowClearButton="True"
                        Style="{StaticResource SearchBarPlus}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                        <hc:Interaction.Triggers>
                            <hc:EventTrigger EventName="TextChanged">
                                <hc:InvokeCommandAction Command="{Binding SearchCommand}" />
                            </hc:EventTrigger>
                        </hc:Interaction.Triggers>
                    </hc:SearchBar>
                </StackPanel>
                <!--  工程列表  -->
                <StackPanel Grid.Row="1">
                    <ListBox
                        Name="ProjectView"
                        BorderThickness="0"
                        ItemsSource="{Binding ProjectList}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        Style="{DynamicResource ListBoxCustom}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" Rows="2" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Height="190"
                                    Margin="0,10,10,0"
                                    BorderBrush="#57a9fd"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                    <Grid Margin="20,10,20,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="2*" />
                                            <RowDefinition Height="5*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Button
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding Path=DataContext.OpenProjCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding FullName}"
                                                Content="{lang:Lang Key={x:Static lang:LangKeys.OpenProject}}"
                                                DockPanel.Dock="Right"
                                                Foreground="#57a9fd"
                                                Style="{StaticResource ButtonCustom}" />
                                            <Button
                                                Margin="5,0,0,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding Path=DataContext.DeleteProjCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding FullName}"
                                                Content="{lang:Lang Key={x:Static lang:LangKeys.DeleteProject}}"
                                                DockPanel.Dock="Right"
                                                Foreground="#57a9fd"
                                                Style="{StaticResource ButtonCustom}" />
                                            <Button
                                                Margin="5,0,0,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding Path=DataContext.ExportProjCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding FullName}"
                                                Content="{lang:Lang Key={x:Static lang:LangKeys.ExportProject}}"
                                                DockPanel.Dock="Right"
                                                Foreground="#57a9fd"
                                                Style="{StaticResource ButtonCustom}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1">
                                            <Label
                                                HorizontalAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Content="{Binding Time}"
                                                ContentStringFormat="{}{0:yyyy-MM-dd}" />
                                            <Label
                                                Name="lblProjName"
                                                Margin="0,-10"
                                                HorizontalAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Content="{Binding ProjName}"
                                                FontSize="15"
                                                FontWeight="Bold" />
                                        </StackPanel>
                                        <ListBox
                                            Grid.Row="2"
                                            BorderThickness="0"
                                            ItemContainerStyle="{StaticResource ListProjectItemStyle}"
                                            ItemsSource="{Binding RecipeList}"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            Style="{DynamicResource ListBoxCustom}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Name="border"
                                                        Margin="5,5,5,0"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding Path=Background, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}}"
                                                        BorderBrush="#cdcdcd"
                                                        BorderThickness="1">
                                                        <Grid Margin="5">
                                                            <TextBlock Text="{Binding Name}">
                                                                <TextBlock.InputBindings>
                                                                    <MouseBinding
                                                                        Command="{Binding DataContext.ActiveRecipeCommand, RelativeSource={RelativeSource AncestorType=ListBox, AncestorLevel=2}}"
                                                                        CommandParameter="{Binding}"
                                                                        MouseAction="LeftDoubleClick" />
                                                                </TextBlock.InputBindings>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <hc:Pagination
                        Name="Pagenation"
                        Margin="10,10"
                        MaxPageCount="{Binding MaxPageCount}"
                        PageIndex="{Binding PageIndex}">
                        <hc:Interaction.Triggers>
                            <hc:EventTrigger EventName="PageUpdated">
                                <hc:EventToCommand Command="{Binding PageUpdatedCommand}" PassEventArgsToCommand="True" />
                            </hc:EventTrigger>
                        </hc:Interaction.Triggers>
                    </hc:Pagination>
                </StackPanel>

                <StackPanel
                    Grid.Row="3"
                    Margin="0,10,0,0"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
                    <Button
                        Width="100"
                        Margin="10,0,0,0"
                        hc:BackgroundSwitchElement.MouseDownBackground="#57a9fd"
                        Background="Transparent"
                        BorderBrush="#57a9fd"
                        Command="{Binding AddProjCommand}"
                        Content="{lang:Lang Key={x:Static lang:LangKeys.NewProject}}"
                        Foreground="#57a9fd" />
                    <Button
                        Width="100"
                        Margin="10,0,0,0"
                        Background="Transparent"
                        BorderBrush="#57a9fd"
                        Command="{Binding OpenProjCommand}"
                        Content="{lang:Lang Key={x:Static lang:LangKeys.OpenProject}}"
                        Foreground="#57a9fd" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
