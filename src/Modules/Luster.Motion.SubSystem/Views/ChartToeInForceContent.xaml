<UserControl
    x:Class="Luster.Motion.SubSystem.Views.ChartToeInForceContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chart="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:converter="clr-namespace:Luster.Motion.CommonUI.Converter;assembly=Luster.Motion.CommonUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Luster.Motion.SubSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="650"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Visibility="{Binding IsVisible, Converter={StaticResource Boolean2VisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <hc:SimplePanel
                Grid.Row="0"
                Height="32"
                Background="#F4F6FA">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource PrimaryBrush}"
                    Style="{StaticResource TextBlockDefaultBold}"
                    Text="ToeIn3合1曲线" />
                <Button
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    hc:IconElement.Geometry="{StaticResource SettingGeometry}"
                    Command="{Binding SetCommand}"
                    Foreground="{DynamicResource PrimaryBrush}"
                    IsEnabled="{Binding BtnEnable}"
                    Style="{StaticResource ButtonIcon}"
                    Visibility="Hidden" />
            </hc:SimplePanel>
        </Grid>

        <Grid Grid.Row="1" MinHeight="600">
            <Border
                Grid.Row="0"
                Margin="2"
                BorderBrush="#57a9fd"
                BorderThickness="1"
                CornerRadius="0">
                <Grid
                    x:Name="parent_chart_time"
                    Grid.Row="0"
                    Background="{DynamicResource RegionBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MinWidth="385" />
                        <ColumnDefinition Width="175" />
                    </Grid.ColumnDefinitions>

                    <chart:CartesianChart Name="chartTorqueTime" IsHitTestVisible="False" />

                    <StackPanel Grid.Column="1" Orientation="Vertical">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="10" />
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock x:Name="tbxTime_EC" VerticalAlignment="Center">EC=</TextBlock>
                        <TextBlock x:Name="tbxTime_T1" VerticalAlignment="Center">T1=</TextBlock>
                        <TextBlock x:Name="tbxTime_T2" VerticalAlignment="Center">T2=</TextBlock>
                        <TextBlock x:Name="tbxTime_T3" VerticalAlignment="Center">T3=</TextBlock>
                        <TextBlock x:Name="tbxTime_Tt" VerticalAlignment="Center">Tt=</TextBlock>
                        <TextBlock x:Name="tbxTime_A1" VerticalAlignment="Center">A1=</TextBlock>
                        <TextBlock x:Name="tbxTime_A2" VerticalAlignment="Center">A2=</TextBlock>
                        <TextBlock x:Name="tbxTime_A3" VerticalAlignment="Center">A3=</TextBlock>
                        <TextBlock x:Name="tbxTime_SSL" VerticalAlignment="Center">SSL=</TextBlock>
                        <TextBlock x:Name="tbxTime_MaxAngle" VerticalAlignment="Center">Max.angle=</TextBlock>
                        <TextBlock x:Name="tbxTime_MaxTorque" VerticalAlignment="Center">Max.torque=</TextBlock>
                        <TextBlock x:Name="tbxTime_SeatingTorque" VerticalAlignment="Center">Seating torque=</TextBlock>
                        <TextBlock x:Name="tbxTime_ClampTorque" VerticalAlignment="Center">Clamp torque=</TextBlock>
                        <TextBlock x:Name="tbxTime_PrevailingTorque" VerticalAlignment="Center">Prevailing torque=</TextBlock>
                        <TextBlock x:Name="tbxTime_MC" VerticalAlignment="Center">MC=</TextBlock>
                        <TextBlock x:Name="tbxMax_Press" VerticalAlignment="Center">MaPressx=</TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>

    <hc:Interaction.Triggers>
        <hc:EventTrigger EventName="Loaded">
            <hc:EventToCommand Command="{Binding GetChartControls}">
                <hc:EventToCommand.CommandParameter>
                    <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                        <Binding ElementName="parent_chart_time" />
                        <Binding ElementName="chartTorqueTime" />
                        <Binding ElementName="tbxTime_EC" />
                        <Binding ElementName="tbxTime_T1" />
                        <Binding ElementName="tbxTime_T2" />
                        <Binding ElementName="tbxTime_T3" />
                        <Binding ElementName="tbxTime_Tt" />
                        <Binding ElementName="tbxTime_A1" />
                        <Binding ElementName="tbxTime_A2" />
                        <Binding ElementName="tbxTime_A3" />

                        <Binding ElementName="tbxTime_SSL" />
                        <Binding ElementName="tbxTime_MaxAngle" />
                        <Binding ElementName="tbxTime_MaxTorque" />
                        <Binding ElementName="tbxTime_SeatingTorque" />
                        <Binding ElementName="tbxTime_ClampTorque" />
                        <Binding ElementName="tbxTime_PrevailingTorque" />
                        <Binding ElementName="tbxTime_MC" />
                        <Binding ElementName="tbxMax_Press" />


                        <Binding ElementName="parent_chart_agnle" />
                        <Binding ElementName="chartTorqueAngle" />
                        <Binding ElementName="tbxAngle_EC" />
                        <Binding ElementName="tbxAngle_T1" />
                        <Binding ElementName="tbxAngle_T2" />
                        <Binding ElementName="tbxAngle_T3" />
                        <Binding ElementName="tbxAngle_Tt" />
                        <Binding ElementName="tbxAngle_A1" />
                        <Binding ElementName="tbxAngle_A2" />
                        <Binding ElementName="tbxAngle_A3" />

                        <Binding ElementName="tbxAngle_SSL" />
                        <Binding ElementName="tbxAngle_MaxAngle" />
                        <Binding ElementName="tbxAngle_MaxTorque" />
                        <Binding ElementName="tbxAngle_SeatingTorque" />
                        <Binding ElementName="tbxAngle_ClampTorque" />
                        <Binding ElementName="tbxAngle_PrevailingTorque" />
                        <Binding ElementName="tbxAngle_MC" />

                    </MultiBinding>
                </hc:EventToCommand.CommandParameter>
            </hc:EventToCommand>
        </hc:EventTrigger>
    </hc:Interaction.Triggers>

</UserControl>
