<Border
    x:Class="Luster.Motion.SubSystem.Views.ProReportContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter1="clr-namespace:Luster.Motion.CommonUI.Converter;assembly=Luster.Motion.CommonUI"
    xmlns:ctrl="clr-namespace:Luster.Control.Wpf.Motion.Controls;assembly=Luster.Control.Wpf.Motion"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:g="clr-namespace:Luster.Motion.CommonUI;assembly=Luster.Motion.CommonUI"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.SubSystem.Views"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:views="clr-namespace:Luster.Motion.CommonUI.Views;assembly=Luster.Motion.CommonUI"
    d:DesignHeight="300"
    d:DesignWidth="600"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <Border.Resources>
        <converter1:ProductStringConverter x:Key="ResultConverter" />
        <Style x:Key="DataColumnTextElementStyleResult" TargetType="{x:Type TextBlock}">
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ., Converter={StaticResource ResultConverter}}" Value="OK">
                    <Setter Property="Background" Value="Green" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ., Converter={StaticResource ResultConverter}}" Value="NG">
                    <Setter Property="Background" Value="Red" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ., Converter={StaticResource ResultConverter}}" Value="Toss">
                    <Setter Property="Background" Value="Orange" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Border.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="LightGray" CornerRadius="7,7,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="15,8,5,8"
                    HorizontalAlignment="Left"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="{lang:Lang Key={x:Static lang:LangKeys.ProductInfo}}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="5,0,10,0"
                    HorizontalAlignment="Right"
                    FontSize="28"
                    Foreground="{StaticResource PrimaryBrush}"
                    Style="{StaticResource MotionIconMid}"
                    Text="&#xe64c;">
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="PreviewMouseDown">
                            <hc:EventToCommand Command="{Binding NavigateCommand}" CommandParameter="QualitySetContent" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </TextBlock>
            </Grid>
        </Border>
        <DataGrid
            Name="dgProduct"
            Grid.Row="1"
            Padding="0"
            AlternationCount="2"
            BorderBrush="{DynamicResource BorderBrush}"
            ColumnHeaderStyle="{DynamicResource CustomDataGridColumnHeaderStyle}"
            HeadersVisibility="Column"
            ItemsSource="{Binding ProductInfos}"
            RowHeight="24"
            RowStyle="{DynamicResource CustomDataGridRowStyle}"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="45"
                    MinWidth="45"
                    Binding="{Binding Index}"
                    ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.Index}}" />
                <DataGridTextColumn
                    Width="110"
                    MinWidth="110"
                    Binding="{Binding ProCode}"
                    ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.SNCode}}" />
                <!--<DataGridTextColumn
                            Width="100"
                            MinWidth="100"
                            Binding="{Binding JigCode}"
                            ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.Fixture}}" />-->
                <DataGridTextColumn
                    Width="50"
                    MinWidth="50"
                    Binding="{Binding ., Converter={StaticResource ResultConverter}}"
                    ElementStyle="{StaticResource DataColumnTextElementStyleResult}"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.Result}}" />
                <DataGridTextColumn
                    Width="160"
                    MinWidth="160"
                    Binding="{Binding EnterTime, StringFormat='MM-dd HH:mm:ss.fff'}"
                    ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.InboundTime}}" />
                <DataGridTextColumn
                    Width="160"
                    MinWidth="160"
                    Binding="{Binding OutTime, StringFormat='MM-dd HH:mm:ss.fff'}"
                    ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.OutBoundTime}}" />
                <DataGridTextColumn
                    Width="85"
                    MinWidth="85"
                    Binding="{Binding CT, StringFormat={}{0}s}"
                    ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.CT}}" />
                <DataGridTextColumn
                    Width="85"
                    MinWidth="85"
                    Binding="{Binding NewCT, StringFormat={}{0}s}"
                    ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.SingleCT}}" />
                <DataGridTextColumn
                    Width="150"
                    MinWidth="120"
                    Binding="{Binding NgReason}"
                    ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.NGReason}}" />
            </DataGrid.Columns>

            <hc:Interaction.Triggers>
                <hc:EventTrigger EventName="Loaded">
                    <hc:EventToCommand Command="{Binding LoadedCommand}" PassEventArgsToCommand="True" />
                </hc:EventTrigger>
            </hc:Interaction.Triggers>
        </DataGrid>
    </Grid>
</Border>
