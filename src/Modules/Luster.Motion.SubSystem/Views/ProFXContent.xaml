<UserControl
    x:Class="Luster.Motion.SubSystem.Views.ProFXContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter1="clr-namespace:Luster.Motion.CommonUI.Converter;assembly=Luster.Motion.CommonUI"
    xmlns:ctrl="clr-namespace:Luster.Control.Wpf.Motion.Controls;assembly=Luster.Control.Wpf.Motion"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:g="clr-namespace:Luster.Motion.CommonUI;assembly=Luster.Motion.CommonUI"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.SubSystem.Views"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:views="clr-namespace:Luster.Motion.CommonUI.Views;assembly=Luster.Motion.CommonUI"
    d:DesignWidth="600"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="PDCAStyle"
            BasedOn="{StaticResource ToggleButtonCustom}"
            TargetType="ToggleButton">
            <Setter Property="Background" Value="Red" />
            <Setter Property="Width" Value="90" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="18" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="Green" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="SafeStyle"
            BasedOn="{StaticResource ToggleButtonCustom}"
            TargetType="ToggleButton">
            <Setter Property="Background" Value="Gray" />
            <Setter Property="Width" Value="90" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="10,3" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />

                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="AutoModeStyle"
            BasedOn="{StaticResource ToggleButtonCustom}"
            TargetType="ToggleButton">
            <Setter Property="Background" Value="Gray" />
            <Setter Property="Width" Value="90" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="10,3" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Content" Value="自动模式" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OrderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
        </Style>
        <Style x:Key="ErrorStyle" TargetType="TextBlock">
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="Red" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ErrorDetailStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Green" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid FocusManager.FocusedElement="{Binding ElementName=scanText}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ToggleButton
                        HorizontalAlignment="Left"
                        BorderThickness="0"
                        Content="PDCA"
                        IsChecked="{Binding PDCAEnabled}"
                        IsEnabled="False"
                        Style="{StaticResource PDCAStyle}" />
                    <ToggleButton
                        Margin="10,0"
                        HorizontalAlignment="Left"
                        BorderThickness="0"
                        Content="CPK"
                        IsChecked="{Binding CPKEnabled}"
                        IsEnabled="False"
                        Style="{StaticResource PDCAStyle}" />
                    <ToggleButton
                        HorizontalAlignment="Left"
                        BorderThickness="0"
                        Content="SFC"
                        IsChecked="{Binding SFCEnabled}"
                        IsEnabled="False"
                        Style="{StaticResource PDCAStyle}" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Height="48"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Right"
                    Background="{Binding HiveTestColor}"
                    Command="{Binding HiveSetUpCommand}"
                    Content="Hive 验证"
                    Visibility="Hidden"
                    FontSize="16"
                    Foreground="Black" />
                <Button
                    Grid.Column="2"
                    Height="48"
                    Padding="10,5"
                    HorizontalAlignment="Right"
                    hc:BorderElement.CornerRadius="32"
                    Background="Blue"
                    Command="{Binding HiveRepairCommand}"
                    Content="报修"
                    FontSize="16"
                    Visibility="Hidden"
                    Foreground="White" />
            </Grid>
            <StackPanel
                Grid.Row="1"
                Margin="10,0"
                Orientation="Horizontal">
                <ToggleButton
                    x:Name="BtnAutoMode"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    BorderThickness="0"
                    Content="手动模式"
                    IsChecked="{Binding IsAutoMode}"
                    IsEnabled="False"
                    Style="{StaticResource AutoModeStyle}" />

                <ToggleButton
                    x:Name="btnOpen"
                    Grid.Column="1"
                    Margin="10,0"
                    HorizontalAlignment="Left"
                    BorderThickness="0"
                    Command="{Binding OpenDoorCommand}"
                    CommandParameter="{Binding Path=IsChecked, ElementName=btnOpen}"
                    Content="一键开门"
                    IsEnabled="{Binding CanOpenDoor}"
                    Style="{StaticResource SafeStyle}" />

                <ToggleButton
                    x:Name="btnTray"
                    Grid.Column="1"
                    Width="150"
                    Margin="0,0"
                    HorizontalAlignment="Left"
                    BorderThickness="0"
                    Command="{Binding EmptyTrayCommand}"
                    CommandParameter="{Binding Path=IsChecked, ElementName=btnTray}"
                    Content="{Binding TrayText}"
                    IsChecked="{Binding TrayEnabled}"
                    Style="{StaticResource SafeStyle}"
                    Visibility="{Binding TrayVisible, Converter={StaticResource Boolean2VisibilityConverter}}" />

            </StackPanel>
            <Border
                Grid.Row="2"
                Margin="10"
                Style="{StaticResource BorderRegion}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Style="{StaticResource ErrorStyle}"
                        Text="问题设备 : " />
                    <TextBlock
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        Style="{StaticResource ErrorStyle}"
                        Text="{Binding Path=ErrorDetail.Name}" />      
                    <TextBlock 
                        Grid.Row="1"
                        Style="{StaticResource ErrorStyle}" Text="错误码 : " />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                         Grid.ColumnSpan="3"
                        Style="{StaticResource ErrorStyle}"
                        Text="{Binding Path=ErrorDetail.Code}" />
                    <TextBlock
                         Grid.Row="2"
                         Style="{StaticResource ErrorStyle}"
                         Text="错误时间 : " />
                    <TextBlock
                          Grid.Row="2"
                          Grid.Column="1"
                          Grid.ColumnSpan="3"
                          Style="{StaticResource ErrorStyle}"
                          Text="{Binding Path=ErrorDetail.AlarmTime}" />
                    <TextBlock
                        Grid.Row="3"
                        Style="{StaticResource ErrorStyle}"
                        Text="错误描述 : " />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        Style="{StaticResource ErrorStyle}"
                        Text="{Binding Path=ErrorDetail.Addition}" />
                    <TextBlock
                        Grid.Row="4"
                        VerticalAlignment="Top"
                        Style="{StaticResource ErrorStyle}"
                        Text="解决措施 : " />
                    <ListBox
                        Grid.Row="4"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Path=DataContext.ErrorDetail.UserActions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource ListBoxCustom}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource ErrorDetailStyle}" Text="{Binding .}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            
        </Grid>
        <Grid Grid.Row="1">
            <DataGrid
                Padding="0"
			    AlternationCount="2"
			    BorderBrush="{DynamicResource BorderBrush}"
			    BorderThickness="1"
			    ColumnHeaderStyle="{DynamicResource CustomDataGridColumnHeaderStyle}"
			    HeadersVisibility="Column"
			    IsReadOnly="True"
			    ItemsSource="{Binding RunningModuleList}"
			    RowStyle="{DynamicResource CustomDataGridRowStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn
					    Width="*"
					    MinWidth="100"
					    Binding="{Binding StationName}"
					    ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
					    Header="工站" />
                    <DataGridTextColumn
					    Width="*"
					    MinWidth="100"
					    Binding="{Binding ModuleName}"
					    ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
					    Header="正在运行模块" />
                    <DataGridTextColumn
					    Width="*"
					    MinWidth="100"
					    Binding="{Binding ModuleAlias}"
					    ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
					    Header="路径" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
    
