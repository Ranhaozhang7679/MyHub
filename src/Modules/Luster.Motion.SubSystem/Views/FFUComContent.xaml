<Border x:Class="Luster.Motion.SubSystem.Views.FFUComContent"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:hc="https://handyorg.github.io/handycontrol"
          xmlns:prism="http://prismlibrary.com/"
          xmlns:local="clr-namespace:Luster.Motion.SubSystem.Views"
          prism:ViewModelLocator.AutoWireViewModel="True"
          xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
          mc:Ignorable="d"
          d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="10"/>

            <RowDefinition Height="60"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>


        <hc:TextBox
        Grid.Row="0"
        IsEnabled="False"
        hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.CurrentValue}}"
        hc:InfoElement.TitlePlacement="Left"
        hc:InfoElement.TitleWidth="120"
        Foreground="{DynamicResource EditorForeground}"
        Text="{Binding Current, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0} A}" />

        <hc:TextBox
        Grid.Row="2" 
        IsEnabled="False"
        hc:InfoElement.Title="FFU风力档位"
        hc:InfoElement.TitlePlacement="Left"
        hc:InfoElement.TitleWidth="120"
        Foreground="{DynamicResource EditorForeground}"
        Text="{Binding FFUSpeedLevel, UpdateSourceTrigger=PropertyChanged}" />

        <hc:TextBox
        Grid.Row="4" 
        Margin="0,0,0,0"
        IsEnabled="False"
        hc:InfoElement.Title="FFU开关"
        hc:InfoElement.TitlePlacement="Left"
        hc:InfoElement.TitleWidth="120"
        Foreground="{DynamicResource EditorForeground}"
        Text="{Binding FFUSwitch, UpdateSourceTrigger=PropertyChanged}" />


        <Button 
            Grid.Row="6"
            Width="120"
            Height="60"
            IsEnabled="True"
            HorizontalAlignment="Left"
            Content="FFU开机" 
            Command="{Binding FFUOpen}" />
        
        <Button 
            Grid.Row="6"
            Width="120"
            Height="60"
            IsEnabled="True"
            HorizontalAlignment="Center"
            Content="终止线程读取" 
            Command="{Binding ClosePage}" />

        <Button
            Width="120"
            Height="60"
            Grid.Row="6"
            IsEnabled="True"
            HorizontalAlignment="Right"
            Content="FFU关机" 
            Command="{Binding FFUClose}" />

        <Button
            Grid.Row="8" 
            Width="120"
            Height="50"
            HorizontalAlignment="Left"
            IsEnabled="True"
            Content="FFU一档" 
            Command="{Binding FFULow}" />

        <Button
            Grid.Row="8"  
            Width="120"
            Height="50"
            HorizontalAlignment="Center"
            IsEnabled="True"
            Content="FFU二档" 
            Command="{Binding FFUMiddle}" />

        <Button
            Grid.Row="8" 
            Width="120"
            Height="50"
            HorizontalAlignment="Right"
            IsEnabled="True"
            Content="FFU三档" 
            Command="{Binding FFUHigh}" />
    </Grid>
</Border>
