<UserControl
    x:Class="Luster.Motion.SubSystem.Views.QualitySetContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extension="clr-namespace:Luster.Motion.Assests.Extention;assembly=Luster.Motion.Assests"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Luster.Motion.SubSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="150" />
            <ColumnDefinition Width="2*" />
            <!--<ColumnDefinition Width="2*" />-->
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0" Margin="5,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Margin="0,0,0,10"
                FontSize="20"
                FontWeight="Bold"
                Text="数据源" />

            <!-- 搜索框 -->
            <TextBox
                x:Name="SearchTextBox"
                Grid.Row="1"
                Margin="0,0,0,10"
                Padding="5"
                hc:InfoElement.Placeholder="搜索数据源..."
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <TreeView
                x:Name="TvwImportSource"
                Grid.Row="2"
                ItemsSource="{Binding SourceNodes}"
                Style="{StaticResource TreeViewBaseStyle}">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Text}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
        <Grid Grid.Column="1" Margin="5,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Margin="0,0,0,10"
                FontSize="20"
                FontWeight="Bold"
                Text="输出项" />
            <StackPanel
                Grid.Column="2"
                Margin="10,0,5,5"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="100"
                    Margin="10,0,0,0"
                    Background="Transparent"
                    BorderBrush="#57a9fd"
                    Command="{Binding CancelQualitySetCommand}"
                    Content="取消"
                    Foreground="#57a9fd" />
                <Button
                    Width="100"
                    Margin="10,0,0,0"
                    Background="Transparent"
                    BorderBrush="#57a9fd"
                    Command="{Binding SaveQualitySetCommand}"
                    CommandParameter="True"
                    Content="保存"
                    Foreground="#57a9fd" />
            </StackPanel>
            <Popup
                x:Name="dgPopup"
                AllowsTransparency="True"
                IsHitTestVisible="False"
                Placement="RelativePoint"
                PlacementTarget="{Binding ElementName=dgOutput}">
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="8"
                    FontWeight="Normal"
                    Text="Dragging..." />
            </Popup>
            <DataGrid
                x:Name="dgOutput"
                Grid.Row="1"
                Padding="0"
                extension:DragDropRowBehavior.Edit="True"
                extension:DragDropRowBehavior.Enabled="True"
                extension:DragDropRowBehavior.PopupControl="{Binding ElementName=dgPopup}"
                AllowDrop="True"
                AlternationCount="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="2"
                CanUserSortColumns="False"
                ColumnHeaderStyle="{DynamicResource CustomDataGridColumnHeaderStyle}"
                HeadersVisibility="Column"
                IsReadOnly="False"
                ItemsSource="{Binding OutputItemModels, Mode=TwoWay}"
                RowStyle="{DynamicResource CustomDataGridRowStyle}"
                SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="150"
                        MinWidth="100"
                        Binding="{Binding AliasName, Mode=TwoWay}"
                        ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                        Header="别名" />
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding Source}"
                        ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                        Header="数据源"
                        IsReadOnly="True" />
                    <!--<DataGridTemplateColumn Width="90" Header="监控">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>-->
                    <DataGridTextColumn
                        Width="120"
                        MinWidth="100"
                        Binding="{Binding StandardValue}"
                        ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                        Header="标准值" />
                    <DataGridTextColumn
                        Width="120"
                        MinWidth="100"
                        Binding="{Binding NegativeStandardDeviation}"
                        ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                        Header="公差-" />
                    <DataGridTextColumn
                        Width="120"
                        MinWidth="100"
                        Binding="{Binding PositiveStandardDeviation}"
                        ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                        Header="公差+" />
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding CompensationValue}"
                        ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                        Header="补偿" />
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding NgReason}"
                        ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                        Header="Ng原因"
                        Visibility="Collapsed" />
                    <DataGridTemplateColumn
                        Width="80"
                        MinWidth="70"
                        Header="删除">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <hc:ElementGroup HorizontalContentAlignment="Center" Orientation="Horizontal">
                                    <Button
                                        Width="60"
                                        Margin="0"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.DeleteCommand}"
                                        CommandParameter="{Binding}"
                                        Content="删除"
                                        Style="{StaticResource ButtonDanger.Small}" />
                                </hc:ElementGroup>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="Drop">
                        <hc:EventToCommand Command="{Binding RecieveDrogCommand}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                    <hc:EventTrigger EventName="BeginningEdit">
                        <hc:EventToCommand Command="{Binding ForbidEditCommand}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </DataGrid>
        </Grid>
        <Grid
            Grid.Column="2"
            Margin="5,15"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="20"
                    FontWeight="Bold"
                    Text="质量标准定义" />
                <StackPanel
                    Grid.Column="2"
                    Margin="10,0,5,5"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="100"
                        Margin="10,0,0,0"
                        Background="Transparent"
                        BorderBrush="#57a9fd"
                        Command="{Binding CancelQualitySetCommand}"
                        Content="取消"
                        Foreground="#57a9fd" />
                    <Button
                        Width="100"
                        Margin="10,0,0,0"
                        Background="Transparent"
                        BorderBrush="#57a9fd"
                        Command="{Binding SaveQualitySetCommand}"
                        CommandParameter="True"
                        Content="保存"
                        Foreground="#57a9fd" />
                </StackPanel>
            </Grid>
            <DataGrid
                Grid.Row="1"
                Padding="0"
                AlternationCount="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="2"
                CanUserSortColumns="False"
                ColumnHeaderStyle="{DynamicResource CustomDataGridColumnHeaderStyle}"
                HeadersVisibility="Column"
                IsReadOnly="False"
                ItemsSource="{Binding QualityItemModels}"
                RowStyle="{DynamicResource CustomDataGridRowStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="120"
                        MinWidth="100"
                        Binding="{Binding AliasName}"
                        ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                        Header="别名"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="120"
                        MinWidth="100"
                        Binding="{Binding StandardValue}"
                        ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                        Header="标准值" />
                    <DataGridTextColumn
                        Width="120"
                        MinWidth="100"
                        Binding="{Binding NegativeStandardDeviation}"
                        ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                        Header="公差-" />
                    <DataGridTextColumn
                        Width="120"
                        MinWidth="100"
                        Binding="{Binding PositiveStandardDeviation}"
                        ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                        Header="公差+" />
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="100"
                        Binding="{Binding CompensationValue}"
                        ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                        Header="补偿" />
                </DataGrid.Columns>
            </DataGrid>

        </Grid>
    </Grid>
</UserControl>