<UserControl
    x:Class="Luster.Motion.SubSystem.Views.ModuleDisplayContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalon="https://github.com/Dirkster99/AvalonDock"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Luster.Motion.SubSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:theme="clr-namespace:Luster.Motion.Assests.Themes.AvalonDock;assembly=Luster.Motion.Assests"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">

    <Grid
        Name="gridDock"
        Margin="0"
        SizeChanged="gridDock_SizeChanged">
        <!--<Grid Grid.Row="2" Grid.Column="1">-->
        <!--  双击配置显示  -->
        <hc:TransitioningContentControl Visibility="{Binding SetVisible, Converter={StaticResource Boolean2VisibilityConverter}}">
            <hc:SimplePanel Margin="32">
                <TextBlock
                    Foreground="{DynamicResource BorderBrush}"
                    Style="{StaticResource TextBlockTitle}"
                    Text="双击配置" />
                <Rectangle
                    Width="300"
                    Height="200"
                    RadiusX="4"
                    RadiusY="4"
                    Stroke="{DynamicResource BorderBrush}"
                    StrokeDashArray="2,2" />
                <Border
                    Width="300"
                    Height="200"
                    Background="Transparent">
                    <Border.InputBindings>
                        <MouseBinding Command="{Binding ModuleSetCommand}" MouseAction="LeftDoubleClick" />
                    </Border.InputBindings>
                </Border>
            </hc:SimplePanel>
        </hc:TransitioningContentControl>
        <!--  模块配置显示  -->
        <avalon:DockingManager Name="ModuleDock">
            <avalon:DockingManager.Theme>
                <theme:Vs2013LightTheme />
            </avalon:DockingManager.Theme>
            <avalon:LayoutRoot>
                <avalon:LayoutPanel x:Name="LPanel">
                    <avalon:LayoutAnchorablePane x:Name="layoutDocPane" />
                </avalon:LayoutPanel>
            </avalon:LayoutRoot>
            <avalon:DockingManager.InputBindings>
                <MouseBinding Command="{Binding ModuleSetCommand}" MouseAction="LeftDoubleClick" />
            </avalon:DockingManager.InputBindings>
        </avalon:DockingManager>
    </Grid>
</UserControl>
