<UserControl
    x:Class="Luster.Motion.SubSystem.Views.UserContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.SubSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource SecondaryRegionBrush}"
    mc:Ignorable="d">
    <Grid Background="#F0F2F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>
        <!--  用户列表  -->
        <Border
            Margin="10"
            Background="{DynamicResource RegionBrush}"
            CornerRadius="10"
            Effect="{StaticResource EffectShadow4}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{lang:Lang Key={x:Static lang:LangKeys.UserList}}" />
                    <Button
                        Grid.Column="4"
                        Width="30"
                        Margin="0,0,5,0"
                        Padding="5"
                        HorizontalAlignment="Right"
                        hc:IconElement.Geometry="{StaticResource AddGeometry}"
                        hc:IconElement.Height="14"
                        hc:IconElement.Width="14"
                        Command="{Binding AddUserCommand}"
                        Foreground="{DynamicResource PrimaryBrush}"
                        Style="{StaticResource ButtonIcon}" />
                </Grid>
                <Border
                    Grid.Row="1"
                    Background="{DynamicResource RegionBrush}"
                    CornerRadius="4">
                    <DataGrid
                        Padding="0"
                        AlternationCount="2"
                        CanUserSortColumns="False"
                        ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                        HeadersVisibility="Column"
                        ItemsSource="{Binding UserList}"
                        RowStyle="{StaticResource CustomDataGridRowStyle}"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="100"
                                MinWidth="80"
                                Binding="{Binding Id}"
                                ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.UseID}}" />
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="100"
                                Binding="{Binding UserName}"
                                ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.UserName}}" />
                            <DataGridTemplateColumn
                                Width="150"
                                MinWidth="70"
                                Header="{lang:Lang Key={x:Static lang:LangKeys.Operate}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <hc:ElementGroup HorizontalContentAlignment="Center" Orientation="Horizontal">
                                            <Button
                                                Width="60"
                                                Margin="0,0,10,0"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.EditUserCommand}"
                                                CommandParameter="{Binding}"
                                                Content="{lang:Lang Key={x:Static lang:LangKeys.Edit}}"
                                                Style="{StaticResource ButtonPrimary.Small}"
                                                Visibility="{Binding IsSystem, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                                            <Button
                                                Width="60"
                                                Margin="10,0,10,0"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.RemoveUserCommand}"
                                                CommandParameter="{Binding}"
                                                Content="{lang:Lang Key={x:Static lang:LangKeys.Delete}}"
                                                Style="{StaticResource ButtonDanger.Small}"
                                                Visibility="{Binding IsSystem, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                                        </hc:ElementGroup>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <hc:Interaction.Triggers>
                            <hc:EventTrigger EventName="SelectionChanged">
                                <hc:EventToCommand Command="{Binding UserSelectedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}" />
                            </hc:EventTrigger>
                        </hc:Interaction.Triggers>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>
        <!--  页面控制  -->
        <GroupBox
            Grid.Column="1"
            Margin="10"
            HorizontalContentAlignment="Stretch"
            hc:TitleElement.Background="{DynamicResource RegionBrush}"
            Background="{DynamicResource SecondaryRegionBrush}">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{lang:Lang Key={x:Static lang:LangKeys.SystemOperationPromptInformation}}" />
                        <Button
                            Grid.Column="4"
                            HorizontalAlignment="Right"
                            hc:IconElement.Geometry="{StaticResource AddGeometry}"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding DataContext.AddOperationCommand, RelativeSource={RelativeSource AncestorType=GroupBox}}"
                            Foreground="#4BA4FE" />
                    </Grid>
                </DataTemplate>
            </GroupBox.HeaderTemplate>

            <DataGrid
                Padding="0"
                AlternationCount="2"
                CanUserSortColumns="False"
                ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                HeadersVisibility="Column"
                ItemsSource="{Binding OprationVms}"
                RowStyle="{StaticResource CustomDataGridRowStyle}"
                SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="150"
                        Binding="{Binding Tip}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.PromptContent}}" />
                    <DataGridTextColumn
                        Width="170"
                        MinWidth="160"
                        Binding="{Binding Operation}"
                        ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.OperationType}}" />
                    <DataGridTemplateColumn
                        Width="150"
                        MinWidth="100"
                        Header="{lang:Lang Key={x:Static lang:LangKeys.Operate}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <hc:ElementGroup HorizontalContentAlignment="Center" Orientation="Horizontal">
                                    <Button
                                        Width="60"
                                        Margin="0,0,10,0"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.EditOperationCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{lang:Lang Key={x:Static lang:LangKeys.Edit}}"
                                        Style="{StaticResource ButtonPrimary.Small}" />
                                    <Button
                                        Width="60"
                                        Margin="10,0,10,0"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.RemoveOperationCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{lang:Lang Key={x:Static lang:LangKeys.Delete}}"
                                        Style="{StaticResource ButtonDanger.Small}" />
                                </hc:ElementGroup>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
