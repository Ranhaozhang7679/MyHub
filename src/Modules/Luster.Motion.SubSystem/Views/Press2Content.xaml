<UserControl
    x:Class="Luster.Motion.SubSystem.Views.Press2Content"  
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chart="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:converter="clr-namespace:Luster.Motion.CommonUI.Converter;assembly=Luster.Motion.CommonUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Luster.Motion.SubSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="650"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Visibility="{Binding IsVisible, Converter={StaticResource Boolean2VisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <hc:SimplePanel
                Grid.Row="0"
                Height="32"
                Background="#F4F6FA">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource PrimaryBrush}"
                    Style="{StaticResource TextBlockDefaultBold}"
                    Text="压力曲线Y" />
                <Button
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    hc:IconElement.Geometry="{StaticResource SettingGeometry}"
                    Command="{Binding SetCommand}"
                    Foreground="{DynamicResource PrimaryBrush}"
                    IsEnabled="{Binding BtnEnable}"
                    Style="{StaticResource ButtonIcon}"
                    Visibility="Hidden" />
            </hc:SimplePanel>
        </Grid>

        <Grid Grid.Row="1" MinHeight="600">

            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Margin="2"
                BorderBrush="#57a9fd"
                BorderThickness="1"
                CornerRadius="0">
                <Grid
                    x:Name="parent_press_time" 
                    Grid.Row="0"
                    Background="{DynamicResource RegionBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MinWidth="385" />
                        <ColumnDefinition Width="175" />
                    </Grid.ColumnDefinitions>

                    <chart:CartesianChart Name="PressTime" IsHitTestVisible="False" />

                    <StackPanel Grid.Column="1" Orientation="Vertical">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="10" />
                            </Style>
                        </StackPanel.Resources>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <hc:Interaction.Triggers>
        <hc:EventTrigger EventName="Loaded">
            <hc:EventToCommand Command="{Binding GetChartControls}">
                <hc:EventToCommand.CommandParameter>
                    <MultiBinding Converter="{StaticResource MultiBindingConverter}">
                        <Binding ElementName="parent_press_time" />
                        <Binding ElementName="PressTime" />
                    </MultiBinding>
                </hc:EventToCommand.CommandParameter>
            </hc:EventToCommand>
        </hc:EventTrigger>
    </hc:Interaction.Triggers>

</UserControl>
