<Border x:Class="Luster.Motion.SubSystem.Views.DustContent"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Luster.Motion.SubSystem.Views"
      mc:Ignorable="d" 
      xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:prism="http://prismlibrary.com/"
      prism:ViewModelLocator.AutoWireViewModel="True"
      d:DesignHeight="450" d:DesignWidth="800"
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="40"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <hc:TextBox Grid.Row="0"
          hc:InfoElement.Title="0.3umDust"
          hc:TitleElement.TitlePlacement="Left"
          hc:InfoElement.TitleWidth="120"
          IsReadOnly="True"
          Text="{Binding ZeroPointThreeDust}"
        />

        <hc:TextBox Grid.Row="1"
          hc:InfoElement.Title="0.5umDust"
          hc:TitleElement.TitlePlacement="Left"
          hc:InfoElement.TitleWidth="120"
          IsReadOnly="True"
          Text="{Binding ZeroPointFiveDust}"
        />

        <hc:TextBox Grid.Row="2"
          hc:InfoElement.Title="1.0umDust"
          hc:TitleElement.TitlePlacement="Left"
          hc:InfoElement.TitleWidth="120"
          IsReadOnly="True"
          Text="{Binding OneDust}"
        />

        <hc:TextBox Grid.Row="3"
          hc:InfoElement.Title="5.0umDust"
          hc:TitleElement.TitlePlacement="Left"
          hc:InfoElement.TitleWidth="120"
          IsReadOnly="True"
          Text="{Binding FiveDust}"
        />

        <hc:TextBox Grid.Row="4"
          hc:InfoElement.Title="TestTime"
          hc:TitleElement.TitlePlacement="Left"
          hc:InfoElement.TitleWidth="120"
          IsReadOnly="True"
          Text="{Binding TestTime}"/>

        <CheckBox  
                   Grid.Row="5"
                   Margin="0,0,0,0"
                   HorizontalAlignment="Right"
                  Content="尘埃粒子计数器是否启用"
                  
                  IsChecked="{Binding IsEnable}"
        />
    </Grid>
</Border>
