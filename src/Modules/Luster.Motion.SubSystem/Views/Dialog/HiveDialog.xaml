<UserControl
    x:Class="Luster.Motion.SubSystem.Dialogs.HiveDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.SubSystem.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Width="400"
    MinHeight="300"
    d:DesignHeight="450"
    d:DesignWidth="500"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--<GroupBox
                Grid.Column="1"
                Background="Blue"
                Margin="5,0,0,0"
                hc:TitleElement.Background="{DynamicResource RegionBrush}"
                Header="维护操作"
                Style="{StaticResource GroupBoxTab}">
            <ItemsControl ItemsSource="{Binding RepairReasons}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton
                                Content="{Binding Text}"
                                GroupName="Down"
                                IsChecked="{Binding IsSelected}"
                                HorizontalAlignment="Left"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>-->
        <Grid Grid.Row="0" Background="Blue">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="LightGray" />
            <RadioButton
                Grid.Row="1"
                HorizontalAlignment="Left"
                Background="Black"
                Command="{Binding Path=DataContext.CheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="设备故障"
                Content="设备故障 Unplanned Time"
                FontSize="20"
                Foreground="White"
                IsChecked="True" />
            <RadioButton
                Grid.Row="2"
                HorizontalAlignment="Left"
                Background="Black"
                Command="{Binding Path=DataContext.CheckCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="预防性维护"
                Content="预防性维护 Planned Time"
                FontSize="20"
                Foreground="White" />

        </Grid>
        <Grid Grid.Row="1" Margin="0,10">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <CheckBox
                Name="ckOther"
                Margin="0,0,0,5"
                Content="备注 Remarks"
                FontSize="16"
                FontWeight="Bold"
                IsChecked="{Binding IsOther}" />
            <TextBox
                Grid.Row="1"
                hc:InfoElement.Placeholder="请输入额外信息"
                IsEnabled="{Binding ElementName=ckOther, Path=IsChecked}"
                Text="{Binding Memo}" />
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,0,0,0">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <!--<Button
                    Width="80"
                    HorizontalAlignment="Right"
                    Command="{Binding StartCommand}"
                    CommandParameter="cancel"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.StartRepair}}" />
                <Button
                    Width="80"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="cancel"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />-->
                <Button
                    Width="80"
                    Height="60"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="ok"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Confirm}}"
                    FontSize="20"
                    Foreground="Black" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
