<UserControl
    x:Class="Luster.Motion.SubSystem.Dialog.HiveDialog1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.SubSystem.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="200"
    d:DesignWidth="500"
    Background="Blue"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="Gray" />
        <Label
            Grid.Row="2"
            Width="450"
            Background="Blue"
            BorderThickness="0"
            Content="等待维修..."
            FontSize="20"
            Foreground="White" />
        <Label
            Grid.Row="3"
            Width="450"
            Background="Blue"
            Content="Waiting for repair..."
            FontSize="20"
            Foreground="White" />

        <DockPanel Grid.Row="5" Margin="0,0,0,0">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button
                    Grid.Row="5"
                    Height="70"
                    HorizontalAlignment="Center"
                    Command="{Binding StartCommand}"
                    CommandParameter="start"
                    Content="  开始维修&#x000A;Start Repair"
                    FontSize="20"
                    Foreground="Black" />
                <!--<Button
                    Width="80"
                    Height="50"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Right"
                    Click="Button_Click"
                    Command="{Binding CloseCommand}"
                    CommandParameter="cancel"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />-->
            </StackPanel>
        </DockPanel>

    </Grid>
</UserControl>
