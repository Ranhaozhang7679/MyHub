<UserControl
    x:Class="Luster.Motion.SubSystem.Views.VisionConfig"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.SubSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="600"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource SecondaryRegionBrush}"
    mc:Ignorable="d">

    <Grid IsEnabled="{Binding SysRole, Converter={StaticResource RoleEnabledCoverter}, ConverterParameter=Integrator}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <hc:SimplePanel
            Grid.Row="0"
            Height="32"
            Background="#F4F6FA">
            <hc:Watermark
                FontSize="20"
                FontWeight="Bold"
                MarkBrush="#0F000000"
                MarkMargin="3,0" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{DynamicResource PrimaryBrush}"
                Style="{StaticResource TextBlockDefaultBold}"
                Text="{lang:Lang Key={x:Static lang:LangKeys.VisionInformation}}" />

        </hc:SimplePanel>
        <Border
    Grid.Row="2"
    Margin="20,10,20,15"
    Background="White"
    CornerRadius="5">
            <ScrollViewer IsEnabled="{Binding SysRole, Converter={StaticResource RoleEnabledCoverter}, ConverterParameter=Integrator}">
                <StackPanel Margin="15,25,15,0">
                    <TextBlock
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Text="{lang:Lang Key={x:Static lang:LangKeys.DeviceInfo}}" />
                    <hc:Divider Margin="0,3,0,20" />
                    <StackPanel>
                        <TextBlock
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    FontWeight="Bold"
                    Text="{lang:Lang Key={x:Static lang:LangKeys.SFC}}" />
                        <hc:Divider Margin="0,3,0,20" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <hc:TextBox
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="10,10,10,0"
                        hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.StationID}}"
                        hc:InfoElement.TitlePlacement="Left"
                        hc:InfoElement.TitleWidth="80"
                        Foreground="{DynamicResource EditorForeground}"
                        Text="{Binding StationId, UpdateSourceTrigger=PropertyChanged}"
                        TextChanged="TextBox_TextChanged" />
                            <hc:TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="10,10,10,0"
                        hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.StationName}}"
                        hc:InfoElement.TitlePlacement="Left"
                        hc:InfoElement.TitleWidth="80"
                        Foreground="{DynamicResource EditorForeground}"
                        Text="{Binding StationName, UpdateSourceTrigger=PropertyChanged}"
                        TextChanged="TextBox_TextChanged" />
                            <hc:TextBox
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="10,10,10,0"
                        hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Machine}}"
                        hc:InfoElement.TitlePlacement="Left"
                        hc:InfoElement.TitleWidth="80"
                        Foreground="{DynamicResource EditorForeground}"
                        Text="{Binding Product, UpdateSourceTrigger=PropertyChanged}"
                        TextChanged="TextBox_TextChanged" />
                            <hc:TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="10,10,10,0"
                        hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.PlantArea}}"
                        hc:InfoElement.TitlePlacement="Left"
                        hc:InfoElement.TitleWidth="80"
                        Foreground="{DynamicResource EditorForeground}"
                        Text="{Binding SiteCode, UpdateSourceTrigger=PropertyChanged}"
                        TextChanged="TextBox_TextChanged" />
                            <Button
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="10,10,10,0"
                        Command="{Binding UpdateSFCInfoCommand}"
                        Content="更新工站信息"
                        Foreground="{DynamicResource EditorForeground}" />
                        </Grid>
                    </StackPanel>
                    <hc:Divider Margin="0,3,0,20" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="0,10,10,10"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    FontWeight="Bold"
                    Text="{lang:Lang Key={x:Static lang:LangKeys.Vision}}" />

                        <hc:TextBox
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="10,0,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.DeviceSN}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding MachineSn, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="10,0,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.DeviceName}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding MachineName, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="10,0,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.DeviceType}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding MachineType, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />

                        <hc:TextBox
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.DeviceFirm}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding VendorName, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.IPAddress}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding DeviceIP, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="2"
                    Grid.Column="2"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.MacAddress}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding DeviceMac, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.StationType}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding StationType, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Region}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding Area, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="3"
                    Grid.Column="2"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.StationName}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding StationName_Vision, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />

                        <hc:TextBox
                    Grid.Row="4"
                    Grid.Column="0"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Floor}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding Floor, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="4"
                    Grid.Column="1"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Liner}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding LineCode, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" Height="30" VerticalAlignment="Top" />
                        <hc:TextBox
                    Grid.Row="4"
                    Grid.Column="2"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Unit}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding UniteCode, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="5"
                    Grid.Column="0"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.InsightType}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding InsightType, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="5"
                    Grid.Column="1"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.VisionVersion}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding VisionVersion, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="5"
                    Grid.Column="2"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.RobotVersion}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding RobotVersion, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="6"
                    Grid.Column="0"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.LaserVersion}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding LaserVersion, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="6"
                    Grid.Column="1"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.LimitsVersion}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding LimitsVersion, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="6"
                    Grid.Column="2"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.BaliVersion}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding BaliVersion, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="7"
                    Grid.Column="0"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.SoftVersion}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    IsEnabled="False"
                    Text="{Binding SoftVersion, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="7"
                    Grid.Column="1"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Product_Vision}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding Product_Vision, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="7"
                    Grid.Column="2"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.HiveAppId}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding HiveAppId, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="8"
                    Grid.Column="0"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.PictureStoragePath}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="8"
                    Grid.Column="1"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.VisionExtra}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding VisionExtra, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="8"
                    Grid.Column="2"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.ApiVersion}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding ApiVersion, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="9"
                    Grid.Column="0"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.ManageDept_Vision}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding ManageDept_Vision, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:TextBox
                    Grid.Row="9"
                    Grid.Column="1"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.FunctionId}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding FunctionId, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                        <hc:ComboBox
                    Grid.Row="9"
                    Grid.Column="2"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.RegisterType}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    ItemsSource="{Binding RegisterTypes}"
                    Text="{Binding RegisterType, UpdateSourceTrigger=PropertyChanged}" />
                        <hc:TextBox
                    Grid.Row="10"
                    Grid.Column="0"
                    Margin="10,10,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.VisionStationId}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding VisionStationId, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="TextBox_TextChanged" />
                    </Grid>
                    <hc:Divider Margin="0,3,0,20" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />

                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="0,10,10,10"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    FontWeight="Bold"
                    Text="{lang:Lang Key={x:Static lang:LangKeys.FFU}}" />
                        <!--  FFU  -->

                        <hc:ComboBox
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="10,0,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.FFUSpeedLevel}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="80"
                    Foreground="{DynamicResource EditorForeground}"
                    ItemsSource="{Binding FFUSpeedModes}"
                    Text="{Binding FFUSpeedLevel, UpdateSourceTrigger=PropertyChanged}" />
                        <!--  Level  -->

                        <hc:TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="10,0,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.LowCurrentLowLimit}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="120"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding LowCurrentLowLimit, UpdateSourceTrigger=PropertyChanged}" />

                        <hc:TextBox
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="10,0,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.LowCurrentUpperLimit}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="120"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding LowCurrentUpperLimit, UpdateSourceTrigger=PropertyChanged}" />

                        <hc:TextBox
                    Grid.Row="1"
                    Grid.Column="3"
                    Margin="10,0,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.MiddleCurrentLowLimit}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="120"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding MiddleCurrentLowLimit, UpdateSourceTrigger=PropertyChanged}" />

                        <hc:TextBox
                    Grid.Row="1"
                    Grid.Column="4"
                    Margin="10,0,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.MiddleCurrentUpperLimit}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="120"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding MiddleCurrentUpperLimit, UpdateSourceTrigger=PropertyChanged}" />

                        <hc:TextBox
                    Grid.Row="1"
                    Grid.Column="5"
                    Margin="10,0,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.HighCurrentLowLimit}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="120"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding HighCurrentLowLimit, UpdateSourceTrigger=PropertyChanged}" />

                        <hc:TextBox
                    Grid.Row="1"
                    Grid.Column="6"
                    Margin="10,0,10,0"
                    hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.HighCurrentUpperLimit}}"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="120"
                    Foreground="{DynamicResource EditorForeground}"
                    Text="{Binding HighCurrentUpperLimit, UpdateSourceTrigger=PropertyChanged}" />

                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

    </Grid>
</UserControl>
