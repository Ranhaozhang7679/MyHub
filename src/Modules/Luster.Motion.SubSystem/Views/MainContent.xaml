<UserControl
    x:Class="Luster.Motion.SubSystem.Views.MainContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter1="clr-namespace:Luster.Motion.CommonUI.Converter;assembly=Luster.Motion.CommonUI"
    xmlns:ctrl="clr-namespace:Luster.Control.Wpf.Motion.Controls;assembly=Luster.Control.Wpf.Motion"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:g="clr-namespace:Luster.Motion.CommonUI;assembly=Luster.Motion.CommonUI"
    xmlns:gc="clr-namespace:Luster.Common.Assets.Global;assembly=Luster.Common.Assets"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.SubSystem.Views"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:views="clr-namespace:Luster.Motion.CommonUI.Views;assembly=Luster.Motion.CommonUI"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding Command="{x:Static g:GlobalCommands.SaveCommand}" Gesture="Ctrl+S" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="450" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="750" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ContentControl
            Grid.Row="0"
            Grid.Column="0"
            prism:RegionManager.RegionName="ProIndexRegion" />
        <ContentControl
            Grid.Row="1"
            Grid.Column="0"
            Margin="5,5,0,0"
            prism:RegionManager.RegionName="ProReportRegion"
            Focusable="True" />
        <GridSplitter
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="2"
            Margin="0,10"
            HorizontalAlignment="Stretch"
            Foreground="{DynamicResource RegionBrush}" />
        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="2"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="2">
            <Grid Margin="0">
                <ContentControl prism:RegionManager.RegionName="ModuleDisplayRegion" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
