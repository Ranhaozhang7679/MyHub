<UserControl
    x:Class="Luster.Motion.SubSystem.Views.FileConfigContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.SubSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="650"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#F0F2F5"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>
        <hc:SimplePanel
            Grid.Row="0"
            Grid.ColumnSpan="3"
            Height="32"
            Background="#F4F6FA">
            <hc:Watermark
                FontSize="20"
                FontWeight="Bold"
                MarkBrush="#0F000000"
                MarkMargin="3,0" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{DynamicResource PrimaryBrush}"
                Style="{StaticResource TextBlockDefaultBold}"
                Text="{lang:Lang Key={x:Static lang:LangKeys.FileConfig}}" />

        </hc:SimplePanel>
        <GroupBox
            Grid.Row="1"
            Margin="0,5"
            Padding="10"
            HorizontalContentAlignment="Left"
            BorderThickness="0"
            Header="{lang:Lang Key={x:Static lang:LangKeys.DataBase}}"
            Style="{StaticResource GroupBoxTab}">
            <Border Background="{DynamicResource RegionBrush}" CornerRadius="4">
                <WrapPanel
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <StackPanel Margin="5" Orientation="Horizontal">
                        <hc:TextBox
                            MinWidth="400"
                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.DefaultPath}}"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="80"
                            Foreground="Black"
                            IsEnabled="False"
                            Text="{Binding DBPath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        <Button
                            Margin="5,0,0,0"
                            hc:IconElement.Geometry="{StaticResource FolderGeometry}"
                            Background="Transparent"
                            BorderBrush="#4BA4FE"
                            Command="{Binding SelectPathCommand}"
                            CommandParameter="DB"
                            Content="{lang:Lang Key={x:Static lang:LangKeys.Broswer}}"
                            Foreground="#4BA4FE"
                            IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Margin="5" Orientation="Horizontal">
                        <hc:TextBox
                            MinWidth="400"
                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.DumpPath}}"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="80"
                            Foreground="Black"
                            IsEnabled="True"
                            Text="{Binding DumpDBPath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            TextChanged="TextBox_TextChanged" />
                        <Button
                            Margin="5,0,0,0"
                            hc:IconElement.Geometry="{StaticResource FolderGeometry}"
                            Background="Transparent"
                            BorderBrush="#4BA4FE"
                            Command="{Binding SelectPathCommand}"
                            CommandParameter="DumpDB"
                            Content="{lang:Lang Key={x:Static lang:LangKeys.Broswer}}"
                            Foreground="#4BA4FE" />
                    </StackPanel>
                    <StackPanel Margin="5" Orientation="Horizontal">
                        <hc:TextBox
                            Width="200"
                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.SaveDays}}"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="80"
                            Foreground="Black"
                            Text="{Binding DBSaveDays, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            TextChanged="TextBox_TextChanged" />
                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="{lang:Lang Key={x:Static lang:LangKeys.Day}}" />
                    </StackPanel>

                </WrapPanel>
            </Border>
        </GroupBox>
        <GroupBox
            Grid.Row="1"
            Grid.Column="2"
            Margin="0,5"
            Padding="10"
            HorizontalContentAlignment="Left"
            BorderThickness="0"
            Header="{lang:Lang Key={x:Static lang:LangKeys.Image}}"
            Style="{StaticResource GroupBoxTab}">
            <Border Background="{DynamicResource RegionBrush}" CornerRadius="4">
                <WrapPanel
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <StackPanel Margin="5" Orientation="Horizontal">
                        <hc:TextBox
                            MinWidth="400"
                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.DefaultPath}}"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="80"
                            Foreground="Black"
                            Text="{Binding PicPath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        <Button
                            Margin="5,0,0,0"
                            hc:IconElement.Geometry="{StaticResource FolderGeometry}"
                            Background="Transparent"
                            BorderBrush="#4BA4FE"
                            Command="{Binding SelectPathCommand}"
                            CommandParameter="Pic"
                            Content="{lang:Lang Key={x:Static lang:LangKeys.Broswer}}"
                            Foreground="#4BA4FE" />
                    </StackPanel>
                    <StackPanel Margin="5" Orientation="Horizontal">
                        <hc:TextBox
                            Width="200"
                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.SaveDays}}"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="80"
                            Foreground="Black"
                            Text="{Binding PicSaveDays, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            TextChanged="TextBox_TextChanged" />
                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="{lang:Lang Key={x:Static lang:LangKeys.Day}}" />
                    </StackPanel>
                    <StackPanel Margin="5" Orientation="Horizontal">
                        <hc:TextBox
                            Width="200"
                            hc:InfoElement.Title="日志存放路径"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="80"
                            Foreground="Black"
                            Text="{Binding LogsSavePath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            TextChanged="TextBox_TextChanged" />
                        <Button
                            Margin="5,0,0,0"
                            hc:IconElement.Geometry="{StaticResource FolderGeometry}"
                            Background="Transparent"
                            BorderBrush="#4BA4FE"
                            Command="{Binding SelectPathCommand}"
                            CommandParameter="Log"
                            Content="{lang:Lang Key={x:Static lang:LangKeys.Broswer}}"
                            Foreground="#4BA4FE" />
                    </StackPanel>
                </WrapPanel>
            </Border>
        </GroupBox>
        <GroupBox
            Grid.Row="2"
            Grid.ColumnSpan="3"
            Margin="0,5"
            Padding="10"
            HorizontalContentAlignment="Left"
            BorderThickness="0"
            Header="{lang:Lang Key={x:Static lang:LangKeys.BackUpSet}}"
            Style="{StaticResource GroupBoxTab}">
            <Border Background="{DynamicResource RegionBrush}" CornerRadius="4">
                <WrapPanel
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <StackPanel Margin="5" Orientation="Horizontal">
                        <hc:TextBox
                            MinWidth="200"
                            Margin="5,0,0,0"
                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.LogBackUpDays}}"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="80"
                            Foreground="Black"
                            Text="{Binding LogBackUpDays, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="{lang:Lang Key={x:Static lang:LangKeys.Day}}" />
                    </StackPanel>
                    <StackPanel Margin="25,5,5,5" Orientation="Horizontal">
                        <hc:TextBox
                            Width="200"
                            Margin="5,0,0,0"
                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.RecipeBackUpDays}}"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="80"
                            Foreground="Black"
                            Text="{Binding RecipeBackUpDays, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            TextChanged="TextBox_TextChanged" />
                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="{lang:Lang Key={x:Static lang:LangKeys.Day}}" />
                    </StackPanel>
                    <StackPanel Margin="25,5,5,5" Orientation="Horizontal">
                        <hc:TextBox
                            Width="200"
                            Margin="5,0,0,0"
                            hc:InfoElement.Title="数据库备份天数"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="100"
                            Foreground="Black"
                            Text="{Binding DBBackUpDays, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            TextChanged="TextBox_TextChanged" />
                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="{lang:Lang Key={x:Static lang:LangKeys.Day}}" />
                    </StackPanel>

                </WrapPanel>
            </Border>
        </GroupBox>

        <GroupBox
            Grid.Row="3"
            Grid.ColumnSpan="3"
            Margin="0,5"
            Padding="10"
            HorizontalContentAlignment="Left"
            BorderThickness="0"
            Header="{lang:Lang Key={x:Static lang:LangKeys.Maintenance}}"
            Style="{StaticResource GroupBoxTab}">
            <Border Background="{DynamicResource RegionBrush}" CornerRadius="4">
                <WrapPanel
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <StackPanel Margin="5" Orientation="Horizontal">
                        <hc:TextBox
                            MinWidth="300"
                            Margin="5,0,0,0"
                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.LastWeekMaintenance}}"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="100"
                            Foreground="Black"
                            IsReadOnly="True"
                            Text="{Binding LastWeekMaintenanceDate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Margin="25,5,5,5" Orientation="Horizontal">
                        <hc:TextBox
                            Width="300"
                            Margin="5,0,0,0"
                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.LastMonthMaintenance}}"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="100"
                            Foreground="Black"
                            IsReadOnly="True"
                            Text="{Binding LastMonthMaintenanceDate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            TextChanged="TextBox_TextChanged" />
                    </StackPanel>
                </WrapPanel>
            </Border>
        </GroupBox>
        <GroupBox
            Grid.Row="4"
            Grid.ColumnSpan="3"
            Margin="0,5"
            Padding="10"
            HorizontalContentAlignment="Left"
            BorderThickness="0"
            Header="{lang:Lang Key={x:Static lang:LangKeys.HiveConfig}}"
            Style="{StaticResource GroupBoxTab}">
            <Border Background="{DynamicResource RegionBrush}" CornerRadius="4">
                <WrapPanel
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <StackPanel Margin="5" Orientation="Horizontal">
                        <hc:TextBox
                            Width="500"
                            Margin="5,0,0,0"
                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.DownTimeReason}}"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="100"
                            Foreground="Black"
                            hc:InfoElement.Placeholder="可以输入多个，用@分割"
                            Text="{Binding DownTimeCauses, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                            TextChanged="TextBox_TextChanged"/>
                    </StackPanel>
                    <StackPanel Margin="5,5,5,5" Orientation="Horizontal">
                        <hc:TextBox
                            Width="500"
                            Margin="5,0,0,0"
                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.SparePartsUsed}}"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:TitleElement.TitleWidth="100"
                            Foreground="Black"
                            hc:InfoElement.Placeholder="可以输入多个，用@分割"
                            Text="{Binding SparePartsUsed, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            TextChanged="TextBox_TextChanged" />
                    </StackPanel>
                </WrapPanel>
            </Border>
        </GroupBox>

    </Grid>
</UserControl>
