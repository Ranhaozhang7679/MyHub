<UserControl
    x:Class="Luster.Motion.SubSystem.Views.AlarmConfig"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.SubSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Border Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Margin="10,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Text="{lang:Lang Key={x:Static lang:LangKeys.Alarm}}" />
            <StackPanel
                Grid.Row="0"
                Width="Auto"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="White"
                Orientation="Horizontal">
                <Button
                    x:Name="Add"
                    Width="50"
                    Margin="0,5,10,5"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    BorderBrush="#57a9fd"
                    Command="{Binding DataContext.AddAlarm, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Add}}" />
                <Button
                    x:Name="Export"
                    Width="60"
                    Margin="0,5,10,5"
                    Background="Transparent"
                    BorderBrush="#57a9fd"
                    Command="{Binding ExportCommand}"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Export}}"
                    Foreground="#57a9fd" />
                <Button
                    x:Name="Import"
                    Width="60"
                    Margin="0,5,10,5"
                    Background="Transparent"
                    BorderBrush="#57a9fd"
                    Command="{Binding ImportCommand}"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Import}}"
                    Foreground="#57a9fd" />
            </StackPanel>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <DataGrid
                    AlternationCount="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CanUserSortColumns="False"
                    ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                    HeadersVisibility="Column"
                    IsReadOnly="False"
                    ItemsSource="{Binding PlcAlarmList}"
                    RowStyle="{StaticResource CustomDataGridRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="100"
                            Binding="{Binding AlarmId}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.AlarmID}}" />
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="100"
                            Binding="{Binding AlarmContent}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.AlarmContent}}" />
                        <DataGridTextColumn
                            Width="*"
                            MinWidth="100"
                            Binding="{Binding AlarmSoultion}"
                            ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.AlarmSolution}}" />
                        <DataGridTemplateColumn
                            Width="110"
                            MinWidth="100"
                            hc:TitleElement.HorizontalAlignment="Center"
                            CanUserResize="False"
                            Header="{lang:Lang Key={x:Static lang:LangKeys.Operate}}"
                            HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <hc:ElementGroup HorizontalContentAlignment="Center" Orientation="Horizontal">
                                        <Button
                                            Margin="0"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.DeletePlcAlarmCommand}"
                                            CommandParameter="{Binding}"
                                            Content="{lang:Lang Key={x:Static lang:LangKeys.Delete}}"
                                            Style="{StaticResource ButtonDanger.Small}" />
                                    </hc:ElementGroup>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>

        </Grid>
    </Border>
</UserControl>
