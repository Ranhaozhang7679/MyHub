<UserControl
    x:Class="Luster.Motion.SubSystem.Views.ChartCopyContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chart="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Luster.Motion.SubSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Visibility="{Binding IsVisible, Converter={StaticResource Boolean2VisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <hc:SimplePanel
                Grid.Row="0"
                Height="32"
                Background="#F4F6FA">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource PrimaryBrush}"
                    Style="{StaticResource TextBlockDefaultBold}"
                    Text="报表" />
                <Button
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    hc:IconElement.Geometry="{StaticResource SettingGeometry}"
                    Command="{Binding SetCommand}"
                    Foreground="{DynamicResource PrimaryBrush}"
                    IsEnabled="{Binding BtnEnable}"
                    Style="{StaticResource ButtonIcon}" />
            </hc:SimplePanel>
            <Border
                Grid.Row="1"
                Height="200"
                Margin="10"
                BorderBrush="#57a9fd"
                BorderThickness="1"
                CornerRadius="0" />
        </Grid>
        <Grid Grid.Row="1" Background="{DynamicResource RegionBrush}">
            <ListBox
                Name="ListChart"
                Grid.Column="1"
                Margin="0,0"
                BorderThickness="0"
                ItemsSource="{Binding ChartList}"
                Style="{DynamicResource ListBoxCustom}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <hc:SimplePanel
                                Grid.Row="0"
                                Height="32"
                                Background="#F4F6FA">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Style="{StaticResource TextBlockDefaultBold}"
                                    Text="{Binding Name}" />
                                <Button
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    hc:IconElement.Geometry="{StaticResource SettingGeometry}"
                                    Command="{Binding Path=DataContext.SetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    IsEnabled="{Binding Path=DataContext.BtnEnable, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    Style="{StaticResource ButtonIcon}" />
                            </hc:SimplePanel>
                            <Border
                                Grid.Row="1"
                                Margin="10"
                                BorderBrush="#57a9fd"
                                BorderThickness="1"
                                CornerRadius="0">
                                <hc:ScrollViewer HorizontalScrollBarVisibility="Visible">
                                    <chart:CartesianChart
                                        Name="ChartReport"
                                        MinWidth="{Binding Width}"
                                        MinHeight="{Binding Height}"
                                        Background="{DynamicResource RegionBrush}"
                                        BorderBrush="Black"
                                        BorderThickness="1"
                                        LegendPosition="Bottom"
                                        LegendTextPaint="{Binding LegendTextPaint}"
                                        Series="{Binding SrSeries}"
                                        TooltipTextPaint="{Binding TooltipTextPaint}"
                                        XAxes="{Binding XAxes}"
                                        YAxes="{Binding YAxes}"
                                        ZoomMode="X" />
                                </hc:ScrollViewer>
                            </Border>
                        </Grid>

                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

    </Grid>
</UserControl>
