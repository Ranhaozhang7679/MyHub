<UserControl
    x:Class="Luster.Motion.AlarmUI.Views.AlarmTimeStatisticContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Luster.Motion.AlarmUI.Views"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label
                Width="300"
                Height="30"
                Margin="0,5,0,0"
                Background="Transparent"
                BorderThickness="0"
                Content="Downtime Statistic(Top10)"
                FontSize="16"
                FontWeight="UltraBlack" />
            <Border
                Grid.Row="1"
                Margin="5"
                BorderBrush="Black"
                BorderThickness="1">
                <DataGrid
                    Grid.Row="1"
                    Padding="0"
                    AlternationCount="1"
                    Background="Transparent"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CanUserSortColumns="False"
                    ColumnHeaderStyle="{DynamicResource AppleDataGridColumnHeaderStyle}"
                    HeadersVisibility="Column"
                    IsReadOnly="False"
                    ItemsSource="{Binding AlarmGroupList}"
                    RowStyle="{DynamicResource AppleDataGridRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="45" MinWidth="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Label
                                        Height="25"
                                        MinWidth="50"
                                        Background="{Binding Color}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="120"
                            MinWidth="120"
                            Binding="{Binding AlarmType}"
                            ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                            Header="Error" />
                        <DataGridTextColumn
                            Width="50"
                            MinWidth="100"
                            Binding="{Binding Time}"
                            ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                            Header="Total Time" />
                        <DataGridTextColumn
                            Width="50"
                            MinWidth="100"
                            Binding="{Binding Count}"
                            ElementStyle="{DynamicResource DataColumnTextElementStyleCenter}"
                            Header="Count Total" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
        <lvc:PieChart
            Grid.Column="1"
            Hoverable="False"
            Series="{Binding PieSeriesCollection}">
            <lvc:PieChart.DataTooltip>
                <lvc:DefaultTooltip BulletSize="10" />
            </lvc:PieChart.DataTooltip>
        </lvc:PieChart>

    </Grid>
</UserControl>
