<UserControl
    x:Class="Luster.Motion.AlarmUI.Views.AlarmContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chart="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.AlarmUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Built-in converter -->
            <BooleanToVisibilityConverter x:Key="Boolean2VisibilityConverter" />

            <Style
                x:Key="ReportRadioButtonStyle"
                BasedOn="{StaticResource RadioButtonSameAsButtonDefault}"
                TargetType="RadioButton">
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextIconBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Margin="10" CornerRadius="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <GridSplitter Width="3" HorizontalAlignment="Right" />

            <!-- Left: Chart + Today list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <StackPanel
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <RadioButton
                        Width="80"
                        Height="30"
                        VerticalAlignment="Center"
                        Command="{Binding ChangeSerieCommand}"
                        CommandParameter="天"
                        Content="{lang:Lang Key={x:Static lang:LangKeys.Day}}"
                        IsChecked="True"
                        Style="{StaticResource ReportRadioButtonStyle}" />
                    <RadioButton
                        Width="80"
                        Height="30"
                        Margin="5"
                        VerticalAlignment="Center"
                        Command="{Binding ChangeSerieCommand}"
                        CommandParameter="周"
                        Content="{lang:Lang Key={x:Static lang:LangKeys.Week}}"
                        Style="{StaticResource ReportRadioButtonStyle}" />
                    <RadioButton
                        Width="80"
                        Height="30"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Command="{Binding ChangeSerieCommand}"
                        CommandParameter="月"
                        Content="{lang:Lang Key={x:Static lang:LangKeys.Month}}"
                        Style="{StaticResource ReportRadioButtonStyle}" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>

                    <chart:CartesianChart
                        Margin="0,0,5,10"
                        LegendLocation="Bottom"
                        Series="{Binding SCollections}"
                        DataClick="CartesianChart_DataClick"
                        >
                        <chart:CartesianChart.AxisX>
                            <chart:Axis Labels="{Binding AlarmLables}" LabelsRotation="-90">

                            </chart:Axis>
                        </chart:CartesianChart.AxisX>
                        <chart:CartesianChart.AxisY>
                            <chart:Axis MinValue="0" />
                        </chart:CartesianChart.AxisY>
                    </chart:CartesianChart>
                    <Border
                        Grid.Row="1"
                        Margin="5,5,5,0"
                        Background="{DynamicResource RegionBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Effect="{StaticResource EffectShadow4}">
                        <DataGrid
                            AutoGenerateColumns="False"
                            Padding="0"
                            AlternationCount="2"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="2"
                            CanUserSortColumns="True"
                            ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                            HeadersVisibility="Column"
                            HorizontalScrollBarVisibility="Auto"
                            IsReadOnly="True"
                            ItemsSource="{Binding CurrentDayAlarmVMs}"
                            RowStyle="{StaticResource CustomDataGridRowStyle}"
                            GridLinesVisibility="None"
                            HorizontalGridLinesBrush="Transparent"
                            VerticalGridLinesBrush="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="10"
                                    Binding="{Binding Id}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="ID" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="10"
                                    Binding="{Binding Module}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="{lang:Lang Key={x:Static lang:LangKeys.Module}}" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="10"
                                    Binding="{Binding AlarmType}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="{lang:Lang Key={x:Static lang:LangKeys.AlarmType}}" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="10"
                                    Binding="{Binding Reason}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="{lang:Lang Key={x:Static lang:LangKeys.Reason}}" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="10"
                                    Binding="{Binding StartTime}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="{lang:Lang Key={x:Static lang:LangKeys.StartTime}}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Right: Header fixed + Content + Footer fixed -->
            <Grid Grid.Column="1" Margin="10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Header: view switch + query controls -->
                <Grid Grid.Row="0" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Margin="5,0,0,0"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">
                        <RadioButton
                            VerticalAlignment="Center"
                            Command="{Binding ShowAlarmViewCommand}"
                            Content="{lang:Lang Key={x:Static lang:LangKeys.AlarmDetailInfo}}"
                            IsChecked="{Binding IsAlarmView}"
                            Style="{StaticResource ReportRadioButtonStyle}" />
                        <RadioButton
                            Margin="5"
                            VerticalAlignment="Center"
                            Command="{Binding ShowLogViewCommand}"
                            Content="{lang:Lang Key={x:Static lang:LangKeys.SysOperateInfo}}"
                            Style="{StaticResource ReportRadioButtonStyle}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        Margin="0,5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{DynamicResource BackgroundBrush}"
                        Orientation="Horizontal">
                        <hc:DatePicker
                            Width="180"
                            Height="30"
                            Margin="10,0,0,0"
                            hc:InfoElement.Placeholder="开始日期时间"
                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.StartTime}}"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:InfoElement.TitleWidth="70"
                            hc:InfoElement.VerticalAlignment="Center"
                            SelectedDate="{Binding StartTime}"
                            Style="{StaticResource DatePickerExtend}" />
                        <hc:DatePicker
                            Width="180"
                            Height="30"
                            Margin="10,0,0,0"
                            hc:InfoElement.Placeholder="结束日期时间"
                            hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.EndTime}}"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:InfoElement.TitleWidth="70"
                            hc:InfoElement.VerticalAlignment="Center"
                            SelectedDate="{Binding EndTime}"
                            Style="{StaticResource DatePickerExtend}" />
                        <hc:SearchBar
                            Width="160"
                            Height="30"
                            Margin="10,0"
                            hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.PleaseEnterConditions}}"
                            Command="{Binding QueryCommand}"
                            Style="{StaticResource SearchBarExtend}"
                            Text="{Binding SearchParas, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Margin="0,0,5,0"
                            Command="{Binding ExportCommand}"
                            Content="{lang:Lang Key={x:Static lang:LangKeys.ExportData}}"
                            Style="{StaticResource ButtonPrimary}" />
                    </StackPanel>
                </Grid>

                <!-- Content -->
                <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}">
                    <DockPanel>
                        <!-- Alarm View -->
                        <StackPanel
                            DockPanel.Dock="Top"
                            Margin="5,5,5,0"
                            Orientation="Horizontal"
                            Visibility="{Binding IsAlarmView, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <RadioButton
                                VerticalAlignment="Center"
                                Content="报警"
                                IsChecked="{Binding IsAlarmTab}"
                                Style="{StaticResource ReportRadioButtonStyle}" />
                            <RadioButton
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Content="警告"
                                IsChecked="{Binding IsWarningTab}"
                                Style="{StaticResource ReportRadioButtonStyle}" />
                            <RadioButton
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Content="统计信息"
                                IsChecked="{Binding IsStatisticsTab}"
                                Style="{StaticResource ReportRadioButtonStyle}" />
                            <RadioButton
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Content="Towntime"
                                IsChecked="{Binding IsDownTimeBomTab}"
                                Style="{StaticResource ReportRadioButtonStyle}" />
                            <RadioButton
                                Visibility="Visible"
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Content="DownTimeChart"
                                IsChecked="{Binding IsDownTimeTab}"
                                Style="{StaticResource ReportRadioButtonStyle}" />
                        </StackPanel>

                        <!-- Alarm List -->
                        <DataGrid
                            AutoGenerateColumns="False"
                            Margin="5"
                            Padding="0"
                            AlternationCount="2"
                            BorderThickness="0"
                            BorderBrush="Transparent"
                            CanUserSortColumns="True"
                            ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                            HeadersVisibility="Column"
                            HorizontalScrollBarVisibility="Auto"
                            IsReadOnly="True"
                            ItemsSource="{Binding AlarmItemVMs}"
                            RowStyle="{StaticResource CustomDataGridRowStyle}"
                            GridLinesVisibility="None"
                            HorizontalGridLinesBrush="Transparent"
                            VerticalGridLinesBrush="Transparent">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="AutoGenerateColumns" Value="False" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsAlarmView}" Value="True" />
                                                <Condition Binding="{Binding IsAlarmListVisible}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="10"
                                    Binding="{Binding Id}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="ID" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="10"
                                    Binding="{Binding Module}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="{lang:Lang Key={x:Static lang:LangKeys.Module}}" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="10"
                                    Binding="{Binding AlarmType}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="{lang:Lang Key={x:Static lang:LangKeys.AlarmType}}" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="10"
                                    Binding="{Binding AlarmCode}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="{lang:Lang Key={x:Static lang:LangKeys.AlarmCode}}" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="10"
                                    Binding="{Binding AlarmLongTime}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="{lang:Lang Key={x:Static lang:LangKeys.AlarmTime}}" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="10"
                                    Binding="{Binding StartTime}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="{lang:Lang Key={x:Static lang:LangKeys.StartTime}}" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="10"
                                    Binding="{Binding EndTime}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="{lang:Lang Key={x:Static lang:LangKeys.EndTime}}" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="10"
                                    Binding="{Binding Reason}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="{lang:Lang Key={x:Static lang:LangKeys.Reason}}" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="10"
                                    Binding="{Binding ProcMethod}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="{lang:Lang Key={x:Static lang:LangKeys.HandlingMethod}}" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="10"
                                    Binding="{Binding ProcUser}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="{lang:Lang Key={x:Static lang:LangKeys.HandledUser}}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Statistics List (Alarm+Warning summary; downtime only counts Alarm types) -->
                        <DataGrid
                            AutoGenerateColumns="False"
                            Margin="5"
                            Padding="0"
                            AlternationCount="2"
                            BorderThickness="0"
                            BorderBrush="Transparent"
                            CanUserSortColumns="True"
                            ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                            HeadersVisibility="Column"
                            HorizontalScrollBarVisibility="Auto"
                            IsReadOnly="True"
                            ItemsSource="{Binding AlarmStatisticsRows}"
                            RowStyle="{StaticResource CustomDataGridRowStyle}"
                            GridLinesVisibility="None"
                            HorizontalGridLinesBrush="Transparent"
                            VerticalGridLinesBrush="Transparent">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="AutoGenerateColumns" Value="False" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsAlarmView}" Value="True" />
                                                <Condition Binding="{Binding IsStatisticsTab}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="40"
                                    Binding="{Binding Index}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="序号" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="60"
                                    Binding="{Binding Category}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="类别" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="140"
                                    Binding="{Binding AlarmType}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="类型" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="120"
                                    Binding="{Binding Module}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="模块" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="60"
                                    Binding="{Binding Count}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="次数" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="90"
                                    Binding="{Binding TotalMinutes}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="宕机总时长(min)" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="90"
                                    Binding="{Binding AvgMinutes}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="平均(min)" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="90"
                                    Binding="{Binding MaxMinutes}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="最大(min)" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="100"
                                    Binding="{Binding PercentByAlarmDownTime}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="宕机占比(%)" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- DownTime Chart: per-day downtime segments (no pie chart) -->
                        <Border Margin="5" Background="{DynamicResource RegionBrush}" CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsAlarmView}" Value="True" />
                                                <Condition Binding="{Binding IsDownTimeTab}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Margin="10,8,10,0" FontSize="14" FontWeight="SemiBold" Text="设备宕机时间段(按天)" />

                                <!-- 关键：用横向滚动容器 + 给图一个较大的最小宽度，形成“展开的甘特图”效果 -->
                                <!-- DownTimeChart 区域：用一个容器 Grid 把 Chart + Tooltip 叠在一起 -->
                                <Grid Grid.Row="1">
                                    <chart:CartesianChart
                                        MinWidth="1200"
                                        LegendLocation="None"
                                        Series="{Binding DownTimeSeries}"
                                        Zoom="X"
                                        Hoverable="True"
                                        DataTooltip="{x:Null}"
                                        MouseMove="DownTimeChart_MouseMove"
                                        MouseLeave="DownTimeChart_MouseLeave">

                                        <chart:CartesianChart.AxisX>
                                            <chart:Axis
                                                Title="时间"
                                                LabelFormatter="{Binding DownTimeFormatter}"
                                                MinValue="{Binding DownTimeMinValue}"
                                                MaxValue="{Binding DownTimeMaxValue}"
                                                LabelsRotation="0">
                                                <chart:Axis.Separator>
                                                    <chart:Separator Step="60" />
                                                </chart:Axis.Separator>
                                            </chart:Axis>
                                        </chart:CartesianChart.AxisX>

                                        <!-- DownTime Chart: AxisY -->
                                        <chart:CartesianChart.AxisY>
                                            <chart:Axis
                                                Title="日期"
                                                LabelFormatter="{Binding DownTimeYLabelFormatter}"
                                                MinValue="{Binding DownTimeYMinValue}"
                                                MaxValue="{Binding DownTimeYMaxValue}">
                                                <chart:Axis.Separator>
                                                    <!-- 必须启用，否则不会生成刻度/标签 -->
                                                    <!-- Stroke=Transparent: 不显示横向分隔线，但保留刻度与 LabelFormatter -->
                                                    <chart:Separator Step="1"/>
                                                </chart:Axis.Separator>
                                            </chart:Axis>
                                        </chart:CartesianChart.AxisY>
                                    </chart:CartesianChart>

                                    <!-- Custom Tooltip：叠加层（同一容器内，覆盖图表） -->
                                    <Canvas IsHitTestVisible="False">
                                        <Border
                                            x:Name="CustomTooltip_DownTime"
                                            Background="#CC000000"
                                            BorderBrush="White"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="10"
                                            Visibility="Collapsed">
                                            <TextBlock x:Name="TooltipText_DownTime" Foreground="White" Text="Info" />
                                        </Border>
                                    </Canvas>

                                    <!-- 图例：颜色-类型 -->
                                    <ItemsControl Margin="10,30,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        ItemsSource="{Binding AlarmGroupList}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                                    <Rectangle Width="16" Height="16" Fill="{Binding Color}" Stroke="{Binding Color}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding AlarmType}" Foreground="{DynamicResource TextBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- TowntimeBom: 用表格展示甘特图统计明细 -->
                        <DataGrid
                            AutoGenerateColumns="False"
                            Margin="5"
                            Padding="0"
                            AlternationCount="2"
                            BorderThickness="0"
                            BorderBrush="Transparent"
                            CanUserSortColumns="True"
                            ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                            HeadersVisibility="Column"
                            HorizontalScrollBarVisibility="Auto"
                            IsReadOnly="True"
                            ItemsSource="{Binding DownTimeSegments}"
                            RowStyle="{StaticResource CustomDataGridRowStyle}"
                            GridLinesVisibility="None"
                            HorizontalGridLinesBrush="Transparent"
                            VerticalGridLinesBrush="Transparent">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsAlarmView}" Value="True" />
                                                <Condition Binding="{Binding IsDownTimeBomTab}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="Auto" MinWidth="120" Binding="{Binding Day, StringFormat=yyyy-MM-dd}" ElementStyle="{StaticResource DataColumnTextElementStyleCenter}" Header="日期" />
                                <DataGridTextColumn Width="Auto" MinWidth="160" Binding="{Binding Start, StringFormat=yyyy-MM-dd HH:mm:ss}" ElementStyle="{StaticResource DataColumnTextElementStyleCenter}" Header="开始" />
                                <DataGridTextColumn Width="Auto" MinWidth="160" Binding="{Binding End, StringFormat=yyyy-MM-dd HH:mm:ss}" ElementStyle="{StaticResource DataColumnTextElementStyleCenter}" Header="结束" />
                                <DataGridTextColumn Width="Auto" MinWidth="90" Binding="{Binding Minutes}" ElementStyle="{StaticResource DataColumnTextElementStyleCenter}" Header="时长(min)" />
                                <DataGridTextColumn Width="Auto" MinWidth="120" Binding="{Binding AlarmType}" ElementStyle="{StaticResource DataColumnTextElementStyleCenter}" Header="类型" />
                                <DataGridTextColumn Width="*" MinWidth="140" Binding="{Binding Module}" ElementStyle="{StaticResource DataColumnTextElementStyleCenter}" Header="模块" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Log List (System Operation Info) -->
                        <DataGrid
                            AutoGenerateColumns="False"
                            Margin="5"
                            Padding="0"
                            AlternationCount="2"
                            BorderThickness="0"
                            BorderBrush="Transparent"
                            CanUserSortColumns="True"
                            ColumnHeaderStyle="{StaticResource CustomDataGridColumnHeaderStyle}"
                            HeadersVisibility="Column"
                            HorizontalScrollBarVisibility="Auto"
                            IsReadOnly="True"
                            ItemsSource="{Binding LogItemVMs}"
                            RowStyle="{StaticResource CustomDataGridRowStyle}"
                            GridLinesVisibility="None"
                            HorizontalGridLinesBrush="Transparent"
                            VerticalGridLinesBrush="Transparent">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAlarmView}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="10"
                                    Binding="{Binding Id}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="ID" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="10"
                                    Binding="{Binding Operation}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="操作内容" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="10"
                                    Binding="{Binding UserName}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="用户" />
                                <DataGridTextColumn
                                    Width="Auto"
                                    MinWidth="10"
                                    Binding="{Binding CreateTime}"
                                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                                    Header="时间" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Footer paging: Alarm -->
                <StackPanel
                    Grid.Row="2"
                    Margin="5,0,5,5"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAlarmView}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <hc:NumericUpDown
                        Height="30"
                        hc:InfoElement.Title="{lang:Lang Key={x:Static lang:LangKeys.MaxPerPage}}"
                        hc:InfoElement.TitlePlacement="Left"
                        hc:InfoElement.TitleWidth="80"
                        Minimum="1"
                        Style="{StaticResource NumericUpDownExtend}"
                        Value="{Binding AlarmPerPageCount}">
                        <hc:Interaction.Triggers>
                            <hc:EventTrigger EventName="ValueChanged">
                                <hc:EventToCommand Command="{Binding QueryCommand}" />
                            </hc:EventTrigger>
                        </hc:Interaction.Triggers>
                    </hc:NumericUpDown>
                    <hc:Pagination
                        Margin="5,5,0,5"
                        AutoHiding="False"
                        DataCountPerPage="{Binding AlarmPerPageCount}"
                        IsJumpEnabled="True"
                        MaxPageCount="{Binding AlarmPageCount}"
                        MaxPageInterval="3"
                        PageIndex="{Binding AlarmPageIndex, Mode=TwoWay}">
                        <hc:Interaction.Triggers>
                            <hc:EventTrigger EventName="PageUpdated">
                                <hc:EventToCommand Command="{Binding PageUpdatedCommand}" PassEventArgsToCommand="True" />
                            </hc:EventTrigger>
                        </hc:Interaction.Triggers>
                    </hc:Pagination>
                </StackPanel>

                <!-- Footer paging: Log -->
                <StackPanel
                    Grid.Row="2"
                    Margin="5,0,5,5"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAlarmView}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <hc:NumericUpDown
                        Height="30"
                        hc:InfoElement.Title="每页数量"
                        hc:InfoElement.TitlePlacement="Left"
                        hc:InfoElement.TitleWidth="80"
                        Minimum="1"
                        Style="{StaticResource NumericUpDownExtend}"
                        Value="{Binding LogPerPageCount}">
                        <hc:Interaction.Triggers>
                            <hc:EventTrigger EventName="ValueChanged">
                                <hc:EventToCommand Command="{Binding QueryCommand}" />
                            </hc:EventTrigger>
                        </hc:Interaction.Triggers>
                    </hc:NumericUpDown>
                    <hc:Pagination
                        Margin="5,5,0,5"
                        AutoHiding="False"
                        DataCountPerPage="{Binding LogPerPageCount}"
                        IsJumpEnabled="True"
                        MaxPageCount="{Binding LogPageCount}"
                        MaxPageInterval="3"
                        PageIndex="{Binding LogPageIndex, Mode=TwoWay}">
                        <hc:Interaction.Triggers>
                            <hc:EventTrigger EventName="PageUpdated">
                                <hc:EventToCommand Command="{Binding PageUpdatedCommand}" PassEventArgsToCommand="True" />
                            </hc:EventTrigger>
                        </hc:Interaction.Triggers>
                    </hc:Pagination>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</UserControl>
    