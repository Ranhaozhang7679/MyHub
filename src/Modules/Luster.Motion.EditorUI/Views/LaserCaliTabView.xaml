<UserControl
    x:Class="Luster.Motion.EditorUI.Views.LaserCaliTabView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.EditorUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:param="clr-namespace:Luster.Control.Wpf.Motion;assembly=Luster.Control.Wpf.Motion"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="520"
    d:DesignWidth="480"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <!--
        激光标定 Tab UserControl（TES-140 XAML 骨架）
        范围：激光↔Z 轴线性映射两点定标 + 激光/相机示教位置 + 实时读取 + 各点位更新按钮
        源端：Form5Cali.designer.cs:334-408（laserCali Tab，TextBox+Label+Button，无 PropertyGrid）
        目标端：HandyControl TextBox + TextBlock + Button 平迁，不用 ParamGrid
        不含（VM 阶段）：VM 逻辑 / 命令接线 / 保存触发（源端由父级全局 Apply 触发）
        绑定源：LaserCaliResult（LaserStandard / LaserMap.Map1|Map2.DirectValue|UnitValue / LaserPosi / CameraPosi）
    -->
    <Border
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="4"
        Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 块 A+B+C：激光与 Z 轴映射（标定参数 + 实时值 + 操作按钮）-->
                <RowDefinition Height="Auto" />
                <!-- 块 D：激光与相机位置映射 -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============== 块 A+B+C：激光与 Z 轴映射 ============== -->
            <GroupBox
                Grid.Row="0"
                Margin="0,0,0,8"
                Header="激光与Z轴映射">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <!-- 块 A：标定参数（可编辑）-->
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <!-- 块 B：实时激光值（只读）-->
                        <RowDefinition Height="Auto" />
                        <!-- 块 C：操作按钮区 -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- 标签列 -->
                        <ColumnDefinition Width="Auto" />
                        <!-- 输入框列 -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 块 A 行 1：激光标准值 -->
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,4,12,4"
                        VerticalAlignment="Center"
                        Text="激光标准值" />
                    <hc:TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,4"
                        Text="{Binding LaserStandard, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- 块 A 行 2：点位1激光测量值 -->
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,4,12,4"
                        VerticalAlignment="Center"
                        Text="点位1激光测量值" />
                    <hc:TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,4"
                        Text="{Binding LaserMap.Map1.DirectValue, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- 块 A 行 3：点位1Z轴位置 -->
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,4,12,4"
                        VerticalAlignment="Center"
                        Text="点位1Z轴位置" />
                    <hc:TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,4"
                        Text="{Binding LaserMap.Map1.UnitValue, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- 块 A 行 4：点位2激光测量值 -->
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,4,12,4"
                        VerticalAlignment="Center"
                        Text="点位2激光测量值" />
                    <hc:TextBox
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,4"
                        Text="{Binding LaserMap.Map2.DirectValue, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- 块 A 行 5：点位2Z轴位置 -->
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="0,4,12,4"
                        VerticalAlignment="Center"
                        Text="点位2Z轴位置" />
                    <hc:TextBox
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="0,4"
                        Text="{Binding LaserMap.Map2.UnitValue, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- 块 B 行 6：实时激光值（只读 OneWay）-->
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Margin="0,4,12,4"
                        VerticalAlignment="Center"
                        Text="实时激光值" />
                    <hc:TextBox
                        Grid.Row="5"
                        Grid.Column="1"
                        Margin="0,4"
                        IsReadOnly="True"
                        Text="{Binding RealtimeLaserValue, Mode=OneWay}" />

                    <!-- 块 C：操作按钮区（跨两列，WrapPanel 自适应换行）-->
                    <WrapPanel
                        Grid.Row="6"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,8,0,0"
                        ItemHeight="32"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,4"
                            Command="{Binding OpenLaserCommand}"
                            Content="打开" />
                        <Button
                            Margin="0,0,8,4"
                            Command="{Binding ToggleRealtimeReadCommand}"
                            Content="读取" />
                        <Button
                            Margin="0,0,8,4"
                            Command="{Binding RefreshPoint1Command}"
                            Content="更新（点位1）" />
                        <Button
                            Margin="0,0,8,4"
                            Command="{Binding RefreshPoint2Command}"
                            Content="更新（点位2）" />
                        <Button
                            Margin="0,0,8,4"
                            Command="{Binding RefreshLaserPosiCommand}"
                            Content="更新（激光位置）" />
                        <Button
                            Margin="0,0,8,4"
                            Command="{Binding RefreshCameraPosiCommand}"
                            Content="更新（相机位置）" />
                    </WrapPanel>
                </Grid>
            </GroupBox>

            <!-- ============== 块 D：激光与相机位置映射 ============== -->
            <GroupBox
                Grid.Row="1"
                Header="激光与相机位置映射">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 行 1：激光位置 -->
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,4,12,4"
                        VerticalAlignment="Center"
                        Text="激光位置" />
                    <hc:TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,4"
                        Text="{Binding LaserPosi, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- 行 2：相机位置 -->
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,4,12,4"
                        VerticalAlignment="Center"
                        Text="相机位置" />
                    <hc:TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,4"
                        Text="{Binding CameraPosi, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </GroupBox>
        </Grid>
    </Border>
</UserControl>
