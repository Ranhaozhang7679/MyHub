<UserControl
    x:Class="Luster.Motion.EditorUI.Views.CTConfigContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Luster.Control.Wpf.Motion.Controls;assembly=Luster.Control.Wpf.Motion"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.EditorUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:Luster.Motion.EditorUI.Models"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:tx="clr-namespace:Luster.Control.Wpf.Motion.TreeEx;assembly=Luster.Control.Wpf.Motion"
    d:DesignHeight="250"
    d:DesignWidth="450"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl
        MinHeight="32"
        Margin="10,5"
        ItemsSource="{Binding Stations}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <hc:UniformSpacingPanel
                    HorizontalAlignment="Center"
                    Orientation="Vertical"
                    Spacing="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <hc:ElementGroup>
                            <hc:ElementGroup.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="35" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </ItemsPanelTemplate>
                            </hc:ElementGroup.ItemsPanel>
                            <RadioButton
                        Width="100"
                        Command="{Binding Path=DataContext.ChangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding .}"
                        Content="{Binding StationName}"
                        GroupName="CTGroup"
                        Style="{StaticResource RadioButtonSameAsButtonDefault}" />
                            <ToggleButton
                        Grid.Column="1"
                        hc:StatusSwitchElement.HideUncheckedElement="True"
                        IsChecked="{Binding UseLog, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ToggleButtonCustom}">
                                <hc:StatusSwitchElement.CheckedElement>
                                    <Border
                                Width="30"
                                Height="30"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="0,4,4,0">
                                        <Ellipse
                                    Width="20"
                                    Height="20"
                                    Fill="{DynamicResource SuccessBrush}"
                                    Stroke="{DynamicResource BorderBrush}"
                                    StrokeThickness="1" />
                                    </Border>
                                </hc:StatusSwitchElement.CheckedElement>
                                <Border
                            Width="30"
                            Height="30"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0,4,4,0">
                                    <Ellipse
                                Width="20"
                                Height="20"
                                Fill="{DynamicResource BorderBrush}"
                                Stroke="{DynamicResource BorderBrush}"
                                StrokeThickness="1" />
                                </Border>
                            </ToggleButton>
                        </hc:ElementGroup>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Border
            Grid.Column="1"
            Background="{DynamicResource BackgroundBrush}"
            CornerRadius="5">
            <tx:TreeListBox
                x:Name="treeFlow"
                Margin="5"
                Background="{DynamicResource RegionBrush}"
                BorderThickness="0"
                FontSize="11"
                HierarchySource="{Binding MotionChildList}"
                Indentation="24">
                <tx:TreeListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type model:ModuleCT}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Name="xIcon"
                                Grid.Column="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Margin="0,0,3,1"
                                    FontSize="20"
                                    Foreground="{Binding StatusColor, Converter={StaticResource String2BrushConverter}}"
                                    Style="{StaticResource MotionIconSmall}"
                                    Text="{Binding Icon}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Margin="2,3"
                                VerticalAlignment="center">
                                <TextBlock x:Name="xName" Text="{Binding Name}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="3"
                                Margin="3,3"
                                HorizontalAlignment="Center">
                                <TextBox
                                    x:Name="txtCT"
                                    MinWidth="60"
                                    MaxHeight="20"
                                    Margin="0,1,10,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="12"
                                    MouseDoubleClick="txtCT_MouseDoubleClick"
                                    MouseLeave="txtCT_MouseLeave"
                                    Style="{StaticResource TextBox.Small}"
                                    Text="{Binding CT, StringFormat={}{0} ms}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </tx:TreeListBox.ItemTemplate>
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="Loaded">
                        <hc:EventToCommand Command="{Binding LoadedCommand}" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </tx:TreeListBox>
        </Border>

    </Grid>
</UserControl>
