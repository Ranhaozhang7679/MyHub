<Window x:Class="Luster.Motion.EditorUI.Views.ModuleSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择要导入的模块" Height="500" Width="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="请选择要导入到流程中的模块:" Margin="0,0,0,10" FontWeight="Bold"/>

        <DataGrid Grid.Row="1" x:Name="ModulesDataGrid" SelectionMode="Extended" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="模块名称" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="模块类型" Binding="{Binding Type}" Width="150"/>
                <DataGridTextColumn Header="功能名称" Binding="{Binding Function}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="全选" Click="SelectAllButton_Click" Width="60" Margin="0,0,10,0"/>
            <Button Content="确定" Click="OKButton_Click" Width="60" Margin="0,0,10,0"/>
            <Button Content="取消" Click="CancelButton_Click" Width="60"/>
        </StackPanel>
    </Grid>
</Window>