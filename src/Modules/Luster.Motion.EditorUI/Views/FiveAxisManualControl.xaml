<UserControl
    x:Class="Luster.Motion.EditorUI.Views.FiveAxisManualControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.EditorUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:param="clr-namespace:Luster.Control.Wpf.Motion;assembly=Luster.Control.Wpf.Motion"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="600"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <!--
        五轴手动控制 UserControl（TES-131/138/139/132 XAML + VM）
        范围：主面板容器 + X/Y/Z/A/C 五轴 Jog 按钮组（10 按钮，±方向 × 5 轴）
        已含（TES-139）：坐标系选择器（SelectedCoordinateFrame）/ 模式开关（IsJogMode）/ 步距/速度输入（MovePara）
        已含（TES-132）：VM 逻辑 + 10 Jog 命令接线（占位，不接真运动）
        待办（TES-124）：press-hold 接线 + 真运动调度；轴语义 A≡MRx、C≡MRz 归 TES-124
    -->
    <Border
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="4"
        Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 顶部：标题 + TES-139 预留区（坐标系/模式/步距，本骨架不实际放置控件）-->
                <RowDefinition Height="Auto" />
                <!-- Jog 按钮组 -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部标题 + TES-139 控件区（坐标系/模式/步距） -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <!-- 标题 -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 坐标系 Label -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 坐标系 ComboBox -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 模式 Label -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 模式 RadioButton：频率（Jog） -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 模式 RadioButton：步进（Step） -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 运行参数 Label -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 运行参数 ComboBox -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 右侧弹性占位 -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="五轴手动控制" />
                <!-- 坐标系选择器：4 档（机械/粗略/精确/工件），绑定 SelectedCoordinateFrame -->
                <TextBlock
                    Grid.Column="1"
                    Margin="8,0,4,0"
                    VerticalAlignment="Center"
                    Text="坐标系" />
                <!-- 坐标系：ItemsSource 绑 VM.CoordinateFrameOptions（Value=enum,Display=中文），SelectedValue 直绑 enum -->
                <ComboBox
                    Grid.Column="2"
                    MinWidth="80"
                    Margin="2"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding CoordinateFrameOptions}"
                    SelectedValue="{Binding SelectedCoordinateFrame}"
                    SelectedValuePath="Value" />
                <!-- 模式开关：Jog/Step 互斥 RadioButton，绑定 IsJogMode（true=频率Jog，false=步进Step） -->
                <TextBlock
                    Grid.Column="3"
                    Margin="16,0,4,0"
                    VerticalAlignment="Center"
                    Text="模式" />
                <RadioButton
                    Grid.Column="4"
                    Margin="2"
                    VerticalAlignment="Center"
                    Content="频率"
                    GroupName="JogMode"
                    IsChecked="{Binding IsJogMode}" />
                <RadioButton
                    Grid.Column="5"
                    Margin="2"
                    VerticalAlignment="Center"
                    Content="步进"
                    GroupName="JogMode"
                    IsChecked="{Binding IsStepMode, Mode=OneWay}" />
                <!-- 步距/速度输入：7 档预设，绑定 MovePara（double）。Tips：频率模式=速度，步进模式=步距 -->
                <TextBlock
                    Grid.Column="6"
                    Margin="16,0,4,0"
                    VerticalAlignment="Center"
                    Text="运行参数" />
                <!-- 运行参数：ItemsSource 绑 VM.MoveParaOptions（double 集合），SelectedItem 直绑 double -->
                <ComboBox
                    Grid.Column="7"
                    MinWidth="80"
                    Margin="2"
                    ItemsSource="{Binding MoveParaOptions}"
                    SelectedItem="{Binding MovePara}"
                    ToolTip="频率模式=速度（mm/s），步进模式=步距（mm）" />
            </Grid>

            <!-- Jog 按钮组：5 行 × 3 列（轴名 | - | +） -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- 轴名 -->
                    <ColumnDefinition Width="Auto" />
                    <!-- - 按钮 -->
                    <ColumnDefinition Width="*" />
                    <!-- + 按钮 -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 行 1：X 轴 -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="X" />
                <!-- TODO TES-132: 改 PreviewMouseDown/Up press-hold（参照 VAxisMContent.xaml:286-308 hc:EventToCommand） -->
                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="2"
                    Command="{Binding JogXMinusCommand}"
                    Content="-X" />
                <!-- TODO TES-132: 改 PreviewMouseDown/Up press-hold -->
                <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="2"
                    Command="{Binding JogXPlusCommand}"
                    Content="+X" />

                <!-- 行 2：Y 轴 -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="Y" />
                <!-- TODO TES-132: 改 PreviewMouseDown/Up press-hold -->
                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="2"
                    Command="{Binding JogYMinusCommand}"
                    Content="-Y" />
                <!-- TODO TES-132: 改 PreviewMouseDown/Up press-hold -->
                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="2"
                    Command="{Binding JogYPlusCommand}"
                    Content="+Y" />

                <!-- 行 3：Z 轴 -->
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="Z" />
                <!-- TODO TES-132: 改 PreviewMouseDown/Up press-hold -->
                <Button
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="2"
                    Command="{Binding JogZMinusCommand}"
                    Content="-Z" />
                <!-- TODO TES-132: 改 PreviewMouseDown/Up press-hold -->
                <Button
                    Grid.Row="2"
                    Grid.Column="2"
                    Margin="2"
                    Command="{Binding JogZPlusCommand}"
                    Content="+Z" />

                <!-- 行 4：A 轴（A≡MRx，绕 X 转）-->
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="A" />
                <!-- TODO TES-132: 改 PreviewMouseDown/Up press-hold -->
                <Button
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="2"
                    Command="{Binding JogAMinusCommand}"
                    Content="-A" />
                <!-- TODO TES-132: 改 PreviewMouseDown/Up press-hold -->
                <Button
                    Grid.Row="3"
                    Grid.Column="2"
                    Margin="2"
                    Command="{Binding JogAPlusCommand}"
                    Content="+A" />

                <!-- 行 5：C 轴（C≡MRz，绕 Z 转）-->
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="C" />
                <!-- TODO TES-132: 改 PreviewMouseDown/Up press-hold -->
                <Button
                    Grid.Row="4"
                    Grid.Column="1"
                    Margin="2"
                    Command="{Binding JogCMinusCommand}"
                    Content="-C" />
                <!-- TODO TES-132: 改 PreviewMouseDown/Up press-hold -->
                <Button
                    Grid.Row="4"
                    Grid.Column="2"
                    Margin="2"
                    Command="{Binding JogCPlusCommand}"
                    Content="+C" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
