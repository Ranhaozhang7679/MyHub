<UserControl
    x:Class="Luster.Motion.EditorUI.Views.Dialogs.AxisConfigDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.EditorUI.Views.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Width="500"
    Height="400"
    d:DesignHeight="370"
    d:DesignWidth="500"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <GroupBox
                Margin="5"
                hc:TitleElement.Background="{DynamicResource RegionBrush}"
                Header="{lang:Lang Key={x:Static lang:LangKeys.SingleAxis}}"
                Style="{StaticResource GroupBoxTab}">
                <ListBox
                    Margin="0"
                    ItemsSource="{Binding AxisDatas}"
                    SelectedValue="{Binding SelectedItem}"
                    SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="SelectionChanged">
                            <hc:EventToCommand Command="{Binding Path=DataContext.SelectedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=SelectedItem}" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </ListBox>
            </GroupBox>
            <GroupBox
                Grid.Column="1"
                Margin="0,5,5,5"
                hc:TitleElement.Background="{DynamicResource RegionBrush}"
                Header="{Binding CurrentItem.Name}"
                Style="{StaticResource GroupBoxTab}">
                <Border
                    Padding="10"
                    Background="{DynamicResource RegionBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5,5,0,0">
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                        <hc:ElementGroup
                            MinHeight="32"
                            Margin="5,0,0,0"
                            ItemsSource="{Binding CurrentItem.StatusList}">
                            <hc:ElementGroup.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="28" Margin="5">
                                        <Path
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Data="M 0,0 A 5,5 45 1 1 0,1 Z"
                                            Fill="{Binding Status, Converter={StaticResource Boolean2PassColorCoverter}}" />
                                        <TextBlock
                                            Margin="-5,10,5,0"
                                            HorizontalAlignment="Left"
                                            FontSize="10"
                                            Text="{Binding Alias}" />
                                    </Grid>
                                </DataTemplate>
                            </hc:ElementGroup.ItemTemplate>
                        </hc:ElementGroup>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="5,0,0,0" Text="{lang:Lang Key={x:Static lang:LangKeys.RealTimeLocation}}" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,10,0"
                                HorizontalAlignment="Left"
                                FontWeight="Bold"
                                Foreground="Red"
                                Text="{Binding CurrentItem.CurrentPos, StringFormat={}{0:N3} mm}" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="5,0,0,0"
                                Text="{lang:Lang Key={x:Static lang:LangKeys.TeachLocation}}" />
                            <TextBlock
                                Grid.Column="3"
                                Margin="10,0,10,0"
                                HorizontalAlignment="Left"
                                FontWeight="Bold"
                                Foreground="Red"
                                Text="{Binding CurrentItem.Position, StringFormat={}{0:N3} mm}" />
                        </Grid>
                        <hc:NumericUpDown
                            Margin="5,0"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:InfoElement.TitleWidth="60"
                            hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.MotionSpeed}}"
                            DecimalPlaces="3"
                            Style="{StaticResource NumericUpDownExtend}"
                            Value="{Binding CurrentItem.Speed, Delay=2000}" />
                        <hc:NumericUpDown
                            Grid.Column="1"
                            Margin="5,0"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:InfoElement.TitleWidth="60"
                            hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.MovePosition}}"
                            Style="{StaticResource NumericUpDownExtend}"
                            Value="{Binding CurrentItem.DstPosition, Delay=2000}" />
                        <hc:ButtonGroup>
                            <Button hc:IconElement.Geometry="{StaticResource AddGeometry}" hc:IconElement.Width="12">
                                <hc:Interaction.Triggers>
                                    <hc:EventTrigger EventName="PreviewMouseDown">
                                        <hc:EventToCommand Command="{Binding CurrentItem.JogCommandAdd}" />
                                    </hc:EventTrigger>
                                    <hc:EventTrigger EventName="PreviewMouseUp">
                                        <hc:EventToCommand Command="{Binding CurrentItem.StopCommand}" />
                                    </hc:EventTrigger>
                                </hc:Interaction.Triggers>
                            </Button>
                            <Button hc:IconElement.Geometry="{StaticResource SubGeometry}" hc:IconElement.Width="12">
                                <hc:Interaction.Triggers>
                                    <hc:EventTrigger EventName="PreviewMouseDown">
                                        <hc:EventToCommand Command="{Binding CurrentItem.JogCommandSub}" />
                                    </hc:EventTrigger>
                                    <hc:EventTrigger EventName="PreviewMouseUp">
                                        <hc:EventToCommand Command="{Binding CurrentItem.StopCommand}" />
                                    </hc:EventTrigger>
                                </hc:Interaction.Triggers>
                            </Button>
                            <Button Command="{Binding CurrentItem.MoveAbsCommand}" Content="{lang:Lang Key={x:Static lang:LangKeys.AbsoluteMotion}}" />
                            <Button Command="{Binding CurrentItem.MoveRelCommand}" Content="{lang:Lang Key={x:Static lang:LangKeys.RelativeMotion}}" />
                        </hc:ButtonGroup>
                        <hc:ButtonGroup>
                            <Button
                                Grid.Column="6"
                                Command="{Binding CurrentItem.ClearErrorCommand}"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.ClearMistake}}" />
                            <Button
                                Grid.Column="7"
                                Command="{Binding CurrentItem.StopCommand}"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.Stop}}" />
                            <Button
                                Grid.Column="8"
                                Command="{Binding CurrentItem.HomeCommand}"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.HomeZero}}" />
                            <Button
                                Grid.Column="9"
                                Command="{Binding CurrentItem.ApplyCommand}"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.Teach}}" />
                        </hc:ButtonGroup>
                    </hc:UniformSpacingPanel>
                </Border>
            </GroupBox>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="80"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="no"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Clear}}" />
                <Button
                    Width="80"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="cancel"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
                <Button
                    Width="80"
                    Margin="10,0,5,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="ok"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Confirm}}" />
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
