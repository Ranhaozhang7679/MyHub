<UserControl
    x:Class="Luster.Motion.EditorUI.Views.Dialogs.AxisPosDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.EditorUI.Views.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:tx="clr-namespace:Luster.Control.Wpf.Motion.TreeEx;assembly=Luster.Control.Wpf.Motion"
    Width="650"
    Height="500"
    d:DesignHeight="500"
    d:DesignWidth="650"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TabControl
                Margin="5"
                Background="{DynamicResource RegionBrush}"
                Style="{StaticResource TabControlCapsuleSolid}">
                <TabItem Header="{lang:Lang Key={x:Static lang:LangKeys.SingleAxis}}">
                    <tx:TreeListBox
                        x:Name="treeFlow"
                        Background="{DynamicResource RegionBrush}"
                        BorderThickness="0"
                        FontSize="11"
                        HierarchySource="{Binding AxisPostions}"
                        Indentation="20">
                        <tx:TreeListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="2,3"
                                    VerticalAlignment="center">
                                    <TextBlock x:Name="xName" Text="{Binding Text}" />
                                </StackPanel>
                            </DataTemplate>
                        </tx:TreeListBox.ItemTemplate>
                        <hc:Interaction.Triggers>
                            <hc:EventTrigger EventName="PreviewMouseDoubleClick">
                                <hc:EventToCommand Command="{Binding Path=DataContext.SelectPosCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Path=SelectedItem, ElementName=treeFlow}" />
                            </hc:EventTrigger>
                        </hc:Interaction.Triggers>
                    </tx:TreeListBox>
                </TabItem>
                <TabItem Header="{lang:Lang Key={x:Static lang:LangKeys.PosLocation}}">
                    <ListBox
                        Margin="0"
                        BorderThickness="1"
                        ItemsSource="{Binding Positions}"
                        SelectedValue="{Binding SelectPos}"
                        SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <hc:Interaction.Triggers>
                            <hc:EventTrigger EventName="SelectionChanged">
                                <hc:EventToCommand Command="{Binding Path=DataContext.SelectedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=SelectedItem}" />
                            </hc:EventTrigger>
                        </hc:Interaction.Triggers>
                    </ListBox>
                </TabItem>
            </TabControl>

            <GroupBox
                Grid.Column="1"
                Margin="0,5,5,5"
                hc:TitleElement.Background="{DynamicResource RegionBrush}"
                hc:TitleElement.Foreground="{DynamicResource DangerBrush}"
                Foreground="{DynamicResource DangerBrush}"
                Header="{Binding TipName}"
                Style="{StaticResource GroupBoxTab}">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding AxisPosItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <hc:UniformSpacingPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    ChildWrapping="Wrap"
                                    ScrollViewer.VerticalScrollBarVisibility="Visible"
                                    Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="410"
                                    Padding="5"
                                    Background="{DynamicResource RegionBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Margin="5,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="Blue"
                                                Text="{Binding Name}" />
                                            <hc:DashedBorder
                                                Grid.Column="1"
                                                MinWidth="80"
                                                MinHeight="28"
                                                Margin="5,0"
                                                BorderBrush="{StaticResource PrimaryBrush}"
                                                BorderDashArray="2,2"
                                                BorderThickness="1">
                                                <TextBlock
                                                    Margin="5,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    FontSize="15"
                                                    Foreground="{StaticResource PrimaryTextBrush}"
                                                    Text="{Binding Position}" />
                                            </hc:DashedBorder>
                                            <Button
                                                Grid.Column="2"
                                                hc:IconElement.Geometry="{StaticResource RemoveGeometry}"
                                                Command="{Binding Path=DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource ButtonDanger.Small}" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <hc:NumericUpDown
                                                Margin="5,0"
                                                hc:InfoElement.TitlePlacement="Left"
                                                hc:InfoElement.TitleWidth="60"
                                                hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Acc}}"
                                                DecimalPlaces="3"
                                                Style="{StaticResource NumericUpDownExtend}"
                                                Value="{Binding Acc, Delay=2000}" />
                                            <hc:NumericUpDown
                                                Grid.Column="1"
                                                Margin="5,0"
                                                hc:InfoElement.TitlePlacement="Left"
                                                hc:InfoElement.TitleWidth="60"
                                                hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Dec}}"
                                                DecimalPlaces="3"
                                                Style="{StaticResource NumericUpDownExtend}"
                                                Value="{Binding Dec, Delay=2000}" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <hc:NumericUpDown
                                                Margin="5,0"
                                                hc:InfoElement.TitlePlacement="Left"
                                                hc:InfoElement.TitleWidth="60"
                                                hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.MotionSpeed}}"
                                                DecimalPlaces="3"
                                                Style="{StaticResource NumericUpDownExtend}"
                                                Value="{Binding Speed, Delay=2000}" />
                                            <hc:ComboBox
                                                Grid.Column="1"
                                                Margin="5,0"
                                                hc:InfoElement.TitlePlacement="Left"
                                                hc:InfoElement.TitleWidth="60"
                                                hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.Priority}}"
                                                DisplayMemberPath="Desc"
                                                ItemsSource="{Binding Path=DataContext.Priorities, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                SelectedValue="{Binding Priority}"
                                                SelectedValuePath="Value"
                                                Style="{StaticResource ComboBoxExtend}" />
                                        </Grid>
                                    </hc:UniformSpacingPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="80"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="no"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Clear}}" />
                <Button
                    Width="80"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="cancel"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
                <Button
                    Width="80"
                    Margin="10,0,5,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="ok"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Confirm}}" />
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
