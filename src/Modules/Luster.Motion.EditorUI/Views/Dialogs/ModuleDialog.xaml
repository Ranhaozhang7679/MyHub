<UserControl
    x:Class="Luster.Motion.EditorUI.Views.ModuleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Luster.Control.Wpf.Motion.Controls;assembly=Luster.Control.Wpf.Motion"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.EditorUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:Luster.Motion.EditorUI.Models"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:tx="clr-namespace:Luster.Control.Wpf.Motion.TreeEx;assembly=Luster.Control.Wpf.Motion"
    Height="500"
    d:DesignHeight="250"
    d:DesignWidth="450"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            Grid.Column="1"
            Background="{DynamicResource BackgroundBrush}"
            CornerRadius="5">
            <tx:TreeListBox
                x:Name="treeFlow"
                MaxHeight="400"
                Margin="5"
                Background="{DynamicResource RegionBrush}"
                BorderThickness="0"
                FontSize="11"
                HierarchySource="{Binding MotionChildList}"
                Indentation="24">
                <tx:TreeListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type model:ModuleCT}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Name="xIcon"
                                Grid.Column="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Margin="0,0,3,1"
                                    FontSize="20"
                                    Foreground="{Binding StatusColor, Converter={StaticResource String2BrushConverter}}"
                                    Style="{StaticResource MotionIconSmall}"
                                    Text="{Binding Icon}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Margin="2,3"
                                VerticalAlignment="center">
                                <TextBlock x:Name="xName" Text="{Binding Name}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </tx:TreeListBox.ItemTemplate>
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="SelectionChanged">
                        <hc:EventToCommand Command="{Binding SelectCommand}" CommandParameter="{Binding Path=SelectedItem, ElementName=treeFlow}" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </tx:TreeListBox>
        </Border>
        <StackPanel
            Grid.Row="1"
            Margin="5"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                Command="{Binding CloseCommand}"
                CommandParameter="no"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Clear}}" />
            <Button
                Width="80"
                HorizontalAlignment="Right"
                Command="{Binding CloseCommand}"
                CommandParameter="cancel"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
        </StackPanel>
    </Grid>

</UserControl>
