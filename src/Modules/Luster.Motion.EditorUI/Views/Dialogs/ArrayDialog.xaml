<UserControl
    x:Class="Luster.Motion.EditorUI.Views.Dialogs.ArrayDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.EditorUI.Views.Dialogs"
    xmlns:m="clr-namespace:Luster.Motion.EditorUI.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinHeight="400"
    d:DesignHeight="450"
    d:DesignWidth="400"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource ComboBoxExtend}" TargetType="hc:ComboBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="Red" />
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="BoolTemplate" DataType="{x:Type m:ValueModel}">
            <ToggleButton
                HorizontalAlignment="Right"
                IsChecked="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource ToggleButtonSwitch}" />
        </DataTemplate>

        <DataTemplate x:Key="StringTemplate" DataType="{x:Type m:ValueModel}">
            <TextBox
                Width="150"
                MinHeight="24"
                MaxHeight="24"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>
        <DataTemplate x:Key="IntTemplate" DataType="{x:Type m:ValueModel}">
            <hc:NumericUpDown
                Width="150"
                MinHeight="24"
                MaxHeight="24"
                HorizontalAlignment="Right"
                Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>

        <local:DataTypeTemplateSelector
            x:Key="DTypeSelector"
            BoolTemplate="{StaticResource BoolTemplate}"
            IntTemplate="{StaticResource IntTemplate}"
            StringTemplate="{StaticResource StringTemplate}" />
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <hc:ElementGroup>
            <hc:ElementGroup.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </hc:ElementGroup.ItemsPanel>
            <TextBlock VerticalAlignment="Center" Text="{lang:Lang Key={x:Static lang:LangKeys.DataType}}" />
            <TextBlock
                Grid.Column="1"
                Foreground="Red"
                Style="{StaticResource TextBlockBoldBaseStyle}"
                Text="{Binding DataType, Converter={StaticResource Object2StringConverter}}" />
            <Button
                Grid.Column="2"
                hc:IconElement.Geometry="{StaticResource AddGeometry}"
                Command="{Binding AddCommand}" />
        </hc:ElementGroup>

        <DataGrid
            Grid.Row="1"
            Margin="0,5"
            hc:DataGridAttach.ShowRowNumber="True"
            hc:DataGridAttach.ShowSelectAllButton="True"
            ItemsSource="{Binding Array}">
            <DataGrid.Columns>
                <DataGridTemplateColumn
                    Width="200"
                    MinWidth="200"
                    CellTemplateSelector="{StaticResource DTypeSelector}"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.CurrentValue}}"
                    HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                HorizontalAlignment="Right"
                Command="{Binding CloseCommand}"
                CommandParameter="cancel"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
            <Button
                Width="80"
                Margin="10,0,0,0"
                HorizontalAlignment="Right"
                Command="{Binding CloseCommand}"
                CommandParameter="Ok"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Confirm}}" />
        </StackPanel>
    </Grid>
</UserControl>
