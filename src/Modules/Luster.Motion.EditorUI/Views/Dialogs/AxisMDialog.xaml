<UserControl
    x:Class="Luster.Motion.EditorUI.Views.Dialogs.AxisMDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.EditorUI.Views.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Width="750"
    Height="530"
    d:DesignHeight="370"
    d:DesignWidth="600"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox
                Margin="5"
                hc:TitleElement.Background="{DynamicResource RegionBrush}"
                Header="{lang:Lang Key={x:Static lang:LangKeys.MultiAxis}}"
                Style="{StaticResource GroupBoxTab}">
                <ListBox
                    Margin="0"
                    ItemsSource="{Binding AxisDatas}"
                    SelectedValue="{Binding CurrentItem}"
                    SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="SelectionChanged">
                            <hc:EventToCommand Command="{Binding Path=DataContext.SelectedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=SelectedItem}" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </ListBox>
            </GroupBox>
            <GroupBox
                Name="gp"
                Grid.Column="1"
                Margin="0,5,5,5"
                hc:TitleElement.Background="{DynamicResource RegionBrush}"
                Header="{lang:Lang Key={x:Static lang:LangKeys.SelectedAxis}}"
                Style="{StaticResource GroupBoxTab}">
                <ScrollViewer Width="{Binding ElementName=gp, Path=ActualWidth}">
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding HasAxisDatas}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <hc:UniformSpacingPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    ChildWrapping="Wrap"
                                    Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    MaxWidth="320"
                                    Margin="0,5"
                                    Padding="10,5"
                                    Background="{DynamicResource RegionBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.ColumnSpan="2"
                                            Margin="0,5,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="{Binding Name}"
                                            TextWrapping="NoWrap"
                                            ToolTip="{Binding Name}" />
                                        <hc:ElementGroup
                                            Grid.Row="1"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Center"
                                            ItemsSource="{Binding StatusList}">
                                            <hc:ElementGroup.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="32" Margin="3">
                                                        <Path
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Data="M 0,0 A 5,5 45 1 1 0,1 Z"
                                                            Fill="{Binding Status, Converter={StaticResource Boolean2PassColorCoverter}}" />
                                                        <TextBlock
                                                            Margin="-5,10,5,0"
                                                            HorizontalAlignment="Left"
                                                            FontSize="10"
                                                            Text="{Binding Alias}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </hc:ElementGroup.ItemTemplate>
                                        </hc:ElementGroup>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Margin="5,0,0,0"
                                                FontWeight="Bold"
                                                Foreground="Blue"
                                                Text="{lang:Lang Key={x:Static lang:LangKeys.RealTimeLocation}}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="10,0,10,0"
                                                HorizontalAlignment="Left"
                                                FontWeight="Bold"
                                                Foreground="Red"
                                                Text="{Binding CurrentPos, StringFormat={}{0:N3} mm}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Margin="5,0,0,0"
                                                FontWeight="Bold"
                                                Foreground="Blue"
                                                Text="{lang:Lang Key={x:Static lang:LangKeys.TeachLocation}}" />
                                            <TextBlock
                                                Grid.Column="3"
                                                Margin="10,0,10,0"
                                                HorizontalAlignment="Left"
                                                FontWeight="Bold"
                                                Foreground="Red"
                                                Text="{Binding Position, StringFormat={}{0:N3} mm}" />
                                            <!--<TextBlock
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Margin="0,0,20,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                Foreground="Blue"
                                                Text="{Binding CurrentPos, StringFormat=实时 : {0:N3} mm}"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Margin="0,0,10,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                Foreground="Red"
                                                Text="{Binding Position, StringFormat=示教 : {0:N3} mm}"
                                                TextWrapping="NoWrap" />-->
                                        </Grid>
                                        <Grid Grid.Row="3" Margin="0,15,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="{lang:Lang Key={x:Static lang:LangKeys.AxisPriority}}"
                                                TextWrapping="NoWrap" />
                                            <ComboBox
                                                Grid.Column="1"
                                                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.Priority}}"
                                                DisplayMemberPath="Desc"
                                                ItemsSource="{Binding DataContext.Priorities, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                SelectedValue="{Binding Priority}"
                                                SelectedValuePath="Value"
                                                ToolTip="{lang:Lang Key={x:Static lang:LangKeys.MotionPriorityOfEachAxisInMultipleScenes}}" />
                                        </Grid>

                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Margin="0,0,20,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="{lang:Lang Key={x:Static lang:LangKeys.MotionSpeed_mm_s_}}"
                                                TextWrapping="NoWrap" />
                                            <hc:TextBox
                                                Grid.Row="4"
                                                Grid.Column="1"
                                                hc:InfoElement.Placeholder=""
                                                hc:InfoElement.TitlePlacement="Left"
                                                Text="{Binding Speed, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                TextType="Double"
                                                ToolTip="{lang:Lang Key={x:Static lang:LangKeys.MotionSpeedWithUnit}}" />
                                        </Grid>
                                        <Grid Grid.Row="5" Margin="0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Margin="0,0,20,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Text="{lang:Lang Key={x:Static lang:LangKeys.MovePostion_mm_}}"
                                                TextWrapping="NoWrap" />
                                            <hc:TextBox
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.TargetWithUnit}}"
                                                hc:InfoElement.TitlePlacement="Left"
                                                Text="{Binding DstPosition}"
                                                TextType="Double"
                                                ToolTip="{lang:Lang Key={x:Static lang:LangKeys.TargetUnitOfMotion}}" />

                                        </Grid>

                                        <hc:ElementGroup
                                            Grid.Row="6"
                                            Margin="0,0,0,5"
                                            HorizontalAlignment="Right">
                                            <hc:ElementGroup.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                    </Grid>
                                                </ItemsPanelTemplate>
                                            </hc:ElementGroup.ItemsPanel>
                                            <Button
                                                Grid.Column="0"
                                                hc:IconElement.Geometry="{StaticResource AddGeometry}"
                                                hc:IconElement.Width="12">
                                                <hc:Interaction.Triggers>
                                                    <hc:EventTrigger EventName="PreviewMouseDown">
                                                        <hc:EventToCommand Command="{Binding JogCommandAdd}" />
                                                    </hc:EventTrigger>
                                                    <hc:EventTrigger EventName="PreviewMouseUp">
                                                        <hc:EventToCommand Command="{Binding StopCommand}" />
                                                    </hc:EventTrigger>
                                                </hc:Interaction.Triggers>
                                            </Button>
                                            <Button
                                                Grid.Column="1"
                                                hc:IconElement.Geometry="{StaticResource SubGeometry}"
                                                hc:IconElement.Width="12">
                                                <hc:Interaction.Triggers>
                                                    <hc:EventTrigger EventName="PreviewMouseDown">
                                                        <hc:EventToCommand Command="{Binding JogCommandSub}" />
                                                    </hc:EventTrigger>
                                                    <hc:EventTrigger EventName="PreviewMouseUp">
                                                        <hc:EventToCommand Command="{Binding StopCommand}" />
                                                    </hc:EventTrigger>
                                                </hc:Interaction.Triggers>
                                            </Button>
                                            <Button
                                                Grid.Column="2"
                                                Command="{Binding MoveAbsCommand}"
                                                Content="{lang:Lang Key={x:Static lang:LangKeys.Absolutely}}" />
                                            <Button
                                                Grid.Column="3"
                                                Command="{Binding MoveRelCommand}"
                                                Content="{lang:Lang Key={x:Static lang:LangKeys.Relative}}" />
                                            <Button
                                                Grid.Column="4"
                                                Command="{Binding HomeCommand}"
                                                Content="{lang:Lang Key={x:Static lang:LangKeys.HomeZero}}" />
                                            <Button
                                                Grid.Column="5"
                                                Command="{Binding ApplyCommand}"
                                                Content="{lang:Lang Key={x:Static lang:LangKeys.Teach}}" />
                                        </hc:ElementGroup>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox
                Width="160"
                Margin="10,0,0,0"
                hc:TitleElement.Title="{lang:Lang Key={x:Static lang:LangKeys.MoveDirection}}"
                hc:TitleElement.TitlePlacement="Left"
                hc:TitleElement.TitleWidth="60"
                DisplayMemberPath="Desc"
                ItemsSource="{Binding Directions}"
                SelectedValue="{Binding MoveDirection}"
                SelectedValuePath="Value"
                Style="{StaticResource ComboBoxExtend}" />
            <hc:ButtonGroup Grid.Column="1" Margin="10,0,0,0">
                <hc:ButtonGroup.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </hc:ButtonGroup.ItemsPanel>
                <Button
                    Grid.Column="0"
                    Command="{Binding AxisCommand}"
                    CommandParameter="Move"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Motion}}" />
                <Button
                    Grid.Column="1"
                    Command="{Binding AxisCommand}"
                    CommandParameter="JOG"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.JOG}}" />
                <Button
                    Grid.Column="2"
                    Command="{Binding AxisCommand}"
                    CommandParameter="Home"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.HomeZero}}" />
                <Button
                    Grid.Column="2"
                    Command="{Binding AxisCommand}"
                    CommandParameter="Stop"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Stop}}" />
            </hc:ButtonGroup>
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="80"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="no"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Clear}}" />
                <Button
                    Width="80"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="cancel"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Cancel}}" />
                <Button
                    Width="80"
                    Margin="10,0,5,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}"
                    CommandParameter="ok"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Confirm}}" />
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
