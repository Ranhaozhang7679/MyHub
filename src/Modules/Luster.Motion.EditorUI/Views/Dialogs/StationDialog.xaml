<UserControl
    x:Class="Luster.Motion.EditorUI.Views.Dialogs.StationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.EditorUI.Views.Dialogs"
    xmlns:m="clr-namespace:Luster.Motion.EditorUI.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinHeight="400"
    MaxWidth="400"
    d:DesignHeight="450"
    d:DesignWidth="400"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource ComboBoxExtend}" TargetType="hc:ComboBox">
            <Setter Property="hc:InfoElement.TitleWidth" Value="80" />
            <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="Red" />
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="BoolTemplate" DataType="{x:Type m:ValueModel}">
            <ToggleButton
                HorizontalAlignment="Right"
                IsChecked="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource ToggleButtonSwitch}" />
        </DataTemplate>

        <DataTemplate x:Key="StringTemplate" DataType="{x:Type m:ValueModel}">
            <TextBox
                Width="150"
                HorizontalAlignment="Right"
                Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>
        <DataTemplate x:Key="IntTemplate" DataType="{x:Type m:ValueModel}">
            <hc:NumericUpDown
                Width="150"
                HorizontalAlignment="Right"
                Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>

    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid HorizontalAlignment="Right">
            <hc:ButtonGroup Grid.Column="1">
                <hc:ButtonGroup.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </hc:ButtonGroup.ItemsPanel>
                <Button
                    hc:IconElement.Geometry="{StaticResource SubGeometry}"
                    hc:IconElement.Width="12"
                    Command="{Binding CloseCommand}"
                    CommandParameter="cancel"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Clear}}"
                    Foreground="{StaticResource DangerBrush}"
                    Style="{StaticResource ButtonDanger}" />
                <Button
                    Grid.Column="1"
                    hc:IconElement.Geometry="{StaticResource RemoveGeometry}"
                    Command="{Binding CloseCommand}"
                    CommandParameter="close"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.Exit}}"
                    Style="{StaticResource ButtonDanger}" />
            </hc:ButtonGroup>
        </Grid>
        <DataGrid
            Grid.Row="1"
            Margin="0,5"
            AutoGenerateColumns="False"
            CanUserSortColumns="False"
            HeadersVisibility="All"
            IsReadOnly="False"
            ItemsSource="{Binding Stations}"
            SelectionMode="Single"
            Style="{StaticResource DataGrid.Small}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    MinWidth="120"
                    Binding="{Binding Name}"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.StationName}}"
                    IsReadOnly="True" />
                <DataGridTemplateColumn
                    Width="80"
                    MinWidth="80"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.Operate}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                HorizontalAlignment="Right"
                                hc:IconElement.Geometry="{StaticResource SuccessGeometry}"
                                hc:IconElement.Width="12"
                                Command="{Binding Path=DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding .}"
                                Content="{lang:Lang Key={x:Static lang:LangKeys.Choose}}"
                                Style="{StaticResource ButtonDashed.Small}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
