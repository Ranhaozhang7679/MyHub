<UserControl
    x:Class="Luster.Motion.EditorUI.Views.EditorContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="clr-namespace:Luster.Motion.EditorUI.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:flow="clr-namespace:Luster.Control.Wpf.Motion.Flow;assembly=Luster.Control.Wpf.Motion"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.EditorUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource ButtonDashed}" TargetType="Button">
            <Setter Property="Margin" Value="3,5" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="breadStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="RoyalBlue" />
            <Setter Property="FontFamily" Value="微软雅黑" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="Blue" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="ButtonStyle"
            BasedOn="{StaticResource RadioButtonSameAsButtonDefault}"
            TargetType="RadioButton">
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="GroupName" Value="Switch" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel
            Margin="5,5,5,0"
            HorizontalAlignment="Stretch"
            Background="#F3F3F3">
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                IsEnabled="{Binding IsBtnEnabled}"
                Orientation="Horizontal">
                <!--<Button
                    hc:IconElement.Geometry="{StaticResource RunAllGeometry}"
                    Command="{Binding RunAllCommand}"
                    Foreground="Blue"
                    IsEnabled="{Binding SysRole, Converter={StaticResource RoleEnabledCoverter}, ConverterParameter=Admin}"
                    ToolTip="{lang:Lang Key={x:Static lang:LangKeys.RunAllF5}}" />-->
                <!--<Button
                    hc:IconElement.Geometry="{StaticResource RunOneGeometry}"
                    Command="{Binding RunOneCommand}"
                    ToolTip="运行选中项 F6" />
                <Button
                    hc:IconElement.Geometry="{StaticResource RunNextGeometry}"
                    Command="{Binding RunNextCommand}"
                    ToolTip="运行下一项 F7"
                    Visibility="{Binding IsDataFlow, Converter={StaticResource Boolean2VisibilityReConverter}}" />-->
                <!--<Button
                    hc:IconElement.Geometry="{StaticResource StopGeometry}"
                    Command="{Binding StopCommand}"
                    Foreground="red"
                    IsEnabled="{Binding SysRole, Converter={StaticResource RoleEnabledCoverter}, ConverterParameter=Admin}"
                    ToolTip="{lang:Lang Key={x:Static lang:LangKeys.StopF8}}" />-->
            </StackPanel> <!--主动将右侧按钮界面首先定义，确保显示完整，因为DockPanel是默认最后一个定义的占据剩余空间，所有必须显示的先定义-->
            <ItemsControl Margin="5,0,0,0" ItemsSource="{Binding Breads}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type b:BreadItem}">
                        <StackPanel Orientation="Horizontal">
                            <hc:HighlightTextBlock
                                Style="{StaticResource breadStyle}"
                                Text="{Binding Text}"
                                TextWrapping="Wrap"
                                MaxWidth="150">
                                <hc:Interaction.Triggers>
                                    <hc:EventTrigger EventName="PreviewMouseDown">
                                        <hc:EventToCommand Command="{Binding Path=DataContext.LoadedCommand, RelativeSource={RelativeSource AncestorType=DockPanel}}" CommandParameter="{Binding Value}" />
                                    </hc:EventTrigger>
                                </hc:Interaction.Triggers>
                            </hc:HighlightTextBlock>
                            <TextBlock
                                Margin="1,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="RoyalBlue"
                                Text="&gt;"
                                Visibility="{Binding IsLast, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Orientation="Horizontal" />
        </DockPanel>
        <ItemsControl
            Grid.Row="1"
            Margin="10,5"
            ItemsSource="{Binding SwitchButtons}"
            Visibility="{Binding IsSwitch, Converter={StaticResource Boolean2VisibilityConverter}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <hc:UniformSpacingPanel
                        HorizontalAlignment="Stretch"
                        ChildWrapping="Wrap"
                        Orientation="Horizontal"
                        Spacing="10" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton
                        Command="{Binding DataContext.LoadedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Value}"
                        Content="{Binding Name}"
                        IsChecked="{Binding IsCurrent}"
                        Style="{StaticResource ButtonStyle}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ScrollViewer Grid.Row="2">
            <flow:FlowEditor
                x:Name="flowEditor"
                Padding="5,5"
                AllowDrop="True"
                IsDataFlow="{Binding IsDataFlow}"
                ItemsSource="{Binding FlowItems}">
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="ItemSelected">
                        <hc:EventToCommand Command="{Binding SelectedCommand}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                    <hc:EventTrigger EventName="ItemsMoved">
                        <hc:EventToCommand Command="{Binding MovedCommand}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                    <hc:EventTrigger EventName="ItemDoubleClick">
                        <hc:EventToCommand Command="{Binding LoadedCommand}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                    <hc:EventTrigger EventName="ItemDrop">
                        <hc:EventToCommand Command="{Binding DropCommand}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                    <hc:EventTrigger EventName="Loaded">
                        <hc:EventToCommand Command="{Binding EditorLoadedCommand}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </flow:FlowEditor>
        </ScrollViewer>

    </Grid>
</UserControl>
