<UserControl
    x:Class="Luster.Motion.EditorUI.Views.FlowViewContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Luster.Motion.EditorUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:Luster.Motion.EditorUI.Models"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:tx="clr-namespace:Luster.Control.Wpf.Motion.TreeEx;assembly=Luster.Control.Wpf.Motion"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources />
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ListBox
            x:Name="lsTree"
            Grid.Row="0"
            BorderThickness="0"
            IsSynchronizedWithCurrentItem="True"
            ItemsSource="{Binding StationList}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            Style="{DynamicResource ListBoxCustom}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel HorizontalAlignment="Stretch" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type model:ModuleCT}">
                    <Border
                        Height="{Binding Path=ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Grid}}"
                        MinWidth="200"
                        Margin="5,0"
                        Background="{DynamicResource BackgroundBrush}"
                        CornerRadius="5">
                        <tx:TreeListBox
                            x:Name="treeFlow"
                            Margin="5"
                            Background="{DynamicResource RegionBrush}"
                            BorderThickness="0"
                            FontSize="11"
                            HierarchySource="{Binding MotionChildList}"
                            Indentation="20">
                            <tx:TreeListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel
                                            Name="xIcon"
                                            Grid.Column="0"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Margin="0,0,3,1"
                                                FontSize="20"
                                                Foreground="{Binding StatusColor, Converter={StaticResource String2BrushConverter}}"
                                                Style="{StaticResource MotionIconSmall}"
                                                Text="{Binding Icon}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="2,3"
                                            VerticalAlignment="center">
                                            <TextBlock x:Name="xName" Text="{Binding Name}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </tx:TreeListBox.ItemTemplate>
                            <hc:Interaction.Triggers>
                                <hc:EventTrigger EventName="SelectionChanged">
                                    <hc:EventToCommand Command="{Binding Path=DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" PassEventArgsToCommand="True" />
                                </hc:EventTrigger>
                                <hc:EventTrigger EventName="PreviewMouseDoubleClick">
                                    <hc:EventToCommand Command="{Binding Path=DataContext.LoadedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding ElementName=treeFlow, Path=SelectedItem}" />
                                </hc:EventTrigger>
                            </hc:Interaction.Triggers>
                        </tx:TreeListBox>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!--<Border
            Grid.Row="1"
            Margin="5"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="5">
            <ContentControl
                x:Name="WorkFlowContent"
                Grid.Row="1"
                prism:RegionManager.RegionName="WorkFlowRegion" />
        </Border>-->
    </Grid>
</UserControl>
