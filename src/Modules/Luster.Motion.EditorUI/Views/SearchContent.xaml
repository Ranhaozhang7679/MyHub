<UserControl
    x:Class="Luster.Motion.EditorUI.Views.SearchContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:Luster.Common.DataStruct.DataModels;assembly=Luster.Common.DataStruct"
    xmlns:ex="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.EditorUI.Views"
    xmlns:m="clr-namespace:Luster.Motion.EditorUI.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="250"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ModuleItemStyle" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="rootBorder"
                            Padding="10"
                            Background="{StaticResource BorderBrush}"
                            CornerRadius="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="rootBorder" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="Grid_Search">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            Margin="5,0"
            Padding="0"
            Style="{StaticResource BorderRegion}">
            <hc:SearchBar
                Name="TxtSearchKey"
                MinWidth="200"
                Margin="10,5"
                hc:InfoElement.Placeholder="模块名称"
                hc:TitleElement.Title="模块名"
                hc:TitleElement.TitlePlacement="Left"
                hc:TitleElement.TitleWidth="60"
                Command="{Binding SearchCommand}"
                CommandParameter="{Binding Path=Text, ElementName=TxtSearchKey}"
                ShowClearButton="True"
                Style="{StaticResource SearchBarExtend}"
                Text="{Binding SearchKey}" />
        </Border>
        <Border
            Grid.Row="1"
            Margin="5,5"
            Padding="0"
            Style="{StaticResource BorderRegion}">
            <hc:SearchBar
                Name="TxtSearchType"
                Grid.Row="0"
                MinWidth="200"
                Margin="10,5"
                hc:InfoElement.Placeholder="类型名"
                hc:TitleElement.Title="类型名"
                hc:TitleElement.TitlePlacement="Left"
                hc:TitleElement.TitleWidth="60"
                Command="{Binding SearchTypeCommand}"
                CommandParameter="{Binding Path=Text, ElementName=TxtSearchType}"
                ShowClearButton="True"
                Style="{StaticResource SearchBarExtend}"
                Text="{Binding SearchType}" />
        </Border>

        <ListBox
            Name="listModules"
            Grid.Row="2"
            Margin="5,0"
            Padding="5"
            ItemContainerStyle="{StaticResource ModuleItemStyle}"
            ItemsSource="{Binding SearchItems}"
            Style="{StaticResource ListBoxCustom}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <hc:UniformSpacingPanel Orientation="Vertical" Spacing="2" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock VerticalAlignment="Center" Text="{Binding Desc}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
            <hc:Interaction.Triggers>
                <hc:EventTrigger EventName="PreviewMouseDoubleClick">
                    <hc:EventToCommand Command="{Binding Path=DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding Path=SelectedItem, ElementName=listModules}" />
                </hc:EventTrigger>
            </hc:Interaction.Triggers>
        </ListBox>
    </Grid>
</UserControl>
