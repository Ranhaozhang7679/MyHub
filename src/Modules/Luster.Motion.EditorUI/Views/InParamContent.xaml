<UserControl
    x:Class="Luster.Motion.EditorUI.Views.InParamContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:Luster.Common.DataStruct.DataModels;assembly=Luster.Common.DataStruct"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:langs="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.EditorUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:param="clr-namespace:Luster.Control.Wpf.Motion;assembly=Luster.Control.Wpf.Motion"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="300"
    d:DesignWidth="300"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <TextBlock
            x:Key="menuIconKey"
            FontSize="20"
            Foreground="Green"
            Style="{StaticResource MotionIconSmall}"
            Text="{Binding Icon}" />
        <TextBlock
            x:Key="connectKey"
            FontSize="20"
            Foreground="Green"
            Style="{StaticResource MotionIconSmall}"
            Text="&#xe69e;" />
        <ContextMenu
            x:Key="menuLink"
            Width="200"
            ItemsSource="{Binding RefNodes}">
            <ContextMenu.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type data:LNode}" ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding .}" />
                </HierarchicalDataTemplate>
            </ContextMenu.ItemTemplate>
            <ContextMenu.ItemContainerStyle>
                <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                    <Setter Property="Command" Value="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.DataContext.LinkCommand}" />
                    <Setter Property="CommandParameter" Value="{Binding}" />
                    <Setter Property="Icon" Value="{StaticResource menuIconKey}" />
                    <Setter Property="Header" Value="{Binding Text}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border
                                    Name="Bd"
                                    MinWidth="150"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                    <Grid Name="Grid" Margin="{TemplateBinding Padding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter
                                            Name="Icon"
                                            Width="20"
                                            Height="20"
                                            Margin="0,0,5,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            ContentSource="Icon"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        <ContentPresenter
                                            Name="ContentPresenter"
                                            Grid.Column="1"
                                            Margin="0,3"
                                            ContentSource="Header"
                                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                                            RecognizesAccessKey="True"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text}" Value="-">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate>
                                        <Separator Margin="5,2" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Text}" Value="Clear">
                            <Setter Property="Foreground" Value="Red" />
                            <Setter Property="Header" Value="{langs:Lang Key={Binding Text}}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Icon}" Value="Link">
                            <Setter Property="Icon" Value="{StaticResource connectKey}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContextMenu.ItemContainerStyle>
        </ContextMenu>
    </UserControl.Resources>
    <Grid Visibility="{Binding ViewVisible}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <hc:TextBox
                Width="170"
                Margin="5,5"
                HorizontalAlignment="Left"
                hc:TitleElement.TitlePlacement="Left"
                IsEnabled="{Binding SysRole, Converter={StaticResource RoleEnabledCoverter}, ConverterParameter=Admin}"
                Text="{Binding ModuleAlias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="1"
                Margin="0,0,5,0"
                HorizontalAlignment="Right"
                hc:IconElement.Geometry="{StaticResource ApplyGeometry}"
                Command="{Binding ApplyCommand}"
                Content="Apply"
                DockPanel.Dock="Right"
                IsEnabled="{Binding SysRole, Converter={StaticResource RoleEnabledCoverter}, ConverterParameter=Engineer}" />
        </Grid>
        <ScrollViewer Grid.Row="1">
            <param:ParamGrid
                MinHeight="120"
                Margin="0"
                HasPermission="{Binding SysRole, Converter={StaticResource RoleEnabledCoverter}, ConverterParameter=Engineer}"
                PreviewMouseDown="Preview_LeftButtonDown"
                SelectedObject="{Binding ModuleObj}">
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <hc:EventToCommand Command="{Binding ShowLinkCommand}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                    <hc:EventTrigger EventName="ItemConfig">
                        <hc:EventToCommand Command="{Binding ItemConfigCommand}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </param:ParamGrid>
        </ScrollViewer>

        <hc:DashedBorder
            Grid.Row="2"
            Margin="5"
            BorderBrush="{StaticResource DarkInfoBrush}"
            BorderDashArray="2,2"
            BorderThickness="1"
            CornerRadius="5"
            Visibility="{Binding NoteVisible, Converter={StaticResource Boolean2VisibilityConverter}}">
            <Grid Margin="5,0,5,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="{Binding ModuleNote}" />
                <Button
                    Grid.Row="1"
                    MaxHeight="28"
                    HorizontalAlignment="Right"
                    Command="{Binding NoteCommand}"
                    Content="{lang:Lang Key={x:Static lang:LangKeys.AnnotationGeneration}}"
                    Style="{StaticResource ButtonPrimary}" />
            </Grid>
        </hc:DashedBorder>
    </Grid>
</UserControl>
