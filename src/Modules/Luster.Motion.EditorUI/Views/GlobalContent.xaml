<UserControl
    x:Class="Luster.Motion.EditorUI.Views.GlobalContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:con="clr-namespace:Luster.Motion.CommonUI.Converter;assembly=Luster.Motion.CommonUI"
    xmlns:converter="clr-namespace:Luster.Motion.EditorUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lang="clr-namespace:Luster.Motion.Assests.Langs;assembly=Luster.Motion.Assests"
    xmlns:local="clr-namespace:Luster.Motion.EditorUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="600"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="cbkInSelectStyle"
            BasedOn="{StaticResource DataGridColumnHeaderStyle.Small}"
            TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <CheckBox
                            HorizontalAlignment="Center"
                            Command="{Binding Path=DataContext.SelectAllCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                            CommandParameter="Input"
                            IsChecked="{Binding Path=DataContext.IsInSelectAll, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <converter:Object2StringTypeConveter x:Key="Object2StringTypeConveter" />
    </UserControl.Resources>
    <Grid IsEnabled="{Binding SysRole, Converter={StaticResource RoleEnabledCoverter}, ConverterParameter=Engineer}">
        <!--Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions-->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="100" />
            <RowDefinition Height="5" />
            <RowDefinition Height="1*" MinHeight="50" />
        </Grid.RowDefinitions>

        <hc:ElementGroup
            Margin="5,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Layout="Stack">
            <hc:SearchBar
                Width="180"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                hc:InfoElement.Placeholder="{lang:Lang Key={x:Static lang:LangKeys.GlobalVar}}"
                Command="{Binding SearchCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Text}" />
            <Button
                Margin="10,0,10,5"
                hc:IconElement.Geometry="{StaticResource ExportGeometry}"
                Command="{Binding ExportCommand}"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Export}}"
                Style="{StaticResource ButtonPrimary}" />
            <Button
                Margin="10,0,10,5"
                hc:IconElement.Geometry="{StaticResource ImportGeometry}"
                Command="{Binding ImportCommand}"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Import}}"
                Style="{StaticResource ButtonPrimary}" />
            <!--Button
                Margin="10,0,10,5"
                hc:IconElement.Geometry="{StaticResource ImportGeometry}"
                Command="{Binding ExportToTxtCommand}"
                Content="导出到文本"
                Style="{StaticResource ButtonPrimary}" /-->
            <Button
                Margin="10,0,10,5"
                hc:IconElement.Geometry="{StaticResource AddGeometry}"
                Command="{Binding AddCommand}"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Add}}" />
            <Button
                Margin="10,0,10,5"
                hc:IconElement.Geometry="{StaticResource RedoGeometry}"
                Command="{Binding RefreshCommand}"
                Content="{lang:Lang Key={x:Static lang:LangKeys.Refresh}}" />
        </hc:ElementGroup>
        <!--hc:ButtonGroup
            Grid.Column="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Layout="Stack">
            
        </hc:ButtonGroup-->
        <DataGrid
            Name="dgInput"
            Grid.Row="1"
            hc:DataGridAttach.ShowRowNumber="False"
            hc:DataGridAttach.ShowSelectAllButton="False"
            HeadersVisibility="Column"
            IsReadOnly="False"
            ItemsSource="{Binding VarDatas}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    MinWidth="80"
                    Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.Name}}" />
                <DataGridTextColumn
                    MinWidth="40"
                    Binding="{Binding TypeName}"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.Type}}"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    MinWidth="70"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.CurrentValue}}"
                    IsReadOnly="False">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource Object2StringTypeConveter}">
                            <Binding Path="Value" />
                            <Binding Path="Type" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn
                    MinWidth="70"
                    Binding="{Binding DefaultV, Converter={StaticResource Object2StringConverter}}"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.DefaultValue}}"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    MinWidth="30"
                    Binding="{Binding IsMemoric, Converter={StaticResource Object2StringConverter}}"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.IsMemoric}}"
                    IsReadOnly="True" />

                <DataGridTextColumn
                    MinWidth="30"
                    Binding="{Binding IsHomeDefault, Converter={StaticResource Object2StringConverter}}"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.IsHomeDefault}}"
                    IsReadOnly="True" />
                <DataGridTemplateColumn
                    Width="100"
                    MinWidth="100"
                    hc:TitleElement.HorizontalAlignment="Center"
                    CanUserResize="False"
                    Header="{lang:Lang Key={x:Static lang:LangKeys.Operate}}"
                    HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Margin="0"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.EditCommand}"
                                    CommandParameter="{Binding .}"
                                    Content="{lang:Lang Key={x:Static lang:LangKeys.Edit}}"
                                    Style="{StaticResource ButtonDanger.Small}" />
                                <Button
                                    Margin="5,0,0,0"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.RemoveCommand}"
                                    CommandParameter="{Binding .}"
                                    Content="{lang:Lang Key={x:Static lang:LangKeys.Delete}}"
                                    Style="{StaticResource ButtonDanger.Small}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <hc:Interaction.Triggers>
                <hc:EventTrigger EventName="SelectionChanged">
                    <hc:EventToCommand Command="{Binding Path=DataContext.SelectedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding Path=SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                </hc:EventTrigger>
            </hc:Interaction.Triggers>
        </DataGrid>

        <!-- GridSplitter 用于拖动调整行高 -->
        <GridSplitter
            Grid.Row="2"
            Height="5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="Gray"
            ResizeDirection="Rows"
            ShowsPreview="True" />

        <GroupBox
            Grid.Row="3"
            Padding="0"
            hc:TitleElement.Background="{StaticResource RegionBrush}"
            Header="{Binding RefTitle}"
            Style="{StaticResource GroupBoxTab}">
            <ListBox ItemsSource="{Binding RefModules}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5,2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                Text="{Binding Alias}"
                                TextWrapping="Wrap" />
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="PreviewMouseDoubleClick">
                        <hc:EventToCommand Command="{Binding Path=DataContext.RefSelectedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding Path=SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </ListBox>
        </GroupBox>
    </Grid>
</UserControl>
