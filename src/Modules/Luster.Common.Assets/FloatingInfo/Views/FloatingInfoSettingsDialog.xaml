<UserControl
    x:Class="Luster.Common.Assets.FloatingInfo.Views.FloatingInfoSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:models="clr-namespace:Luster.Common.Assets.FloatingInfo.Models"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Topmost" Value="True"/>
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="SizeToContent" Value="WidthAndHeight"/>
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
            <Setter Property="Width" Value="78" />
            <Setter Property="Height" Value="32" />
        </Style>
        
        <!-- 内容项类型模板选择器 -->
        <DataTemplate x:Key="TextContentItemTemplate" DataType="{x:Type models:TextContentItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- 文本内容 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="文本内容:" VerticalAlignment="Center" Margin="0,0,5,5"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,5"/>
                
                <!-- 字体大小 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="字体大小:" VerticalAlignment="Center" Margin="0,0,5,5"/>
                <hc:NumericUpDown Grid.Row="1" Grid.Column="1"
                                  Value="{Binding FontSize, Mode=TwoWay}"
                                  Minimum="8" Maximum="72"
                                  Margin="0,0,0,5"/>
                
                <!-- 文本对齐 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="对齐方式:" VerticalAlignment="Center" Margin="0,0,5,5"/>
                <ComboBox Grid.Row="2" Grid.Column="1"
                          SelectedValue="{Binding TextAlignment, Mode=TwoWay}"
                          SelectedValuePath="Tag"
                          Margin="0,0,0,5">
                    <ComboBoxItem Content="左对齐" Tag="{x:Static TextAlignment.Left}"/>
                    <ComboBoxItem Content="居中" Tag="{x:Static TextAlignment.Center}"/>
                    <ComboBoxItem Content="右对齐" Tag="{x:Static TextAlignment.Right}"/>
                </ComboBox>
                
                <!-- 是否换行 -->
                <CheckBox Grid.Row="3" Grid.Column="1"
                          Content="自动换行"
                          IsChecked="{Binding TextWrapping, Mode=TwoWay}"
                          Margin="0,0,0,5"/>
            </Grid>
        </DataTemplate>
        
        <DataTemplate x:Key="ImageContentItemTemplate" DataType="{x:Type models:ImageContentItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- 图片路径 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="图片路径:" VerticalAlignment="Center" Margin="0,0,5,5"/>
                <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding ImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,5,0"/>
                    <Button Grid.Column="1" Content="..." Width="30" Padding="0"
                            Command="{Binding DataContext.SelectImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            ToolTip="选择图片"/>
                </Grid>
                
                <!-- 最大尺寸 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="最大宽度:" VerticalAlignment="Center" Margin="0,0,5,5"/>
                <hc:NumericUpDown Grid.Row="1" Grid.Column="1"
                                  Value="{Binding MaxWidth, Mode=TwoWay}"
                                  Minimum="50" Maximum="800"
                                  Margin="0,0,0,5"/>
                
                <TextBlock Grid.Row="2" Grid.Column="0" Text="最大高度:" VerticalAlignment="Center" Margin="0,0,5,5"/>
                <hc:NumericUpDown Grid.Row="2" Grid.Column="1"
                                  Value="{Binding MaxHeight, Mode=TwoWay}"
                                  Minimum="50" Maximum="600"
                                  Margin="0,0,0,5"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>
        
        <!-- 启用设置 -->
        <CheckBox Grid.Row="1"
                  Content="启用浮动信息显示"
                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                  Margin="0,5"/>
        
        <!-- 窗口设置 -->
        <GroupBox Grid.Row="2" Header="窗口设置" Margin="0,10">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Column="0" Text="宽度:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <hc:NumericUpDown Grid.Column="1"
                                  Value="{Binding WindowWidth, Mode=TwoWay}"
                                  Minimum="200" Maximum="800"
                                  Margin="0,0,10,0"/>
                
                <TextBlock Grid.Column="2" Text="高度:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <hc:NumericUpDown Grid.Column="3"
                                  Value="{Binding WindowHeight, Mode=TwoWay}"
                                  Minimum="150" Maximum="600"
                                  Margin="0,0,10,0"/>
                
                <TextBlock Grid.Column="4" Text="X:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <hc:NumericUpDown Grid.Column="5"
                                  Value="{Binding WindowLeft, Mode=TwoWay}"
                                  Minimum="0" Maximum="3840"
                                  Margin="0,0,10,0"/>
                
                <TextBlock Grid.Column="6" Text="Y:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <hc:NumericUpDown Grid.Column="7"
                                  Value="{Binding WindowTop, Mode=TwoWay}"
                                  Minimum="0" Maximum="2160"/>
            </Grid>
        </GroupBox>
        
        <!-- 内容项设置 -->
        <GroupBox Grid.Row="3" Header="内容项设置" Margin="0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- 左侧：内容项列表 -->
                <Grid Grid.Column="0" Margin="0,0,5,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 添加新项 -->
                    <Grid Grid.Row="0" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  SelectedItem="{Binding SelectedNewContentType, Mode=TwoWay}"
                                  ItemsSource="{Binding ContentTypeValues}"
                                  Margin="0,0,5,0"/>
                        <Button Grid.Column="1"
                                Content="+"
                                Width="28" Height="28"
                                Command="{Binding AddContentItemCommand}"
                                ToolTip="添加内容项"/>
                    </Grid>
                    
                    <!-- 内容项列表 -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ContentItems}"
                             SelectedItem="{Binding SelectedContentItem, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="[" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Order}" VerticalAlignment="Center"/>
                                    <TextBlock Text="] " VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ContentType}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- 操作按钮 -->
                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,5,0,0">
                        <Button Content="↑" Width="28" Height="28"
                                Command="{Binding MoveUpCommand}" ToolTip="上移"/>
                        <Button Content="↓" Width="28" Height="28"
                                Command="{Binding MoveDownCommand}" ToolTip="下移"/>
                        <Button Content="×" Width="28" Height="28"
                                Command="{Binding RemoveContentItemCommand}" ToolTip="删除"/>
                    </UniformGrid>
                </Grid>
                
                <!-- 分隔线 -->
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                
                <!-- 右侧：内容项编辑 -->
                <Grid Grid.Column="2" Margin="5,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 内容类型选择 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="内容类型: " VerticalAlignment="Center"/>
                        <ComboBox SelectedItem="{Binding SelectedContentType, Mode=TwoWay}"
                                  ItemsSource="{Binding ContentTypeValues}"
                                  Width="100"/>
                    </StackPanel>
                    
                    <!-- 内容项属性编辑 -->
                    <ContentControl Grid.Row="1" Content="{Binding SelectedContentItem}">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <Setter Property="ContentTemplate" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedContentItem.ContentType}" Value="Text">
                                        <Setter Property="ContentTemplate" Value="{StaticResource TextContentItemTemplate}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedContentItem.ContentType}" Value="Image">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ImageContentItemTemplate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    
                    <!-- 无选中项提示 -->
                    <TextBlock Grid.Row="1"
                               Text="请选择或添加内容项"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="Gray">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedContentItem}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </GroupBox>
        
        <!-- 按钮区域 -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="取消"
                    Command="{Binding CancelCommand}"
                    Margin="0,0,10,0"/>
            <Button Content="确定"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource ButtonPrimary}"/>
        </StackPanel>
    </Grid>
</UserControl>
