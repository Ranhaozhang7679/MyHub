<Window
    x:Class="Luster.Common.Assets.FloatingInfo.Views.FloatingInfoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:selectors="clr-namespace:Luster.Common.Assets.FloatingInfo.Selectors"
    xmlns:models="clr-namespace:Luster.Common.Assets.FloatingInfo.Models"
    xmlns:vm="clr-namespace:Luster.Common.Assets.FloatingInfo.ViewModel"
    Title="{Binding Title}"
    Width="{Binding WindowWidth, Mode=TwoWay}"
    Height="{Binding WindowHeight, Mode=TwoWay}"
    WindowStyle="None"
    AllowsTransparency="True"
    ShowInTaskbar="False"
    Topmost="True"
    ResizeMode="CanResize"
    WindowStartupLocation="Manual"
    Background="Transparent"
    Left="{Binding WindowLeft, Mode=TwoWay}"
    Top="{Binding WindowTop, Mode=TwoWay}"
    prism:ViewModelLocator.AutoWireViewModel="True">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <selectors:ContentTemplateSelector x:Key="ContentTemplateSelector">
            <selectors:ContentTemplateSelector.TextTemplate>
                <DataTemplate DataType="{x:Type models:TextContentItem}">
                    <TextBlock Text="{Binding Text}" 
                               TextWrapping="Wrap"
                               Margin="{Binding Margin}"
                               FontSize="12"/>
                </DataTemplate>
            </selectors:ContentTemplateSelector.TextTemplate>
            <selectors:ContentTemplateSelector.ImageTemplate>
                <DataTemplate DataType="{x:Type models:ImageContentItem}">
                    <Image Source="{Binding ImagePath}" 
                           MaxWidth="{Binding MaxWidth}"
                           MaxHeight="{Binding MaxHeight}"
                           Margin="{Binding Margin}"
                           Stretch="Uniform"/>
                </DataTemplate>
            </selectors:ContentTemplateSelector.ImageTemplate>
        </selectors:ContentTemplateSelector>
    </Window.Resources>

    <Border Background="#F0F0F0" 
            BorderBrush="#0078D4" 
            BorderThickness="1"
            CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- 标题栏 -->
            <Border Grid.Row="0" 
                    Background="#0078D4" 
                    CornerRadius="5,5,0,0"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid Margin="10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" 
                               Text="{Binding Title}" 
                               Foreground="White" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    
                    <StackPanel Grid.Column="1" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right">
                        
                        <!-- 设置按钮 -->
                        <Button  Width="32"
                                 Height="32"
                                 Margin="2,0"
                                 Command="{Binding OpenSettingsCommand}"
                                 Visibility="{Binding ShowSettingsButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 ToolTip="设置">
                            <Button.Content>
                                <Path Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.4,13C19.5,12.7 19.5,12.3 19.5,12C19.5,11.7 19.5,11.3 19.4,11L21.5,9.4C21.7,9.2 21.7,9 21.6,8.8L19.6,5.4C19.5,5.2 19.2,5.1 19,5.2L16.5,6.2C16,5.8 15.4,5.5 14.8,5.3L14.4,2.6C14.4,2.3 14.2,2.1 13.9,2.1H10.1C9.8,2.1 9.6,2.3 9.6,2.6L9.2,5.3C8.6,5.5 8,5.8 7.5,6.2L5,5.2C4.8,5.1 4.5,5.2 4.4,5.4L2.4,8.8C2.3,9 2.3,9.2 2.5,9.4L4.6,11C4.5,11.3 4.5,11.7 4.5,12C4.5,12.3 4.5,12.7 4.6,13L2.5,14.6C2.3,14.8 2.3,15 2.4,15.2L4.4,18.6C4.5,18.8 4.8,18.9 5,18.8L7.5,17.8C8,18.2 8.6,18.5 9.2,18.7L9.6,21.4C9.6,21.7 9.8,21.9 10.1,21.9H13.9C14.2,21.9 14.4,21.7 14.4,21.4L14.8,18.7C15.4,18.5 16,18.2 16.5,17.8L19,18.8C19.2,18.9 19.5,18.8 19.6,18.6L21.6,15.2C21.7,15 21.7,14.8 21.5,14.6L19.4,13Z"
                                      Stroke="White"
                                      StrokeThickness="0.5"
                                      Fill="White"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"/>
                            </Button.Content>
                        </Button>

                        <!-- 最小化按钮 -->
                        <Button  Width="32"
                                 Height="32"
                                 Margin="2,0"
                                 Command="{Binding MinimizeCommand}"
                                 ToolTip="最小化">
                            <Button.Content>
                                <Path Data="M3,12 L21,12"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      Width="16"
                                      Height="16"/>
                            </Button.Content>
                        </Button>

                        <!-- 关闭按钮 -->
                        <Button Width="32"
                                Height="32"
                                Margin="2,0"
                                Command="{Binding CloseCommand}"
                                ToolTip="关闭">
                            <Button.Content>
                                <Path Data="M2,2 L16,16 M16,2 L2,16"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      Width="16"
                                      Height="16"/>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- 内容区域 -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="5">
                <ItemsControl ItemsSource="{Binding ContentItems}"
                              ItemTemplateSelector="{StaticResource ContentTemplateSelector}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
