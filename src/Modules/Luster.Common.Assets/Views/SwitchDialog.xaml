<UserControl
    x:Class="Luster.Common.Assets.Views.SwitchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:Luster.Common.DataStruct.DataModels;assembly=Luster.Common.DataStruct"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Luster.Common.Assets.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:tx="clr-namespace:Luster.Controls.Wpf.TreeEx;assembly=Luster.Controls.Wpf"
    xmlns:vm="clr-namespace:Luster.Common.Assets.ViewModel"
    Height="550"
    MaxWidth="800"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="CalulateKey"
            BasedOn="{StaticResource {x:Type Button}}"
            TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="hc:BorderElement.CornerRadius" Value="20" />
            <EventSetter Event="Click" Handler="Button_Click" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="TagCustomStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{Binding Name}" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="AliceBlue" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="AntiqueWhite" />
                    <Setter Property="Cursor" Value="Hand" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="VariableStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="AliceBlue" />
                    <Setter Property="Cursor" Value="Hand" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExpressItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <hc:DashedBorder
                            x:Name="PART_Border"
                            Margin="5,0"
                            Padding="4,2"
                            VerticalAlignment="Center"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderDashArray="2,2"
                            BorderThickness="1">
                            <ContentPresenter
                                Margin="10,0,0,0"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </hc:DashedBorder>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NormalTemplate" DataType="{x:Type data:LNode}">
            <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,3,0"
                    VerticalAlignment="Center"
                    Style="{DynamicResource IconSmall}"
                    Text="{Binding Icon}" />
                <TextBlock
                    x:Name="xName"
                    VerticalAlignment="Center"
                    Text="{Binding Text}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ParamTemplate" DataType="{x:Type data:LNode}">
            <StackPanel Margin="8,2,0,2" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,3,0"
                    VerticalAlignment="Center"
                    Foreground="Blue"
                    Style="{DynamicResource IconSmall}"
                    Text="{Binding Icon}" />
                <TextBlock
                    x:Name="xName"
                    VerticalAlignment="Center"
                    Foreground="Blue"
                    Text="{Binding Text}" />
            </StackPanel>
        </DataTemplate>

        <vm:ParamDataTemplateSelector
            x:Key="VarTemplate"
            NormalTemplate="{StaticResource NormalTemplate}"
            ParamTemplate="{StaticResource ParamTemplate}" />
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Width="250">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource TitleStyle}" Text="变量" />
                <TextBox
                    Grid.Column="1"
                    Height="28"
                    Margin="5,0"
                    Text="{Binding SearchKey, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
            </Grid>
            <hc:DashedBorder
                Name="bTree"
                Grid.Row="1"
                Padding="5"
                BorderBrush="Blue"
                BorderDashArray="2,2"
                BorderThickness="1"
                CornerRadius="4">
                <tx:TreeListBox
                    x:Name="treeVar"
                    Background="{DynamicResource RegionBrush}"
                    BorderThickness="0"
                    FontSize="12"
                    HierarchySource="{Binding Variables}"
                    Indentation="12"
                    ItemTemplateSelector="{StaticResource VarTemplate}">
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="MouseDoubleClick">
                            <hc:EventToCommand Command="{Binding SelectVarCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=tx:TreeListBox}, Path=SelectedItem}" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </tx:TreeListBox>
            </hc:DashedBorder>
        </Grid>
        <Grid Grid.Column="1" Margin="5,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock Style="{StaticResource TitleStyle}" Text="表达式" />
                    <CheckBox
                        DockPanel.Dock="Right"
                        IsChecked="{Binding AutoSort}"
                        IsThreeState="False">
                        <TextBlock Style="{StaticResource TitleStyle}" Text="自动排序" />
                    </CheckBox>
                </DockPanel>

                <hc:DashedBorder
                    BorderBrush="Blue"
                    BorderDashArray="2,2"
                    BorderThickness="1">
                    <avalonEdit:TextEditor
                        x:Name="richText"
                        Height="350"
                        BorderThickness="1"
                        Document="{Binding DocumentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        FontFamily="Consolas"
                        FontSize="12pt"
                        IsModified="True"
                        ShowLineNumbers="True"
                        WordWrap="True" />
                </hc:DashedBorder>
            </StackPanel>
            <ListBox
                Grid.Row="1"
                MinHeight="48"
                Margin="0,0,0,5"
                ItemsSource="{Binding TagList}"
                Style="{StaticResource ListBoxCustom}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <hc:UniformSpacingPanel
                            VerticalAlignment="Top"
                            ChildWrapping="Wrap"
                            ScrollViewer.VerticalScrollBarVisibility="Visible" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Margin="1,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Name}" />
                            <Button
                                Grid.Column="1"
                                Margin="3,0"
                                Padding="2"
                                hc:IconElement.Geometry="{StaticResource RemoveGeometry}"
                                hc:IconElement.Height="12"
                                hc:IconElement.Width="12"
                                Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.RemoveCondition}"
                                CommandParameter="{Binding .}"
                                Style="{StaticResource ButtonDashed.Small}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="OverridesDefaultStyle" Value="True" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <Setter Property="Foreground" Value="Black" />
                        <Setter Property="FontSize" Value="16" />
                        <Setter Property="MinWidth" Value="45" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <hc:DashedBorder
                                        x:Name="border"
                                        Margin="5"
                                        Padding="2,4"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderDashArray="4,4"
                                        BorderThickness="1"
                                        CornerRadius="0">
                                        <ContentPresenter
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </hc:DashedBorder>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="Red" />
                                            <Setter TargetName="border" Property="Background" Value="white" />
                                            <Setter TargetName="border" Property="BorderBrush" Value="Red" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True" />
                                                <Condition Property="IsSelected" Value="False" />
                                            </MultiTrigger.Conditions>
                                            <MultiTrigger.Setters>
                                                <Setter Property="Foreground" Value="#FF46679A" />
                                                <Setter TargetName="border" Property="Background" Value="white" />
                                                <Setter TargetName="border" Property="Opacity" Value="0.6" />
                                            </MultiTrigger.Setters>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="SelectionChanged">
                        <hc:EventToCommand Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.TagSelectCommand}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </ListBox>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <hc:ElementGroup>
                    <hc:ElementGroup.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </ItemsPanelTemplate>
                    </hc:ElementGroup.ItemsPanel>
                    <TextBox
                        Grid.Column="0"
                        Width="250"
                        Height="28"
                        HorizontalAlignment="Left"
                        hc:InfoElement.Placeholder="条件名称"
                        hc:TitleElement.Title="条件名称"
                        hc:TitleElement.TitlePlacement="Left"
                        Style="{StaticResource TextBoxExtend}"
                        Text="{Binding TagName}" />
                    <Button
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        hc:IconElement.Geometry="{StaticResource AddGeometry}"
                        Command="{Binding AddCommand}"
                        Content="{Binding Action}"
                        ToolTip="新增/编辑条件名称" />
                </hc:ElementGroup>
                <hc:ButtonGroup Grid.Column="1">
                    <Button
                        Grid.Column="2"
                        Margin="10,0,0,0"
                        Padding="6,2"
                        HorizontalAlignment="Right"
                        hc:IconElement.Geometry="{StaticResource RedoGeometry}"
                        Command="{Binding CloseCommand}"
                        CommandParameter="cancel"
                        Content="取消"
                        DockPanel.Dock="Right" />
                    <Button
                        Grid.Column="3"
                        Padding="4"
                        hc:IconElement.Geometry="{StaticResource ConfirmGeometry}"
                        Command="{Binding CloseCommand}"
                        CommandParameter="ok"
                        Content="确定"
                        DockPanel.Dock="Right" />
                </hc:ButtonGroup>
            </Grid>
        </Grid>
        <hc:Interaction.Triggers>
            <hc:EventTrigger EventName="Loaded">
                <hc:EventToCommand Command="{Binding LoadedCommand}" CommandParameter="{Binding Path=., ElementName=richText}" />
            </hc:EventTrigger>
        </hc:Interaction.Triggers>
    </Grid>
</UserControl>
