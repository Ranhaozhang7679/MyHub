<UserControl
    x:Class="Luster.Common.Assets.Views.AddInParamDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Luster.Common.Assets.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    MinWidth="500"
    MaxWidth="600"
    MaxHeight="450"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <GroupBox
            Grid.Column="0"
            Width="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Width}"
            MinWidth="200"
            hc:TitleElement.Background="{StaticResource RegionBrush}"
            Header="已有参数"
            Style="{StaticResource GroupBoxTabBaseStyle}">
            <DataGrid
                hc:DataGridAttach.ShowRowNumber="False"
                hc:DataGridAttach.ShowSelectAllButton="False"
                AutoGenerateColumns="False"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding ParamList}"
                SelectionMode="Single"
                Style="{StaticResource DataGrid.Small}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="120"
                        hc:TipElement.Placement="{Binding Desc}"
                        Binding="{Binding Desc}"
                        Header="参数名称" />
                    <DataGridTemplateColumn
                        Width="60"
                        MinWidth="60"
                        hc:TitleElement.HorizontalAlignment="Center"
                        CanUserResize="False"
                        Header="操作"
                        HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    HorizontalAlignment="Center"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.RemoveCommand}"
                                    CommandParameter="{Binding .}"
                                    Content="删除"
                                    Style="{StaticResource ButtonDanger.Small}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="SelectionChanged">
                        <hc:EventToCommand Command="{Binding SelectedCommand}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>
            </DataGrid>
        </GroupBox>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <hc:UniformSpacingPanel
                Grid.Column="1"
                Margin="10"
                Orientation="Vertical"
                Spacing="10">
                <hc:ComboBox
                    Width="370"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="参数类型"
                    hc:InfoElement.Title="参数类型"
                    DisplayMemberPath="Desc"
                    ItemsSource="{Binding TypeList}"
                    SelectedValue="{Binding Type, ValidatesOnNotifyDataErrors=True}"
                    SelectedValuePath="Value"
                    Style="{StaticResource ComboBoxValidationStyle}" />
                <TextBox
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="参数名"
                    hc:InfoElement.Title="参数名称"
                    Style="{StaticResource TextBoxValidationStyle}"
                    Text="{Binding Name, ValidatesOnNotifyDataErrors=True}" />

                <Grid Visibility="{Binding IsNumberic, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <hc:NumericUpDown
                        hc:InfoElement.Placeholder="最小值"
                        hc:InfoElement.Title="参数最小值"
                        Style="{StaticResource NumericUpDownValidationStyle}"
                        Value="{Binding Min}" />
                    <hc:NumericUpDown
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        hc:InfoElement.Title="参数最大值"
                        Style="{StaticResource NumericUpDownValidationStyle}"
                        Value="{Binding Max}" />
                    
                </Grid>
                <Grid>
                    <TextBox
                        Grid.Column="0"
                        hc:InfoElement.Necessary="True"
                        hc:InfoElement.Placeholder="默认值"
                        hc:InfoElement.Title="默认值"
                        Style="{StaticResource TextBoxValidationStyle}"
                        Text="{Binding DefaultV, ValidatesOnNotifyDataErrors=True}" Margin="0,0,127,0" />
                    <CheckBox
                        Grid.Column="1"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Right"
                        Content="是否参数引用"
                        IsChecked="{Binding CanRef}" />

                </Grid>
                <Grid>
                    <CheckBox
                        Margin="0,0,0,0"
                        HorizontalAlignment="Left"
                        Content="是否回零复位"
                        IsChecked="{Binding IsHomeDefault}" />
                    <CheckBox
                        Margin="0,0,0,0"
                        HorizontalAlignment="Right"
                        Content="是否参数记忆"
                        IsChecked="{Binding IsMemoric}" />

                </Grid>

                <StackPanel HorizontalAlignment="Left">
                    <TextBox
                        Width="370"
                        HorizontalAlignment="Left"
                        hc:InfoElement.Title="备注信息"
                        Style="{StaticResource TextBoxValidationStyle}"
                        Text="{Binding Desc}" />
                </StackPanel>
            </hc:UniformSpacingPanel>
            <Grid Grid.Row="1" Margin="10,5,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Width="80"
                    Margin="0,0,10,0"
                    Command="{Binding CloseCommand}"
                    CommandParameter="add"
                    Content="{Binding AddText}" />
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="80"
                        Margin="0,0,10,0"
                        Command="{Binding CloseCommand}"
                        CommandParameter="cancel"
                        Content="{Binding CancelText}" />
                    <Button
                        Width="80"
                        Command="{Binding CloseCommand}"
                        CommandParameter="ok"
                        Content="{Binding OKText}" />
                </StackPanel>
            </Grid>

        </Grid>


    </Grid>
</UserControl>
