<UserControl
    x:Class="Luster.Common.Assets.Views.MessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="clr-namespace:Luster.Common.Assets.Extension"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:langs="clr-namespace:Luster.Common.Assets.Langs;assembly=Luster.Common.Assets"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    MaxWidth="450"
    d:DesignHeight="200"
    d:DesignWidth="400"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="5,0" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="80" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="0"
                Margin="10,0,5,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock
                    MinWidth="60"
                    FontSize="64"
                    Foreground="{Binding Foreground}"
                    Style="{StaticResource IconLarge}"
                    Text="{Binding MsgIcon}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <TextBlock
                    Margin="15"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Text="{Binding MsgInfo}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                x:Name="BtnYes"
                Command="{Binding CloseCommand}"
                CommandParameter="yes"
                Content="{Binding BtnYesText}" />
            <Button
                x:Name="BtnNo"
                Command="{Binding CloseCommand}"
                CommandParameter="no"
                Content="{Binding BtnNoText}"
                Visibility="{Binding IsNoButton, Converter={StaticResource Boolean2VisibilityConverter}}" />
            <Button
                x:Name="BtnCancel"
                Command="{Binding CloseCommand}"
                CommandParameter="cancel"
                Content="{Binding BtnCancelText}"
                Visibility="{Binding IsCancelButton, Converter={StaticResource Boolean2VisibilityConverter}}" />
        </StackPanel>
    </Grid>
</UserControl>