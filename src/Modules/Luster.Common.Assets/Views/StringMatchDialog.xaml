<UserControl
    x:Class="Luster.Common.Assets.Views.StringMatchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:Luster.Common.DataStruct.DataModels;assembly=Luster.Common.DataStruct"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Luster.Common.Assets.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Width="600"
    MinWidth="550"
    MinHeight="350"
    MaxHeight="550"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="TagCustomStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{Binding Name}" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="AliceBlue" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="AntiqueWhite" />
                    <Setter Property="Cursor" Value="Hand" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="VariableStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="AliceBlue" />
                    <Setter Property="Cursor" Value="Hand" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <hc:UniformSpacingPanel Margin="10" Orientation="Vertical">
        <Grid Background="{StaticResource RegionBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource TitleStyle}" Text="字符变量 点击行进入编辑,回车完成" />
            <Button
                Grid.Column="1"
                Padding="2"
                HorizontalAlignment="Right"
                Command="{Binding AddCommand}">
                <Button.Content>
                    <TextBlock Style="{StaticResource IconMid}" Text="&#xe601;" />
                </Button.Content>
            </Button>
        </Grid>
        <DataGrid
            Name="lstVars"
            MinWidth="200"
            MinHeight="150"
            MaxHeight="200"
            hc:DataGridAttach.ShowRowNumber="True"
            AutoGenerateColumns="False"
            CanUserResizeColumns="False"
            DataGridCell.Selected="lstVars_Selected"
            FontSize="12"
            HeadersVisibility="All"
            IsReadOnly="False"
            ItemsSource="{Binding Variables}"
            Style="{StaticResource DataGrid.Small}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    MinWidth="120"
                    Binding="{Binding Name}"
                    Header="变量名称"
                    IsReadOnly="False" />
                <DataGridComboBoxColumn
                    MinWidth="100"
                    Header="类型"
                    HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="DisplayMemberPath" Value="Desc" />
                            <Setter Property="SelectedValuePath" Value="Value" />
                            <Setter Property="ItemsSource" Value="{Binding Path=DataContext.DataTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            <Setter Property="SelectedValue" Value="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" />
                        </Style>
                    </DataGridComboBoxColumn.EditingElementStyle>
                    <DataGridComboBoxColumn.ElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="DisplayMemberPath" Value="Desc" />
                            <Setter Property="SelectedValuePath" Value="Value" />
                            <Setter Property="ItemsSource" Value="{Binding Path=DataContext.DataTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                            <Setter Property="SelectedValue" Value="{Binding DataType}" />
                        </Style>
                    </DataGridComboBoxColumn.ElementStyle>
                </DataGridComboBoxColumn>
                <DataGridTextColumn
                    MinWidth="80"
                    Binding="{Binding Length}"
                    ElementStyle="{StaticResource DataColumnTextElementStyleCenter}"
                    Header="变量长度"
                    HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}" />
                <DataGridTextColumn
                    MinWidth="120"
                    Binding="{Binding Value, Converter={StaticResource Object2StringConverter}}"
                    Header="变量值"
                    IsReadOnly="True" />
                <DataGridTemplateColumn
                    MinWidth="60"
                    Header="操作"
                    HeaderStyle="{StaticResource DataColumnHeaderStyleCenter}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                Margin="5,0,0,0"
                                Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.RemoveCommand}"
                                CommandParameter="{Binding .}"
                                Content="删除"
                                Style="{StaticResource ButtonDanger.Small}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <hc:Interaction.Triggers>
                <hc:EventTrigger EventName="PreviewMouseDoubleClick">
                    <hc:EventToCommand Command="{Binding SelectVarCommand}" PassEventArgsToCommand="True" />
                </hc:EventTrigger>
            </hc:Interaction.Triggers>
        </DataGrid>
        <StackPanel>
            <TextBlock Style="{StaticResource TitleStyle}" Text="字符匹配模板" />
            <hc:DashedBorder
                BorderBrush="Blue"
                BorderDashArray="2,2"
                BorderThickness="1">
                <avalonEdit:TextEditor
                    x:Name="richText"
                    Height="80"
                    BorderThickness="1"
                    Document="{Binding DocumentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    FontFamily="Consolas"
                    FontSize="12pt"
                    IsModified="True"
                    ShowLineNumbers="True"
                    WordWrap="True" />
            </hc:DashedBorder>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource TitleStyle}" Text="测试文本" />
                <TextBox
                    Grid.Column="1"
                    Height="28"
                    Text="{Binding TestText}" />
            </Grid>
        </StackPanel>
        <Grid Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                HorizontalAlignment="Left"
                Command="{Binding PreviewCommand}"
                Content="结果预览" />
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,5,0"
                    HorizontalAlignment="Right"
                    hc:IconElement.Geometry="{StaticResource RedoGeometry}"
                    Command="{Binding CloseCommand}"
                    CommandParameter="cancel"
                    Content="取消"
                    DockPanel.Dock="Right" />
                <Button
                    hc:IconElement.Geometry="{StaticResource ConfirmGeometry}"
                    Command="{Binding CloseCommand}"
                    CommandParameter="ok"
                    Content="确定"
                    DockPanel.Dock="Right" />
            </StackPanel>
        </Grid>
    </hc:UniformSpacingPanel>
    <hc:Interaction.Triggers>
        <hc:EventTrigger EventName="Loaded">
            <hc:EventToCommand Command="{Binding LoadedCommand}" PassEventArgsToCommand="True" />
        </hc:EventTrigger>
    </hc:Interaction.Triggers>
</UserControl>
