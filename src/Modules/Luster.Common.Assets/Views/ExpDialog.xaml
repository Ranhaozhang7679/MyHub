<UserControl
    x:Class="Luster.Common.Assets.Views.ExpDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:Luster.Common.DataStruct.DataModels;assembly=Luster.Common.DataStruct"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Luster.Common.Assets.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:tx="clr-namespace:Luster.Controls.Wpf.TreeEx;assembly=Luster.Controls.Wpf"
    xmlns:vm="clr-namespace:Luster.Common.Assets.ViewModel"
    Width="400"
    Height="500"
    MinWidth="700"
    MaxWidth="700"
    d:DesignHeight="500"
    d:DesignWidth="700"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{DynamicResource RegionBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="CalulateKey"
            BasedOn="{StaticResource {x:Type Button}}"
            TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="hc:BorderElement.CornerRadius" Value="20" />
            <EventSetter Event="Click" Handler="Button_Click" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="TagCustomStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{Binding Name}" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="AliceBlue" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="AntiqueWhite" />
                    <Setter Property="Cursor" Value="Hand" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="VariableStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="AliceBlue" />
                    <Setter Property="Cursor" Value="Hand" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExpressItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <hc:DashedBorder
                            x:Name="PART_Border"
                            Margin="5,0"
                            Padding="4,2"
                            VerticalAlignment="Center"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderDashArray="2,2"
                            BorderThickness="1">
                            <ContentPresenter
                                Margin="10,0,0,0"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </hc:DashedBorder>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NormalTemplate" DataType="{x:Type data:LNode}">
            <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,3,0"
                    VerticalAlignment="Center"
                    Style="{DynamicResource IconSmall}"
                    Text="{Binding Icon}" />
                <TextBlock
                    x:Name="xName"
                    VerticalAlignment="Center"
                    Text="{Binding Text}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ParamTemplate" DataType="{x:Type data:LNode}">
            <StackPanel Margin="8,2,0,2" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,3,0"
                    VerticalAlignment="Center"
                    Foreground="Blue"
                    Style="{DynamicResource IconSmall}"
                    Text="{Binding Icon}" />
                <TextBlock
                    x:Name="xName"
                    VerticalAlignment="Center"
                    Foreground="Blue"
                    Text="{Binding Text}" />
            </StackPanel>
        </DataTemplate>

        <vm:ParamDataTemplateSelector
            x:Key="VarTemplate"
            NormalTemplate="{StaticResource NormalTemplate}"
            ParamTemplate="{StaticResource ParamTemplate}" />
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Width="250">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource TitleStyle}" Text="变量" />
                <TextBox
                    Grid.Column="1"
                    Height="28"
                    Margin="5,0"
                    Text="{Binding SearchKey, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
            </Grid>
            <hc:DashedBorder
                Name="bTree"
                Grid.Row="1"
                Padding="5"
                BorderBrush="Blue"
                BorderDashArray="2,2"
                BorderThickness="1"
                CornerRadius="4">
                <tx:TreeListBox
                    x:Name="treeVar"
                    Background="{DynamicResource RegionBrush}"
                    BorderThickness="0"
                    FontSize="12"
                    HierarchySource="{Binding Variables}"
                    Indentation="10"
                    ItemTemplateSelector="{StaticResource VarTemplate}">
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="MouseDoubleClick">
                            <hc:EventToCommand Command="{Binding SelectVarCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=tx:TreeListBox}, Path=SelectedItem}" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </tx:TreeListBox>
            </hc:DashedBorder>
        </Grid>
        <Grid Grid.Column="1" Margin="5,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource TitleStyle}" Text="表达式 [结果必须为True/False]" />
                <hc:DashedBorder
                    BorderBrush="Blue"
                    BorderDashArray="2,2"
                    BorderThickness="1">
                    <avalonEdit:TextEditor
                        x:Name="richText"
                        Height="370"
                        BorderThickness="1"
                        Document="{Binding DocumentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        FontFamily="Consolas"
                        FontSize="12pt"
                        IsModified="True"
                        ShowLineNumbers="True"
                        WordWrap="True" />
                </hc:DashedBorder>
            </StackPanel>
            <hc:ElementGroup
                Grid.Row="1"
                Margin="0,5"
                HorizontalAlignment="Right"
                Layout="Stack">
                <hc:ComboBox
                    Width="80"
                    DisplayMemberPath="Desc"
                    ItemsSource="{Binding Types}"
                    SelectedValue="{Binding ValueType}"
                    SelectedValuePath="Value" />
                <TextBox
                    Width="250"
                    Height="28"
                    Text="{Binding PreviewText}" />
                <Button Command="{Binding PreviewCommand}" Content="预览" />
            </hc:ElementGroup>
            <Grid Grid.Row="2" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        Margin="0,0,5,0"
                        HorizontalAlignment="Right"
                        hc:IconElement.Geometry="{StaticResource RedoGeometry}"
                        Command="{Binding CloseCommand}"
                        CommandParameter="cancel"
                        Content="取消"
                        DockPanel.Dock="Right" />
                    <Button
                        hc:IconElement.Geometry="{StaticResource ConfirmGeometry}"
                        Command="{Binding CloseCommand}"
                        CommandParameter="ok"
                        Content="确定"
                        DockPanel.Dock="Right" />
                </StackPanel>
            </Grid>
        </Grid>
        <hc:Interaction.Triggers>
            <hc:EventTrigger EventName="Loaded">
                <hc:EventToCommand Command="{Binding LoadedCommand}" CommandParameter="{Binding Path=., ElementName=richText}" />
            </hc:EventTrigger>
        </hc:Interaction.Triggers>
    </Grid>
</UserControl>
