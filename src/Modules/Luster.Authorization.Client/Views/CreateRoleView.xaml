<UserControl xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"  x:Class="DC.Authorization.WPF.Views.CreateRoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DC.Authorization.WPF.Views" 
             xmlns:viewmodels="clr-namespace:DC.Authorization.WPF.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:CreateRoleViewModel}"
             xmlns:prism ="http://prismlibrary.com/"
             mc:Ignorable="d" >
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <!--<Setter Property="ResizeMode" Value="NoResize"/>-->
            <Setter Property="ShowInTaskbar" Value="False"/>
            <Setter Property="SizeToContent" Value="WidthAndHeight"/>
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <!---->
        <ResourceDictionary x:Key="1">
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DC.Authorization.WPF;component/Resources/MahAppsInternalTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="180">
            <StackPanel Orientation="Horizontal">
                <Label Style="{StaticResource LabelStyle}">角色名</Label>
                <TextBox Style="{StaticResource TextBoxStyle}" Text="{Binding Name}"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Style="{StaticResource LabelStyle}">角色等级</Label>
                <ComboBox Margin="5" Width="200" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
                <Button Margin="10" Command="{Binding CreateCommand}">保存</Button>
            </StackPanel>
           
        </StackPanel>

    </Grid>
</UserControl>
