<UserControl x:Class="DC.Authorization.WPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DC.Authorization.WPF.Views" 
             xmlns:viewmodels="clr-namespace:DC.Authorization.WPF.ViewModels" 
             xmlns:converters="clr-namespace:DC.Authorization.WPF.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodels:LoginViewModel}"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded">
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="ResizeMode" Value="NoResize"/>
            <Setter Property="ShowInTaskbar" Value="False"/>
            <Setter Property="SizeToContent" Value="WidthAndHeight"/>
            <Setter Property="Title" Value="Settings Login"/>
        </Style>
    </prism:Dialog.WindowStyle>

    <UserControl.Resources>

        <converters:BooleanVisibilityConverter x:Key="BoolVisConv"/>

        <!-- 标签样式 -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="90"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <!-- 只读信息框样式（刷卡后显示用户信息） -->
        <Style x:Key="InfoTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#AAAAAA"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <!-- 密码框样式 -->
        <Style x:Key="PwdBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#AAAAAA"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
        <ResourceDictionary x:Key="1">
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DC.Authorization.WPF;component/Resources/MahAppsInternalTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 主容器：固定宽度 320 -->
    <Border Width="320" Background="#F0F0F0" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部：标题 + 右上角关闭按钮 -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <TextBlock Text="权限登录" FontSize="13" FontWeight="Bold"
                           Foreground="#333" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right"
                        Width="22" Height="22"
                        Content="✕"
                        FontSize="12"
                        Cursor="Hand"
                        Command="{Binding CancelCommand}"
                        ToolTip="关闭"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#666">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E81123"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- 原内容区 -->
            <StackPanel Grid.Row="1" Orientation="Vertical">
            <!-- ① 权限类型 / Permission group -->
            <Grid Margin="0,4,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Width="72" VerticalAlignment="Center">
                    <TextBlock FontSize="12" FontWeight="Bold" Text="权限类型" Foreground="#222"/>
                    <TextBlock FontSize="10" Text="Permission" Foreground="#555"/>
                    <TextBlock FontSize="10" Text="group" Foreground="#555"/>
                </StackPanel>
                <ComboBox Grid.Column="1"
                          Margin="4,0,0,0"
                          ItemsSource="{Binding Roles}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedRole}"
                          VerticalAlignment="Center"
                          FontSize="13"
                          x:Name="cmbRole"
                          MouseEnter="ComboBox_MouseEnter"/>
            </Grid>

            <!-- ② 刷卡提示区域 -->
            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                    Padding="8,6" Margin="0,2,0,4">
                <StackPanel Orientation="Horizontal">
                    <!-- 人物图标 -->
                    <Border Width="36" Height="36" Background="#DDDDDD" 
                            BorderBrush="#BBBBBB" BorderThickness="1"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="&#x1F4B3;" FontSize="18" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="请刷卡登录" FontSize="13" FontWeight="Bold" Foreground="#333"/>
                        <TextBlock Text="Please swipe badge to login" FontSize="11" Foreground="#777"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ③ 刷卡后显示用户信息（始终显示，未验证时为空） -->
            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                    Padding="8,6" Margin="0,2,0,2">
                <StackPanel Orientation="Vertical">
                    <!-- 卡号 CardNo（只读，仅由刷卡填入） -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                            <Run Text="卡号 " FontWeight="Bold"/>
                            <Run Text="CardNo"/>
                        </TextBlock>
                        <TextBox Grid.Column="1" Style="{StaticResource InfoTextBoxStyle}"
                                 Text="{Binding CardNo, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Focusable="False"
                                 Background="#F5F5F5"
                                 Foreground="#555555"/>
                    </Grid>
                    <!-- 名字 Name -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                            <Run Text="名字 " FontWeight="Bold"/>
                            <Run Text="Name"/>
                        </TextBlock>
                        <TextBox Grid.Column="1" Style="{StaticResource InfoTextBoxStyle}"
                                 Text="{Binding CardUserName, Mode=OneWay}"/>
                    </Grid>
                    <!-- 厂商 Vendor -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                            <Run Text="厂商 " FontWeight="Bold"/>
                            <Run Text="Vendor"/>
                        </TextBlock>
                        <TextBox Grid.Column="1" Style="{StaticResource InfoTextBoxStyle}"
                                 Text="{Binding CardVendor, Mode=OneWay}"/>
                    </Grid>
                    <!-- 级别 Level -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                            <Run Text="级别 " FontWeight="Bold"/>
                            <Run Text="Level"/>
                        </TextBlock>
                        <TextBox Grid.Column="1" Style="{StaticResource InfoTextBoxStyle}"
                                 Text="{Binding CardLevel, Mode=OneWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ④ MES 通信状态文本框 -->
            <Border Background="#E8E8E8" BorderBrush="#CCCCCC" BorderThickness="1"
                    Padding="6,4" Margin="0,4,0,0" MinHeight="50">
                <TextBox Text="{Binding MesStatusMessage, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         FontSize="12"
                         Foreground="#444"
                         Background="Transparent"
                         BorderThickness="0"/>
            </Border>

            <!-- ④b 进度条（绿色，MES通信/等待刷卡中） -->
            <ProgressBar Height="6" Margin="0,0,0,4"
                         IsIndeterminate="{Binding IsProgressActive}"
                         Visibility="{Binding IsProgressActive, Converter={StaticResource BoolVisConv}, ConverterParameter=True}"
                         Foreground="#4CAF50"
                         Background="#DDDDDD"
                         BorderThickness="0"/>

            <!-- ⑤ 离线登录勾选 + 密码框区域 -->
            <!-- 通常隐藏；MES不可用时作为备用显示 -->
            <StackPanel Orientation="Vertical">
                <!-- 离线登录勾选框 -->
                <CheckBox Margin="0,4,0,2"
                          FontSize="12"
                          Foreground="#555"
                          IsChecked="{Binding IsOfflineLogin}"
                          x:Name="chkOfflineLogin">
                    <TextBlock>
                        <Run Text="离线登录 "/>
                        <Run Text="Offline Login" Foreground="#777"/>
                    </TextBlock>
                </CheckBox>

                <!-- 密码区域：勾选离线登录后才显示 -->
                <Grid Margin="0,2,0,4"
                      Visibility="{Binding IsOfflineLogin, Converter={StaticResource BoolVisConv}, ConverterParameter=True}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource FieldLabelStyle}">
                        <Run Text="密码" FontWeight="Bold"/>
                        <Run Text="Password"/>
                    </TextBlock>
                    <PasswordBox Grid.Column="1" Style="{StaticResource PwdBoxStyle}"
                                 PasswordChar="*"
                                 mah:PasswordBoxBindingBehavior.Password="{Binding Password}"/>
                </Grid>
            </StackPanel>

            <!-- ⑥ 登录按钮 -->
            <Button Margin="0,6,0,4"
                    HorizontalAlignment="Center"
                    MinWidth="120" Height="32"
                    FontSize="14"
                    Command="{Binding LoginCommand}">登录 / Login</Button>

        </StackPanel>
        </Grid>
    </Border>
</UserControl>
