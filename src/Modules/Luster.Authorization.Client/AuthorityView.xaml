<UserControl xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"  x:Class="DC.Authorization.WPF.AuthorityView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DC.Authorization.WPF"
        xmlns:views ="clr-namespace:DC.Authorization.WPF.Views"
             xmlns:viewmodels="clr-namespace:DC.Authorization.WPF.ViewModels"
             xmlns:prism="http://prismlibrary.com/" xmlns:converter="clr-namespace:DC.Authorization.WPF.Converters"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             d:DataContext="{d:DesignInstance Type=viewmodels:AuthorityViewModel}"
        mc:Ignorable="d"
             
        >
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <!--<Setter Property="ResizeMode" Value="NoResize"/>-->
            <Setter Property="ShowInTaskbar" Value="False"/>
            <Setter Property="SizeToContent" Value="WidthAndHeight"/>
        </Style>
    </prism:Dialog.WindowStyle>
    <UserControl.Resources>
        <converter:EnableConverter x:Key="EnableConverter"/>
        <converter:TabItemVisibilityConverter x:Key="TabItemVisibilityConverter"/>
        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <!--<Style TargetType="TabItem" BasedOn="{StaticResource MahApps.Styles.TabItem}" >
            <Setter Property="FontSize" Value="16"/>
        </Style>-->
        <!--<Style x:Key="MenuItemWithIconStyle" TargetType="MenuItem">
            <Setter Property="Icon">
                <Setter.Value>
                    <Image Source="/Resources/Material-AccountMultiple.png" Width="16" Height="16"/>
                </Setter.Value>
            </Setter>
        </Style>-->
        
        <ResourceDictionary x:Key="1">
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DC.Authorization.WPF;component/Resources/MahAppsInternalTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- 自动高度，用于 Menu -->
            <RowDefinition MinHeight="600"/>
            <!-- 剩余空间，用于 TabControl -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="800" MaxWidth="1000"/>
        </Grid.ColumnDefinitions>
        <Menu VerticalAlignment="Top" Grid.Row="0" Grid.Column="0"  Visibility="{Binding CurrentLogin,Converter={StaticResource TabItemVisibilityConverter}}"  >
            <MenuItem Header="设置" >
                <MenuItem Header="切换登录" Command="{Binding ChangeLoginCommand}">
                    <MenuItem.Icon>
                        <Image Source="/DC.Authorization.WPF;component/Resources/PhosphorIcons-UserSwitch.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="修改密码" Command="{Binding ChangePasswordCommand}">
                    <MenuItem.Icon>
                        <Image Source="/DC.Authorization.WPF;component/Resources/PhosphorIcons-Password.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="退出登录" Command="{Binding LogoutCommand}" Visibility="{Binding CurrentLogin,Converter={StaticResource TabItemVisibilityConverter}}">
                    <MenuItem.Icon>
                        <Image Source="/DC.Authorization.WPF;component/Resources/BoxIcons-UserLogout.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- 右上角关闭按钮，悬停变红 -->
        <Button Grid.Row="0" Grid.Column="0"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="28" Height="28"
                Content="✕" FontSize="20"
                Cursor="Hand"
                Command="{Binding CancelCommand}"
                ToolTip="关闭"
                Panel.ZIndex="10">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Foreground" Value="#666"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

        <TabControl Margin="0,10,0,0" Grid.Row="2" Background="LightGray" Padding="20" SelectedIndex="{Binding SelectedTabIndex }" >
            <TabItem Header="登录" Visibility="Collapsed" >
                <StackPanel Margin="20,50,20,0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300" Height="180">
                    <StackPanel Orientation="Horizontal">
                        <Label Style="{StaticResource LabelStyle}">账户</Label>
                        <TextBox Style="{StaticResource TextBoxStyle}" Text="{Binding Username}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Style="{StaticResource LabelStyle}">密码</Label>
                        <PasswordBox Margin="5" Width="200" PasswordChar="*"  VerticalContentAlignment="Center"
                      mah:PasswordBoxBindingBehavior.Password="{Binding Password}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"  Margin="10,0,70,10" HorizontalAlignment="Right">
                        <Button Margin="10" FontSize="16" MinWidth="80" Command="{Binding LoginCommand}">登录</Button>
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="角色管理" >
                <StackPanel  Orientation="Vertical" >
                    <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                        <Button Width="50" HorizontalAlignment="Left" Margin="5" Command="{Binding RoleAddCommand}">增加</Button>
                        <Button Width="50" HorizontalAlignment="Left" Margin="5" Command="{Binding RoledeleteCommand}">删除</Button>
                        <Button Width="50" HorizontalAlignment="Left" Margin="5" Command="{Binding RoleEditCommand}">修改</Button>
                    </StackPanel>
                    <DataGrid HorizontalAlignment="Stretch"  IsReadOnly="True" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="角色等级" Binding="{Binding Level}" Width="1*" />
                            <DataGridTextColumn Header="角色" Binding="{Binding Name}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>
            <TabItem Header="账户管理" VerticalAlignment="Top" HorizontalAlignment="Stretch" > 
                <StackPanel Orientation="Vertical">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"  Orientation="Horizontal">
                        <Button Width="50" HorizontalAlignment="Left" Margin="5" Command="{Binding AccountAddCommand}">
                            <Image Width="20" Height="20" Source="/DC.Authorization.WPF;component/Resources/Codicons-Add.png"/>
                        </Button>
                        <Button Width="50" HorizontalAlignment="Left" Margin="5" Command="{Binding AccountEditCommand}" IsEnabled="{Binding SelectedAccount,Converter={StaticResource EnableConverter}}">
                            <Image Width="20" Height="20" Source="/DC.Authorization.WPF;component/Resources/Codicons-Edit.png"/>
                        </Button>
                        <Button Width="50" HorizontalAlignment="Left" Margin="5" Command="{Binding AccountDeleteCommand}" IsEnabled="{Binding SelectedAccount,Converter={StaticResource EnableConverter}}">
                            <Image Width="20" Height="20" Source="/DC.Authorization.WPF;component/Resources/Material-DeleteAlertOutline.png"/>
                        </Button>
                    </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Width="50" Margin="5" HorizontalAlignment="Center"  Command="{Binding ImportCommand}" ToolTip="导入">
                                <Image Width="20" Height="20" Source="/DC.Authorization.WPF;component/Resources/RemixIcon-ImportLine.png"/>
                            </Button>
                            <Button Width="50" Margin="5" HorizontalAlignment="Center" Command="{Binding ExportCommand}" ToolTip="导出">
                                <Image Width="20" Height="20" Source="/DC.Authorization.WPF;component/Resources/RemixIcon-ExportFill.png"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <DataGrid IsReadOnly="True" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="用户名" Binding="{Binding AccName}" Width="1*"/>
                            <DataGridTextColumn Header="卡号" Binding="{Binding TelNo}" Width="1*"/>
                            <DataGridTextColumn Header="角色" Binding="{Binding RoleName}" Width="1*" />
                            <DataGridTextColumn Header="姓名" Binding="{Binding RealName}" Width="1*"/>
                            <DataGridTextColumn Header="所在部门" Binding="{Binding Department}" Width="1*" />
                            <DataGridTextColumn Header="登录时限(分钟)" Binding="{Binding SessionExpireMin}" Width="1*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>
            <TabItem Header="权限配置" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部：角色选择 + 保存 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,5" HorizontalAlignment="Center">
                        <Label Content="角色" VerticalAlignment="Center" FontSize="14" Margin="0,0,5,0"/>
                        <ComboBox Height="35" Width="500" VerticalAlignment="Center"
                                  ItemsSource="{Binding RolesForRights}" SelectedItem="{Binding SelectedRightRole}" DisplayMemberPath="Name"/>
                        <Button Height="35" Width="60" FontSize="14" Margin="15,0,0,0" VerticalAlignment="Center"
                                Command="{Binding SaveRightsCommand}">保存</Button>
                    </StackPanel>

                    <!-- 下方：左右两栏 -->
                    <Grid Grid.Row="1" Margin="10,5,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左栏：操作权限 -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="操作权限" FontWeight="Bold" FontSize="14" Margin="5,0,0,5"/>
                            <TreeView Grid.Row="1" ItemsSource="{Binding RightTree}" BorderThickness="0">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="True"/>
                                        <Setter Property="Margin" Value="0,2,0,2"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="13"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>

                        <!-- 分隔线 -->
                        <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="LightGray"/>

                        <!-- 右栏：界面可见性 -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="界面可见性" FontWeight="Bold" FontSize="14" Margin="5,0,0,5"/>
                            <TreeView Grid.Row="1" ItemsSource="{Binding VisibilityRightTree}" BorderThickness="0">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="True"/>
                                        <Setter Property="Margin" Value="0,2,0,2"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="13"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="审计日志" Visibility="{Binding CurrentLogin,Converter={StaticResource TabItemVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" >
                        <hc:DateTimePicker
                            Width="225" Height="30" Margin="0,0,10,0"
                            DateTimeFormat="yyyy/MM/dd HH:mm:ss"
                            hc:InfoElement.Placeholder="请选择开始时间"
                            hc:InfoElement.Title="开始时间:"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:InfoElement.TitleWidth="70"
                            SelectedDateTime="{Binding StartDate}" />
                        <hc:DateTimePicker
                            Width="225" Height="30" Margin="0,0,10,0"
                            DateTimeFormat="yyyy/MM/dd HH:mm:ss"
                            hc:InfoElement.Placeholder="请选择结束时间"
                            hc:InfoElement.Title="结束时间:"
                            hc:InfoElement.TitlePlacement="Left"
                            hc:InfoElement.TitleWidth="70"
                            SelectedDateTime="{Binding EndDate}" />
                        <Button Command="{Binding SearchCommand}" FontSize="16" MinWidth="80">查询</Button>
                    </StackPanel>

                    <DataGrid Grid.Row="1" Height="400" ItemsSource="{Binding Logs}" IsReadOnly="True" AutoGenerateColumns="False">
                        <DataGrid.Columns >
                            <DataGridTextColumn Header="操作时间" Width="2*" Binding="{Binding When, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}"/>
                            <DataGridTextColumn Header="操作员" Width="*" Binding="{Binding AccountName}"/>
                            <DataGridTextColumn Header="操作" Width="2*" Binding="{Binding Operation}"/>
                            <DataGridTextColumn Header="详细内容" Width="4*" Binding="{Binding Detail}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Margin="10" Command="{Binding PreviousPageCommand}">上一页</Button>
                        <Label Margin="10" Content="{Binding LogCurrentPage}"/>
                        <Button Margin="10" Command="{Binding NextPageCommand}">下一页</Button>
                        <Separator Margin="5,0" />
                        <TextBlock VerticalAlignment="Center" Text="跳转到" />
                        <TextBox Margin="5,0" Width="50" VerticalAlignment="Center" VerticalContentAlignment="Center" Text="{Binding JumpPageText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock VerticalAlignment="Center" Text="页" />
                        <Button Margin="5,0,10,0" Command="{Binding JumpPageCommand}" Content="跳转" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
