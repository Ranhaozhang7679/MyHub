<Window
    x:Class="LusterMotion.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:LusterMotion"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SplashWindow"
    Width="800"
    Height="450"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True"
    WindowStyle="None"
    mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <WindowChrome
            GlassFrameThickness="-1"
            NonClientFrameEdges="None"
            ResizeBorderThickness="1" />
    </WindowChrome.WindowChrome>
    <Border Background="{DynamicResource RegionBrush}" CornerRadius="10">
        <Grid Margin="10" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Image
                        Height="24"
                        HorizontalAlignment="Left"
                        Source="/Luster.Common.Assets;component/Image/logo.ico" />
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,40,0,0"
                        Orientation="Horizontal">
                        <Image
                            Height="64"
                            HorizontalAlignment="Left"
                            Source="/LusterMotion;component/logo.ico" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="24"
                            FontWeight="Bold"
                            Text="HyperTrain" />
                    </StackPanel>
                    <TextBlock
                        Grid.Row="2"
                        Margin="0,20"
                        FontSize="16"
                        FontWeight="Light"
                        TextWrapping="WrapWithOverflow">
                        HyperTrain 是一款图形化运控软件，无需编程即可实现轴卡控制、设备通信、数据处理以及生产监控功能，可以快速构建复杂的、高稳健的可配置运控系统。
                    </TextBlock>
                </Grid>
                <Border
                    Grid.Column="1"
                    Background="{DynamicResource BorderBrush}"
                    CornerRadius="10">
                    <Image Source="/Luster.Motion.Assests;component/Images/loading-small.png" />
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,10">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <ProgressBar Value="{Binding ProgressVal, RelativeSource={RelativeSource AncestorType=local:SplashWindow, Mode=FindAncestor}}" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,5,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="15"
                    Text="{Binding ShowTips, RelativeSource={RelativeSource AncestorType=local:SplashWindow, Mode=FindAncestor}}" />
            </Grid>
        </Grid>
    </Border>

</Window>
